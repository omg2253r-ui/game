# Copy to apps/api/.env  (Next.js and the worker read this file).
# Everything is optional for local development: with nothing set, the API uses
# a JSON file store, an in-process queue, local file storage and the mock
# generator, so `pnpm dev` works offline.

# --- Security -------------------------------------------------------------
# HMAC key for the session cookie. REQUIRED in production (≥ 32 chars):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Only behind a proxy you control (Cloudflare, a load balancer): trust X-Forwarded-For.
TRUST_PROXY=false

# --- Database (PostgreSQL) -----------------------------------------------
# docker compose up -d   then   pnpm db:migrate
# DATABASE_URL=postgres://design3d:design3d@localhost:5432/design3d

# --- Queue + rate limiting (Redis / BullMQ) ------------------------------
# Requires DATABASE_URL. Run extra workers with `pnpm worker`.
# REDIS_URL=redis://localhost:6379
RUN_WORKER_IN_API=true
WORKER_CONCURRENCY=2

# --- File storage --------------------------------------------------------
# local = DATA_DIR/storage. s3 = any S3-compatible store (Cloudflare R2, AWS S3, MinIO).
STORAGE_DRIVER=local
# Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com   MinIO: http://localhost:9000
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=design3d-models
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Text-to-3D provider -------------------------------------------------
# mock  = offline procedural generator (no key, not AI)
# meshy = https://www.meshy.ai   (MESHY_API_KEY)
# tripo = https://www.tripo3d.ai (TRIPO_API_KEY)
AI_PROVIDER=mock
# MESHY_API_KEY=
# TRIPO_API_KEY=
# 0 = instant, 1 = realistic pacing (3–10 s) so the progress UI is visible.
MOCK_DELAY_SCALE=1
PROVIDER_TIMEOUT_SECONDS=900

# --- Product limits ------------------------------------------------------
STARTER_CREDITS=50
RATE_LIMIT_USER_PER_MIN=6
RATE_LIMIT_IP_PER_MIN=30

DATA_DIR=.data
