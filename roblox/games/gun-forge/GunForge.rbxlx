</ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX00000037"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX00000036"><Properties><string name="Name">Server</string></Properties><Item class="Script" referent="RBX00000018"><Properties><string name="Name">Main</string><ProtectedString name="Source">-- Server entry. Services are plain modules with Init(services); order matters only
-- for who connects to DataService.Loaded first (all connect before any player loads).
local Services = script.Parent.Services

local order = {
	"DataService",
	"WorldService",
	"MapService",
	"MonetizationService",
	"EconomyService",
	"AnalyticsService",
	"QuestService",
	"RewardService",
	"LeaderboardService",
	"CollectibleService",
	-- Gun Forge
	"PlayerService",
	"InventoryService",
	"PetService",
	"ClanService",
	"TrainingService",
	"ZoneService",
	"MonsterService",
	"GunService",
	"ForgeService",
	"MinigameService",
	"StationService",
	"RebirthService",
	"CodesService",
	"WorldBossService",
	"ArenaService",
	"TournamentService",
	"GemShopService",
}

local services = {}
for _, name in ipairs(order) do
	services[name] = require(Services:WaitForChild(name))
end

-- DataService.Init last-but-first: other services must subscribe to Loaded before players load
for _, name in ipairs(order) do
	if name ~= "DataService" and services[name].Init then
		services[name].Init(services)
	end
end
services.DataService.Init()

print(("[Server] %d services started"):format(#order))
</ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000035"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX00000019"><Properties><string name="Name">AnalyticsService</string><ProtectedString name="Source">-- Thin wrappers: Roblox AnalyticsService (funnels/economy dashboards) + BadgeService.
-- All calls are pcall-wrapped so analytics can never break gameplay.
local RbxAnalytics = game:GetService("AnalyticsService")
local BadgeService = game:GetService("BadgeService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Economy = require(ReplicatedStorage.Shared.Config.Economy)

local AnalyticsService = {}

function AnalyticsService.Event(player: Player, name: string, value: number?)
	pcall(function()
		RbxAnalytics:LogCustomEvent(player, name, value or 1)
	end)
end

-- Onboarding funnel: call with steps 1..n in order (e.g. 1 Joined, 2 FirstCollect, 3 OpenedShop)
function AnalyticsService.Funnel(player: Player, step: number, stepName: string)
	pcall(function()
		RbxAnalytics:LogOnboardingFunnelStepEvent(player, step, stepName)
	end)
end

function AnalyticsService.Economy(player: Player, flow: "Source" | "Sink", currency: string, amount: number, balance: number, txType: string, sku: string?)
	pcall(function()
		local flowType = if flow == "Source" then Enum.AnalyticsEconomyFlowType.Source else Enum.AnalyticsEconomyFlowType.Sink
		RbxAnalytics:LogEconomyEvent(player, flowType, currency, amount, balance, txType, sku)
	end)
end

function AnalyticsService.Purchase(player: Player, sku: string, robux: number?)
	AnalyticsService.Event(player, "Purchase_" .. sku, robux or 0)
	AnalyticsService.Badge(player, "FirstPurchase")
end

function AnalyticsService.Badge(player: Player, key: string)
	local id = Economy.Badges[key]
	if not id or id == 0 then
		return
	end
	task.spawn(function()
		pcall(function()
			if not BadgeService:UserHasBadgeAsync(player.UserId, id) then
				BadgeService:AwardBadge(player.UserId, id)
			end
		end)
	end)
end

function AnalyticsService.Init(services)
	services.DataService.Loaded:Connect(function(player)
		AnalyticsService.Funnel(player, 1, "Joined")
		AnalyticsService.Badge(player, "Welcome")
	end)
	services.EconomyService.Earned:Connect(function(player, currency, amount, source)
		local bal = services.EconomyService.Get(player, currency)
		AnalyticsService.Economy(player, "Source", currency, amount, bal, Enum.AnalyticsEconomyTransactionType.Gameplay.Name, source)
	end)
end

return AnalyticsService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001A"><Properties><string name="Name">ArenaService</string><ProtectedString name="Source">-- PvP arena: queues (Duel/Duo/Squad), matches in Map.Arena.Arena1..3, normalized HP/damage
-- (Power &amp; passes never matter), no real deaths (respawn at team spawn), Elo rating.
-- StartMatch() is reused by TournamentService.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Combat = require(Shared.Config.Combat)
local Net = require(Shared.Net)

local ArenaService = {}
local S
local A = Combat.Arena
local arenas: { Model } = {}
local busy: { [number]: any } = {}
local queues: { [string]: { Player } } = { Duel = {}, Duo = {}, Squad = {} }
local pending = {} -- matches waiting for a free arena
local matches: { [number]: any } = {}
local nextId = 0

local function root(p: Player): BasePart?
	return p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function hum(p: Player): Humanoid?
	return p.Character and p.Character:FindFirstChildOfClass("Humanoid")
end

local function spawnAt(match, p: Player)
	local team = p:GetAttribute("Team")
	local spawnPart = match.arena:FindFirstChild(team == "A" and "SpawnA" or "SpawnB") :: BasePart?
	local r = root(p)
	if spawnPart and r then
		r.CFrame = spawnPart.CFrame + Vector3.new(math.random(-4, 4), 4, math.random(-4, 4))
	end
	local h = hum(p)
	if h then
		h.Health = h.MaxHealth
	end
	if p.Character then
		local ff = Instance.new("ForceField")
		ff.Visible = true
		ff.Parent = p.Character
		task.delay(2, function()
			ff:Destroy()
		end)
	end
end

local function removeFromQueues(p: Player)
	for _, q in pairs(queues) do
		local i = table.find(q, p)
		if i then
			table.remove(q, i)
		end
	end
end

local function pushQueue(mode: string)
	local q = queues[mode]
	for _, p in ipairs(q) do
		Net.fire(p, "QueueState", { mode = mode, count = #q, need = A.Modes[mode].teamSize * 2 })
	end
end

local function sendState(match)
	local names = { A = {}, B = {} }
	for team, list in pairs(match.teams) do
		for _, p in ipairs(list) do
			table.insert(names[team], p.DisplayName)
		end
	end
	for _, list in pairs(match.teams) do
		for _, p in ipairs(list) do
			Net.fire(p, "MatchState", { id = match.id, mode = match.modeName, team = p:GetAttribute("Team"), names = names,
				kills = match.kills, killsToWin = match.killsToWin, endsAt = match.endsAt })
		end
	end
end

local function avgRating(list: { Player }): number
	local sum, n = 0, 0
	for _, p in ipairs(list) do
		local d = S.DataService.Get(p)
		if d then
			sum += d.pvp.rating
			n += 1
		end
	end
	return if n &gt; 0 then sum / n else 1000
end

local function finish(match, winner: string?)
	if match.done then
		return
	end
	match.done = true
	matches[match.id] = nil
	busy[match.arenaIndex] = nil
	local ra, rb = avgRating(match.teams.A), avgRating(match.teams.B)
	for team, list in pairs(match.teams) do
		local mine, theirs = if team == "A" then ra else rb, if team == "A" then rb else ra
		local expected = 1 / (1 + 10 ^ ((theirs - mine) / 400))
		local score = if winner == nil then 0.5 elseif winner == team then 1 else 0
		local delta = if match.ranked then math.floor(A.EloK * (score - expected) + 0.5) else 0
		for _, p in ipairs(list) do
			if p.Parent then
				S.DataService.Update(p, function(d)
					d.pvp.rating = math.max(0, d.pvp.rating + delta)
					if winner == team then
						d.pvp.wins += 1
					elseif winner then
						d.pvp.losses += 1
					end
				end)
				if match.ranked then
					S.EconomyService.Add(p, "Coins", if winner == team then A.WinCoins else A.LoseCoins, "pvp", false)
				end
				if winner == team then
					S.QuestService.Progress(p, "PvpWins", 1)
					S.ClanService.AddXp(p, Combat.Clan.XpPerPvpWin)
				end
				p:SetAttribute("MatchId", nil)
				p:SetAttribute("Team", nil)
				S.PlayerService.RefreshCharacter(p)
				local r = root(p)
				if r then
					r.CFrame = CFrame.new(0, 5, 0)
				end
				Net.fire(p, "MatchEnd", { winner = winner, team = team, delta = delta, ranked = match.ranked })
			end
		end
	end
	if match.onEnd then
		task.spawn(match.onEnd, winner, match)
	end
end

local function begin(match)
	-- drop players who left while the match was pending
	for team, list in pairs(match.teams) do
		for i = #list, 1, -1 do
			if not list[i].Parent then
				table.remove(list, i)
			end
		end
		if #list == 0 then
			match.arenaIndex = 0
			finish(match, if team == "A" then "B" else "A")
			return true
		end
	end
	for i, arena in ipairs(arenas) do
		if not busy[i] then
			busy[i] = match
			match.arena, match.arenaIndex = arena, i
			match.endsAt = Workspace:GetServerTimeNow() + match.minutes * 60
			matches[match.id] = match
			for team, list in pairs(match.teams) do
				for _, p in ipairs(list) do
					removeFromQueues(p)
					p:SetAttribute("MatchId", match.id)
					p:SetAttribute("Team", team)
					S.PlayerService.RefreshCharacter(p)
					spawnAt(match, p)
				end
			end
			sendState(match)
			return true
		end
	end
	return false
end

function ArenaService.Dequeue(p: Player)
	removeFromQueues(p)
	Net.fire(p, "QueueState", nil)
end

-- teamA/teamB: lists of players. opts: { killsToWin, minutes, ranked, onEnd(winnerTeam|nil, match) }
function ArenaService.StartMatch(teamA: { Player }, teamB: { Player }, modeName: string, opts)
	nextId += 1
	local match = { id = nextId, teams = { A = teamA, B = teamB }, kills = { A = 0, B = 0 }, modeName = modeName,
		killsToWin = opts.killsToWin, minutes = opts.minutes, ranked = opts.ranked, onEnd = opts.onEnd }
	if not begin(match) then
		table.insert(pending, match)
	end
	return match
end

function ArenaService.Damage(attacker: Player, victim: Player, dmg: number): boolean
	local mid = attacker:GetAttribute("MatchId")
	local match = mid and matches[mid]
	if not match or victim:GetAttribute("MatchId") ~= mid or victim:GetAttribute("Team") == attacker:GetAttribute("Team") then
		return false
	end
	local h = hum(victim)
	if not h or h.Health &lt;= 0 or (victim.Character and victim.Character:FindFirstChildOfClass("ForceField")) then
		return false
	end
	if h.Health - dmg &gt; 0 then
		h.Health -= dmg
		return true
	end
	local team = attacker:GetAttribute("Team")
	match.kills[team] += 1
	Net.fire(attacker, "Announce", "You eliminated " .. victim.DisplayName .. "!")
	S.ClanService.AddXp(attacker, Combat.Clan.XpPerKill)
	if match.kills[team] &gt;= match.killsToWin then
		finish(match, team)
	else
		task.delay(0, function()
			spawnAt(match, victim)
		end)
		sendState(match)
	end
	return true
end

local function leave(p: Player)
	removeFromQueues(p)
	local mid = p:GetAttribute("MatchId")
	local match = mid and matches[mid]
	if not match then
		return
	end
	for team, list in pairs(match.teams) do
		local i = table.find(list, p)
		if i then
			table.remove(list, i)
			if #list == 0 then
				finish(match, if team == "A" then "B" else "A")
			end
		end
	end
end

local function matchmake()
	for mode, q in pairs(queues) do
		local size = A.Modes[mode].teamSize
		while #q &gt;= size * 2 do
			local group = {}
			for _ = 1, size * 2 do
				table.insert(group, table.remove(q, 1))
			end
			table.sort(group, function(a, b) -- snake draft by rating for fair teams
				local da, db = S.DataService.Get(a), S.DataService.Get(b)
				return (da and da.pvp.rating or 0) &gt; (db and db.pvp.rating or 0)
			end)
			local ta, tb = {}, {}
			for i, p in ipairs(group) do
				table.insert(if (i % 4 == 1 or i % 4 == 0) then ta else tb, p)
			end
			local m = A.Modes[mode]
			ArenaService.StartMatch(ta, tb, m.name, { killsToWin = m.killsToWin, minutes = m.minutes, ranked = true })
		end
		pushQueue(mode)
	end
	for i = #pending, 1, -1 do
		if begin(pending[i]) then
			table.remove(pending, i)
		end
	end
	local t = Workspace:GetServerTimeNow()
	for _, match in pairs(matches) do
		if t &gt;= match.endsAt then
			local a, b = match.kills.A, match.kills.B
			finish(match, if a &gt; b then "A" elseif b &gt; a then "B" else nil)
		end
	end
end

function ArenaService.Init(services)
	S = services
	for _, n in ipairs({ "QueueState", "MatchState", "MatchEnd" }) do
		Net.declare(n)
	end
	task.spawn(function()
		local root = Workspace:WaitForChild("Map", 30)
		local arenaFolder = root and root:WaitForChild("Arena", 30)
		for i = 1, 3 do
			local a = arenaFolder and arenaFolder:WaitForChild("Arena" .. i, 10)
			if a then
				table.insert(arenas, a :: Model)
			end
		end
	end)

	Net.on("QueueJoin", function(player, mode)
		if type(mode) ~= "string" or not queues[mode] or player:GetAttribute("MatchId") or player:GetAttribute("InTournament") then
			return
		end
		removeFromQueues(player)
		table.insert(queues[mode], player)
		pushQueue(mode)
	end, 2)
	Net.on("QueueLeave", function(player)
		removeFromQueues(player)
		Net.fire(player, "QueueState", nil)
	end, 2)
	Net.handle("PvpStats", function(player)
		local d = S.DataService.Get(player)
		return d and d.pvp
	end, 2)

	Players.PlayerRemoving:Connect(leave)
	Players.PlayerAdded:Connect(function(p)
		p.CharacterAdded:Connect(function()
			local mid = p:GetAttribute("MatchId")
			if mid and matches[mid] then
				task.wait(0.3)
				S.PlayerService.RefreshCharacter(p)
				spawnAt(matches[mid], p)
			end
		end)
	end)
	task.spawn(function()
		while true do -- lint-ok (task.wait)
			task.wait(2)
			matchmake()
		end
	end)
end

return ArenaService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001B"><Properties><string name="Name">ClanService</string><ProtectedString name="Source">-- Clans (cross-server): DataStore records, roles, invites, filtered names/tags, clan XP + perks,
-- weekly Clan War leaderboard (OrderedDataStore per week). All web calls pcall-wrapped.
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")

local Shared = ReplicatedStorage.Shared
local Combat = require(Shared.Config.Combat)
local Net = require(Shared.Net)

local ClanService = {}
local S
local C = Combat.Clan
local okStore, store = pcall(DataStoreService.GetDataStore, DataStoreService, "Clans_v1")
local cache: { [string]: { data: any, t: number } } = {}
local localClans: { [string]: any } = {} -- offline fallback (Studio without API access)
local pendingXp: { [string]: number } = {}
local invites: { [Player]: { [string]: boolean } } = {}
local warCache = { t = 0, list = {} }
local busy: { [Player]: boolean } = {} -- one clan mutation per player at a time (handlers yield)

-- wraps a RemoteFunction handler: serialises per player and never throws back at the client
local function guarded(fn)
	return function(player: Player, ...)
		if busy[player] then
			return "Busy"
		end
		busy[player] = true
		local ok, res = pcall(fn, player, ...)
		busy[player] = nil
		if not ok then
			warn("[Clan]", res)
			return "Error"
		end
		return res
	end
end

local function week(): number
	return math.floor((os.time() - 345600) / 604800) -- weeks starting Monday UTC
end

local function warStore()
	local ok, s = pcall(DataStoreService.GetOrderedDataStore, DataStoreService, "ClanWar_" .. week())
	return ok and s or nil
end

-- returns data, fetched (fetched=false: the DataStore read failed, data is only a fallback)
local function load(id: string, fresh: boolean?)
	local c = cache[id]
	if c and not fresh and os.clock() - c.t &lt; 60 then
		return c.data, true
	end
	local data = localClans[id]
	local fetched = not okStore
	if okStore then
		local ok, res = pcall(store.GetAsync, store, id)
		if ok then
			data, fetched = res, true
		end
	end
	if fetched then
		cache[id] = { data = data, t = os.clock() }
	end
	return data, fetched
end

-- atomic modify; fn(data) returns data or nil to abort
local function modify(id: string, fn)
	local result
	local useLocal = not okStore
	if okStore then
		local ok, err = pcall(function()
			store:UpdateAsync(id, function(old) -- lint-ok (pcall)
				result = fn(old)
				return result
			end)
		end)
		if not ok then
			warn("[Clan] update failed", err)
			if not tostring(err):find("API") then
				return nil
			end
			result, useLocal = nil, true -- Studio without API access: keep clans in memory
		end
	end
	if useLocal then
		result = fn(localClans[id])
	end
	if result ~= nil then
		localClans[id] = result
		cache[id] = { data = result, t = os.clock() }
	end
	return result
end

local function level(xp: number): number
	return math.floor(xp / C.XpPerLevel)
end

function ClanService.Perk(player: Player): number
	return (player:GetAttribute("ClanPerk") :: number?) or 0
end

local function applyTag(player: Player, clan)
	player:SetAttribute("ClanTag", clan and clan.tag or nil)
	player:SetAttribute("ClanPerk", clan and math.min(0.5, level(clan.xp) * C.PerkPerLevel) or 0)
	local head = player.Character and player.Character:FindFirstChild("Head")
	local old = head and head:FindFirstChild("ClanTag")
	if old then
		old:Destroy()
	end
	if clan and head then
		local g = Instance.new("BillboardGui")
		g.Name = "ClanTag"
		g.Size = UDim2.fromOffset(100, 24)
		g.StudsOffset = Vector3.new(0, 3.3, 0)
		g.MaxDistance = 60
		local l = Instance.new("TextLabel")
		l.Size = UDim2.fromScale(1, 1)
		l.BackgroundTransparency = 1
		l.Font = Enum.Font.FredokaOne
		l.TextScaled = true
		l.Text = "[" .. clan.tag .. "]"
		l.TextColor3 = Color3.fromRGB(58, 216, 255)
		l.TextStrokeTransparency = 0.2
		l.Parent = g
		g.Parent = head
	end
end

local function filter(text: string, userId: number): string?
	local ok, res = pcall(function()
		return TextService:FilterStringAsync(text, userId):GetNonChatStringForBroadcastAsync()
	end)
	return if ok then res else nil
end

local function myClan(player: Player)
	local d = S.DataService.Get(player)
	if not d or d.clan == "" then
		return nil, nil
	end
	return d.clan, load(d.clan)
end

local function setClan(player: Player, id: string)
	S.DataService.Update(player, function(d)
		d.clan = id
	end)
end

function ClanService.AddXp(player: Player, n: number)
	local d = S.DataService.Get(player)
	if d and d.clan ~= "" then
		pendingXp[d.clan] = (pendingXp[d.clan] or 0) + n
	end
end

local function flush()
	local batch = pendingXp
	pendingXp = {}
	local ws = warStore()
	for id, xp in pairs(batch) do
		modify(id, function(c)
			if c then
				c.xp += xp
			end
			return c
		end)
		if ws then
			pcall(ws.IncrementAsync, ws, id, xp)
		end
	end
	for _, p in ipairs(Players:GetPlayers()) do
		local _, clan = myClan(p)
		if clan then
			p:SetAttribute("ClanPerk", math.min(0.5, level(clan.xp) * C.PerkPerLevel))
		end
	end
end

local function info(player: Player)
	local id, clan = myClan(player)
	if not clan or not clan.members[tostring(player.UserId)] then
		return { clan = nil }
	end
	local members = {}
	for uid, m in pairs(clan.members) do
		table.insert(members, { userId = tonumber(uid), name = m.name, role = m.role, online = Players:GetPlayerByUserId(tonumber(uid) or 0) ~= nil })
	end
	table.sort(members, function(a, b)
		return a.role &lt; b.role
	end)
	return { clan = { id = id, name = clan.name, tag = clan.tag, xp = clan.xp, level = level(clan.xp), perk = math.min(0.5, level(clan.xp) * C.PerkPerLevel),
		max = C.MaxMembers, members = members }, role = clan.members[tostring(player.UserId)].role }
end

function ClanService.Init(services)
	S = services
	Net.declare("ClanInvite")

	S.DataService.Loaded:Connect(function(player, data)
		if data.clan ~= "" then
			local clan, fetched = load(data.clan, true)
			if fetched and (not clan or not clan.members[tostring(player.UserId)]) then
				setClan(player, "") -- kicked / disbanded while away
			elseif clan and clan.members[tostring(player.UserId)] then
				applyTag(player, clan)
			end
		end
		player.CharacterAdded:Connect(function()
			task.wait(0.5)
			local _, clan = myClan(player)
			applyTag(player, clan)
		end)
	end)
	Players.PlayerRemoving:Connect(function(p)
		invites[p] = nil
		busy[p] = nil
	end)

	Net.handle("ClanInfo", info, 3)

	Net.handle("ClanCreate", guarded(function(player, name, tag)
		if type(name) ~= "string" or type(tag) ~= "string" then
			return "Invalid"
		end
		name, tag = name:sub(1, C.NameMaxLen), tag:upper():sub(1, C.TagMaxLen)
		if #name &lt; 3 or #tag &lt; 2 or not tag:match("^[A-Z0-9]+$") then
			return "Name 3+ chars, tag 2-4 letters/numbers"
		end
		if myClan(player) then
			return "Leave your clan first"
		end
		local fName, fTag = filter(name, player.UserId), filter(tag, player.UserId)
		if fName ~= name or fTag ~= tag then
			return "That name is not allowed"
		end
		if not S.EconomyService.Spend(player, "Coins", C.CreateCoins) then
			return ("Need %d Coins"):format(C.CreateCoins)
		end
		local id = HttpService:GenerateGUID(false)
		local made = modify(id, function()
			return { name = name, tag = tag, owner = player.UserId, xp = 0, created = os.time(),
				members = { [tostring(player.UserId)] = { role = "1Leader", name = player.DisplayName } } }
		end)
		if not made then
			S.EconomyService.Add(player, "Coins", C.CreateCoins, "clan_refund", false)
			return "Could not create clan, try again"
		end
		setClan(player, id)
		applyTag(player, made)
		return "OK"
	end), 1)

	Net.on("ClanInviteSend", function(player, targetUserId)
		local id, clan = myClan(player)
		local target = type(targetUserId) == "number" and Players:GetPlayerByUserId(targetUserId)
		if not clan or not target or target == player then
			return
		end
		local mine = clan.members[tostring(player.UserId)]
		if not mine or mine.role == "3Member" then
			return
		end
		invites[target] = invites[target] or {}
		invites[target][id] = true
		Net.fire(target, "ClanInvite", { id = id, name = clan.name, tag = clan.tag, from = player.DisplayName })
	end, 3)

	Net.handle("ClanAccept", guarded(function(player, id)
		if type(id) ~= "string" or not (invites[player] and invites[player][id]) or myClan(player) then
			return "No invite"
		end
		local full = false
		local res = modify(id, function(c)
			if not c then
				return nil
			end
			local n = 0
			for _ in pairs(c.members) do
				n += 1
			end
			if n &gt;= C.MaxMembers then
				full = true
				return nil
			end
			c.members[tostring(player.UserId)] = { role = "3Member", name = player.DisplayName }
			return c
		end)
		if full or not res then
			return "Clan is full"
		end
		invites[player] = nil
		setClan(player, id)
		applyTag(player, res)
		return "OK"
	end), 2)

	Net.handle("ClanLeave", guarded(function(player)
		local id, clan = myClan(player)
		if not id then
			return "Not in a clan"
		end
		if not clan then -- stale reference to a missing clan record: just detach
			setClan(player, "")
			applyTag(player, nil)
			return "OK"
		end
		local uid = tostring(player.UserId)
		modify(id :: string, function(c)
			if not c then
				return nil
			end
			c.members[uid] = nil
			if c.owner == player.UserId then -- hand over to an officer, else anyone
				local heir, best = nil, "9"
				for k, m in pairs(c.members) do
					if m.role &lt; best then
						heir, best = k, m.role
					end
				end
				if heir then
					c.owner = tonumber(heir)
					c.members[heir].role = "1Leader"
				end
			end
			return c
		end)
		setClan(player, "")
		applyTag(player, nil)
		return "OK"
	end), 2)

	-- action: "kick" | "promote" | "demote"
	Net.handle("ClanManage", guarded(function(player, targetUserId, action)
		local id, clan = myClan(player)
		if not clan or type(targetUserId) ~= "number" then
			return "Invalid"
		end
		local mine = clan.members[tostring(player.UserId)]
		local me = mine and mine.role
		local key = tostring(targetUserId)
		local them = clan.members[key]
		if not me or not them or me &gt;= them.role then
			return "No permission"
		end
		if action ~= "kick" and action ~= "promote" and action ~= "demote" then
			return "Invalid"
		end
		modify(id :: string, function(c)
			local m = c and c.members[key]
			if not m then
				return c
			end
			if action == "kick" then
				c.members[key] = nil
			elseif action == "promote" and me == "1Leader" then
				m.role = "2Officer"
			elseif action == "demote" and me == "1Leader" then
				m.role = "3Member"
			end
			return c
		end)
		local target = Players:GetPlayerByUserId(targetUserId)
		if target and action == "kick" then
			setClan(target, "")
			applyTag(target, nil)
		end
		return "OK"
	end), 3)

	Net.handle("ClanWarTop", function()
		if os.clock() - warCache.t &gt; 120 then
			warCache.t = os.clock()
			local ws = warStore()
			local ok, pages = false, nil
			if ws then
				ok, pages = pcall(ws.GetSortedAsync, ws, false, 10)
			end
			local list = {}
			if ok and pages then
				for rank, e in ipairs(pages:GetCurrentPage()) do
					local clan = load(e.key)
					table.insert(list, { rank = rank, name = clan and clan.name or "?", tag = clan and clan.tag or "", xp = e.value })
				end
			end
			warCache.list = list
		end
		return warCache.list
	end, 2)

	task.spawn(function()
		while true do -- lint-ok (task.wait)
			task.wait(60)
			flush()
		end
	end)
	game:BindToClose(flush)
end

return ClanService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001C"><Properties><string name="Name">CodesService</string><ProtectedString name="Source">-- Redeem codes from Config/Codes.luau (once per player).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Codes = require(ReplicatedStorage.Shared.Config.Codes)
local Net = require(ReplicatedStorage.Shared.Net)

local CodesService = {}

function CodesService.Init(S)
	Net.handle("Redeem", function(player, code)
		if type(code) ~= "string" or #code &gt; 30 then
			return "Invalid code"
		end
		code = code:upper():gsub("%s", "")
		local def = Codes[code]
		local d = S.DataService.Get(player)
		if not def or not d then
			return "Invalid code"
		end
		if def.expires ~= 0 and os.time() &gt; def.expires then
			return "Code expired"
		end
		if d.codes[code] then
			return "Already redeemed"
		end
		S.DataService.Update(player, function(data)
			data.codes[code] = true
		end)
		S.EconomyService.Grant(player, def.reward, "code")
		return "OK"
	end, 1)
end

return CodesService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001D"><Properties><string name="Name">CollectibleService</string><ProtectedString name="Source">-- DEMO gameplay loop so a fresh template is instantly playable: glowing coins spawn
-- around the map, touching one pays out. Replace/extend with the genre's core loop
-- (keep the pattern: server spawns + validates, client only does visuals).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Cfg = require(Shared.Config.Settings).Collectibles
local Net = require(Shared.Net)

local CollectibleService = {}

function CollectibleService.Init(services)
	if not Cfg.Enabled then
		return
	end
	Net.declare("Collected")
	local folder = Instance.new("Folder")
	folder.Name = "Collectibles"
	folder.Parent = workspace

	-- Optional designer-placed spawn points: workspace.CoinSpawns (Parts)
	local spawns = workspace:FindFirstChild("CoinSpawns")
	local rng = Random.new()
	local active = 0

	local function spawnPoint(): Vector3
		if spawns and #spawns:GetChildren() &gt; 0 then
			local list = spawns:GetChildren()
			return list[rng:NextInteger(1, #list)].Position + Vector3.new(0, 3, 0)
		end
		local r = Cfg.SpawnRadius
		local origin = Vector3.new(rng:NextNumber(-r, r), 60, rng:NextNumber(-r, r))
		local hit = workspace:Raycast(origin, Vector3.new(0, -120, 0))
		return (hit and hit.Position or Vector3.new(origin.X, 0, origin.Z)) + Vector3.new(0, 2.5, 0)
	end

	local template = ReplicatedStorage:FindFirstChild("CoinModel") -- artist can supply a MeshPart named CoinModel

	local function spawnOne()
		local coin: BasePart
		if template then
			coin = template:Clone()
		else
			local part = Instance.new("Part")
			part.Shape = Enum.PartType.Cylinder
			part.Size = Vector3.new(0.4, 2.2, 2.2)
			part.Color = Color3.fromRGB(255, 200, 40)
			part.Material = Enum.Material.Neon
			coin = part
		end
		coin.Name = "Coin"
		coin.Anchored = true
		coin.CanCollide = false
		coin.CanQuery = false
		coin.CastShadow = false
		coin.CFrame = CFrame.new(spawnPoint()) * CFrame.Angles(0, 0, math.rad(90))
		coin:SetAttribute("Spin", true) -- client spins it locally (no server physics cost)
		local taken = false
		coin.Touched:Connect(function(hit)
			if taken then
				return
			end
			local player = Players:GetPlayerFromCharacter(hit.Parent)
			if not player then
				return
			end
			taken = true
			local pos = coin.Position
			coin:Destroy()
			active -= 1
			local got = services.EconomyService.Add(player, "Coins", Cfg.Value, "collect", true)
			services.QuestService.Progress(player, "Collect", got)
			services.QuestService.Progress(player, "Earn", got)
			Net.fire(player, "Collected", pos, got)
			task.delay(Cfg.RespawnSeconds, function()
				if active &lt; Cfg.MaxActive then
					active += 1
					spawnOne()
				end
			end)
		end)
		coin.Parent = folder
	end

	for _ = 1, Cfg.MaxActive do
		active += 1
		spawnOne()
	end
end

return CollectibleService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001E"><Properties><string name="Name">DataService</string><ProtectedString name="Source">-- Player data: session-locked DataStore with retries, autosave, reconcile, BindToClose.
-- Falls back to an in-memory profile (not saved) when DataStores are unavailable
-- (e.g. Studio without "Enable Studio Access to API Services"), so the game stays playable.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Settings = require(Shared.Config.Settings)
local Template = require(Shared.Config.DataTemplate)
local Signal = require(Shared.Signal)

local LOCK_EXPIRE = 600 -- seconds; a lock older than this is considered dead
local MAX_LOAD_TRIES = 6

local DataService = {}
DataService.Loaded = Signal.new() -- (player, data)
DataService.Changed = Signal.new() -- (player, data)

local profiles: { [Player]: { data: any, offline: boolean, dirty: boolean } } = {}
local loadedWaiters: { [Player]: { thread } } = {}

local okStore, store = pcall(function()
	return DataStoreService:GetDataStore(Settings.DataStoreName)
end)
if not okStore then
	store = nil
	warn("[DataService] DataStore unavailable, running OFFLINE (data will not save)")
end

local function deepCopy(t)
	if type(t) ~= "table" then
		return t
	end
	local c = {}
	for k, v in pairs(t) do
		c[k] = deepCopy(v)
	end
	return c
end

local function reconcile(data, template)
	for k, v in pairs(template) do
		if data[k] == nil then
			data[k] = deepCopy(v)
		elseif type(v) == "table" and type(data[k]) == "table" then
			reconcile(data[k], v)
		end
	end
	return data
end

local function key(player: Player)
	return "u_" .. player.UserId
end

local function load(player: Player)
	if not store then
		return deepCopy(Template), true
	end
	for attempt = 1, MAX_LOAD_TRIES do
		local locked = false
		local ok, result = pcall(function()
			return store:UpdateAsync(key(player), function(old) -- lint-ok (pcall above)
				old = old or deepCopy(Template)
				local lock = old._lock
				if lock and lock.job ~= game.JobId and os.time() - lock.t &lt; LOCK_EXPIRE then
					locked = true
					return nil -- abort write, another server still owns it
				end
				old._lock = { job = game.JobId, t = os.time() }
				return old
			end)
		end)
		if ok and result and not locked then
			return reconcile(result, Template), false
		end
		if not ok then
			warn("[DataService] load error:", result)
			if tostring(result):find("API Services") or tostring(result):find("StudioAccess") then
				return deepCopy(Template), true
			end
		end
		task.wait(math.min(2 ^ attempt, 15))
	end
	-- Could not acquire: kick to protect data from duplication
	player:Kick("Your data is still saving on another server. Please rejoin in a minute.")
	return nil, false
end

local function save(player: Player, release: boolean): boolean
	local p = profiles[player]
	if not p or p.offline or not store then
		return true
	end
	local data = p.data
	for attempt = 1, 4 do
		local ok, err = pcall(function()
			store:UpdateAsync(key(player), function(old) -- lint-ok (pcall above)
				if old and old._lock and old._lock.job ~= game.JobId then
					return nil -- someone stole the lock (expired); do not overwrite
				end
				data._lock = if release then nil else { job = game.JobId, t = os.time() }
				return data
			end)
		end)
		if ok then
			p.dirty = false
			return true
		end
		warn("[DataService] save error:", err)
		task.wait(attempt * 2)
	end
	return false
end

function DataService.Get(player: Player): any?
	local p = profiles[player]
	return p and p.data
end

-- Yields until the player's data is loaded (or the player leaves).
function DataService.WaitFor(player: Player): any?
	if profiles[player] then
		return profiles[player].data
	end
	if not player.Parent then
		return nil
	end
	loadedWaiters[player] = loadedWaiters[player] or {}
	table.insert(loadedWaiters[player], coroutine.running())
	return coroutine.yield()
end

-- Mutate data safely: DataService.Update(player, function(data) data.currencies.Coins += 5 end)
function DataService.Update(player: Player, fn: (any) -&gt; ())
	local p = profiles[player]
	if not p then
		return false
	end
	fn(p.data)
	p.dirty = true
	DataService.Changed:Fire(player, p.data)
	return true
end

function DataService.Save(player: Player): boolean
	return save(player, false)
end

function DataService.IsOffline(player: Player): boolean
	local p = profiles[player]
	return p == nil or p.offline
end

local function onJoin(player: Player)
	local data, offline = load(player)
	if not data or not player.Parent then
		return
	end
	if data.firstJoin == 0 then
		data.firstJoin = os.time()
	end
	profiles[player] = { data = data, offline = offline, dirty = false }
	DataService.Loaded:Fire(player, data)
	for _, th in ipairs(loadedWaiters[player] or {}) do
		task.spawn(th, data)
	end
	loadedWaiters[player] = nil
end

local function onLeave(player: Player)
	if profiles[player] then
		save(player, true)
	end
	profiles[player] = nil
	for _, th in ipairs(loadedWaiters[player] or {}) do
		task.spawn(th, nil)
	end
	loadedWaiters[player] = nil
end

function DataService.Init()
	Players.PlayerAdded:Connect(onJoin)
	Players.PlayerRemoving:Connect(onLeave)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(onJoin, p)
	end

	task.spawn(function()
		while true do -- lint-ok (task.wait)
			task.wait(Settings.AutosaveSeconds)
			for player, p in pairs(profiles) do
				if p.dirty then
					task.spawn(save, player, false)
				end
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in pairs(profiles) do
			pending += 1
			task.spawn(function()
				save(player, true)
				pending -= 1
			end)
		end
		local t = os.clock()
		while pending &gt; 0 and os.clock() - t &lt; 25 do
			task.wait(0.1)
		end
	end)
end

return DataService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001F"><Properties><string name="Name">EconomyService</string><ProtectedString name="Source">-- Currencies (server-authoritative), leaderstats, and client sync.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Economy = require(Shared.Config.Economy)
local Net = require(Shared.Net)
local Signal = require(Shared.Signal)

local EconomyService = {}
EconomyService.Earned = Signal.new() -- (player, currency, amount, source)

local DataService, MonetizationService -- injected in Init

local function syncLeaderstats(player: Player, data)
	local ls = player:FindFirstChild("leaderstats")
	if not ls then
		return
	end
	for name, def in pairs(Economy.Currencies) do
		if def.leaderstat then
			local v = ls:FindFirstChild(name)
			if v then
				v.Value = data.currencies[name] or 0
			end
		end
	end
end

-- Push a compact snapshot to the client (HUD, shop, quests read this).
function EconomyService.Sync(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	syncLeaderstats(player, data)
	Net.fire(player, "DataSync", {
		currencies = data.currencies,
		inventory = data.inventory,
		equipped = data.equipped,
		settings = data.settings,
		passes = MonetizationService.OwnedList(player),
	})
end

function EconomyService.Get(player: Player, currency: string): number
	local data = DataService.Get(player)
	return data and data.currencies[currency] or 0
end

-- Adds currency. applyMultiplier=true for gameplay earnings (game passes boost them),
-- false for purchases/rewards with a fixed amount.
function EconomyService.Add(player: Player, currency: string, amount: number, source: string?, applyMultiplier: boolean?)
	assert(Economy.Currencies[currency], "unknown currency " .. tostring(currency))
	if amount &lt;= 0 then
		return 0
	end
	if applyMultiplier and currency == "Coins" then
		amount = math.floor(amount * MonetizationService.GetMultiplier(player, "coinMultiplier"))
	end
	local ok = DataService.Update(player, function(d)
		d.currencies[currency] = (d.currencies[currency] or 0) + amount
	end)
	if ok then
		EconomyService.Earned:Fire(player, currency, amount, source or "unknown")
		EconomyService.Sync(player)
		return amount
	end
	return 0
end

function EconomyService.Spend(player: Player, currency: string, amount: number): boolean
	if amount &lt; 0 then
		return false
	end
	local data = DataService.Get(player)
	if not data or (data.currencies[currency] or 0) &lt; amount then
		return false
	end
	DataService.Update(player, function(d)
		d.currencies[currency] -= amount
	end)
	EconomyService.Sync(player)
	return true
end

-- reward = { Coins = 100, Gems = 5 }
function EconomyService.Grant(player: Player, reward: { [string]: number }, source: string?)
	for currency, amount in pairs(reward) do
		if Economy.Currencies[currency] then
			EconomyService.Add(player, currency, amount, source, false)
		end
	end
end

function EconomyService.Init(services)
	DataService = services.DataService
	MonetizationService = services.MonetizationService
	Net.declare("DataSync")
	Net.declare("Toast")

	DataService.Loaded:Connect(function(player, data)
		local ls = Instance.new("Folder")
		ls.Name = "leaderstats"
		for name, def in pairs(Economy.Currencies) do
			if def.leaderstat then
				local v = Instance.new("IntValue")
				v.Name = name
				v.Value = data.currencies[name] or 0
				v.Parent = ls
			end
		end
		ls.Parent = player
		EconomyService.Sync(player)
	end)

	Net.handle("GetData", function(player)
		local data = DataService.WaitFor(player)
		if not data then
			return nil
		end
		return {
			currencies = data.currencies,
			inventory = data.inventory,
			equipped = data.equipped,
			settings = data.settings,
			passes = MonetizationService.OwnedList(player),
		}
	end)

	Net.on("SetSetting", function(player, name, value)
		if type(name) ~= "string" or type(value) ~= "boolean" then
			return
		end
		DataService.Update(player, function(d)
			if d.settings[name] ~= nil then
				d.settings[name] = value
			end
		end)
	end, 5)
end

function EconomyService.Toast(player: Player, text: string, kind: string?)
	Net.fire(player, "Toast", text, kind or "info")
end

return EconomyService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000020"><Properties><string name="Name">ForgeService</string><ProtectedString name="Source">-- Forge: recipe -&gt; take materials/coins -&gt; assembly minigame session -&gt; rarity/quality roll -&gt; item.
-- Minigame only nudges odds (bump chance + quality), so client-reported results are low-risk; the
-- server still enforces min duration, clamps hits and auto-finishes abandoned sessions (no lost mats).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Recipes = require(Shared.Config.Recipes)
local Guns = require(Shared.Config.Guns)
local Net = require(Shared.Net)

local ForgeService = {}
local S
local rng = Random.new()
local sessions: { [Player]: { recipe: any, t0: number, id: number } } = {}
local sid = 0

local function rollRarity(): number
	local total = 0
	for _, r in ipairs(Guns.Rarities) do
		total += r.weight
	end
	local x = rng:NextNumber() * total
	for i, r in ipairs(Guns.Rarities) do
		x -= r.weight
		if x &lt;= 0 then
			return i
		end
	end
	return 1
end

local function finish(player: Player, perfects: number)
	local sess = sessions[player]
	if not sess then
		return nil
	end
	sessions[player] = nil
	local cfg = Recipes.Minigame
	perfects = math.clamp(math.floor(perfects), 0, cfg.Parts)
	local recipe = sess.recipe
	local rarity = rollRarity()
	local bump = perfects * cfg.PerfectBump
	if S.MonetizationService.GetPerk(player, "forgeLuck") then
		bump += cfg.PassBump
	end
	local bumped = false
	if rarity &lt; #Guns.Rarities and rng:NextNumber() &lt; bump then
		rarity += 1
		bumped = true
	end
	local skill = perfects / cfg.Parts
	local quality = cfg.QualityMin + (cfg.QualityMax - cfg.QualityMin) * (skill * 0.7 + rng:NextNumber() * 0.3)
	quality = math.floor(quality * 100) / 100
	local item = if recipe.kind == "gun"
		then S.InventoryService.MakeGun(recipe.item, recipe.tier, rarity, quality)
		else S.InventoryService.MakeArmor(recipe.item, recipe.tier, rarity, quality)
	local uid = S.InventoryService.CreateItem(player, item)
	S.QuestService.Progress(player, "Crafts", 1)
	if rarity &gt;= 4 then
		S.AnalyticsService.Badge(player, "FirstLegendary")
		if rarity == 5 then
			Net.fireAll("Announce", ("%s forged a MYTHIC %s!"):format(player.DisplayName, recipe.item))
		end
	end
	return { uid = uid, item = item, bumped = bumped, perfects = perfects }
end

function ForgeService.Init(services)
	S = services
	Net.declare("Announce")

	Net.handle("ForgeStart", function(player, recipeId)
		local recipe = type(recipeId) == "string" and Recipes.ById[recipeId]
		if not recipe or sessions[player] then
			return { ok = false, err = "busy" }
		end
		if not S.InventoryService.CanAdd(player, "gun") then
			return { ok = false, err = "Inventory full — salvage some items" }
		end
		if not S.InventoryService.Take(player, recipe.mats, recipe.coins) then
			return { ok = false, err = "Missing materials or coins" }
		end
		sid += 1
		local id = sid
		sessions[player] = { recipe = recipe, t0 = os.clock(), id = id }
		task.delay(60, function() -- abandoned -&gt; finish with 0 perfects
			if sessions[player] and sessions[player].id == id then
				local res = finish(player, 0)
				if res then
					Net.fire(player, "ForgeAuto", res)
				end
			end
		end)
		return { ok = true, session = id, parts = Recipes.Minigame.Parts }
	end, 2)
	Net.declare("ForgeAuto")

	Net.handle("ForgeFinish", function(player, sessionId, perfects)
		local sess = sessions[player]
		if not sess or sess.id ~= sessionId or type(perfects) ~= "number" or perfects ~= perfects then
			return nil
		end
		if os.clock() - sess.t0 &lt; Recipes.Minigame.MinSeconds then
			perfects = 0 -- too fast = bot; still give the item
		end
		return finish(player, perfects)
	end, 2)

	Players.PlayerRemoving:Connect(function(p)
		if sessions[p] then
			finish(p, 0) -- runs before DataService releases the profile in practice; item is saved with it
		end
	end)
end

return ForgeService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000021"><Properties><string name="Name">GemShopService</string><ProtectedString name="Source">-- Gem shop: boosts, cooldown resets, coin/material packs scaled to the player's best zone.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local GemShop = require(Shared.Config.GemShop)
local Zones = require(Shared.Config.Zones)
local Monsters = require(Shared.Config.Monsters)
local Recipes = require(Shared.Config.Recipes)
local Net = require(Shared.Net)

local GemShopService = {}

function GemShopService.Init(S)
	local byKey = {}
	for _, it in ipairs(GemShop) do
		byKey[it.key] = it
	end
	Net.handle("GemBuy", function(player, key)
		local it = type(key) == "string" and byKey[key]
		if not it then
			return false
		end
		if not S.EconomyService.Spend(player, "Gems", it.gems) then
			S.EconomyService.Toast(player, "Not enough Gems", "error")
			return false
		end
		local tier = S.ZoneService.BestTier(S.PlayerService.GetPower(player))
		if it.boostSeconds then
			S.DataService.Update(player, function(d)
				d.boostUntil = math.max(os.time(), d.boostUntil) + it.boostSeconds
			end)
			S.TrainingService.Push(player)
		elseif key == "ResetGames" then
			S.MinigameService.ResetCooldowns(player)
		elseif it.coinsBossKills then
			local boss = Monsters[Zones[tier].boss]
			S.EconomyService.Add(player, "Coins", boss.coins * it.coinsBossKills, "gemshop", false)
		elseif it.common then
			S.InventoryService.AddMaterial(player, Recipes.TierMats[tier][1], it.common)
			S.InventoryService.AddMaterial(player, Recipes.TierMats[tier][2], it.rare)
		end
		S.EconomyService.Toast(player, "Bought " .. it.name, "success")
		return true
	end, 2)
end

return GemShopService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000022"><Properties><string name="Name">GunService</string><ProtectedString name="Source">-- Guns: gives the equipped gun as a Tool, validates every shot server-side (rate, range, target),
-- applies PvE damage (Power-scaled) or PvP damage (normalized, via ArenaService), relays tracers.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Guns = require(Shared.Config.Guns)
local Combat = require(Shared.Config.Combat)
local Net = require(Shared.Net)

local GunService = {}
local S
local lastShot: { [Player]: number } = {}
local lastRelay: { [Player]: number } = {}

local function buildHandle(item): BasePart
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local src = assets and assets:FindFirstChild("Guns") and assets.Guns:FindFirstChild(item.id)
	local rarityColor = Guns.Rarities[item.rarity].color
	if src and src:IsA("BasePart") then
		local h = src:Clone()
		h.Name = "Handle"
		return h
	end
	-- code-built fallback: body + barrel + glowing rarity strip, welded to Handle
	local t = Guns.Types[item.id]
	local len = 1.6 + t.range / 60
	local h = Instance.new("Part")
	h.Name = "Handle"
	h.Size = Vector3.new(0.45, 0.9, len * 0.55)
	h.Color = t.color
	h.Material = Enum.Material.SmoothPlastic
	local function add(size: Vector3, offset: CFrame, color: Color3, mat: Enum.Material)
		local p = Instance.new("Part")
		p.Size = size
		p.Color = color
		p.Material = mat
		p.CanCollide, p.CanQuery, p.CanTouch, p.Massless = false, false, false, true
		p.CFrame = h.CFrame * offset
		local w = Instance.new("WeldConstraint")
		w.Part0, w.Part1 = h, p
		w.Parent = p
		p.Parent = h
	end
	add(Vector3.new(0.35, 0.35, len), CFrame.new(0, 0.45, -len * 0.35), t.color:Lerp(Color3.new(0, 0, 0), 0.3), Enum.Material.Metal)
	add(Vector3.new(0.5, 0.12, len * 0.7), CFrame.new(0, 0.7, -len * 0.2), rarityColor, Enum.Material.Neon)
	local muzzle = Instance.new("Attachment")
	muzzle.Name = "Muzzle"
	muzzle.Position = Vector3.new(0, 0.45, -len * 0.85 - 0.2)
	muzzle.Parent = h
	return h
end

function GunService.GiveGun(player: Player)
	local item = S.InventoryService.EquippedGun(player)
	local backpack = player:FindFirstChildOfClass("Backpack")
	local char = player.Character
	if not item or not backpack then
		return
	end
	for _, container in ipairs({ backpack, char }) do
		if container then
			for _, tool in ipairs(container:GetChildren()) do
				if tool:IsA("Tool") and tool:GetAttribute("Gun") then
					tool:Destroy()
				end
			end
		end
	end
	local tool = Instance.new("Tool")
	tool.Name = Guns.Rarities[item.rarity].name .. " " .. Guns.Types[item.id].name
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.GripPos = Vector3.new(0, -0.2, 0.3)
	tool:SetAttribute("Gun", item.id)
	tool:SetAttribute("Rarity", item.rarity)
	tool:SetAttribute("Rate", Guns.Types[item.id].rate)
	tool:SetAttribute("Range", Guns.Types[item.id].range)
	buildHandle(item).Parent = tool
	tool.Parent = backpack
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum:EquipTool(tool) -- AFK friendly: always holding the gun
	end
end

local function hrp(player: Player): BasePart?
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function relay(player: Player, toPos: Vector3)
	local t = os.clock()
	if t - (lastRelay[player] or 0) &lt; 0.3 then
		return
	end
	lastRelay[player] = t
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			Net.fire(other, "Shot", player, toPos)
		end
	end
end

-- kind: "m" monster id | "p" player userId
local function onFire(player: Player, kind, targetId)
	local item = S.InventoryService.EquippedGun(player)
	local root = hrp(player)
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if not item or not root or not hum or hum.Health &lt;= 0 or type(targetId) ~= "number" then
		return
	end
	local t = Guns.Types[item.id]
	local now = os.clock()
	if now - (lastShot[player] or 0) &lt; (1 / t.rate) * Combat.FireTolerance then
		return
	end
	lastShot[player] = now

	if kind == "m" then
		if S.PlayerService.InArena(player) then
			return
		end
		local rec = S.MonsterService.Get(targetId)
		if not rec then
			return
		end
		local pos = S.MonsterService.Position(rec)
		if (pos - root.Position).Magnitude &gt; t.range + rec.def.size + 6 then
			return
		end
		local dmg = item.dmg * Guns.PowerFactor(S.PlayerService.GetPower(player))
		S.MonsterService.Damage(targetId, player, dmg)
		Net.fire(player, "Hit", pos, math.floor(dmg))
		relay(player, pos)
	elseif kind == "p" then
		local target = Players:GetPlayerByUserId(targetId)
		local troot = target and hrp(target)
		if not troot or (troot.Position - root.Position).Magnitude &gt; t.range + 4 then
			return
		end
		local dmg = t.dmg * t.pellets * (1 + Guns.PvP.RarityBonus * (item.rarity - 1)) * Guns.PvP.DamageScale
		if S.ArenaService.Damage(player, target :: Player, dmg) then
			Net.fire(player, "Hit", troot.Position, math.floor(dmg))
			relay(player, troot.Position)
		end
	end
end

function GunService.Init(services)
	S = services
	Net.declare("Shot")
	Net.declare("Hit")
	Net.on("Fire", onFire, 12)

	S.InventoryService.GearChanged:Connect(function(player, slot)
		if slot == "gun" then
			GunService.GiveGun(player)
		end
	end)
	local function hook(player: Player)
		player.CharacterAdded:Connect(function(char)
			char:WaitForChild("Humanoid", 5)
			task.wait(0.2)
			GunService.GiveGun(player)
		end)
	end
	Players.PlayerAdded:Connect(hook)
	for _, p in ipairs(Players:GetPlayers()) do
		hook(p)
	end
	Players.PlayerRemoving:Connect(function(p)
		lastShot[p] = nil
		lastRelay[p] = nil
	end)
end

return GunService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000023"><Properties><string name="Name">InventoryService</string><ProtectedString name="Source">-- Materials + unique items (guns, armor, pets), equip/salvage, index, client sync.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Guns = require(Shared.Config.Guns)
local Recipes = require(Shared.Config.Recipes)
local Pets = require(Shared.Config.Pets)
local Materials = require(Shared.Config.Materials)
local Net = require(Shared.Net)
local Signal = require(Shared.Signal)

local InventoryService = {}
InventoryService.GearChanged = Signal.new() -- (player, slot)
local S

local function countKind(items, kind: string): number
	local n = 0
	for _, it in pairs(items) do
		if (kind == "pet") == (it.kind == "pet") then
			n += 1
		end
	end
	return n
end

function InventoryService.Sync(player: Player)
	local d = S.DataService.Get(player)
	if not d then
		return
	end
	Net.fire(player, "Inv", { materials = d.inventory, items = d.items, equipped = d.equipped, index = d.index, rebirths = d.rebirths })
end

-- debounce syncs within the same frame burst
local pending: { [Player]: boolean } = {}
function InventoryService.SyncSoon(player: Player)
	if pending[player] then
		return
	end
	pending[player] = true
	task.delay(0.4, function()
		pending[player] = nil
		if player.Parent then
			InventoryService.Sync(player)
		end
	end)
end

function InventoryService.AddMaterial(player: Player, id: string, n: number)
	if not Materials[id] or n &lt;= 0 then
		return
	end
	S.DataService.Update(player, function(d)
		d.inventory[id] = (d.inventory[id] or 0) + n
	end)
	InventoryService.SyncSoon(player)
end

function InventoryService.Has(player: Player, mats: { [string]: number }, coins: number?): boolean
	local d = S.DataService.Get(player)
	if not d then
		return false
	end
	for id, n in pairs(mats) do
		if (d.inventory[id] or 0) &lt; n then
			return false
		end
	end
	return (coins or 0) &lt;= (d.currencies.Coins or 0)
end

-- Atomically take materials + coins. Returns false if anything is missing.
function InventoryService.Take(player: Player, mats: { [string]: number }, coins: number?): boolean
	if not InventoryService.Has(player, mats, coins) then
		return false
	end
	if coins and coins &gt; 0 and not S.EconomyService.Spend(player, "Coins", coins) then
		return false
	end
	S.DataService.Update(player, function(d)
		for id, n in pairs(mats) do
			d.inventory[id] -= n
			if d.inventory[id] &lt;= 0 then
				d.inventory[id] = nil
			end
		end
	end)
	InventoryService.SyncSoon(player)
	return true
end

function InventoryService.ItemCount(player: Player, kind: string): number
	local d = S.DataService.Get(player)
	return d and countKind(d.items, kind) or 0
end

function InventoryService.CanAdd(player: Player, kind: string): boolean
	local limit = if kind == "pet" then Pets.MaxPets else Recipes.MaxItems
	return InventoryService.ItemCount(player, kind) &lt; limit
end

-- item = { kind, id, tier, rarity, ... } -&gt; uid
function InventoryService.CreateItem(player: Player, item): string?
	local uid
	S.DataService.Update(player, function(d)
		uid = "i" .. d.nextUid
		d.nextUid += 1
		d.items[uid] = item
		if item.kind == "gun" then
			d.index.guns[item.id .. "_" .. item.rarity] = true
		elseif item.kind == "pet" then
			d.index.pets[item.id] = true
		end
	end)
	InventoryService.SyncSoon(player)
	return uid
end

function InventoryService.RemoveItem(player: Player, uid: string)
	S.DataService.Update(player, function(d)
		d.items[uid] = nil
		for slot, v in pairs(d.equipped) do
			if v == uid then
				d.equipped[slot] = ""
			end
		end
		local i = table.find(d.equipped.pets, uid)
		if i then
			table.remove(d.equipped.pets, i)
		end
	end)
	InventoryService.SyncSoon(player)
end

function InventoryService.GetItem(player: Player, uid: string)
	local d = S.DataService.Get(player)
	return d and d.items[uid]
end

function InventoryService.EquippedGun(player: Player)
	local d = S.DataService.Get(player)
	return d and d.items[d.equipped.gun]
end

function InventoryService.MakeGun(typeId: string, tier: number, rarity: number, quality: number)
	return { kind = "gun", id = typeId, tier = tier, rarity = rarity, q = quality, dmg = Guns.GunDamage(typeId, tier, rarity, quality) }
end

function InventoryService.MakeArmor(slot: string, tier: number, rarity: number, quality: number)
	return { kind = "armor", id = slot, tier = tier, rarity = rarity, q = quality, hp = Guns.ArmorHp(slot, tier, rarity, quality) }
end

local function equip(player: Player, uid: string)
	local d = S.DataService.Get(player)
	local item = d and d.items[uid]
	if not item or item.kind == "pet" then
		return
	end
	local slot = if item.kind == "gun" then "gun" else item.id
	S.DataService.Update(player, function(data)
		data.equipped[slot] = uid
	end)
	InventoryService.GearChanged:Fire(player, slot)
	InventoryService.Sync(player)
end
InventoryService.Equip = equip

local function salvage(player: Player, uid: string)
	local d = S.DataService.Get(player)
	local item = d and d.items[uid]
	if not item or item.kind == "pet" then
		return
	end
	for slot, v in pairs(d.equipped) do
		if v == uid and slot ~= "pets" then
			S.EconomyService.Toast(player, "Unequip it first!", "error")
			return
		end
	end
	local recipe = Recipes.ById[item.id .. "_t" .. item.tier]
	local refund = recipe and math.floor(recipe.coins * Recipes.SalvageRefund * (1 + (item.rarity - 1) * 0.5)) or 10
	InventoryService.RemoveItem(player, uid)
	S.EconomyService.Add(player, "Coins", refund, "salvage", false)
	S.EconomyService.Toast(player, ("Salvaged for %d Coins"):format(refund), "info")
end

function InventoryService.Init(services)
	S = services
	Net.declare("Inv")

	S.DataService.Loaded:Connect(function(player, data)
		if next(data.items) == nil then -- starter pistol
			local st = Guns.Starter
			local uid = InventoryService.CreateItem(player, InventoryService.MakeGun(st.id, st.tier, st.rarity, st.quality))
			if uid then
				S.DataService.Update(player, function(d)
					d.equipped.gun = uid
				end)
			end
		end
		InventoryService.Sync(player)
		InventoryService.GearChanged:Fire(player, "gun")
	end)
	Players.PlayerRemoving:Connect(function(p)
		pending[p] = nil
	end)

	Net.on("Equip", function(player, uid)
		if type(uid) == "string" then
			equip(player, uid)
		end
	end, 4)
	Net.on("Unequip", function(player, slot)
		if slot == "helmet" or slot == "vest" or slot == "boots" then
			S.DataService.Update(player, function(d)
				d.equipped[slot] = ""
			end)
			InventoryService.GearChanged:Fire(player, slot)
			InventoryService.Sync(player)
		end
	end, 4)
	Net.on("Salvage", function(player, uid)
		if type(uid) == "string" then
			salvage(player, uid)
		end
	end, 6)
	Net.on("SalvageAllCommon", function(player)
		local d = S.DataService.Get(player)
		if not d then
			return
		end
		for uid, item in pairs(table.clone(d.items)) do
			if item.kind ~= "pet" and item.rarity == 1 and d.equipped.gun ~= uid and d.equipped[item.id] ~= uid then
				salvage(player, uid)
			end
		end
	end, 1)

	InventoryService.GearChanged:Connect(function(player, slot)
		if slot ~= "gun" then
			S.PlayerService.RefreshCharacter(player)
		end
	end)
end

return InventoryService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000024"><Properties><string name="Name">LeaderboardService</string><ProtectedString name="Source">-- Global leaderboard via OrderedDataStore. Writes the top list to
-- ReplicatedStorage.Leaderboard (StringValue JSON) for any in-world board / UI.
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Settings = require(ReplicatedStorage.Shared.Config.Settings).Leaderboard

local LeaderboardService = {}

function LeaderboardService.Init(services)
	if not Settings.Enabled then
		return
	end
	local ok, store = pcall(DataStoreService.GetOrderedDataStore, DataStoreService, Settings.StoreName)
	if not ok then
		return
	end
	local out = Instance.new("StringValue")
	out.Name = "Leaderboard"
	out.Value = "[]"
	out.Parent = ReplicatedStorage

	local function score(player)
		local data = services.DataService.Get(player)
		if not data then
			return nil
		end
		return data.currencies[Settings.Stat] or data.stats[Settings.Stat]
	end

	task.spawn(function()
		while true do -- lint-ok (task.wait)
			for _, player in ipairs(Players:GetPlayers()) do
				local s = score(player)
				if s and not services.DataService.IsOffline(player) then
					pcall(store.SetAsync, store, tostring(player.UserId), math.floor(s))
				end
				task.wait(0.5) -- spread writes (DataStore budget)
			end
			local okPage, pages = pcall(store.GetSortedAsync, store, false, Settings.Top)
			if okPage then
				local list = {}
				for rank, entry in ipairs(pages:GetCurrentPage()) do
					local okName, name = pcall(Players.GetNameFromUserIdAsync, Players, tonumber(entry.key))
					table.insert(list, { rank = rank, name = okName and name or "?", value = entry.value })
				end
				out.Value = HttpService:JSONEncode(list)
			end
			task.wait(Settings.RefreshSeconds)
		end
	end)
end

return LeaderboardService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000025"><Properties><string name="Name">MapParts</string><ProtectedString name="Source">-- Part helpers + landmark builders for MapService. Everything Anchored; decor has collision/query/touch off.
local P = {}

P.Cyan = Color3.fromRGB(58, 216, 255)
P.Pink = Color3.fromRGB(255, 79, 216)
P.Gold = Color3.fromRGB(255, 201, 53)
P.Dark = Color3.fromRGB(22, 20, 42)

function P.part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, mat: Enum.Material?, decor: boolean?)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if decor then
		p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = false, false, false, false
	end
	p.Parent = parent
	return p
end

-- Upright cylinder (Roblox cylinders lie along X, so rotate).
function P.cyl(parent: Instance, name: string, diameter: number, height: number, cf: CFrame, color: Color3, mat: Enum.Material?, decor: boolean?)
	local p = P.part(parent, name, Vector3.new(height, diameter, diameter), cf * CFrame.Angles(0, 0, math.pi / 2), color, mat, decor)
	p.Shape = Enum.PartType.Cylinder
	return p
end

function P.label(adornee: BasePart, text: string, color: Color3?, offsetY: number?)
	local g = Instance.new("BillboardGui")
	g.Name = "NameLabel"
	g.Size = UDim2.fromOffset(220, 44)
	g.StudsOffset = Vector3.new(0, offsetY or 8, 0)
	g.MaxDistance = 80
	g.AlwaysOnTop = true
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Text = text
	t.Font = Enum.Font.GothamBlack
	t.TextScaled = true
	t.TextColor3 = color or Color3.new(1, 1, 1)
	t.TextStrokeTransparency = 0
	t.TextStrokeColor3 = P.Dark
	t.Parent = g
	g.Parent = adornee
end

local NEON, ROCK = Enum.Material.Neon, Enum.Material.Slate
local function up(y: number): Vector3
	return Vector3.new(0, y, 0)
end

-- Landmark builders: (parent, pos on ground, cframe facing the hub, color). All decor, &lt;= 60 parts.
local L = {}

function L.meadow(m, pos, base, color)
	for i = 1, 7 do
		local w = 16 - i * 1.8
		P.part(m, "Spire", Vector3.new(w, 14, w), CFrame.new(pos + up(i * 13 - 6)) * CFrame.Angles(0, i * 0.4, 0), i % 2 == 0 and P.Cyan or Color3.fromRGB(140, 235, 255), i % 2 == 0 and NEON or Enum.Material.Glass, true)
	end
	for i = 1, 12 do
		local a = i / 12 * math.pi * 2
		local h = 14 + (i % 4) * 7
		P.part(m, "Shard", Vector3.new(4, h, 4), CFrame.new(pos + Vector3.new(math.cos(a) * 20, h / 2, math.sin(a) * 20)) * CFrame.Angles(math.sin(a) * 0.3, a, math.cos(a) * 0.3), i % 3 == 0 and P.Pink or P.Cyan, NEON, true)
	end
	P.part(m, "Tip", Vector3.new(6, 12, 6), CFrame.new(pos + up(100)) * CFrame.Angles(0.8, 0.8, 0), P.Gold, NEON, true)
end

function L.desert(m, pos, base, color)
	local rng = Random.new(7)
	for i = 1, 10 do
		local s = 22 - i * 1.4
		P.part(m, "Scrap", Vector3.new(s, 9, s * rng:NextNumber(0.7, 1)), CFrame.new(pos + Vector3.new(rng:NextNumber(-2, 2), i * 8.5, rng:NextNumber(-2, 2))) * CFrame.Angles(0, rng:NextNumber(0, 3), 0), i % 2 == 0 and Color3.fromRGB(150, 95, 60) or Color3.fromRGB(110, 110, 120), i % 2 == 0 and Enum.Material.CorrodedMetal or Enum.Material.Metal, true)
	end
	P.part(m, "Antenna", Vector3.new(1.4, 40, 1.4), CFrame.new(pos + up(105)), Color3.fromRGB(90, 90, 100), Enum.Material.Metal, true)
	P.part(m, "Beacon", Vector3.new(6, 6, 6), CFrame.new(pos + up(128)), P.Gold, NEON, true)
	for i = 1, 4 do
		local a = i * math.pi / 2
		P.cyl(m, "Gear", 20, 3, CFrame.new(pos + Vector3.new(math.cos(a) * 20, 14 + i * 6, math.sin(a) * 20)) * CFrame.Angles(a, 0, 0), Color3.fromRGB(170, 130, 80), Enum.Material.Metal, true)
	end
end

function L.frost(m, pos, base, color)
	for i = 1, 12 do
		local a = i / 12 * math.pi * 2
		local r = i % 3 == 0 and 0 or 12 + (i % 4) * 5
		local h = 30 + (i * 13 % 50)
		P.part(m, "Ice", Vector3.new(7, h, 7), CFrame.new(pos + Vector3.new(math.cos(a) * r, h / 2 - 2, math.sin(a) * r)) * CFrame.Angles(math.sin(a) * 0.25, a, math.cos(a) * 0.25), i % 2 == 0 and Color3.fromRGB(170, 230, 255) or Color3.fromRGB(230, 250, 255), Enum.Material.Ice, true)
	end
	P.part(m, "Core", Vector3.new(10, 70, 10), CFrame.new(pos + up(40)) * CFrame.Angles(0, 0.7, 0), P.Cyan, NEON, true).Transparency = 0.35
end

function L.magma(m, pos, base, color)
	for i = 1, 8 do
		local d = 78 - i * 8
		P.cyl(m, "Cone", d, 10, CFrame.new(pos + up(i * 10 - 5)), i % 2 == 0 and Color3.fromRGB(70, 45, 40) or Color3.fromRGB(50, 35, 35), ROCK, true)
	end
	P.cyl(m, "Lava", 18, 4, CFrame.new(pos + up(82)), Color3.fromRGB(255, 120, 30), NEON, true)
	for i = 1, 6 do
		local a = i / 6 * math.pi * 2
		P.part(m, "Stream", Vector3.new(3, 60, 3), CFrame.new(pos + Vector3.new(math.cos(a) * 22, 50, math.sin(a) * 22)) * CFrame.Angles(math.sin(a) * 0.45, 0, -math.cos(a) * 0.45), Color3.fromRGB(255, 90, 20), NEON, true)
		P.part(m, "Ember", Vector3.new(4, 4, 4), CFrame.new(pos + Vector3.new(math.cos(a) * 10, 95 + (i % 3) * 8, math.sin(a) * 10)), P.Gold, NEON, true).Shape = Enum.PartType.Ball
	end
end

function L.void(m, pos, base, color)
	local c = CFrame.new(pos) * (base - base.Position)
	for i = 1, 24 do
		local a = i / 24 * math.pi * 2
		P.part(m, "Ring", Vector3.new(8, 9, 7), c * CFrame.new(math.cos(a) * 40, 62 + math.sin(a) * 40, 0) * CFrame.Angles(0, 0, a), i % 2 == 0 and P.Pink or P.Cyan, NEON, true)
	end
	P.part(m, "Portal", Vector3.new(1, 66, 66), c * CFrame.new(0, 62, 0) * CFrame.Angles(0, math.pi / 2, 0), Color3.fromRGB(90, 40, 160), Enum.Material.ForceField, true).Shape = Enum.PartType.Cylinder
	for s = -1, 1, 2 do
		P.part(m, "Pylon", Vector3.new(8, 24, 8), c * CFrame.new(s * 40, 12, 0), P.Dark, Enum.Material.Metal, true)
	end
end

P.Landmarks = L
return P
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000026"><Properties><string name="Name">MapService</string><ProtectedString name="Source">-- Builds workspace.Map in code (Hub, Zones, Arena). Names are contracts for other services:
--   Map.Hub{TrainingPads, Booth_*, Forge, FusionAltar, RebirthStatue, ArenaPortal, ClanBoard, CodesBoard, SpawnLocation, BossPit}
--   Map.Zones.&lt;id&gt;{Ground, SpawnArea, Gate(PowerReq, ZoneId), landmark}   Map.Arena.Arena1..3{SpawnA, SpawnB}
-- Perf: all Anchored; decor has CanCollide/CanQuery/CanTouch/CastShadow off. ~1000 parts total.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Zones = require(ReplicatedStorage.Shared.Config.Zones)
local World = require(ReplicatedStorage.Shared.Config.World)
local Combat = require(ReplicatedStorage.Shared.Config.Combat)
local P = require(script.Parent.MapParts)

local part, cyl = P.part, P.cyl
local NEON = Enum.Material.Neon
local MapService = {}

local ZONE_MAT = {
	meadow = Enum.Material.Grass, desert = Enum.Material.Sand, frost = Enum.Material.Snow,
	magma = Enum.Material.Basalt, void = Enum.Material.Slate,
}
local ZONE_ACCENT = {
	meadow = P.Cyan, desert = P.Gold, frost = Color3.fromRGB(150, 220, 255),
	magma = Color3.fromRGB(255, 110, 30), void = P.Pink,
}

local function folder(parent: Instance, name: string)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function model(parent: Instance, name: string)
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

local function invisible(p: Part)
	p.Transparency = 1
	p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = false, false, false, false
end

-- ===== Hub =====
local STATIONS = { -- name, label, angle (deg), color
	{ "Booth_TargetRush", "TARGET RUSH", -72, P.Cyan },
	{ "Booth_ReloadRhythm", "RELOAD RHYTHM", -36, P.Pink },
	{ "Booth_LuckyCrate", "LUCKY CRATE", 5, P.Gold },
	{ "Forge", "THE FORGE", 30, Color3.fromRGB(255, 120, 40) },
	{ "FusionAltar", "FUSION ALTAR", 70, P.Pink },
	{ "RebirthStatue", "REBIRTH", 110, P.Gold },
	{ "ArenaPortal", "PVP ARENA", 145, Color3.fromRGB(255, 80, 80) },
	{ "ClanBoard", "CLAN HALL", 175, P.Cyan },
	{ "CodesBoard", "CODES", 225, Color3.fromRGB(120, 255, 150) },
}

local function buildHub(map: Model)
	local hub = model(map, "Hub")
	local R = World.HubRadius
	cyl(hub, "Floor", R * 2, 2, CFrame.new(0, -1, 0), P.Dark, Enum.Material.Metal)
	cyl(hub, "FloorInlay", R * 2 - 16, 0.2, CFrame.new(0, 0.05, 0), Color3.fromRGB(40, 36, 80), Enum.Material.SmoothPlastic, true)
	cyl(hub, "NeonRing", R * 2 - 4, 0.3, CFrame.new(0, 0.1, 0), P.Cyan, NEON, true)
	cyl(hub, "NeonRingInner", R * 2 - 8, 0.4, CFrame.new(0, 0.12, 0), P.Dark, Enum.Material.SmoothPlastic, true)
	for i = 1, 24 do -- edge pylons
		local a = i / 24 * math.pi * 2
		local c = CFrame.new(math.cos(a) * (R - 1), 0, math.sin(a) * (R - 1))
		part(hub, "Pylon", Vector3.new(2, 7, 2), c * CFrame.new(0, 3.5, 0), P.Dark, Enum.Material.Metal, true)
		part(hub, "PylonLight", Vector3.new(2.4, 1.2, 2.4), c * CFrame.new(0, 7.4, 0), i % 2 == 0 and P.Cyan or P.Pink, NEON, true)
	end

	local sp = Instance.new("SpawnLocation")
	sp.Anchored, sp.Size, sp.Position = true, Vector3.new(14, 1, 14), Vector3.new(0, 0.5, 0)
	sp.Material, sp.Neutral, sp.Duration, sp.TopSurface = NEON, true, 0, Enum.SurfaceType.Smooth
	sp.Color = Color3.fromRGB(58, 120, 200)
	sp.Parent = hub

	local pads = folder(hub, "TrainingPads")
	for i = 1, 6 do
		local a = math.rad(i * 60 + 30)
		local pos = Vector3.new(math.cos(a) * 24, 0.5, math.sin(a) * 24)
		local pad = part(pads, "Pad" .. i, Vector3.new(10, 1, 10), CFrame.new(pos) * CFrame.Angles(0, -a, 0), P.Dark, Enum.Material.Metal)
		part(pads, "PadGlow", Vector3.new(8, 0.3, 8), CFrame.new(pos + Vector3.new(0, 0.55, 0)) * CFrame.Angles(0, -a, 0), P.Cyan, NEON, true)
		pad.Name = "Pad" .. i
	end

	for _, s in ipairs(STATIONS) do
		local a = math.rad(s[3])
		local pos = Vector3.new(math.cos(a) * 45, 0, math.sin(a) * 45)
		local face = CFrame.lookAt(pos, Vector3.zero)
		cyl(hub, s[1] .. "_Base", 14, 0.6, CFrame.new(pos + Vector3.new(0, 0.3, 0)), P.Dark, Enum.Material.Metal, true)
		cyl(hub, s[1] .. "_Glow", 12.5, 0.7, CFrame.new(pos + Vector3.new(0, 0.32, 0)), s[4], NEON, true)
		local blk = part(hub, s[1], Vector3.new(8, 8, 8), face + Vector3.new(0, 4.6, 0), Color3.fromRGB(46, 42, 88), Enum.Material.Metal)
		part(hub, s[1] .. "_Trim", Vector3.new(8.4, 1, 8.4), face + Vector3.new(0, 9, 0), s[4], NEON, true)
		part(hub, s[1] .. "_Face", Vector3.new(5, 4, 0.4), face * CFrame.new(0, 5.6, -4.1), s[4], NEON, true)
		P.label(blk, s[2], s[4], 8)
	end

	local bp = Combat.WorldBoss.Position
	local pit = part(hub, "BossPit", Vector3.new(60, 1, 60), CFrame.new(bp.X, bp.Y - 0.3, bp.Z), Color3.fromRGB(60, 25, 40), Enum.Material.Basalt)
	for i = 1, 4 do
		local a = i * math.pi / 2
		local d = Vector3.new(math.cos(a), 0, math.sin(a))
		local sz = Vector3.new(i % 2 == 0 and 60 or 1.2, 0.4, i % 2 == 0 and 1.2 or 60)
		part(hub, "BossRim", sz, CFrame.new(pit.Position + d * 30 + Vector3.new(0, 0.7, 0)), Color3.fromRGB(255, 60, 90), NEON, true)
	end
	P.label(pit, "WORLD BOSS", Color3.fromRGB(255, 90, 110), 10)
end

-- ===== Zones =====
local function entryT(c: Vector3, half: Vector3, dir: Vector3): number -- ray from origin enters the zone square
	local t0 = 0
	local function slab(cc: number, h: number, d: number)
		if math.abs(d) &lt; 1e-4 then return end
		local a, b = (cc - h) / d, (cc + h) / d
		t0 = math.max(t0, math.min(a, b))
	end
	slab(c.X, half.X, dir.X)
	slab(c.Z, half.Z, dir.Z)
	return t0
end

local function buildZone(parent: Folder, z)
	local m = model(parent, z.id)
	local accent = ZONE_ACCENT[z.id] or P.Cyan
	part(m, "Ground", Vector3.new(z.size.X, 2, z.size.Z), CFrame.new(z.center.X, -1, z.center.Z), z.color, ZONE_MAT[z.id] or Enum.Material.Slate)
	local sa = part(m, "SpawnArea", Vector3.new(z.size.X, 1, z.size.Z), CFrame.new(z.center.X, 0, z.center.Z), accent, nil)
	invisible(sa)

	local dir = Vector3.new(z.center.X, 0, z.center.Z).Unit
	local half = Vector3.new(z.size.X / 2, 0, z.size.Z / 2)
	local t = entryT(z.center, half, dir)
	local face = CFrame.lookAt(Vector3.zero, dir)
	local roadEnd, roadStart = t + 14, World.HubRadius - 2
	local len = roadEnd - roadStart
	local mid = dir * (roadStart + len / 2)
	part(m, "Road", Vector3.new(16, 1, len), CFrame.lookAt(mid + Vector3.new(0, -0.5, 0), mid + dir + Vector3.new(0, -0.5, 0)), P.Dark, Enum.Material.Metal)
	for side = -1, 1, 2 do -- neon edge lines
		local p = mid + face.RightVector * side * 7.6
		part(m, "RoadEdge", Vector3.new(0.8, 0.2, len), CFrame.lookAt(p + Vector3.new(0, 0.1, 0), p + dir + Vector3.new(0, 0.1, 0)), accent, NEON, true)
	end
	local gp = dir * (t - 14)
	local gate = part(m, "Gate", Vector3.new(24, 16, 2), CFrame.lookAt(gp + Vector3.new(0, 8, 0), gp + dir * 2 + Vector3.new(0, 8, 0)), accent, Enum.Material.ForceField)
	gate:SetAttribute("PowerReq", z.powerReq)
	gate:SetAttribute("ZoneId", z.id)
	gate.CastShadow = false
	for side = -1, 1, 2 do
		local p = gp + face.RightVector * side * 13
		part(m, "GatePost", Vector3.new(3, 20, 3), CFrame.new(p + Vector3.new(0, 10, 0)), P.Dark, Enum.Material.Metal, true).CanCollide = true
		part(m, "GateLight", Vector3.new(3.6, 2, 3.6), CFrame.new(p + Vector3.new(0, 21, 0)), accent, NEON, true)
	end
	part(m, "GateBeam", Vector3.new(30, 2, 3), face + gp + Vector3.new(0, 20, 0), accent, NEON, true)

	-- landmark: between the hub and the zone centre so it is visible from the hub
	local lpos = Vector3.new(z.center.X, 0, z.center.Z) - dir * 30
	local lm = model(m, "Landmark")
	P.Landmarks[z.id](lm, lpos, face, z.color)
	if z.id ~= "void" then
		part(lm, "Beacon", Vector3.new(3, 3, 3), CFrame.new(lpos + Vector3.new(0, 150, 0)), accent, NEON, true)
	end
	P.label(gate, z.name .. "  (" .. z.powerReq .. " PWR)", accent, 12)

	-- decor rocks
	local rng = Random.new(#z.id * 31)
	local decor = folder(m, "Decor")
	for _ = 1, 40 do
		local p = Vector3.new(z.center.X + rng:NextNumber(-100, 100), 0, z.center.Z + rng:NextNumber(-100, 100))
		if (p - lpos).Magnitude &gt; 45 then
			local s = rng:NextNumber(2, 7)
			part(decor, "Rock", Vector3.new(s, s * 0.8, s), CFrame.new(p + Vector3.new(0, s * 0.3, 0)) * CFrame.Angles(rng:NextNumber(0, 3), rng:NextNumber(0, 3), 0), z.color:Lerp(Color3.new(0.3, 0.3, 0.3), 0.4), Enum.Material.Slate, true)
		end
	end
end

-- ===== Arena =====
local COVER = { -- x, z, sx, sz  (mirrored by 180 degrees -&gt; symmetric)
	{ { 20, 0, 12, 12 }, { 0, 25, 24, 6 }, { 38, 30, 8, 8 } },
	{ { 25, 10, 6, 6 }, { 10, 30, 6, 6 }, { 38, -10, 6, 6 }, { 0, 0, 14, 14 } },
	{ { 0, 14, 40, 5 }, { 28, 28, 10, 10 }, { 30, -8, 5, 20 } },
}

local function buildArenas(map: Model)
	local root = model(map, "Arena")
	local A = World.Arena
	for i = 1, 3 do
		local m = model(root, "Arena" .. i)
		local c = A.Origin + Vector3.new((i - 2) * A.Spacing, 0, 0)
		local h = A.Size / 2
		local col = ({ P.Cyan, P.Pink, P.Gold })[i]
		part(m, "Floor", Vector3.new(A.Size, 2, A.Size), CFrame.new(c.X, -1, c.Z), Color3.fromRGB(38, 34, 74), Enum.Material.Metal)
		part(m, "FloorGlow", Vector3.new(A.Size - 6, 0.2, A.Size - 6), CFrame.new(c.X, 0.1, c.Z), col, NEON, true).Transparency = 0.75
		for _, w in ipairs({ { 0, h, A.Size, 1 }, { 0, -h, A.Size, 1 }, { h, 0, 1, A.Size }, { -h, 0, 1, A.Size } }) do
			local wall = part(m, "Wall", Vector3.new(w[3], 40, w[4]), CFrame.new(c.X + w[1], 20, c.Z + w[2]), col, Enum.Material.ForceField)
			wall.Transparency = 0.6
			part(m, "WallTrim", Vector3.new(w[3] + 1, 1, w[4] + 1), CFrame.new(c.X + w[1], 0.5, c.Z + w[2]), col, NEON, true)
		end
		for _, b in ipairs(COVER[i]) do
			for sgn = -1, 1, 2 do
				local blk = part(m, "Cover", Vector3.new(b[3], 9, b[4]), CFrame.new(c.X + b[1] * sgn, 4.5, c.Z + b[2] * sgn), Color3.fromRGB(70, 64, 120), Enum.Material.Concrete)
				part(m, "CoverTop", Vector3.new(b[3] + 0.2, 0.6, b[4] + 0.2), blk.CFrame * CFrame.new(0, 4.6, 0), col, NEON, true)
			end
		end
		for n, zz in ipairs({ -h + 12, h - 12 }) do
			local s = part(m, n == 1 and "SpawnA" or "SpawnB", Vector3.new(10, 1, 10), CFrame.new(c.X, 2, c.Z + zz), col, nil)
			invisible(s)
		end
	end
end

function MapService.Init(_services)
	if workspace:FindFirstChild("Map") then
		return
	end
	local base = workspace:FindFirstChild("Baseplate")
	if base then
		base:Destroy()
	end
	local map = Instance.new("Model")
	map.Name = "Map"
	map.ModelStreamingMode = Enum.ModelStreamingMode.Default
	buildHub(map)
	local zf = folder(map, "Zones")
	for _, z in ipairs(Zones) do
		buildZone(zf, z)
	end
	buildArenas(map)
	map.Parent = workspace
end

return MapService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000027"><Properties><string name="Name">MinigameService</string><ProtectedString name="Source">-- Training-break minigames: server starts a session (cooldown), client plays, server clamps score
-- and pays Power (seconds of training) + coins. Lucky Crate result is rolled on the server.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Minigames = require(Shared.Config.Minigames)
local Recipes = require(Shared.Config.Recipes)
local Net = require(Shared.Net)

local MinigameService = {}
local S
local rng = Random.new()
local cooldown: { [Player]: { [string]: number } } = {}
local active: { [Player]: { game: string, t0: number } } = {}

local function crate(player: Player)
	local prizes = Minigames.LuckyCrate.prizes
	local total = 0
	for _, p in ipairs(prizes) do
		total += p.w
	end
	local x = rng:NextNumber() * total
	for _, p in ipairs(prizes) do
		x -= p.w
		if x &lt;= 0 then
			if p.trainingSeconds then
				return { power = S.TrainingService.GrantSeconds(player, p.trainingSeconds) }
			elseif p.coins then
				S.EconomyService.Add(player, "Coins", p.coins, "crate", false)
				return { coins = p.coins }
			elseif p.gems then
				S.EconomyService.Add(player, "Gems", p.gems, "crate", false)
				return { gems = p.gems }
			elseif p.material then
				local tier = S.ZoneService.BestTier(S.PlayerService.GetPower(player))
				local mat = Recipes.TierMats[tier][1]
				S.InventoryService.AddMaterial(player, mat, p.amount)
				return { mat = mat, amount = p.amount }
			end
		end
	end
	return {}
end

function MinigameService.ResetCooldowns(player: Player)
	cooldown[player] = {}
end

function MinigameService.Init(services)
	S = services
	Players.PlayerRemoving:Connect(function(p)
		cooldown[p] = nil
		active[p] = nil
	end)

	Net.handle("MinigameStart", function(player, name)
		local cfg = type(name) == "string" and Minigames[name]
		if not cfg then
			return { ok = false }
		end
		cooldown[player] = cooldown[player] or {}
		local left = (cooldown[player][name] or 0) - os.clock()
		if left &gt; 0 then
			return { ok = false, wait = math.ceil(left) }
		end
		cooldown[player][name] = os.clock() + cfg.cooldown
		active[player] = { game = name, t0 = os.clock() }
		return { ok = true, duration = cfg.duration, maxScore = cfg.maxScore }
	end, 2)

	Net.handle("MinigameEnd", function(player, score)
		local a = active[player]
		if not a or type(score) ~= "number" or score ~= score then
			return nil
		end
		active[player] = nil
		local cfg = Minigames[a.game]
		S.QuestService.Progress(player, "Minigames", 1)
		if a.game == "LuckyCrate" then
			return crate(player)
		end
		if os.clock() - a.t0 &lt; cfg.minSeconds then
			score = 0
		end
		local frac = math.clamp(score, 0, cfg.maxScore) / cfg.maxScore
		local power = S.TrainingService.GrantSeconds(player, cfg.trainingSeconds * frac)
		local coins = math.floor(cfg.coins * frac)
		if coins &gt; 0 then
			S.EconomyService.Add(player, "Coins", coins, "minigame", true)
		end
		return { power = power, coins = coins, score = score }
	end, 2)

	Net.handle("MinigameCooldowns", function(player)
		local out = {}
		for name in pairs(Minigames) do
			out[name] = math.max(0, math.ceil(((cooldown[player] or {})[name] or 0) - os.clock()))
		end
		return out
	end, 2)
end

return MinigameService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000028"><Properties><string name="Name">MonetizationService</string><ProtectedString name="Source">-- Game passes + developer products (real Robux).
-- * Ownership is verified server-side with UserOwnsGamePassAsync (cached per session).
-- * Developer products use ProcessReceipt with PurchaseId idempotency saved in player data.
-- * Perks from Config.GamePasses[*].perks are applied on every character spawn.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Settings = require(Shared.Config.Settings)
local GamePasses = require(Shared.Config.GamePasses)
local Products = require(Shared.Config.Products)
local Net = require(Shared.Net)
local Signal = require(Shared.Signal)

local MonetizationService = {}
MonetizationService.PassGranted = Signal.new() -- (player, passKey)
MonetizationService.ProductBought = Signal.new() -- (player, productKey)

-- Custom product handlers for non-currency products: [productKey] = function(player) -&gt; boolean
MonetizationService.ProductHandlers = {}
-- Custom pass perk hooks: [passKey] = function(player, character)
MonetizationService.PerkHooks = {}

local DataService, EconomyService, AnalyticsService
local owned: { [Player]: { [string]: boolean } } = {}

local passById, productById = {}, {}
for k, v in pairs(GamePasses) do
	if v.id ~= 0 then
		passById[v.id] = k
	end
end
for k, v in pairs(Products) do
	if v.id ~= 0 then
		productById[v.id] = k
	end
end

function MonetizationService.HasPass(player: Player, passKey: string): boolean
	return owned[player] ~= nil and owned[player][passKey] == true
end

function MonetizationService.OwnedList(player: Player): { string }
	local list = {}
	for k, v in pairs(owned[player] or {}) do
		if v then
			table.insert(list, k)
		end
	end
	return list
end

-- Multiplicative perk across owned passes (e.g. VIP x2 and DoubleCoins x2 = x4)
function MonetizationService.GetMultiplier(player: Player, perk: string): number
	local m = 1
	for k in pairs(owned[player] or {}) do
		local p = GamePasses[k] and GamePasses[k].perks
		if p and p[perk] then
			m *= p[perk]
		end
	end
	return m
end

function MonetizationService.GetPerk(player: Player, perk: string): any
	for k in pairs(owned[player] or {}) do
		local p = GamePasses[k] and GamePasses[k].perks
		if p and p[perk] ~= nil then
			return p[perk]
		end
	end
	return nil
end

local function addTrail(character: Model, color: Color3)
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp or hrp:FindFirstChild("PassTrail") then
		return
	end
	local a0 = Instance.new("Attachment")
	a0.Name = "TrailTop"
	a0.Position = Vector3.new(0, 0.8, 0)
	a0.Parent = hrp
	local a1 = Instance.new("Attachment")
	a1.Name = "TrailBottom"
	a1.Position = Vector3.new(0, -0.8, 0)
	a1.Parent = hrp
	local trail = Instance.new("Trail")
	trail.Name = "PassTrail"
	trail.Attachment0, trail.Attachment1 = a0, a1
	trail.Color = ColorSequence.new(color)
	trail.Transparency = NumberSequence.new(0.2, 1)
	trail.Lifetime = 0.35
	trail.LightEmission = 0.6
	trail.Parent = hrp
end

local function addTag(character: Model, text: string)
	local head = character:FindFirstChild("Head")
	if not head or head:FindFirstChild("PassTag") then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "PassTag"
	gui.Size = UDim2.fromOffset(120, 32)
	gui.StudsOffset = Vector3.new(0, 2.4, 0)
	gui.MaxDistance = 60
	gui.AlwaysOnTop = false
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = "⭐ " .. text
	label.TextColor3 = Color3.fromRGB(255, 215, 70)
	label.TextStrokeTransparency = 0.2
	label.Parent = gui
	gui.Parent = head
end

local function applyPerks(player: Player)
	local character = player.Character
	if not character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	for passKey in pairs(owned[player] or {}) do
		local def = GamePasses[passKey]
		local perks = def and def.perks or {}
		if humanoid and perks.walkSpeed then
			humanoid.WalkSpeed = math.max(humanoid.WalkSpeed, perks.walkSpeed)
		end
		if humanoid and perks.jumpPower then
			humanoid.UseJumpPower = true
			humanoid.JumpPower = math.max(humanoid.JumpPower, perks.jumpPower)
		end
		if perks.trail then
			addTrail(character, perks.trail)
		end
		if perks.chatTag then
			addTag(character, perks.chatTag)
		end
		local hook = MonetizationService.PerkHooks[passKey]
		if hook then
			task.spawn(hook, player, character)
		end
	end
end

local function grantPass(player: Player, passKey: string, announce: boolean)
	owned[player] = owned[player] or {}
	if owned[player][passKey] then
		return
	end
	owned[player][passKey] = true
	applyPerks(player)
	MonetizationService.PassGranted:Fire(player, passKey)
	EconomyService.Sync(player)
	if announce then
		EconomyService.Toast(player, "Unlocked " .. GamePasses[passKey].name .. "!", "success")
	end
end

local function loadOwnership(player: Player)
	owned[player] = owned[player] or {}
	local studioFree = RunService:IsStudio() and Settings.StudioGrantUnconfiguredPasses
	for passKey, def in pairs(GamePasses) do
		if def.id == 0 then
			if studioFree then
				owned[player][passKey] = true
			end
		else
			for _ = 1, 3 do
				local ok, has = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, def.id)
				if ok then
					owned[player][passKey] = has or nil
					break
				end
				task.wait(1)
			end
		end
	end
end

local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = DataService.WaitFor(player)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local pid = tostring(receipt.PurchaseId)
	if table.find(data.receipts, pid) then
		DataService.Save(player)
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	local productKey = productById[receipt.ProductId]
	local def = productKey and Products[productKey]
	if not def then
		warn("[Monetization] unknown product id", receipt.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local granted = true
	local handler = MonetizationService.ProductHandlers[productKey]
	if handler then
		local ok, res = pcall(handler, player)
		granted = ok and res ~= false
	elseif def.grant then
		EconomyService.Grant(player, def.grant, "product:" .. productKey)
	end
	if not granted then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	DataService.Update(player, function(d)
		table.insert(d.receipts, pid)
		while #d.receipts &gt; 50 do
			table.remove(d.receipts, 1)
		end
		d.stats.Purchases += 1
	end)
	if not DataService.Save(player) and not DataService.IsOffline(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet -- retried later; receipt id is recorded in memory
	end
	MonetizationService.ProductBought:Fire(player, productKey)
	AnalyticsService.Purchase(player, productKey, def.price)
	EconomyService.Toast(player, "Thanks! You got " .. def.name, "success")
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function MonetizationService.Init(services)
	DataService = services.DataService
	EconomyService = services.EconomyService
	AnalyticsService = services.AnalyticsService

	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		local passKey = passById[passId]
		if purchased and passKey then
			grantPass(player, passKey, true)
			AnalyticsService.Purchase(player, passKey, GamePasses[passKey].price)
		end
	end)

	-- Studio test purchase of an unconfigured pass/product (id = 0) from the shop
	Net.on("StudioTestBuy", function(player, kind, key)
		if not RunService:IsStudio() then
			return
		end
		if kind == "pass" and GamePasses[key] then
			grantPass(player, key, true)
		elseif kind == "product" and Products[key] then
			local handler = MonetizationService.ProductHandlers[key]
			if handler then
				handler(player)
			elseif Products[key].grant then
				EconomyService.Grant(player, Products[key].grant, "studio-test")
			end
			EconomyService.Toast(player, "[Studio] Granted " .. Products[key].name, "success")
		end
	end, 2)

	local function setup(player: Player)
		loadOwnership(player)
		player.CharacterAdded:Connect(function(char)
			char:WaitForChild("Humanoid", 5)
			applyPerks(player)
		end)
		if player.Character then
			applyPerks(player)
		end
		EconomyService.Sync(player)
	end
	Players.PlayerAdded:Connect(setup)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(setup, p)
	end
	Players.PlayerRemoving:Connect(function(p)
		owned[p] = nil
	end)
end

return MonetizationService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000029"><Properties><string name="Name">MonsterService</string><ProtectedString name="Source">-- Server-simulated monsters (cheap): HP + logical position live on the server; models are anchored
-- and moved by the CLIENT from segment attributes (From/To/T0/Dur). Server never moves parts per frame.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Zones = require(Shared.Config.Zones)
local Monsters = require(Shared.Config.Monsters)
local Combat = require(Shared.Config.Combat)
local Net = require(Shared.Net)

local MonsterService = {}
local S
local rng = Random.new()
local folder: Folder
local nextId = 0
local recs: { [number]: any } = {}
local zoneCount: { [string]: number } = {}
local bossAlive: { [string]: boolean } = {}

local function now()
	return Workspace:GetServerTimeNow()
end

function MonsterService.Position(rec): Vector3
	if rec.dur &lt;= 0 then
		return rec.to
	end
	local a = math.clamp((now() - rec.t0) / rec.dur, 0, 1)
	return rec.from:Lerp(rec.to, a)
end

function MonsterService.Get(id: number)
	return recs[id]
end

function MonsterService.InZone(zone, pos: Vector3): boolean
	local c, s = zone.center, zone.size
	return math.abs(pos.X - c.X) &lt;= s.X / 2 and math.abs(pos.Z - c.Z) &lt;= s.Z / 2
end

local function setSegment(rec, to: Vector3, dur: number)
	rec.from = MonsterService.Position(rec)
	rec.to = to
	rec.t0 = now()
	rec.dur = dur
	local m = rec.model
	m:SetAttribute("From", rec.from)
	m:SetAttribute("To", to)
	m:SetAttribute("T0", rec.t0)
	m:SetAttribute("Dur", dur)
end

local function buildModel(defId: string, def, size: number): Model
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local src = assets and assets:FindFirstChild("Monsters") and assets.Monsters:FindFirstChild(defId)
	local m: Model
	if src and src:IsA("Model") then
		m = src:Clone()
		local _, ext = m:GetBoundingBox()
		if ext.Y &gt; 0 then
			m:ScaleTo(size / ext.Y)
		end
	else
		m = Instance.new("Model")
		local body = Instance.new("Part")
		body.Name = "Body"
		body.Shape = Enum.PartType.Ball
		body.Size = Vector3.one * size
		body.Color = def.color
		body.Material = Enum.Material.SmoothPlastic
		body.Parent = m
		for sx = -1, 1, 2 do
			local eye = Instance.new("Part")
			eye.Shape = Enum.PartType.Ball
			eye.Size = Vector3.one * size * 0.22
			eye.Color = Color3.new(0.05, 0.05, 0.08)
			eye.CFrame = CFrame.new(sx * size * 0.2, size * 0.12, -size * 0.42)
			eye.Parent = m
		end
		if def.boss then
			local crown = Instance.new("Part")
			crown.Size = Vector3.new(size * 0.5, size * 0.2, size * 0.5)
			crown.Color = Color3.fromRGB(255, 201, 53)
			crown.Material = Enum.Material.Neon
			crown.CFrame = CFrame.new(0, size * 0.55, 0)
			crown.Parent = m
		end
		m.PrimaryPart = body
	end
	for _, p in ipairs(m:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Anchored = true
			p.CanCollide = false
			p.CanTouch = false
			p.CanQuery = true -- mouse targeting
			p.CastShadow = def.boss == true
		end
	end
	m.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	return m
end

-- opts: { zone, static, onDeath(rec), name, hpOverride }
function MonsterService.Spawn(defId: string, pos: Vector3, opts)
	opts = opts or {}
	local def = opts.def or Monsters[defId]
	nextId += 1
	local id = nextId
	local hp = opts.hpOverride or def.hp
	local m = buildModel(defId, def, def.size)
	m.Name = "M" .. id
	local y = def.size / 2
	local start = Vector3.new(pos.X, y, pos.Z)
	m:PivotTo(CFrame.new(start))
	m:SetAttribute("MonsterId", id)
	m:SetAttribute("Name", opts.name or def.name)
	m:SetAttribute("HP", hp)
	m:SetAttribute("MaxHP", hp)
	m:SetAttribute("Boss", def.boss == true)
	m:SetAttribute("Size", def.size)
	local rec = { id = id, defId = defId, def = def, zone = opts.zone, model = m, hp = hp, maxHp = hp, y = y,
		from = start, to = start, t0 = now(), dur = 0, lastAttack = 0, contrib = {}, static = opts.static, onDeath = opts.onDeath, wanderAt = 0 }
	setSegment(rec, start, 0)
	m.Parent = folder
	recs[id] = rec
	return rec
end

local function rollDrops(def, mult: number)
	local out = {}
	for _, d in ipairs(def.drops) do
		local mat, chance, lo, hi = d[1], d[2], d[3], d[4]
		if rng:NextNumber() &lt; math.min(1, chance) then
			local raw = rng:NextInteger(lo, hi) * mult
			local n = math.floor(raw) + (if rng:NextNumber() &lt; raw % 1 then 1 else 0)
			if n &gt; 0 then
				out[mat] = (out[mat] or 0) + n
			end
		end
	end
	return out
end

local function reward(rec, player: Player, pos: Vector3)
	local def = rec.def
	local coins = S.EconomyService.Add(player, "Coins", math.max(1, math.floor(def.coins * S.PlayerService.CoinBonus(player))), "kill", true)
	local power = math.floor(def.power * S.PlayerService.TrainMultiplier(player))
	S.PlayerService.AddPower(player, power)
	local mats = rollDrops(def, S.PlayerService.DropMultiplier(player))
	for mat, n in pairs(mats) do
		S.InventoryService.AddMaterial(player, mat, n)
	end
	S.QuestService.Progress(player, "Kills", 1)
	S.QuestService.Progress(player, "Earn", coins)
	if def.boss then
		S.QuestService.Progress(player, "BossKills", 1)
	end
	S.DataService.Update(player, function(d)
		d.index.monsters[rec.defId] = true
	end)
	S.ClanService.AddXp(player, if def.boss then 20 else 1)
	Net.fire(player, "Loot", pos, { coins = coins, power = power, mats = mats })
end

local function kill(rec)
	recs[rec.id] = nil
	local pos = MonsterService.Position(rec)
	rec.model:SetAttribute("HP", 0)
	if rec.onDeath then
		task.spawn(rec.onDeath, rec, pos)
	else
		local top, topDmg = nil, 0
		for p, dmg in pairs(rec.contrib) do
			if dmg &gt; topDmg then
				top, topDmg = p, dmg
			end
		end
		for p, dmg in pairs(rec.contrib) do -- shared loot: anyone with &gt;= 10% damage (no kill stealing)
			if p.Parent and (p == top or dmg &gt;= rec.maxHp * 0.1) then
				reward(rec, p, pos)
			end
		end
	end
	task.delay(0.05, function()
		rec.model:Destroy()
	end)
	local zone = rec.zone
	if zone then
		if rec.def.boss then
			task.delay(rec.def.respawn, function()
				bossAlive[zone.id] = false
			end)
		else
			zoneCount[zone.id] -= 1
		end
	end
end

function MonsterService.Remove(id: number)
	local rec = recs[id]
	if rec then
		recs[id] = nil
		rec.model:Destroy()
	end
end

function MonsterService.Damage(id: number, player: Player, dmg: number): boolean
	local rec = recs[id]
	if not rec or rec.hp &lt;= 0 then
		return false
	end
	rec.hp -= dmg
	rec.contrib[player] = (rec.contrib[player] or 0) + dmg
	rec.aggro = player
	rec.model:SetAttribute("HP", math.max(0, math.floor(rec.hp)))
	if rec.hp &lt;= 0 then
		kill(rec)
	end
	return true
end

local function randomPoint(zone, margin: number): Vector3
	local c, s = zone.center, zone.size
	return Vector3.new(c.X + rng:NextNumber(-s.X / 2 + margin, s.X / 2 - margin), 0, c.Z + rng:NextNumber(-s.Z / 2 + margin, s.Z / 2 - margin))
end

local function clampToZone(zone, p: Vector3, y: number): Vector3
	local c, s = zone.center, zone.size
	return Vector3.new(math.clamp(p.X, c.X - s.X / 2 + 4, c.X + s.X / 2 - 4), y, math.clamp(p.Z, c.Z - s.Z / 2 + 4, c.Z + s.Z / 2 - 4))
end

local function spawnTick()
	for _, zone in ipairs(Zones) do
		zoneCount[zone.id] = zoneCount[zone.id] or 0
		local n = 0
		while zoneCount[zone.id] &lt; zone.maxAlive and n &lt; 3 do -- max 3 per tick per zone (smooth)
			n += 1
			zoneCount[zone.id] += 1
			MonsterService.Spawn(zone.monsters[rng:NextInteger(1, #zone.monsters)], randomPoint(zone, 15), { zone = zone })
		end
		if not bossAlive[zone.id] then
			bossAlive[zone.id] = true
			MonsterService.Spawn(zone.boss, zone.center, { zone = zone })
		end
	end
end

local function hrpOf(p: Player): BasePart?
	local char = p.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health &lt;= 0 then
		return nil
	end
	return char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function aiTick()
	local t = now()
	local players = Players:GetPlayers()
	for _, rec in pairs(recs) do
		local pos = MonsterService.Position(rec)
		local def = rec.def
		local reach = Combat.MonsterAttackRange + def.size / 2
		-- pick target: last attacker if close, else nearest player in range
		local target, best = nil, Combat.MonsterAggroRange + def.size
		for _, p in ipairs(players) do
			local hrp = hrpOf(p)
			if hrp and not S.PlayerService.InArena(p) and (not rec.zone or MonsterService.InZone(rec.zone, hrp.Position)) then
				local dist = (hrp.Position - pos).Magnitude
				if p == rec.aggro and dist &lt; best * 2 then
					target, best = hrp, -1
				elseif dist &lt; best then
					target, best = hrp, dist
				end
			end
		end
		if target then
			local tp = target.Position
			local flat = Vector3.new(tp.X, rec.y, tp.Z)
			local dist = (flat - pos).Magnitude
			if dist &lt;= reach then
				if os.clock() - rec.lastAttack &gt;= Combat.MonsterAttackCooldown then
					rec.lastAttack = os.clock()
					local hum = (target.Parent :: Model):FindFirstChildOfClass("Humanoid")
					if hum then
						hum:TakeDamage(def.damage * Combat.MonsterDamageScale)
					end
				end
			elseif not rec.static and (t &gt;= rec.t0 + rec.dur or (rec.to - flat).Magnitude &gt; 6) then
				local goal = pos + (flat - pos).Unit * math.min(def.speed, dist - reach * 0.7)
				if rec.zone then
					goal = clampToZone(rec.zone, goal, rec.y)
				end
				setSegment(rec, goal, math.max(0.2, (goal - pos).Magnitude / def.speed))
			end
		elseif not rec.static and rec.zone and t &gt;= rec.t0 + rec.dur and os.clock() &gt;= rec.wanderAt then
			rec.aggro = nil
			rec.wanderAt = os.clock() + rng:NextNumber(2, 5)
			local goal = clampToZone(rec.zone, pos + Vector3.new(rng:NextNumber(-25, 25), 0, rng:NextNumber(-25, 25)), rec.y)
			setSegment(rec, goal, (goal - pos).Magnitude / (def.speed * 0.5))
		end
	end
end

function MonsterService.Init(services)
	S = services
	Net.declare("Loot")
	folder = Instance.new("Folder")
	folder.Name = "Monsters"
	folder.Parent = Workspace
	task.spawn(function()
		while true do -- lint-ok (task.wait)
			spawnTick()
			task.wait(1)
		end
	end)
	task.spawn(function()
		while true do -- lint-ok (task.wait)
			task.wait(0.35)
			debug.profilebegin("MonsterAI")
			aiTick()
			debug.profileend()
		end
	end)
end

return MonsterService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002A"><Properties><string name="Name">PetService</string><ProtectedString name="Source">-- Fusion Altar pets: core (materials+coins) -&gt; weighted roll (odds public) -&gt; pet item.
-- Equip up to slots, combine 5 same -&gt; golden -&gt; rainbow, multipliers cached per player.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Pets = require(Shared.Config.Pets)
local Net = require(Shared.Net)

local PetService = {}
local S
local rng = Random.new()
local cache: { [Player]: { power: number, coins: number } } = {}
local coreById = {}
for _, c in ipairs(Pets.Cores) do
	coreById[c.id] = c
end

local function levelMult(lvl: number): number
	return if lvl &gt;= 2 then Pets.RainbowMult elseif lvl == 1 then Pets.GoldenMult else 1
end

function PetService.Slots(player: Player): number
	return Pets.BaseSlots + (S.MonetizationService.GetPerk(player, "extraPetSlots") or 0)
end

local function recompute(player: Player)
	local d = S.DataService.Get(player)
	local m = { power = 1, coins = 1 }
	local tags = {}
	if d then
		for _, uid in ipairs(d.equipped.pets) do
			local it = d.items[uid]
			local def = it and Pets.Pets[it.id]
			if def then
				m.power += def.power * levelMult(it.lvl or 0)
				m.coins += def.coins * levelMult(it.lvl or 0)
				table.insert(tags, it.id .. ":" .. (it.lvl or 0))
			end
		end
	end
	cache[player] = m
	player:SetAttribute("Pets", table.concat(tags, ",")) -- clients render followers from this
end

function PetService.Multipliers(player: Player)
	return cache[player] or { power = 1, coins = 1 }
end

local function roll(odds): string
	local total = 0
	for _, w in pairs(odds) do
		total += w
	end
	local x = rng:NextNumber() * total
	local last
	for id, w in pairs(odds) do
		last = id
		x -= w
		if x &lt;= 0 then
			return id
		end
	end
	return last
end

local function changed(player: Player)
	recompute(player)
	S.InventoryService.Sync(player)
	S.TrainingService.Push(player)
end

function PetService.Init(services)
	S = services
	S.DataService.Loaded:Connect(function(player)
		recompute(player)
	end)
	Players.PlayerRemoving:Connect(function(p)
		cache[p] = nil
	end)

	Net.handle("Fuse", function(player, coreId)
		local core = type(coreId) == "string" and coreById[coreId]
		if not core then
			return { ok = false }
		end
		if not S.InventoryService.CanAdd(player, "pet") then
			return { ok = false, err = "Pet storage full" }
		end
		if not S.InventoryService.Take(player, core.mats, core.coins) then
			return { ok = false, err = "Missing materials or coins" }
		end
		local petId = roll(core.odds)
		local lucky = false
		if S.MonetizationService.GetPerk(player, "forgeLuck") and rng:NextNumber() &lt; 0.1 then
			local second = roll(core.odds) -- Lucky Forge: 10% chance to roll twice, keep rarer
			if Pets.Pets[second].rarity &gt; Pets.Pets[petId].rarity then
				petId, lucky = second, true
			end
		end
		local uid = S.InventoryService.CreateItem(player, { kind = "pet", id = petId, lvl = 0 })
		S.QuestService.Progress(player, "Fusions", 1)
		if Pets.Pets[petId].rarity &gt;= 5 then
			Net.fireAll("Announce", ("%s hatched a MYTHIC %s!"):format(player.DisplayName, Pets.Pets[petId].name))
		end
		-- auto-equip if a slot is free
		local d = S.DataService.Get(player)
		if d and uid and #d.equipped.pets &lt; PetService.Slots(player) then
			S.DataService.Update(player, function(data)
				table.insert(data.equipped.pets, uid)
			end)
		end
		changed(player)
		return { ok = true, pet = petId, uid = uid, lucky = lucky }
	end, 2)

	Net.on("EquipPet", function(player, uid)
		local d = S.DataService.Get(player)
		local it = d and type(uid) == "string" and d.items[uid]
		if not it or it.kind ~= "pet" then
			return
		end
		S.DataService.Update(player, function(data)
			local i = table.find(data.equipped.pets, uid)
			if i then
				table.remove(data.equipped.pets, i)
			elseif #data.equipped.pets &lt; PetService.Slots(player) then
				table.insert(data.equipped.pets, uid)
			end
		end)
		changed(player)
	end, 6)

	Net.on("EquipBestPets", function(player)
		local d = S.DataService.Get(player)
		if not d then
			return
		end
		local list = {}
		for uid, it in pairs(d.items) do
			if it.kind == "pet" and Pets.Pets[it.id] then
				table.insert(list, { uid = uid, v = Pets.Pets[it.id].power * levelMult(it.lvl or 0) })
			end
		end
		table.sort(list, function(a, b)
			return a.v &gt; b.v
		end)
		S.DataService.Update(player, function(data)
			data.equipped.pets = {}
			for i = 1, math.min(#list, PetService.Slots(player)) do
				table.insert(data.equipped.pets, list[i].uid)
			end
		end)
		changed(player)
	end, 2)

	-- combine 5 identical (same id + level) into one of the next level
	Net.on("CombinePets", function(player, petId, lvl)
		local d = S.DataService.Get(player)
		if not d or type(petId) ~= "string" or type(lvl) ~= "number" or lvl &lt; 0 or lvl &gt; 1 then
			return
		end
		local uids = {}
		for uid, it in pairs(d.items) do
			if it.kind == "pet" and it.id == petId and (it.lvl or 0) == lvl then
				table.insert(uids, uid)
			end
		end
		if #uids &lt; Pets.CombineCount then
			S.EconomyService.Toast(player, ("Need %d of the same pet"):format(Pets.CombineCount), "error")
			return
		end
		for i = 1, Pets.CombineCount do
			S.InventoryService.RemoveItem(player, uids[i])
		end
		S.InventoryService.CreateItem(player, { kind = "pet", id = petId, lvl = lvl + 1 })
		S.EconomyService.Toast(player, (lvl == 0 and "GOLDEN " or "RAINBOW ") .. Pets.Pets[petId].name .. "!", "success")
		changed(player)
	end, 2)

	Net.on("DeletePet", function(player, uid)
		local it = type(uid) == "string" and S.InventoryService.GetItem(player, uid)
		if it and it.kind == "pet" then
			S.InventoryService.RemoveItem(player, uid)
			changed(player)
		end
	end, 6)
end

return PetService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002B"><Properties><string name="Name">PlayerService</string><ProtectedString name="Source">-- Central player stats: Power (leaderstat), combined multipliers, max HP, arena flag.
-- Genre services call these instead of re-implementing multiplier math.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage.Shared.Config
local Training = require(Config.Training)
local Guns = require(Config.Guns)
local Combat = require(Config.Combat)

local PlayerService = {}
local S -- services

function PlayerService.GetPower(player: Player): number
	local d = S.DataService.Get(player)
	return d and d.stats.Power or 0
end

local function setLeaderstat(player: Player, power: number)
	local ls = player:FindFirstChild("leaderstats")
	local v = ls and ls:FindFirstChild("Power")
	if v then
		(v :: IntValue).Value = math.floor(power)
	end
end

function PlayerService.AddPower(player: Player, amount: number)
	if not (amount &gt; 0) or amount == math.huge then -- also rejects NaN (would corrupt saved Power)
		return
	end
	local power = 0
	S.DataService.Update(player, function(d)
		d.stats.Power += amount
		power = d.stats.Power
	end)
	setLeaderstat(player, power)
end

function PlayerService.SetPower(player: Player, value: number)
	S.DataService.Update(player, function(d)
		d.stats.Power = value
	end)
	setLeaderstat(player, value)
end

function PlayerService.InArena(player: Player): boolean
	return player:GetAttribute("MatchId") ~= nil
end

-- Training gain multiplier (without the temporary x2 pulse, which TrainingService adds)
function PlayerService.TrainMultiplier(player: Player): number
	local d = S.DataService.Get(player)
	if not d then
		return 1
	end
	local m = S.MonetizationService.GetMultiplier(player, "trainMultiplier")
	m *= Training.RebirthMultiplier ^ d.rebirths
	m *= S.PetService.Multipliers(player).power
	if d.boostUntil &gt; os.time() then
		m *= Training.ProductBoost.Multiplier
	end
	return m
end

function PlayerService.BaseGain(power: number): number
	return Training.Base + math.sqrt(math.max(0, power)) * Training.SqrtFactor
end

-- Extra coin multiplier on top of the pass multiplier EconomyService applies itself
function PlayerService.CoinBonus(player: Player): number
	return S.PetService.Multipliers(player).coins * (1 + S.ClanService.Perk(player))
end

function PlayerService.DropMultiplier(player: Player): number
	return S.MonetizationService.GetMultiplier(player, "dropMultiplier") * (1 + S.ClanService.Perk(player))
end

function PlayerService.ArmorHp(player: Player): number
	local d = S.DataService.Get(player)
	if not d then
		return 0
	end
	local hp = 0
	for _, slot in ipairs(Guns.ArmorOrder) do
		local item = d.items[d.equipped[slot]]
		if item and item.kind == "armor" then
			hp += item.hp
		end
	end
	return hp
end

function PlayerService.MaxHp(player: Player): number
	if PlayerService.InArena(player) then
		return Guns.PvP.BaseHp
	end
	return math.floor(Combat.PlayerBaseHp + math.sqrt(PlayerService.GetPower(player)) * Combat.PowerHpFactor + PlayerService.ArmorHp(player))
end

-- Apply max HP + boots speed to the current character (call after gear/arena changes)
function PlayerService.RefreshCharacter(player: Player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end
	local maxHp = PlayerService.MaxHp(player)
	local ratio = if hum.MaxHealth &gt; 0 then hum.Health / hum.MaxHealth else 1
	hum.MaxHealth = maxHp
	hum.Health = math.max(1, maxHp * ratio)
	local speed = 16
	local d = S.DataService.Get(player)
	if d and not PlayerService.InArena(player) then
		local boots = d.items[d.equipped.boots]
		if boots and boots.kind == "armor" then
			speed += (Guns.Armor.boots.speed or 0) * boots.tier * 2
		end
		local passSpeed = S.MonetizationService.GetPerk(player, "walkSpeed")
		if passSpeed then
			speed = math.max(speed, passSpeed)
		end
	end
	hum.WalkSpeed = speed
end

function PlayerService.Init(services)
	S = services
	S.DataService.Loaded:Connect(function(player, data)
		local ls = player:WaitForChild("leaderstats", 10)
		if ls and not ls:FindFirstChild("Power") then
			local v = Instance.new("IntValue")
			v.Name = "Power"
			v.Value = math.floor(data.stats.Power)
			v.Parent = ls
		end
		PlayerService.RefreshCharacter(player)
	end)

	-- regen out of combat
	local lastHit: { [Player]: number } = {}
	PlayerService.MarkHit = function(player: Player)
		lastHit[player] = os.clock()
	end
	Players.PlayerRemoving:Connect(function(p)
		lastHit[p] = nil
	end)
	local function hook(player: Player)
		player.CharacterAdded:Connect(function(char)
			local hum = char:WaitForChild("Humanoid", 5) :: Humanoid?
			if not hum then
				return
			end
			hum.BreakJointsOnDeath = false
			task.wait()
			PlayerService.RefreshCharacter(player)
			hum.Health = hum.MaxHealth
			local last = hum.Health
			hum.HealthChanged:Connect(function(h)
				if h &lt; last then
					lastHit[player] = os.clock()
				end
				last = h
			end)
		end)
	end
	Players.PlayerAdded:Connect(hook)
	for _, p in ipairs(Players:GetPlayers()) do
		hook(p)
	end
	task.spawn(function()
		while true do -- lint-ok (task.wait)
			task.wait(1)
			for _, p in ipairs(Players:GetPlayers()) do
				local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
				if hum and hum.Health &gt; 0 and hum.Health &lt; hum.MaxHealth and os.clock() - (lastHit[p] or 0) &gt; Combat.RegenDelay then
					hum.Health = math.min(hum.MaxHealth, hum.Health + hum.MaxHealth * Combat.RegenPerSecond)
				end
			end
		end
	end)
end

PlayerService.MarkHit = function(_player: Player) end

return PlayerService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002C"><Properties><string name="Name">QuestService</string><ProtectedString name="Source">-- Daily quests rolled from Economy.QuestPool. Call QuestService.Progress(player, stat, n)
-- from any gameplay code (e.g. "Collect", "Kill", "Win", "Minutes").
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Economy = require(Shared.Config.Economy)
local Net = require(Shared.Net)

local QuestService = {}
local DataService, EconomyService

local function today(): number
	return math.floor(os.time() / 86400)
end

local function roll(data)
	local pool = table.clone(Economy.QuestPool)
	local rng = Random.new(today() * 7919 + (data.firstJoin % 1000))
	local list = {}
	for _ = 1, math.min(Economy.QuestsPerDay, #pool) do
		local q = table.remove(pool, rng:NextInteger(1, #pool))
		table.insert(list, { id = q.id, progress = 0, claimed = false })
	end
	data.quests = { day = today(), list = list }
end

local function find(id)
	for _, q in ipairs(Economy.QuestPool) do
		if q.id == id then
			return q
		end
	end
	return nil
end

local function push(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local out = {}
	for i, q in ipairs(data.quests.list) do
		local def = find(q.id)
		if def then
			out[i] = { text = def.text, goal = def.goal, progress = math.min(q.progress, def.goal), claimed = q.claimed, reward = def.reward }
		end
	end
	Net.fire(player, "QuestState", out)
end

local function ensure(player: Player)
	local data = DataService.Get(player)
	if data and data.quests.day ~= today() then
		DataService.Update(player, roll)
	end
end

function QuestService.Progress(player: Player, stat: string, amount: number)
	ensure(player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local changed = false
	DataService.Update(player, function(d)
		d.stats[stat] = (d.stats[stat] or 0) + amount
		for _, q in ipairs(d.quests.list) do
			local def = find(q.id)
			if def and def.stat == stat and not q.claimed and q.progress &lt; def.goal then
				q.progress += amount
				changed = true
			end
		end
	end)
	if changed then
		push(player)
	end
end

function QuestService.Init(services)
	DataService = services.DataService
	EconomyService = services.EconomyService
	Net.declare("QuestState")

	DataService.Loaded:Connect(function(player)
		ensure(player)
		push(player)
	end)

	Net.on("ClaimQuest", function(player, index)
		ensure(player)
		local data = DataService.Get(player)
		local q = data and type(index) == "number" and data.quests.list[index]
		local def = q and find(q.id)
		if not def or q.claimed or q.progress &lt; def.goal then
			return
		end
		DataService.Update(player, function()
			q.claimed = true
		end)
		EconomyService.Grant(player, def.reward, "quest")
		EconomyService.Toast(player, "Quest complete: " .. def.text, "success")
		push(player)
	end, 3)
end

return QuestService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002D"><Properties><string name="Name">RebirthService</string><ProtectedString name="Source">-- Rebirth: reset Power + Coins (keep items/pets) for a permanent training multiplier.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Training = require(Shared.Config.Training)
local Net = require(Shared.Net)

local RebirthService = {}
local BASE_COST, GROWTH = 50000, 4

function RebirthService.Cost(rebirths: number): number
	return BASE_COST * GROWTH ^ rebirths
end

function RebirthService.Init(S)
	Net.handle("RebirthInfo", function(player)
		local d = S.DataService.Get(player)
		if not d then
			return nil
		end
		return { rebirths = d.rebirths, cost = RebirthService.Cost(d.rebirths), power = d.stats.Power,
			now = Training.RebirthMultiplier ^ d.rebirths, after = Training.RebirthMultiplier ^ (d.rebirths + 1) }
	end, 4)

	Net.handle("Rebirth", function(player)
		local d = S.DataService.Get(player)
		if not d or d.stats.Power &lt; RebirthService.Cost(d.rebirths) or S.PlayerService.InArena(player) then
			return false
		end
		S.DataService.Update(player, function(data)
			data.rebirths += 1
			data.currencies.Coins = 0
		end)
		S.PlayerService.SetPower(player, 0)
		S.EconomyService.Sync(player)
		S.InventoryService.Sync(player)
		S.TrainingService.Push(player)
		S.PlayerService.RefreshCharacter(player)
		S.AnalyticsService.Badge(player, "Rebirth1")
		S.EconomyService.Toast(player, ("REBIRTH %d! Training x%.2f"):format(d.rebirths, Training.RebirthMultiplier ^ d.rebirths), "success")
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			root.CFrame = CFrame.new(0, 5, 0)
		end
		return true
	end, 1)
end

return RebirthService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002E"><Properties><string name="Name">RewardService</string><ProtectedString name="Source">-- Retention: daily login streak + session playtime rewards.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Economy = require(Shared.Config.Economy)
local Net = require(Shared.Net)

local RewardService = {}
local DataService, EconomyService, AnalyticsService
local sessionStart: { [Player]: number } = {}
local claimedPlaytime: { [Player]: { [number]: boolean } } = {}

local function today(): number
	return math.floor(os.time() / 86400)
end

local function dailyState(data)
	local d = today()
	local canClaim = data.daily.lastDay &lt; d
	local streak = data.daily.streak
	if data.daily.lastDay &lt; d - 1 then
		streak = 0 -- missed a day
	end
	local nextIndex = (streak % #Economy.DailyRewards) + 1
	return canClaim, streak, nextIndex
end

local function pushState(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local canClaim, streak, nextIndex = dailyState(data)
	local minutes = (os.clock() - (sessionStart[player] or os.clock())) / 60
	local playtime = {}
	for i, r in ipairs(Economy.PlaytimeRewards) do
		playtime[i] = {
			minutes = r.minutes,
			reward = r.reward,
			claimed = claimedPlaytime[player] and claimedPlaytime[player][i] or false,
			ready = minutes &gt;= r.minutes,
		}
	end
	Net.fire(player, "RewardState", {
		daily = { canClaim = canClaim, streak = streak, nextIndex = nextIndex, rewards = Economy.DailyRewards },
		playtime = playtime,
		sessionMinutes = minutes,
	})
end

function RewardService.Init(services)
	DataService = services.DataService
	EconomyService = services.EconomyService
	AnalyticsService = services.AnalyticsService
	Net.declare("RewardState")

	DataService.Loaded:Connect(function(player)
		sessionStart[player] = os.clock()
		claimedPlaytime[player] = {}
		pushState(player)
	end)
	Players.PlayerRemoving:Connect(function(p)
		sessionStart[p] = nil
		claimedPlaytime[p] = nil
	end)

	Net.on("ClaimDaily", function(player)
		local data = DataService.Get(player)
		if not data then
			return
		end
		local canClaim, streak, nextIndex = dailyState(data)
		if not canClaim then
			return
		end
		DataService.Update(player, function(d)
			d.daily.lastDay = today()
			d.daily.streak = streak + 1
		end)
		EconomyService.Grant(player, Economy.DailyRewards[nextIndex], "daily")
		EconomyService.Toast(player, "Daily reward claimed! Day " .. (streak + 1), "success")
		if streak + 1 &gt;= 7 then
			AnalyticsService.Badge(player, "Streak7")
		end
		pushState(player)
	end, 2)

	Net.on("ClaimPlaytime", function(player, index)
		local r = type(index) == "number" and Economy.PlaytimeRewards[index]
		if not r or not sessionStart[player] or claimedPlaytime[player][index] then
			return
		end
		if (os.clock() - sessionStart[player]) / 60 &lt; r.minutes then
			return
		end
		claimedPlaytime[player][index] = true
		EconomyService.Grant(player, r.reward, "playtime")
		EconomyService.Toast(player, "Playtime reward claimed!", "success")
		pushState(player)
	end, 2)

	-- refresh timers once a minute (cheap) and count Minutes stat for quests
	task.spawn(function()
		while true do -- lint-ok (task.wait)
			task.wait(60)
			for _, player in ipairs(Players:GetPlayers()) do
				if sessionStart[player] then
					services.QuestService.Progress(player, "Minutes", 1)
					pushState(player)
				end
			end
		end
	end)
end

return RewardService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002F"><Properties><string name="Name">StationService</string><ProtectedString name="Source">-- ProximityPrompts on hub stations (names are MapService contracts). Client opens the matching
-- panel via ProximityPromptService.PromptTriggered + the prompt's "Panel" attribute.
local Workspace = game:GetService("Workspace")

local StationService = {}

local STATIONS = {
	Booth_TargetRush = { "Target Rush", "Play", "Minigame:TargetRush" },
	Booth_ReloadRhythm = { "Reload Rhythm", "Play", "Minigame:ReloadRhythm" },
	Booth_LuckyCrate = { "Lucky Crate", "Open", "Minigame:LuckyCrate" },
	Forge = { "Forge", "Craft", "Forge" },
	FusionAltar = { "Fusion Altar", "Fuse", "Pets" },
	RebirthStatue = { "Rebirth", "Rebirth", "Rebirth" },
	ArenaPortal = { "PvP Arena", "Queue", "Arena" },
	ClanBoard = { "Clans", "Open", "Clan" },
	CodesBoard = { "Codes", "Redeem", "Codes" },
}

function StationService.Init()
	task.spawn(function()
		local map = Workspace:WaitForChild("Map", 30)
		local hub = map and map:WaitForChild("Hub", 30)
		if not hub then
			warn("[StationService] no Map.Hub")
			return
		end
		for name, s in pairs(STATIONS) do
			local part = hub:WaitForChild(name, 10)
			if part and part:IsA("BasePart") then
				local pp = Instance.new("ProximityPrompt")
				pp.ObjectText = s[1]
				pp.ActionText = s[2]
				pp.HoldDuration = 0
				pp.MaxActivationDistance = 14
				pp.RequiresLineOfSight = false
				pp:SetAttribute("Panel", s[3])
				pp.Parent = part
			end
		end
	end)
end

return StationService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000030"><Properties><string name="Name">TournamentService</string><ProtectedString name="Source">-- Server tournament every N minutes: signup (entry fee) -&gt; single-elimination 1v1 bracket using
-- ArenaService.StartMatch -&gt; champion takes the pot + Gems + trophy + badge.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Combat = require(Shared.Config.Combat)
local Net = require(Shared.Net)

local TournamentService = {}
local S
local T = Combat.Tournament
local state = { phase = "idle", entrants = {} :: { Player }, rounds = {}, endsAt = 0, nextAt = 0, pot = 0 }

local function broadcast()
	local rounds = {}
	for r, list in ipairs(state.rounds) do
		rounds[r] = {}
		for i, m in ipairs(list) do
			rounds[r][i] = { a = m.a and m.a.DisplayName or "BYE", b = m.b and m.b.DisplayName or "BYE", winner = m.winner and m.winner.DisplayName }
		end
	end
	local names = {}
	for _, p in ipairs(state.entrants) do
		table.insert(names, p.DisplayName)
	end
	Net.fireAll("TourState", { phase = state.phase, endsAt = state.endsAt, nextAt = state.nextAt, entrants = names,
		size = T.Size, entry = T.EntryCoins, pot = state.pot, rounds = rounds })
end

local function startDuel(m, done)
	S.ArenaService.StartMatch({ m.a }, { m.b }, "Tournament", {
		killsToWin = T.KillsToWin, minutes = 3, ranked = false,
		onEnd = function(winnerTeam)
			if winnerTeam == "A" then
				done(m.a)
			elseif winnerTeam == "B" then
				done(m.b)
			else -- draw: higher rating advances
				local da, db = S.DataService.Get(m.a), S.DataService.Get(m.b)
				done(if (da and da.pvp.rating or 0) &gt;= (db and db.pvp.rating or 0) then m.a else m.b)
			end
		end,
	})
end

local function runRound(players: { Player }): { Player }
	local list = {}
	for i = 1, #players, 2 do
		table.insert(list, { a = players[i], b = players[i + 1] })
	end
	table.insert(state.rounds, list)
	broadcast()
	local open = 0
	for _, m in ipairs(list) do
		if not m.b or not m.b.Parent then
			m.winner = m.a
		elseif not m.a.Parent then
			m.winner = m.b
		else
			open += 1
			startDuel(m, function(winner)
				m.winner = winner
				open -= 1
				broadcast()
			end)
		end
	end
	local t0 = os.clock()
	while open &gt; 0 and os.clock() - t0 &lt; 600 do
		task.wait(1)
	end
	local winners = {}
	for _, m in ipairs(list) do
		if m.winner and m.winner.Parent then
			table.insert(winners, m.winner)
		end
	end
	return winners
end

local function run()
	state = { phase = "signup", entrants = {}, rounds = {}, endsAt = Workspace:GetServerTimeNow() + T.SignupSeconds, nextAt = 0, pot = 0 }
	Net.fireAll("Announce", ("TOURNAMENT signup open! Entry %d Coins — go to the Arena Portal"):format(T.EntryCoins))
	broadcast()
	task.wait(T.SignupSeconds)
	if #state.entrants &lt; 2 then
		for _, p in ipairs(state.entrants) do
			if p.Parent then
				S.EconomyService.Add(p, "Coins", T.EntryCoins, "tour_refund", false)
				p:SetAttribute("InTournament", nil)
			end
		end
		state.phase = "idle"
		broadcast()
		Net.fireAll("Announce", "Tournament cancelled (not enough players).")
		return
	end
	state.phase = "running"
	local players = table.clone(state.entrants)
	for i = #players, 2, -1 do -- shuffle
		local j = math.random(1, i)
		players[i], players[j] = players[j], players[i]
	end
	while #players &gt; 1 do
		players = runRound(players)
	end
	local champ = players[1]
	if champ and champ.Parent then
		S.EconomyService.Add(champ, "Coins", state.pot, "tournament", false)
		S.EconomyService.Add(champ, "Gems", T.PrizeGems, "tournament", false)
		S.DataService.Update(champ, function(d)
			d.pvp.trophies += 1
		end)
		S.AnalyticsService.Badge(champ, "TournamentWin")
		S.ClanService.AddXp(champ, 200)
		Net.fireAll("Announce", ("🏆 %s won the tournament and %d Coins!"):format(champ.DisplayName, state.pot))
	end
	for _, p in ipairs(state.entrants) do
		p:SetAttribute("InTournament", nil)
	end
	state.phase = "done"
	broadcast()
end

function TournamentService.Init(services)
	S = services
	Net.declare("TourState")
	Net.handle("TourJoin", function(player)
		if state.phase ~= "signup" or table.find(state.entrants, player) or #state.entrants &gt;= T.Size or player:GetAttribute("MatchId") then
			return false
		end
		if not S.EconomyService.Spend(player, "Coins", T.EntryCoins) then
			return false
		end
		S.ArenaService.Dequeue(player)
		table.insert(state.entrants, player)
		state.pot += T.EntryCoins
		player:SetAttribute("InTournament", true)
		broadcast()
		return true
	end, 2)
	Net.handle("TourInfo", function()
		local names = {}
		for _, p in ipairs(state.entrants) do
			table.insert(names, p.DisplayName)
		end
		return { phase = state.phase, endsAt = state.endsAt, nextAt = state.nextAt, entrants = names, size = T.Size, entry = T.EntryCoins, pot = state.pot }
	end, 4)
	Players.PlayerRemoving:Connect(function(p)
		local i = table.find(state.entrants, p)
		if i and state.phase == "signup" then
			table.remove(state.entrants, i)
		end
	end)
	task.spawn(function()
		while true do -- lint-ok (task.wait)
			state.nextAt = Workspace:GetServerTimeNow() + T.IntervalMinutes * 60
			task.wait(T.IntervalMinutes * 60)
			if #Players:GetPlayers() &gt;= 2 then
				run()
			end
		end
	end)
end

return TournamentService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000031"><Properties><string name="Name">TrainingService</string><ProtectedString name="Source">-- AFK training: Power every tick, x2 Pulse (tap to boost), offline earnings, x3 boost product.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Training = require(Shared.Config.Training)
local Net = require(Shared.Net)

local TrainingService = {}
local S
type State = { training: boolean, nextPulse: number, offerUntil: number, pulseUntil: number, pulses: number }
local state: { [Player]: State } = {}
local rng = Random.new()

local function push(player: Player)
	local st = state[player]
	local d = S.DataService.Get(player)
	if not st or not d then
		return
	end
	local power = d.stats.Power
	local mult = S.PlayerService.TrainMultiplier(player) * (if os.clock() &lt; st.pulseUntil then Training.Pulse.Multiplier else 1)
	Net.fire(player, "TrainState", {
		training = st.training,
		gain = S.PlayerService.BaseGain(power) * mult,
		mult = mult,
		pulseLeft = math.max(0, st.pulseUntil - os.clock()),
		boostLeft = math.max(0, d.boostUntil - os.time()),
		rebirths = d.rebirths,
	})
end
TrainingService.Push = push

function TrainingService.GainPerSecond(player: Player): number
	return S.PlayerService.BaseGain(S.PlayerService.GetPower(player)) * S.PlayerService.TrainMultiplier(player)
end

-- grant N seconds worth of training (minigames, crates)
function TrainingService.GrantSeconds(player: Player, seconds: number): number
	local amount = math.floor(TrainingService.GainPerSecond(player) * seconds)
	S.PlayerService.AddPower(player, amount)
	return amount
end

local function offline(player: Player, data)
	local cfg = Training.Offline
	local last = data.lastSeen
	S.DataService.Update(player, function(d) -- consume the offline window now (rejoin must not pay twice)
		d.lastSeen = os.time()
	end)
	if last &lt;= 0 then
		return
	end
	local elapsed = math.min(os.time() - last, cfg.MaxHours * 3600)
	if elapsed &lt; cfg.MinMinutes * 60 then
		return
	end
	local gain = math.floor(S.PlayerService.BaseGain(data.stats.Power) * S.PlayerService.TrainMultiplier(player) * cfg.Rate * elapsed)
	if gain &gt; 0 then
		S.PlayerService.AddPower(player, gain)
		task.delay(4, function()
			S.EconomyService.Toast(player, ("While you were away: +%d Power"):format(gain), "success")
		end)
	end
end

function TrainingService.Init(services)
	S = services
	Net.declare("TrainState")
	Net.declare("PulseOffer")

	S.DataService.Loaded:Connect(function(player, data)
		state[player] = { training = true, nextPulse = os.clock() + Training.Pulse.FirstAt, offerUntil = 0, pulseUntil = 0, pulses = 0 }
		offline(player, data)
		push(player)
	end)
	Players.PlayerRemoving:Connect(function(p)
		S.DataService.Update(p, function(d)
			d.lastSeen = os.time()
		end)
		state[p] = nil
	end)

	Net.on("SetTraining", function(player, on)
		local st = state[player]
		if st and type(on) == "boolean" then
			st.training = on
			push(player)
		end
	end, 4)

	Net.on("PulseTap", function(player)
		local st = state[player]
		if not st or os.clock() &gt; st.offerUntil + 0.5 then
			return
		end
		st.offerUntil = 0
		st.pulseUntil = os.clock() + Training.Pulse.BoostSeconds
		S.QuestService.Progress(player, "X2Taps", 1)
		S.EconomyService.Toast(player, "x2 TRAINING ACTIVE!", "success")
		push(player)
	end, 3)

	S.MonetizationService.ProductHandlers.TrainBoost = function(player)
		local cfg = Training.ProductBoost
		S.DataService.Update(player, function(d)
			d.boostUntil = math.max(os.time(), d.boostUntil) + cfg.Seconds
		end)
		push(player)
		return true
	end

	task.spawn(function()
		local tick = 0
		while true do -- lint-ok (task.wait)
			task.wait(Training.TickSeconds)
			tick += 1
			local now = os.clock()
			for player, st in pairs(state) do
				local d = S.DataService.Get(player)
				if d and st.training and not S.PlayerService.InArena(player) then
					local mult = S.PlayerService.TrainMultiplier(player) * (if now &lt; st.pulseUntil then Training.Pulse.Multiplier else 1)
					S.PlayerService.AddPower(player, S.PlayerService.BaseGain(d.stats.Power) * mult * Training.TickSeconds)
					if now &gt;= st.nextPulse then
						local p = Training.Pulse
						st.offerUntil = now + p.ShowSeconds
						st.nextPulse = now + rng:NextNumber(p.MinGap, p.MaxGap)
						Net.fire(player, "PulseOffer", p.ShowSeconds)
					end
				end
				if tick % 5 == 0 then
					push(player)
				end
				if tick % 60 == 0 then
					S.DataService.Update(player, function(data)
						data.lastSeen = os.time()
					end)
				end
			end
		end
	end)
end

return TrainingService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000032"><Properties><string name="Name">WorldBossService</string><ProtectedString name="Source">-- World boss in the hub every N minutes: HP scales to the players online, everyone who helps gets
-- rewards by damage share, top 3 get Gems. Telegraphed slam AoE keeps it active, not AFK.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Combat = require(Shared.Config.Combat)
local Guns = require(Shared.Config.Guns)
local Recipes = require(Shared.Config.Recipes)
local Net = require(Shared.Net)

local WorldBossService = {}
local S
local TIER_COINS = { 500, 8000, 120000, 1500000, 25000000 }
local DEF = { name = "TITAN OF THE FORGE", hp = 1, damage = 0, coins = 0, power = 0, drops = {},
	color = Color3.fromRGB(255, 79, 216), size = 22, boss = true, speed = 0, respawn = 0 }

local function scaledHp(): number
	local total = 0
	for _, p in ipairs(Players:GetPlayers()) do
		total += 30 * Guns.PowerFactor(S.PlayerService.GetPower(p)) * 1.5 -- ~starter dps with upgrades
	end
	return math.max(Combat.WorldBoss.Hp, math.floor(total * 90)) -- ~90 s with everyone shooting
end

local function onDeath(rec, pos)
	local total = 0
	for _, dmg in pairs(rec.contrib) do
		total += dmg
	end
	local ranking = {}
	for p, dmg in pairs(rec.contrib) do
		if p.Parent and dmg &gt;= total * 0.01 then
			table.insert(ranking, { p = p, dmg = dmg })
		end
	end
	table.sort(ranking, function(a, b)
		return a.dmg &gt; b.dmg
	end)
	for i, r in ipairs(ranking) do
		local p = r.p
		local tier = S.ZoneService.BestTier(S.PlayerService.GetPower(p))
		local coins = math.floor(TIER_COINS[tier] * (0.5 + r.dmg / total * #ranking))
		S.EconomyService.Add(p, "Coins", coins, "worldboss", true)
		S.InventoryService.AddMaterial(p, Recipes.TierMats[tier][2], 3)
		local gems = ({ 30, 20, 10 })[i]
		if gems then
			S.EconomyService.Add(p, "Gems", gems, "worldboss", false)
		end
		S.QuestService.Progress(p, "BossKills", 1)
		S.ClanService.AddXp(p, 50)
		Net.fire(p, "Loot", pos, { coins = coins, power = 0, mats = { [Recipes.TierMats[tier][2]] = 3 }, rank = i })
	end
	Net.fireAll("Announce", "The World Boss has been defeated!")
end

local function run()
	local pos = Combat.WorldBoss.Position
	Net.fireAll("Announce", "WORLD BOSS arrives in 60 seconds at the Boss Pit!")
	task.wait(60)
	local hp = scaledHp()
	local rec = S.MonsterService.Spawn("world_boss", pos, { def = DEF, static = true, onDeath = onDeath, hpOverride = hp })
	Net.fireAll("Announce", "The World Boss is here! Shoot it!")
	local t0 = os.clock()
	while S.MonsterService.Get(rec.id) and os.clock() - t0 &lt; 360 do
		task.wait(6)
		if not S.MonsterService.Get(rec.id) then
			break
		end
		local center = Vector3.new(pos.X, 0, pos.Z)
		Net.fireAll("BossSlam", center, 28, 1.4) -- telegraph: radius, delay
		task.wait(1.4)
		for _, p in ipairs(Players:GetPlayers()) do
			local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
			if root and hum and (Vector3.new(root.Position.X, 0, root.Position.Z) - center).Magnitude &lt; 28 then
				hum:TakeDamage(hum.MaxHealth * 0.3)
			end
		end
	end
	if S.MonsterService.Get(rec.id) then
		S.MonsterService.Remove(rec.id)
		Net.fireAll("Announce", "The World Boss escaped... next time!")
	end
end

function WorldBossService.Init(services)
	S = services
	Net.declare("BossSlam")
	task.spawn(function()
		while true do -- lint-ok (task.wait)
			task.wait(Combat.WorldBoss.IntervalMinutes * 60 - 60)
			if #Players:GetPlayers() &gt; 0 then
				run()
			end
		end
	end)
end

return WorldBossService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000033"><Properties><string name="Name">WorldService</string><ProtectedString name="Source">-- Applies the lighting preset and builds a starter map when none exists.
-- Perf: all static parts Anchored, decorations CanCollide/CanQuery/CanTouch off,
-- CastShadow off on small props, everything grouped under one Map model for streaming.
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local World = require(ReplicatedStorage.Shared.Config.World)

local WorldService = {}

local function ensure(className: string, name: string)
	local inst = Lighting:FindFirstChild(name) or Instance.new(className)
	inst.Name = name
	inst.Parent = Lighting
	return inst
end

local function setProps(inst: Instance, props)
	for k, v in pairs(props or {}) do
		local ok, err = pcall(function()
			(inst :: any)[k] = v
		end)
		if not ok then
			warn("[WorldService] bad prop", k, err)
		end
	end
end

function WorldService.ApplyPreset(name: string)
	local p = World.Presets[name]
	if not p then
		warn("[WorldService] unknown preset", name)
		return
	end
	setProps(Lighting, p.Lighting)
	setProps(ensure("Atmosphere", "Atmosphere"), p.Atmosphere)
	setProps(ensure("BloomEffect", "Bloom"), p.Bloom)
	setProps(ensure("ColorCorrectionEffect", "ColorCorrection"), p.ColorCorrection)
	local rays = ensure("SunRaysEffect", "SunRays")
	rays.Enabled = p.SunRays ~= nil
	setProps(rays, p.SunRays)
end

local function part(parent, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material, decor: boolean)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material
	p.TopSurface = Enum.SurfaceType.Smooth
	if decor then
		p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = false, false, false, false
	end
	p.Parent = parent
	return p
end

local function fallbackTree(parent, pos: Vector3, rng: Random)
	local m = Instance.new("Model")
	m.Name = "Tree"
	local h = rng:NextNumber(6, 10)
	local trunk = part(m, Vector3.new(1.6, h, 1.6), CFrame.new(pos + Vector3.new(0, h / 2, 0)), Color3.fromRGB(120, 80, 50), Enum.Material.Wood, false)
	trunk.CastShadow = false
	local leaf = part(m, Vector3.one * rng:NextNumber(7, 10), CFrame.new(pos + Vector3.new(0, h + 2, 0)), Color3.fromRGB(80, 180, 80):Lerp(Color3.fromRGB(150, 220, 90), rng:NextNumber()), Enum.Material.Grass, true)
	leaf.Shape = Enum.PartType.Ball
	m.Parent = parent
end

function WorldService.BuildStarterMap()
	local cfg = World.StarterMap
	if not cfg.Enabled or workspace:FindFirstChild("Map") then
		return
	end
	local map = Instance.new("Model")
	map.Name = "Map"
	map.ModelStreamingMode = Enum.ModelStreamingMode.Default

	local base = workspace:FindFirstChild("Baseplate")
	if base then
		base:Destroy()
	end
	part(map, cfg.GroundSize, CFrame.new(0, -cfg.GroundSize.Y / 2, 0), cfg.GroundColor, cfg.GroundMaterial, false).Name = "Ground"

	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Size = Vector3.new(14, 1, 14)
	spawn.Position = Vector3.new(0, 0.5, 0)
	spawn.Color = Color3.fromRGB(255, 255, 255)
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.Duration = 0
	spawn.Parent = map

	for _, pl in ipairs(cfg.Platforms) do
		part(map, pl[2], CFrame.new(pl[1]), pl[3], Enum.Material.SmoothPlastic, false)
	end

	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local decorList = assets and assets:FindFirstChild("Decor") and assets.Decor:GetChildren() or {}
	local rng = Random.new(42)
	local decor = Instance.new("Folder")
	decor.Name = "Decor"
	decor.Parent = map
	for _ = 1, cfg.Decorations do
		local r = cfg.GroundSize.X / 2 - 10
		local pos = Vector3.new(rng:NextNumber(-r, r), 0, rng:NextNumber(-r, r))
		if pos.Magnitude &gt; 30 then -- keep spawn clear
			if #decorList &gt; 0 then
				local m = decorList[rng:NextInteger(1, #decorList)]:Clone()
				m:PivotTo(CFrame.new(pos) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0))
				m.Parent = decor
			else
				fallbackTree(decor, pos, rng)
			end
		end
	end
	map.Parent = workspace
end

function WorldService.Init()
	WorldService.ApplyPreset(World.Preset)
	WorldService.BuildStarterMap()
end

return WorldService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000034"><Properties><string name="Name">ZoneService</string><ProtectedString name="Source">-- Zone access by Power: server bounces under-powered players back to the hub (clients make the
-- gate non-collidable locally once unlocked). Sets player attribute "Zone".
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Zones = require(ReplicatedStorage.Shared.Config.Zones)

local ZoneService = {}

function ZoneService.ZoneAt(pos: Vector3)
	for _, z in ipairs(Zones) do
		if math.abs(pos.X - z.center.X) &lt;= z.size.X / 2 and math.abs(pos.Z - z.center.Z) &lt;= z.size.Z / 2 then
			return z
		end
	end
	return nil
end

-- best zone tier the player may enter (for minigame material prizes etc.)
function ZoneService.BestTier(power: number): number
	local tier = 1
	for _, z in ipairs(Zones) do
		if power &gt;= z.powerReq then
			tier = math.max(tier, z.tier)
		end
	end
	return tier
end

function ZoneService.Init(services)
	task.spawn(function()
		while true do -- lint-ok (task.wait)
			task.wait(1)
			for _, p in ipairs(Players:GetPlayers()) do
				local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
				if root then
					local z = ZoneService.ZoneAt(root.Position)
					p:SetAttribute("Zone", z and z.id or "hub")
					if z and services.PlayerService.GetPower(p) &lt; z.powerReq then
						root.CFrame = CFrame.new(0, 5, 0)
						services.EconomyService.Toast(p, ("Need %d Power for %s!"):format(z.powerReq, z.name), "error")
					end
				end
			end
		end
	end)
end

return ZoneService
</ProtectedString></Properties></Item></Item></Item></Item><Item class="StarterPlayer" referent="RBX0000004C"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX0000004B"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX0000004A"><Properties><string name="Name">Client</string></Properties><Item class="ModuleScript" referent="RBX00000038"><Properties><string name="Name">ClientState</string><ProtectedString name="Source">-- Client-side mirror of server pushes (Inv, TrainState). Controllers read + subscribe here.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Net = require(ReplicatedStorage.Shared.Net)
local Signal = require(ReplicatedStorage.Shared.Signal)

local State = {
	Inv = { materials = {}, items = {}, equipped = { gun = "", helmet = "", vest = "", boots = "", pets = {} }, index = { guns = {}, pets = {}, monsters = {} }, rebirths = 0 },
	Train = { training = true, gain = 0, mult = 1, pulseLeft = 0, boostLeft = 0, rebirths = 0 },
	InvChanged = Signal.new(),
	TrainChanged = Signal.new(),
}

function State.Power(): number
	local ls = Players.LocalPlayer:FindFirstChild("leaderstats")
	local v = ls and ls:FindFirstChild("Power")
	return v and (v :: IntValue).Value or 0
end

function State.Coins(): number
	local ls = Players.LocalPlayer:FindFirstChild("leaderstats")
	local v = ls and ls:FindFirstChild("Coins")
	return v and (v :: IntValue).Value or 0
end

function State.Init()
	Net.listen("Inv", function(inv)
		State.Inv = inv
		State.InvChanged:Fire(inv)
	end)
	Net.listen("TrainState", function(t)
		State.Train = t
		State.TrainChanged:Fire(t)
	end)
end

return State
</ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000046"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX00000039"><Properties><string name="Name">ArenaController</string><ProtectedString name="Source">-- PvP: queue window (1v1 / 2v2 / 4v4 + rating), tournament signup + bracket, in-match scoreboard.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Theme = require(Shared.Theme)
local Net = require(Shared.Net)
local Combat = require(Shared.Config.Combat)
local UI = require(script.Parent.Parent.UIKit)
local W = require(script.Parent.Parent.Widgets)
local UIController = require(script.Parent.UIController)

local C = Theme.Colors
local Arena = {}
local body, tab = nil, "QUEUE"
local tour = nil
local queuePill, queueLabel, score

local function renderQueue()
	UIController.List(body)
	local st = Net.invoke("PvpStats")
	if st then
		UIController.Row(body, 0, ("Rating %d   🏆 %d"):format(st.rating, st.trophies), ("Wins %d  •  Losses %d  •  PvP is fair: everyone has the same HP, passes don't count"):format(st.wins, st.losses), "", C.Panel, false, function() end)
	end
	local order = { "Duel", "Duo", "Squad" }
	for i, mode in ipairs(order) do
		local m = Combat.Arena.Modes[mode]
		UIController.Row(body, i, m.name .. " Ranked", ("First to %d kills • %d min • win +%d Coins"):format(m.killsToWin, m.minutes, Combat.Arena.WinCoins), "QUEUE", C.Danger, true, function()
			Net.send("QueueJoin", mode)
			UIController.Close("Arena")
		end)
	end
end

local function renderTour()
	UIController.List(body)
	local t = tour or Net.invoke("TourInfo")
	if not t then
		return
	end
	local now = Workspace:GetServerTimeNow()
	local T = Combat.Tournament
	if t.phase == "signup" then
		UIController.Row(body, 0, ("SIGNUP OPEN — %ds left"):format(math.max(0, math.floor(t.endsAt - now))),
			("%d/%d players • entry %d Coins • pot %s + %d Gems"):format(#t.entrants, t.size, t.entry, W.short(t.pot), T.PrizeGems), "JOIN", C.Gold, true, function()
				if not Net.invoke("TourJoin") then
					UIController.Toast("Can't join (full, already in, or not enough Coins)", "error")
				end
			end)
	else
		local mins = math.max(0, math.floor(((t.nextAt or 0) - now) / 60))
		UIController.Row(body, 0, if t.phase == "running" then "TOURNAMENT IN PROGRESS" else ("Next tournament in ~%d min"):format(mins),
			("8-player 1v1 bracket • first to %d • entry %d Coins"):format(T.KillsToWin, T.EntryCoins), "", C.Panel, false, function() end)
	end
	for r, round in ipairs(t.rounds or {}) do
		for i, m in ipairs(round) do
			UIController.Row(body, r * 10 + i, ("Round %d: %s vs %s"):format(r, m.a, m.b), m.winner and ("Winner: " .. m.winner) or "fighting...", "", C.Panel, false, function() end)
		end
	end
end

local function render()
	if not body then
		return
	end
	W.clear(body)
	if tab == "QUEUE" then
		renderQueue()
	else
		renderTour()
	end
end
Arena.Render = render

function Arena.Init()
	local gui = UIController.Gui()
	local win, b = UIController.MakeWindow("Arena", "PVP ARENA", C.Danger)
	body = b
	local select = W.tabs(win, b, { "QUEUE", "TOURNAMENT" }, function(name)
		tab = name
		render()
	end)
	UIController.AddMenuButton(8, "PVP", C.Danger, "Arena").Activated:Connect(function()
		task.defer(render)
	end)

	-- queue pill
	queuePill = UI.panel({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 70), Size = UDim2.fromOffset(250, 50), BackgroundColor3 = C.Danger, Visible = false, Parent = gui })
	queueLabel = UI.label("", 16, { Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -90, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, Parent = queuePill })
	UI.button("LEAVE", C.PanelLight, function()
		Net.send("QueueLeave")
	end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -6, 0.5, 0), Size = UDim2.fromOffset(76, 38), Parent = queuePill }).Label.TextSize = 14
	Net.listen("QueueState", function(q)
		queuePill.Visible = q ~= nil
		if q then
			queueLabel.Text = ("Finding %s... %d/%d"):format(Combat.Arena.Modes[q.mode].name, q.count, q.need)
		end
	end)

	-- scoreboard
	score = UI.panel({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 100), Size = UDim2.fromOffset(420, 60), BackgroundColor3 = C.Bg, Visible = false, Parent = gui })
	local scoreL = UI.label("", 26, { Size = UDim2.fromScale(1, 1), Parent = score })
	local current = nil
	Net.listen("MatchState", function(s)
		current = s
		queuePill.Visible = false
		score.Visible = true
	end)
	task.spawn(function()
		while true do -- lint-ok (task.wait)
			task.wait(0.25)
			if current and score.Visible then
				local left = math.max(0, current.endsAt - Workspace:GetServerTimeNow())
				local mine = current.team
				local other = if mine == "A" then "B" else "A"
				scoreL.Text = ("%s  YOU %d — %d ENEMY  •  %d:%02d  (to %d)"):format(current.mode, current.kills[mine], current.kills[other], left // 60, left % 60, current.killsToWin)
			end
		end
	end)
	Net.listen("MatchEnd", function(r)
		score.Visible = false
		current = nil
		local won = r.winner == r.team
		local box, close = W.modal(gui, if r.winner == nil then "DRAW" elseif won then "VICTORY!" else "DEFEAT", if won then C.Primary else C.Danger)
		UI.label(if r.ranked then ("Rating %s%d"):format(if r.delta &gt;= 0 then "+" else "", r.delta) else "Tournament match", 30, { Position = UDim2.fromOffset(0, 140), Size = UDim2.new(1, 0, 0, 40), Parent = box })
		UI.button("OK", C.Primary, close, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -20), Size = UDim2.fromOffset(200, 54), Parent = box })
	end)
	Net.listen("TourState", function(t)
		tour = t
		if UIController.IsOpen("Arena") and tab == "TOURNAMENT" then
			render()
		end
	end)
	select("QUEUE")
end

return Arena
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003A"><Properties><string name="Name">ClanController</string><ProtectedString name="Source">-- Clans: create / info / members (promote, kick) / invite nearby players / weekly Clan War top 10.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Theme = require(Shared.Theme)
local Net = require(Shared.Net)
local Combat = require(Shared.Config.Combat)
local UI = require(script.Parent.Parent.UIKit)
local W = require(script.Parent.Parent.Widgets)
local UIController = require(script.Parent.UIController)

local C = Theme.Colors
local Clan = {}
local body, tab = nil, "MY CLAN"
local ROLE = { ["1Leader"] = "Leader", ["2Officer"] = "Officer", ["3Member"] = "Member" }

local function input(parent: Instance, placeholder: string, y: number): TextBox
	local box = UI.new("TextBox", { PlaceholderText = placeholder, Text = "", Font = Theme.Font, TextSize = 22, TextColor3 = C.Text, BackgroundColor3 = C.Bg,
		Size = UDim2.fromOffset(300, 48), Position = UDim2.fromOffset(140, y), ClearTextOnFocus = false, Parent = parent })
	UI.corner().Parent = box
	UI.stroke().Parent = box
	return box
end

local function renderCreate()
	local holder = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 260), Parent = body })
	UI.label("You are not in a clan. Create one or ask a clan member for an invite!", 16, { Size = UDim2.new(1, 0, 0, 24), Parent = holder })
	local name = input(holder, "Clan name (3-20)", 40)
	local tag = input(holder, "TAG (2-4)", 100)
	local res = UI.label("", 16, { Position = UDim2.fromOffset(0, 220), Size = UDim2.new(1, 0, 0, 24), Parent = holder })
	UI.button(("CREATE (%s Coins)"):format(W.short(Combat.Clan.CreateCoins)), C.Primary, function()
		local r = Net.invoke("ClanCreate", name.Text, tag.Text)
		res.Text = if r == "OK" then "Clan created!" else tostring(r)
		if r == "OK" then
			task.defer(Clan.Render)
		end
	end, { Position = UDim2.fromOffset(140, 160), Size = UDim2.fromOffset(300, 50), Parent = holder })
end

local function renderMine(info)
	UIController.List(body)
	local c = info.clan
	UIController.Row(body, 0, ("[%s] %s  •  Lv %d"):format(c.tag, c.name, c.level), ("%d/%d members • XP %s • perk +%d%% drops &amp; coins"):format(#c.members, c.max, W.short(c.xp), math.floor(c.perk * 100)),
		"LEAVE", C.Danger, true, function()
			Net.invoke("ClanLeave")
			task.defer(Clan.Render)
		end, (c.xp % Combat.Clan.XpPerLevel) / Combat.Clan.XpPerLevel)
	for i, m in ipairs(c.members) do
		local canManage = info.role &lt; m.role
		local action = if info.role == "1Leader" and m.role == "3Member" then "promote" elseif canManage then "kick" else nil
		UIController.Row(body, i, (if m.online then "🟢 " else "⚫ ") .. m.name, ROLE[m.role] or m.role, if action == "promote" then "PROMOTE" elseif action then "KICK" else "", C.PanelLight, action ~= nil, function()
			Net.invoke("ClanManage", m.userId, action)
			task.defer(Clan.Render)
		end)
	end
	if info.role ~= "3Member" then
		local o = 100
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= Players.LocalPlayer and not p:GetAttribute("ClanTag") then
				o += 1
				UIController.Row(body, o, "Invite " .. p.DisplayName, "Player in this server without a clan", "INVITE", C.Primary, true, function()
					Net.send("ClanInviteSend", p.UserId)
					UIController.Toast("Invite sent to " .. p.DisplayName, "success")
				end)
			end
		end
	end
end

local function renderWar()
	UIController.List(body)
	local list = Net.invoke("ClanWarTop") or {}
	UIController.Row(body, 0, "WEEKLY CLAN WAR", "Clans earn XP from kills, bosses and PvP wins. Resets every Monday.", "", C.Panel, false, function() end)
	for _, e in ipairs(list) do
		UIController.Row(body, e.rank, ("#%d  [%s] %s"):format(e.rank, e.tag, e.name), W.short(e.xp) .. " XP", "", C.Panel, false, function() end)
	end
end

function Clan.Render()
	if not body then
		return
	end
	W.clear(body)
	if tab == "WAR" then
		renderWar()
		return
	end
	local info = Net.invoke("ClanInfo")
	if info and info.clan then
		renderMine(info)
	else
		renderCreate()
	end
end

function Clan.Init()
	local win, b = UIController.MakeWindow("Clan", "CLANS", C.Energy)
	body = b
	local select = W.tabs(win, b, { "MY CLAN", "WAR" }, function(name)
		tab = name
		Clan.Render()
	end)
	UIController.AddMenuButton(10, "CLAN", C.Energy, "Clan").Activated:Connect(function()
		task.defer(Clan.Render)
	end)
	Net.listen("ClanInvite", function(inv)
		local box, close = W.modal(UIController.Gui(), "CLAN INVITE", C.Energy)
		UI.label(("%s invited you to [%s] %s"):format(inv.from, inv.tag, inv.name), 24, { Position = UDim2.fromOffset(20, 120), Size = UDim2.new(1, -40, 0, 80), Parent = box })
		UI.button("JOIN", C.Primary, function()
			local r = Net.invoke("ClanAccept", inv.id)
			UIController.Toast(if r == "OK" then "Joined clan!" else tostring(r), if r == "OK" then "success" else "error")
			close()
		end, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(0.5, -8, 1, -20), Size = UDim2.fromOffset(170, 54), Parent = box })
		UI.button("NO", C.PanelLight, close, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0.5, 8, 1, -20), Size = UDim2.fromOffset(170, 54), Parent = box })
	end)
	select("MY CLAN")
end

return Clan
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003B"><Properties><string name="Name">EffectsController</string><ProtectedString name="Source">-- Client-only visuals (zero server cost): coin spin, pickup burst + floating text,
-- and a quality governor that turns heavy effects off on weak devices / Low Graphics.
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local Net = require(ReplicatedStorage.Shared.Net)

local EffectsController = { LowFx = false }
local spinning: { BasePart } = {}

function EffectsController.SetLowFx(on: boolean)
	EffectsController.LowFx = on
	for _, e in ipairs(Lighting:GetChildren()) do
		if e:IsA("PostEffect") then
			e.Enabled = not on -- Bloom/SunRays/DepthOfField/ColorCorrection
		end
	end
	for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("ParticleEmitter") and d:GetAttribute("Decor") then
			d.Enabled = not on
		end
	end
end

local function burst(pos: Vector3, amount: number)
	if EffectsController.LowFx then
		return
	end
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
	p.Transparency = 1
	p.Size = Vector3.one
	p.Position = pos
	local a = Instance.new("Attachment")
	a.Parent = p
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	pe.Color = ColorSequence.new(Color3.fromRGB(255, 220, 80))
	pe.LightEmission = 0.8
	pe.Size = NumberSequence.new(0.6, 0)
	pe.Speed = NumberRange.new(8, 14)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Lifetime = NumberRange.new(0.4, 0.6)
	pe.Rate = 0
	pe.Parent = a
	p.Parent = workspace
	pe:Emit(12)

	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(120, 40)
	bb.AlwaysOnTop = true
	bb.Adornee = p
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.Font = Enum.Font.FredokaOne
	t.TextScaled = true
	t.Text = "+" .. amount
	t.TextColor3 = Color3.fromRGB(255, 220, 60)
	t.TextStrokeTransparency = 0
	t.Parent = bb
	bb.Parent = p
	TweenService:Create(bb, TweenInfo.new(0.8), { StudsOffset = Vector3.new(0, 4, 0) }):Play()
	TweenService:Create(t, TweenInfo.new(0.8), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	task.delay(1, function()
		p:Destroy()
	end)
end

function EffectsController.Init()
	-- coin spin: one RenderStepped loop for all coins, skipped when far away
	local function track(inst)
		if inst:IsA("BasePart") and inst:GetAttribute("Spin") then
			table.insert(spinning, inst)
		end
	end
	local folder = workspace:WaitForChild("Collectibles", 10)
	if folder then
		folder.ChildAdded:Connect(track)
		for _, c in ipairs(folder:GetChildren()) do
			track(c)
		end
	end
	local cam = workspace.CurrentCamera
	RunService.RenderStepped:Connect(function(dt) -- lint-ok (distance-culled spin)
		local camPos = cam.CFrame.Position
		for i = #spinning, 1, -1 do
			local part = spinning[i]
			if not part.Parent then
				table.remove(spinning, i)
			elseif (part.Position - camPos).Magnitude &lt; 150 then
				part.CFrame *= CFrame.Angles(dt * 2, 0, 0)
			end
		end
	end)

	Net.listen("Collected", function(pos, amount)
		burst(pos, amount)
	end)

	-- auto low-fx on very low quality settings
	local ok, q = pcall(function()
		return UserSettings().GameSettings.SavedQualityLevel.Value
	end)
	if ok and q &gt; 0 and q &lt;= 3 then
		EffectsController.SetLowFx(true)
	end
end

return EffectsController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003C"><Properties><string name="Name">ForgeController</string><ProtectedString name="Source">-- Forge UI: recipe list (guns / armor, by tier) -&gt; assembly minigame (timing taps per part)
-- -&gt; rarity reveal card -&gt; equip.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage.Shared
local Theme = require(Shared.Theme)
local Net = require(Shared.Net)
local Recipes = require(Shared.Config.Recipes)
local Guns = require(Shared.Config.Guns)
local Materials = require(Shared.Config.Materials)
local UI = require(script.Parent.Parent.UIKit)
local W = require(script.Parent.Parent.Widgets)
local State = require(script.Parent.Parent.ClientState)
local UIController = require(script.Parent.UIController)
local MG = require(script.Parent.MinigameController)

local C = Theme.Colors
local Forge = {}
local body, kindFilter = nil, "GUNS"
local PART_NAMES = { gun = { "Barrel", "Receiver", "Grip", "Sight", "Mag" }, armor = { "Plates", "Straps", "Core", "Padding", "Visor" } }
local GLYPH = { pistol = "🔫", smg = "🔫", shotgun = "🔫", rifle = "🔫", blaster = "✦", railgun = "⚡", helmet = "⛑", vest = "🦺", boots = "👢" }

local function matText(recipe): (string, boolean)
	local inv = State.Inv.materials
	local parts, ok = {}, true
	for id, n in pairs(recipe.mats) do
		local have = inv[id] or 0
		ok = ok and have &gt;= n
		table.insert(parts, ("%s %d/%d"):format(Materials[id].glyph, have, n))
	end
	ok = ok and State.Coins() &gt;= recipe.coins
	table.insert(parts, "🪙 " .. W.short(recipe.coins))
	return table.concat(parts, "  "), ok
end

local function statText(item): string
	if item.kind == "gun" then
		local t = Guns.Types[item.id]
		return ("DMG %s  •  %s/s  •  Q%d%%"):format(W.short(item.dmg), tostring(t.rate), math.floor(item.q * 100))
	end
	return ("+%s HP  •  Q%d%%"):format(W.short(item.hp), math.floor(item.q * 100))
end
Forge.StatText = statText

local function reveal(box: Frame, close: () -&gt; (), res)
	for _, ch in ipairs(box:GetChildren()) do
		if ch.Name == "Play" then
			ch:Destroy()
		end
	end
	local item = res.item
	local r = Guns.Rarities[item.rarity]
	W.flash(UIController.Gui(), r.color)
	local name = if item.kind == "gun" then Guns.Types[item.id].name else Guns.Armor[item.id].name
	local card = W.card(box, 0, item.rarity, GLYPH[item.id] or "★", ("%s %s T%d"):format(r.name, name, item.tier), statText(item))
	card.AnchorPoint = Vector2.new(0.5, 0)
	card.Position = UDim2.new(0.5, 0, 0, 70)
	card.Size = UDim2.fromOffset(220, 150)
	local s = UI.new("UIScale", { Scale = 0.2, Parent = card })
	TweenService:Create(s, TweenInfo.new(0.5, Enum.EasingStyle.Back), { Scale = 1.3 }):Play()
	UI.label(("Perfect parts: %d%s"):format(res.perfects, if res.bumped then "  —  RARITY UP!" else ""), 18, { Position = UDim2.fromOffset(0, 300), Size = UDim2.new(1, 0, 0, 24), TextColor3 = if res.bumped then C.Gold else C.TextDim, Parent = box })
	UI.button("EQUIP", C.Primary, function()
		Net.send("Equip", res.uid)
		close()
	end, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(0.5, -8, 1, -16), Size = UDim2.fromOffset(170, 52), Parent = box })
	UI.button("KEEP", C.PanelLight, close, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0.5, 8, 1, -16), Size = UDim2.fromOffset(170, 52), Parent = box })
end

local function craft(recipe)
	local start = Net.invoke("ForgeStart", recipe.id)
	if not start or not start.ok then
		UIController.Toast(start and start.err or "Can't craft", "error")
		return
	end
	UIController.Close("Forge")
	local box, close = W.modal(UIController.Gui(), "ASSEMBLY", C.Forge)
	local names = PART_NAMES[recipe.kind]
	local perfects, index = 0, 1
	local partL = UI.label("", 30, { Name = "Play", Position = UDim2.fromOffset(0, 70), Size = UDim2.new(1, 0, 0, 36), TextColor3 = C.Gold, Parent = box })
	local slots = UI.new("Frame", { Name = "Play", BackgroundTransparency = 1, Position = UDim2.fromOffset(60, 120), Size = UDim2.new(1, -120, 0, 40), Parent = box })
	UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 10), Parent = slots })
	local slotFrames = {}
	for i = 1, start.parts do
		slotFrames[i] = UI.panel({ Size = UDim2.fromOffset(90, 36), BackgroundColor3 = C.Bg, Parent = slots }, { UI.label(names[i] or "Part", 13, { Size = UDim2.fromScale(1, 1) }) })
	end
	partL.Text = "Install: " .. names[1]
	local tap, stop
	local finished = false
	tap, stop = MG.TimingBar(box, 190, 1.1 + recipe.tier * 0.12, 0.14, function(perfect)
		if finished then
			return
		end
		local f = slotFrames[index]
		f.BackgroundColor3 = if perfect then C.Primary else C.Danger
		local sc = UI.new("UIScale", { Scale = 1.3, Parent = f })
		TweenService:Create(sc, Theme.Tween, { Scale = 1 }):Play()
		if perfect then
			perfects += 1
		end
		index += 1
		if index &gt; start.parts then
			finished = true
			stop()
			partL.Text = "Forging..."
			task.wait(0.8)
			local res = Net.invoke("ForgeFinish", start.session, perfects)
			if res then
				reveal(box, close, res)
			else
				close()
			end
		else
			partL.Text = "Install: " .. (names[index] or "Part")
		end
	end)
	local btn = UI.button("HAMMER!", C.Forge, function()
		tap()
	end, { Name = "Play", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 260), Size = UDim2.fromOffset(240, 70), Parent = box })
	btn.Label.TextSize = 30
end

local function render()
	if not body then
		return
	end
	W.clear(body)
	UIController.List(body)
	local kind = if kindFilter == "GUNS" then "gun" else "armor"
	local list = {}
	for _, r in ipairs(Recipes.List) do
		if r.kind == kind then
			table.insert(list, r)
		end
	end
	table.sort(list, function(a, b)
		local _, oa = matText(a)
		local _, ob = matText(b)
		if oa ~= ob then
			return oa
		end
		return a.tier &lt; b.tier
	end)
	for i, r in ipairs(list) do
		local name = if kind == "gun" then Guns.Types[r.item].name else Guns.Armor[r.item].name
		local text, ok = matText(r)
		UIController.Row(body, i, ("%s %s  (Tier %d)"):format(GLYPH[r.item] or "", name, r.tier), text, "CRAFT", C.Forge, ok, function()
			craft(r)
		end)
	end
end
Forge.Render = render

function Forge.Init()
	local win, b = UIController.MakeWindow("Forge", "THE FORGE", C.Forge)
	body = b
	local select = W.tabs(win, b, { "GUNS", "ARMOR" }, function(name)
		kindFilter = name
		render()
	end)
	UIController.AddMenuButton(5, "FORGE", C.Forge, "Forge").Activated:Connect(function()
		task.defer(render)
	end)
	State.InvChanged:Connect(function()
		if UIController.IsOpen("Forge") then
			render()
		end
	end)
	Net.listen("ForgeAuto", function(res)
		UIController.Toast("Forge finished automatically: " .. Guns.Rarities[res.item.rarity].name, "info")
	end)
	select("GUNS")
end

return Forge
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003D"><Properties><string name="Name">GunController</string><ProtectedString name="Source">-- Shooting: hold mouse / FIRE button (mobile) / AUTO (Auto Farm pass). Client picks the target
-- (aim-assist cone), server validates everything. Tracers + muzzle flash are client-only.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Theme = require(Shared.Theme)
local Net = require(Shared.Net)
local Guns = require(Shared.Config.Guns)
local UI = require(script.Parent.Parent.UIKit)
local UIController = require(script.Parent.UIController)
local MonsterController = require(script.Parent.MonsterController)
local Effects = require(script.Parent.EffectsController)

local player = Players.LocalPlayer
local GunController = { Auto = false }
local holding = false
local lastShot = 0

local function tool(): Tool?
	local c = player.Character
	local t = c and c:FindFirstChildOfClass("Tool")
	return if t and t:GetAttribute("Gun") then t else nil
end

local function muzzlePos(t: Tool?, char: Model?): Vector3?
	local h = t and t:FindFirstChild("Handle") :: BasePart?
	local att = h and h:FindFirstChild("Muzzle") :: Attachment?
	if att then
		return att.WorldPosition
	end
	local head = char and char:FindFirstChild("Head") :: BasePart?
	return head and head.Position
end

local function tracer(from: Vector3, to: Vector3, color: Color3)
	local dist = (to - from).Magnitude
	if dist &lt; 0.5 then
		return
	end
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Size = Vector3.new(0.18, 0.18, dist)
	p.CFrame = CFrame.lookAt(from, to) * CFrame.new(0, 0, -dist / 2)
	p.Parent = Workspace
	TweenService:Create(p, TweenInfo.new(0.09), { Transparency = 1, Size = Vector3.new(0.05, 0.05, dist) }):Play()
	task.delay(0.1, function()
		p:Destroy()
	end)
	if not Effects.LowFx then
		local f = Instance.new("Part")
		f.Anchored, f.CanCollide, f.CanQuery, f.CanTouch, f.CastShadow = true, false, false, false, false
		f.Shape = Enum.PartType.Ball
		f.Material = Enum.Material.Neon
		f.Color = color
		f.Size = Vector3.one * 0.8
		f.Position = from
		f.Parent = Workspace
		TweenService:Create(f, TweenInfo.new(0.06), { Size = Vector3.one * 0.1, Transparency = 1 }):Play()
		task.delay(0.08, function()
			f:Destroy()
		end)
	end
end

local function pickTarget(root: BasePart, range: number, aimRay: Ray?)
	local best, bestScore, kind, id, at = nil, math.huge, nil, nil, nil
	local function consider(p: Vector3, k: string, tid: number)
		local d = (p - root.Position).Magnitude
		if d &gt; range then
			return
		end
		local score = d
		if aimRay then
			local to = (p - aimRay.Origin).Unit
			local ang = math.deg(math.acos(math.clamp(to:Dot(aimRay.Direction.Unit), -1, 1)))
			if ang &gt; 18 then
				return
			end
			score = ang * 4 + d * 0.1
		end
		if score &lt; bestScore then
			best, bestScore, kind, id, at = true, score, k, tid, p
		end
	end
	local mid = player:GetAttribute("MatchId")
	if mid then
		for _, other in ipairs(Players:GetPlayers()) do
			if other ~= player and other:GetAttribute("MatchId") == mid and other:GetAttribute("Team") ~= player:GetAttribute("Team") then
				local r = other.Character and other.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
				local h = other.Character and other.Character:FindFirstChildOfClass("Humanoid")
				if r and h and h.Health &gt; 0 then
					consider(r.Position, "p", other.UserId)
				end
			end
		end
	else
		for _, m in ipairs(MonsterController.Alive()) do
			consider(MonsterController.Pos(m), "m", m:GetAttribute("MonsterId"))
		end
	end
	if best then
		return kind, id, at
	end
	return nil
end

local function step()
	local t = tool()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not t or not root or not (holding or GunController.Auto) then
		return
	end
	local rate = t:GetAttribute("Rate") or 2
	if os.clock() - lastShot &lt; 1 / rate then
		return
	end
	local aimRay = nil
	if holding and UserInputService.MouseEnabled and not UserInputService.TouchEnabled then
		local m = UserInputService:GetMouseLocation()
		aimRay = Workspace.CurrentCamera:ViewportPointToRay(m.X, m.Y)
	end
	local kind, id, at = pickTarget(root, t:GetAttribute("Range") or 60, aimRay)
	if not kind then
		return
	end
	lastShot = os.clock()
	Net.send("Fire", kind, id)
	local from = muzzlePos(t, char)
	if from then
		tracer(from, at, Guns.Rarities[t:GetAttribute("Rarity") or 1].color)
	end
	-- face the target (feels responsive, helps mobile)
	local flat = Vector3.new(at.X, root.Position.Y, at.Z)
	if (flat - root.Position).Magnitude &gt; 1 then
		root.CFrame = CFrame.lookAt(root.Position, flat)
	end
end

function GunController.Init()
	local gui = UIController.Gui()
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.UserInputType == Enum.UserInputType.MouseButton1 then
			holding = true
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			holding = false
		end
	end)
	-- big FIRE button (touch) + AUTO toggle (pass)
	local fire = UI.button("FIRE", Theme.Colors.Danger, function() end, {
		AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -150, 1, -150), Size = UDim2.fromOffset(110, 110),
		Visible = UserInputService.TouchEnabled, Parent = gui })
	UI.corner(UDim.new(1, 0)).Parent = fire
	fire.MouseButton1Down:Connect(function()
		holding = true
	end)
	fire.MouseButton1Up:Connect(function()
		holding = false
	end)
	fire.MouseLeave:Connect(function()
		holding = false
	end)
	local auto
	auto = UI.button("AUTO: OFF", Theme.Colors.PanelLight, function()
		local passes = UIController.State.passes or {}
		if not table.find(passes, "AutoFarm") then
			UIController.Toast("Auto Farm pass required — see SHOP", "info")
			UIController.Open("Shop")
			return
		end
		GunController.Auto = not GunController.Auto
		auto.Label.Text = if GunController.Auto then "AUTO: ON" else "AUTO: OFF"
	end, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -86), Size = UDim2.fromOffset(150, 50), Parent = gui })
	auto.Label.TextSize = 18

	Net.listen("Shot", function(shooter: Player, to: Vector3)
		local char = shooter.Character
		local t = char and char:FindFirstChildOfClass("Tool")
		local from = muzzlePos(t, char)
		if from and (from - Workspace.CurrentCamera.CFrame.Position).Magnitude &lt; 150 then
			tracer(from, to, Guns.Rarities[(t and t:GetAttribute("Rarity")) or 1].color)
		end
	end)
	RunService.Heartbeat:Connect(step)
end

return GunController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003E"><Properties><string name="Name">HudController</string><ProtectedString name="Source">-- Training HUD: Power + gain/s, TRAIN toggle, x2 Pulse pop-up button, boost timers, announcements,
-- loot/damage popups, gate unlocking (local CanCollide), next-zone hint.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Theme = require(Shared.Theme)
local Net = require(Shared.Net)
local Zones = require(Shared.Config.Zones)
local Materials = require(Shared.Config.Materials)
local UI = require(script.Parent.Parent.UIKit)
local W = require(script.Parent.Parent.Widgets)
local State = require(script.Parent.Parent.ClientState)
local UIController = require(script.Parent.UIController)

local C = Theme.Colors

local Hud = {}

local powerLabel, gainLabel, trainBtn, pulseBtn, boostLabel, hintLabel, banner

local function pop(gui: GuiObject, s: number)
	local sc = gui:FindFirstChildOfClass("UIScale") or UI.new("UIScale", { Parent = gui })
	sc.Scale = s
	TweenService:Create(sc, Theme.Tween, { Scale = 1 }):Play()
end

function Hud.Announce(text: string)
	banner.Text = text
	banner.TextTransparency = 0
	banner.Visible = true
	pop(banner, 1.3)
	task.delay(4, function()
		if banner.Text == text then
			TweenService:Create(banner, TweenInfo.new(0.5), { TextTransparency = 1 }):Play()
		end
	end)
end

local function floatText(worldPos: Vector3, text: string, color: Color3, size: number)
	local anchor = Instance.new("Part")
	anchor.Anchored, anchor.CanCollide, anchor.CanQuery, anchor.CanTouch, anchor.Transparency = true, false, false, false, 1
	anchor.Size = Vector3.one
	anchor.Position = worldPos + Vector3.new(math.random(-15, 15) / 10, 2, math.random(-15, 15) / 10)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(160, size + 10)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 120
	local l = UI.label(text, size, { Size = UDim2.fromScale(1, 1), TextColor3 = color, Parent = bb })
	bb.Parent = anchor
	anchor.Parent = Workspace
	TweenService:Create(bb, TweenInfo.new(0.9, Enum.EasingStyle.Quad), { StudsOffset = Vector3.new(0, 3, 0) }):Play()
	TweenService:Create(l, TweenInfo.new(0.9), { TextTransparency = 1 }):Play()
	task.delay(1, function()
		anchor:Destroy()
	end)
end

local function updateGates()
	local power = State.Power()
	local map = Workspace:FindFirstChild("Map")
	local zones = map and map:FindFirstChild("Zones")
	if not zones then
		return
	end
	for _, z in ipairs(Zones) do
		local zm = zones:FindFirstChild(z.id)
		local gate = zm and zm:FindFirstChild("Gate") :: BasePart?
		if gate then
			local open = power &gt;= z.powerReq
			gate.CanCollide = not open -- local only: server still bounces under-powered players
			gate.Transparency = if open then 0.85 else 0.35
			local tag = gate:FindFirstChild("LockTag") :: BillboardGui?
			if not tag then
				tag = Instance.new("BillboardGui")
				tag.Name = "LockTag"
				tag.Size = UDim2.fromOffset(240, 60)
				tag.StudsOffset = Vector3.new(0, gate.Size.Y / 2 + 3, 0)
				tag.MaxDistance = 150
				UI.label("", 26, { Name = "L", Size = UDim2.fromScale(1, 1), Parent = tag })
				tag.Parent = gate
			end
			local l = (tag :: BillboardGui):FindFirstChild("L") :: TextLabel
			l.Text = if open then "✔ " .. z.name else ("🔒 %s\n%s Power"):format(z.name, W.short(z.powerReq))
			l.TextColor3 = if open then C.Primary else C.Gold
		end
	end
end

local function nextZoneHint()
	local power = State.Power()
	for _, z in ipairs(Zones) do
		if power &lt; z.powerReq then
			hintLabel.Text = ("Next: %s at %s Power (%d%%)"):format(z.name, W.short(z.powerReq), math.floor(power / z.powerReq * 100))
			return
		end
	end
	hintLabel.Text = "All zones unlocked — try Rebirth!"
end

function Hud.Init()
	local gui = UIController.Gui()
	-- Power panel (top centre)
	local panel = UI.panel({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 8), Size = UDim2.fromOffset(340, 86), BackgroundColor3 = C.Bg, Parent = gui })
	UI.gradient(C.Panel, C.Bg).Parent = panel
	powerLabel = UI.label("⚡ 0", 34, { Position = UDim2.fromOffset(0, 4), Size = UDim2.new(1, 0, 0, 40), TextColor3 = C.Energy, Parent = panel })
	gainLabel = UI.label("+0 /s", 16, { Font = Theme.FontBody, Position = UDim2.fromOffset(0, 44), Size = UDim2.new(1, 0, 0, 18), TextColor3 = C.TextDim, Parent = panel })
	hintLabel = UI.label("", 13, { Font = Theme.FontBody, Position = UDim2.fromOffset(0, 64), Size = UDim2.new(1, 0, 0, 16), TextColor3 = C.Gold, Parent = panel })

	-- TRAIN toggle + boost (bottom centre)
	trainBtn = UI.button("TRAINING: ON", C.Energy, function()
		Net.send("SetTraining", not State.Train.training)
	end, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -16), Size = UDim2.fromOffset(220, 56), Parent = gui })
	boostLabel = UI.label("", 16, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -76), Size = UDim2.fromOffset(400, 20), TextColor3 = C.Gold, Parent = gui })

	-- x2 pulse button (pops in at random spots on the right side)
	pulseBtn = UI.button("x2!", C.Forge, function()
		Net.send("PulseTap")
		pulseBtn.Visible = false
		W.flash(gui, C.Forge)
	end, { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(130, 130), Visible = false, ZIndex = 10, Parent = gui })
	pulseBtn.Label.TextSize = 48
	UI.corner(UDim.new(1, 0)).Parent = pulseBtn

	banner = UI.label("", 30, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 104), Size = UDim2.fromOffset(900, 40), TextColor3 = C.Gold, Visible = false, Parent = gui })

	Net.listen("PulseOffer", function(seconds)
		pulseBtn.Position = UDim2.fromScale(0.55 + math.random() * 0.3, 0.3 + math.random() * 0.35)
		pulseBtn.Visible = true
		pop(pulseBtn, 0.3)
		local spin = TweenService:Create(pulseBtn, TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Rotation = 8 })
		spin:Play()
		task.delay(seconds, function()
			spin:Cancel()
			pulseBtn.Rotation = 0
			pulseBtn.Visible = false
		end)
	end)

	State.TrainChanged:Connect(function(t)
		trainBtn.Label.Text = if t.training then "TRAINING: ON" else "TRAINING: OFF"
		gainLabel.Text = ("+%s /s   x%.2f"):format(W.short(t.gain), t.mult)
		local parts = {}
		if t.pulseLeft &gt; 0 then
			table.insert(parts, ("x2 PULSE %ds"):format(math.ceil(t.pulseLeft)))
		end
		if t.boostLeft &gt; 0 then
			table.insert(parts, ("x3 BOOST %dm"):format(math.ceil(t.boostLeft / 60)))
		end
		boostLabel.Text = table.concat(parts, "   ")
	end)

	Net.listen("Announce", Hud.Announce)

	Net.listen("Loot", function(pos: Vector3, loot)
		local y = 0
		if loot.coins and loot.coins &gt; 0 then
			floatText(pos + Vector3.new(0, y, 0), "+" .. W.short(loot.coins) .. " 🪙", C.Gold, 22)
			y += 1.5
		end
		if loot.power and loot.power &gt; 0 then
			floatText(pos + Vector3.new(0, y, 0), "+" .. W.short(loot.power) .. " ⚡", C.Energy, 20)
			y += 1.5
		end
		for mat, n in pairs(loot.mats or {}) do
			local def = Materials[mat]
			if def then
				floatText(pos + Vector3.new(0, y, 0), ("+%d %s %s"):format(n, def.glyph, def.name), def.color, 18)
				y += 1.5
			end
		end
		if loot.rank then
			Hud.Announce(("World Boss — your rank #%d"):format(loot.rank))
		end
	end)
	Net.listen("Hit", function(pos: Vector3, dmg: number)
		floatText(pos, W.short(dmg), Color3.new(1, 1, 1), 18)
	end)

	-- power ticker
	local shown = 0
	task.spawn(function()
		local t = 0
		while true do -- lint-ok (task.wait)
			task.wait(0.1)
			local target = State.Power()
			shown += (target - shown) * 0.35
			if math.abs(target - shown) &lt; 1 then
				shown = target
			end
			powerLabel.Text = "⚡ " .. W.short(shown)
			t += 1
			if t % 10 == 0 then
				updateGates()
				nextZoneHint()
			end
		end
	end)
end

return Hud
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003F"><Properties><string name="Name">InventoryController</string><ProtectedString name="Source">-- Inventory: guns / armor (equip, salvage), materials, collection Index. Plus Rebirth + Codes windows.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Theme = require(Shared.Theme)
local Net = require(Shared.Net)
local Guns = require(Shared.Config.Guns)
local Materials = require(Shared.Config.Materials)
local Monsters = require(Shared.Config.Monsters)
local Pets = require(Shared.Config.Pets)
local UI = require(script.Parent.Parent.UIKit)
local W = require(script.Parent.Parent.Widgets)
local State = require(script.Parent.Parent.ClientState)
local UIController = require(script.Parent.UIController)
local Forge = require(script.Parent.ForgeController)

local C = Theme.Colors
local Inv = {}
local body, tab = nil, "GUNS"
local GLYPH = { pistol = "🔫", smg = "🔫", shotgun = "🔫", rifle = "🔫", blaster = "✦", railgun = "⚡", helmet = "⛑", vest = "🦺", boots = "👢" }

local function isEquipped(uid: string): boolean
	local e = State.Inv.equipped
	return e.gun == uid or e.helmet == uid or e.vest == uid or e.boots == uid
end

local function renderGear(kind: string)
	W.grid(body, Vector2.new(140, 170))
	local list = {}
	for uid, it in pairs(State.Inv.items) do
		if it.kind == kind then
			table.insert(list, { uid = uid, it = it })
		end
	end
	table.sort(list, function(a, b)
		local va = a.it.dmg or a.it.hp or 0
		local vb = b.it.dmg or b.it.hp or 0
		return va &gt; vb
	end)
	for i, e in ipairs(list) do
		local it = e.it
		local name = if kind == "gun" then Guns.Types[it.id].name else Guns.Armor[it.id].name
		local eq = isEquipped(e.uid)
		local card = W.card(body, i, it.rarity, GLYPH[it.id] or "★", ("%s T%d"):format(name, it.tier), Forge.StatText(it),
			if eq then "EQUIPPED" else "EQUIP", function()
				if not eq then
					Net.send("Equip", e.uid)
				end
			end, if eq then "ON" else nil)
		if not eq then
			local s = UI.button("♻", C.Danger, function()
				Net.send("Salvage", e.uid)
			end, { Size = UDim2.fromOffset(28, 28), Position = UDim2.new(1, -30, 0, 2), Parent = card })
			s.Label.TextSize = 14
		end
	end
	if #list == 0 then
		UI.label("Nothing yet — craft at the Forge!", 18, { Size = UDim2.fromOffset(560, 30), Parent = body })
	end
end

local function renderMats()
	W.grid(body, Vector2.new(140, 120))
	local i = 0
	for id, n in pairs(State.Inv.materials) do
		local def = Materials[id]
		if def then
			i += 1
			W.card(body, def.rarity * 100 + i, def.rarity, def.glyph, def.name, "x" .. W.short(n))
		end
	end
end

local function renderIndex()
	UIController.List(body)
	local idx = State.Inv.index
	local function count(t)
		local n = 0
		for _ in pairs(t or {}) do
			n += 1
		end
		return n
	end
	local totalGuns = #Guns.TypeOrder * #Guns.Rarities
	local totalPets, totalMon = 0, 0
	for _ in pairs(Pets.Pets) do
		totalPets += 1
	end
	for _ in pairs(Monsters) do
		totalMon += 1
	end
	UIController.Row(body, 1, "Guns discovered", ("%d / %d"):format(count(idx.guns), totalGuns), "", C.Panel, false, function() end, count(idx.guns) / totalGuns)
	UIController.Row(body, 2, "Pets discovered", ("%d / %d"):format(count(idx.pets), totalPets), "", C.Panel, false, function() end, count(idx.pets) / totalPets)
	UIController.Row(body, 3, "Monsters defeated", ("%d / %d"):format(count(idx.monsters), totalMon), "", C.Panel, false, function() end, count(idx.monsters) / totalMon)
	local o = 3
	for _, typeId in ipairs(Guns.TypeOrder) do
		o += 1
		local have = {}
		for r = 1, #Guns.Rarities do
			table.insert(have, if idx.guns[typeId .. "_" .. r] then "★" else "☆")
		end
		UIController.Row(body, o, Guns.Types[typeId].name, table.concat(have, " "), "", C.Panel, false, function() end)
	end
end

local function render()
	if not body then
		return
	end
	W.clear(body)
	if tab == "GUNS" then
		renderGear("gun")
	elseif tab == "ARMOR" then
		renderGear("armor")
	elseif tab == "MATS" then
		renderMats()
	else
		renderIndex()
	end
end

local function rebirthWindow()
	local _, rb = UIController.MakeWindow("Rebirth", "REBIRTH", C.Gold)
	UIController.List(rb)
	local function draw()
		UIController.Clear(rb)
		local info = Net.invoke("RebirthInfo")
		if not info then
			return
		end
		local ok = info.power &gt;= info.cost
		UIController.Row(rb, 1, ("Rebirth %d → %d"):format(info.rebirths, info.rebirths + 1),
			("Training x%.2f → x%.2f  •  Resets Power + Coins, keeps items &amp; pets"):format(info.now, info.after),
			"REBIRTH", C.Gold, ok, function()
				if Net.invoke("Rebirth") then
					UIController.Close("Rebirth")
				end
			end, info.power / info.cost)
		UIController.Row(rb, 2, "Requirement", ("%s / %s Power"):format(W.short(info.power), W.short(info.cost)), "", C.Panel, false, function() end)
	end
	Inv.DrawRebirth = draw
end

local function codesWindow()
	local win = UIController.MakeWindow("Codes", "CODES", C.Energy)
	local box = UI.new("TextBox", { PlaceholderText = "Enter code", Text = "", Font = Theme.Font, TextSize = 26, TextColor3 = C.Text, BackgroundColor3 = C.Bg,
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 120), Size = UDim2.fromOffset(360, 56), ClearTextOnFocus = false, Parent = win })
	UI.corner().Parent = box
	UI.stroke().Parent = box
	local res = UI.label("", 20, { Position = UDim2.fromOffset(0, 270), Size = UDim2.new(1, 0, 0, 30), Parent = win })
	UI.button("REDEEM", C.Primary, function()
		local r = Net.invoke("Redeem", box.Text)
		res.Text = if r == "OK" then "✔ Redeemed!" else tostring(r)
		res.TextColor3 = if r == "OK" then C.Primary else C.Danger
	end, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 196), Size = UDim2.fromOffset(220, 56), Parent = win })
end

local function gemWindow()
	local GemShop = require(Shared.Config.GemShop)
	local _, gb = UIController.MakeWindow("Gems", "GEM SHOP", Color3.fromRGB(181, 108, 255))
	UIController.List(gb)
	for i, it in ipairs(GemShop) do
		UIController.Row(gb, i, it.name, it.desc, ("💎 %d"):format(it.gems), Color3.fromRGB(181, 108, 255), true, function()
			Net.invoke("GemBuy", it.key)
		end)
	end
end

function Inv.Init()
	local win, b = UIController.MakeWindow("Inventory", "INVENTORY", C.Energy)
	body = b
	local select = W.tabs(win, b, { "GUNS", "ARMOR", "MATS", "INDEX" }, function(name)
		tab = name
		render()
	end)
	UI.button("♻ SALVAGE COMMONS", C.Danger, function()
		Net.send("SalvageAllCommon")
	end, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -60, 0, 52), Size = UDim2.fromOffset(200, 40), Parent = win }).Label.TextSize = 14
	UIController.AddMenuButton(6, "BAG", C.Energy, "Inventory")
	State.InvChanged:Connect(function()
		if UIController.IsOpen("Inventory") then
			render()
		end
	end)
	select("GUNS")
	rebirthWindow()
	codesWindow()
	gemWindow()
	UIController.AddMenuButton(11, "GEMS", Color3.fromRGB(181, 108, 255), "Gems")
	UIController.AddMenuButton(9, "REBIRTH", C.Gold, "Rebirth").Activated:Connect(function()
		task.defer(Inv.DrawRebirth)
	end)
end

return Inv
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000040"><Properties><string name="Name">MinigameController</string><ProtectedString name="Source">-- Training-break minigames (play while AFK-training): Target Rush, Reload Rhythm, Lucky Crate.
-- Also exports the timing-bar widget reused by the Forge assembly minigame.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage.Shared
local Theme = require(Shared.Theme)
local Net = require(Shared.Net)
local Minigames = require(Shared.Config.Minigames)
local Materials = require(Shared.Config.Materials)
local UI = require(script.Parent.Parent.UIKit)
local W = require(script.Parent.Parent.Widgets)
local UIController = require(script.Parent.UIController)

local C = Theme.Colors
local MG = { Busy = false }

local function resultText(res): string
	if not res then
		return "No reward"
	end
	local parts = {}
	if res.power and res.power &gt; 0 then
		table.insert(parts, "+" .. W.short(res.power) .. " ⚡ Power")
	end
	if res.coins and res.coins &gt; 0 then
		table.insert(parts, "+" .. W.short(res.coins) .. " 🪙")
	end
	if res.gems then
		table.insert(parts, "+" .. res.gems .. " 💎")
	end
	if res.mat and Materials[res.mat] then
		table.insert(parts, ("+%d %s"):format(res.amount, Materials[res.mat].name))
	end
	return if #parts &gt; 0 then table.concat(parts, "\n") else "Better luck next time!"
end

local function showResult(box: Frame, close: () -&gt; (), title: string, res)
	for _, ch in ipairs(box:GetChildren()) do
		if ch.Name == "Play" then
			ch:Destroy()
		end
	end
	UI.label(title, 34, { Position = UDim2.fromOffset(0, 90), Size = UDim2.new(1, 0, 0, 40), TextColor3 = C.Gold, Parent = box })
	UI.label(resultText(res), 24, { Position = UDim2.fromOffset(0, 150), Size = UDim2.new(1, 0, 0, 120), Parent = box })
	UI.button("NICE!", C.Primary, function()
		close()
		MG.Busy = false
	end, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -20), Size = UDim2.fromOffset(200, 56), Parent = box })
end

-- Timing bar: needle sweeps; tap when inside the gold zone. Calls onHit(perfect: boolean) per tap.
function MG.TimingBar(parent: Frame, y: number, speed: number, zoneWidth: number, onHit: (boolean) -&gt; ())
	local bar = UI.new("Frame", { Name = "Play", BackgroundColor3 = C.Bg, Position = UDim2.new(0.1, 0, 0, y), Size = UDim2.new(0.8, 0, 0, 34), Parent = parent }, { UI.corner(UDim.new(0, 8)), UI.stroke() })
	local zone = UI.new("Frame", { BackgroundColor3 = C.Gold, Size = UDim2.fromScale(zoneWidth, 1), Parent = bar }, { UI.corner(UDim.new(0, 8)) })
	local needle = UI.new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.new(0, 6, 1, 10), Position = UDim2.fromScale(0, -0.15), Parent = bar })
	local x, dir = 0, 1
	local function newZone()
		zone.Position = UDim2.fromScale(math.random() * (1 - zoneWidth), 0)
	end
	newZone()
	local conn = RunService.RenderStepped:Connect(function(dt) -- lint-ok (one needle)
		x += dir * dt * speed
		if x &gt;= 1 or x &lt;= 0 then
			dir = -dir
			x = math.clamp(x, 0, 1)
		end
		needle.Position = UDim2.new(x, -3, -0.15, 0)
	end)
	local function tap()
		local zx = zone.Position.X.Scale
		local perfect = x &gt;= zx and x &lt;= zx + zoneWidth
		zone.BackgroundColor3 = if perfect then C.Primary else C.Danger
		task.delay(0.15, function()
			zone.BackgroundColor3 = C.Gold
			newZone()
		end)
		onHit(perfect)
	end
	return tap, function()
		conn:Disconnect()
	end
end

local function targetRush(box: Frame, duration: number, done: (number) -&gt; ())
	local area = UI.new("Frame", { Name = "Play", BackgroundTransparency = 1, Position = UDim2.fromOffset(20, 100), Size = UDim2.new(1, -40, 1, -120), Parent = box })
	local scoreL = UI.label("0", 26, { Name = "Play", Position = UDim2.fromOffset(0, 58), Size = UDim2.new(1, 0, 0, 30), TextColor3 = C.Gold, Parent = box })
	local score, running = 0, true
	local function spawnTarget()
		if not running then
			return
		end
		local t = UI.button("🎯", C.Danger, function() end, { Size = UDim2.fromOffset(64, 64), Position = UDim2.fromScale(math.random() * 0.88, math.random() * 0.8), Parent = area })
		UI.corner(UDim.new(1, 0)).Parent = t
		local hit = false
		t.Activated:Connect(function()
			if hit then
				return
			end
			hit = true
			score += 1
			scoreL.Text = tostring(score)
			t:Destroy()
			spawnTarget()
		end)
		task.delay(1.1, function()
			if not hit and t.Parent then
				t:Destroy()
				spawnTarget()
			end
		end)
	end
	spawnTarget()
	spawnTarget()
	task.delay(duration, function()
		running = false
		done(score)
	end)
end

local function reloadRhythm(box: Frame, duration: number, maxScore: number, done: (number) -&gt; ())
	local score, taps = 0, 0
	local scoreL = UI.label("0 / " .. maxScore, 26, { Name = "Play", Position = UDim2.fromOffset(0, 58), Size = UDim2.new(1, 0, 0, 30), TextColor3 = C.Gold, Parent = box })
	local tap, stop = MG.TimingBar(box, 170, 1.4, 0.16, function(perfect)
		taps += 1
		if perfect then
			score += 1
		end
		scoreL.Text = ("%d / %d"):format(score, maxScore)
	end)
	local btn = UI.button("RELOAD!", C.Energy, function()
		if taps &lt; maxScore + 5 then
			tap()
		end
	end, { Name = "Play", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 240), Size = UDim2.fromOffset(240, 70), Parent = box })
	btn.Label.TextSize = 30
	task.delay(duration, function()
		stop()
		done(math.min(score, maxScore))
	end)
end

local function luckyCrate(box: Frame, done: (number) -&gt; ())
	local row = UI.new("Frame", { Name = "Play", BackgroundTransparency = 1, Position = UDim2.fromOffset(40, 120), Size = UDim2.new(1, -80, 0, 180), Parent = box })
	UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 24), Parent = row })
	local picked = false
	for _ = 1, 3 do
		local b = UI.button("📦", C.Gold, function()
			if picked then
				return
			end
			picked = true
			done(1)
		end, { Size = UDim2.fromOffset(150, 150), Parent = row })
		b.Label.TextSize = 70
		TweenService:Create(b, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Rotation = 6 }):Play()
	end
end

function MG.Play(name: string)
	local cfg = Minigames[name]
	if not cfg or MG.Busy then
		return
	end
	local res = Net.invoke("MinigameStart", name)
	if not res or not res.ok then
		UIController.Toast(res and res.wait and ("Ready in %ds"):format(res.wait) or "Not available", "info")
		return
	end
	MG.Busy = true
	local box, close = W.modal(UIController.Gui(), cfg.name, cfg.color)
	UI.label(cfg.desc, 18, { Name = "Play", Font = Theme.FontBody, Position = UDim2.fromOffset(0, 60), Size = UDim2.new(1, 0, 0, 0), TextColor3 = C.TextDim, Parent = box })
	local function finish(score)
		local out = Net.invoke("MinigameEnd", score)
		showResult(box, close, if name == "LuckyCrate" then "YOU GOT" else ("SCORE %d"):format(score), out)
	end
	if name == "TargetRush" then
		targetRush(box, res.duration, finish)
	elseif name == "ReloadRhythm" then
		reloadRhythm(box, res.duration, res.maxScore, finish)
	else
		luckyCrate(box, finish)
	end
end

function MG.Init()
	-- quick-access minigame menu (also opened by booths in the hub)
	local _, body = UIController.MakeWindow("Minigames", "TRAINING GAMES", C.Forge)
	UIController.List(body)
	local function render()
		UIController.Clear(body)
		local cds = Net.invoke("MinigameCooldowns") or {}
		local i = 0
		for key, cfg in pairs(Minigames) do
			i += 1
			local cd = cds[key] or 0
			UIController.Row(body, i, cfg.name, cfg.desc, if cd &gt; 0 then (cd .. "s") else "PLAY", cfg.color, cd &lt;= 0, function()
				UIController.Close("Minigames")
				MG.Play(key)
			end)
		end
	end
	local btn = UIController.AddMenuButton(4, "GAMES", C.Forge, "Minigames")
	btn.Activated:Connect(function()
		task.defer(render)
	end)
	MG.Render = render
end

return MG
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000041"><Properties><string name="Name">MonsterController</string><ProtectedString name="Source">-- Moves monster models locally from server segments (zero physics/network per frame), HP bars,
-- death poofs, world-boss slam telegraph. Also exposes targeting queries for GunController.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Net = require(ReplicatedStorage.Shared.Net)
local Theme = require(ReplicatedStorage.Shared.Theme)
local UI = require(script.Parent.Parent.UIKit)
local Effects = require(script.Parent.EffectsController)

local MonsterController = {}
type Rec = { model: Model, size: number, bar: Frame?, last: Vector3 }
local tracked: { [Model]: Rec } = {}

local function pos(m: Model): Vector3
	local from, to = m:GetAttribute("From"), m:GetAttribute("To")
	local t0, dur = m:GetAttribute("T0"), m:GetAttribute("Dur")
	if typeof(from) ~= "Vector3" or typeof(to) ~= "Vector3" then
		return m:GetPivot().Position
	end
	if type(dur) ~= "number" or dur &lt;= 0 then
		return to
	end
	local a = math.clamp((Workspace:GetServerTimeNow() - t0) / dur, 0, 1)
	return from:Lerp(to, a)
end
MonsterController.Pos = pos

function MonsterController.Alive(): { Model }
	local out = {}
	for m in pairs(tracked) do
		if (m:GetAttribute("HP") or 0) &gt; 0 then
			table.insert(out, m)
		end
	end
	return out
end

local function poof(at: Vector3, size: number, color: Color3)
	if Effects.LowFx then
		return
	end
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
	p.Shape = Enum.PartType.Ball
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Size = Vector3.one * size * 0.6
	p.Position = at
	p.Parent = Workspace
	TweenService:Create(p, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { Size = Vector3.one * size * 1.8, Transparency = 1 }):Play()
	task.delay(0.4, function()
		p:Destroy()
	end)
end

local function track(m: Instance)
	if not m:IsA("Model") or tracked[m] then
		return
	end
	local size = m:GetAttribute("Size") or 4
	local root = m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart")
	local rec: Rec = { model = m, size = size, last = pos(m) }
	if root then
		local bb = Instance.new("BillboardGui")
		bb.Size = UDim2.fromOffset(if m:GetAttribute("Boss") then 260 else 130, 34)
		bb.StudsOffset = Vector3.new(0, size * 0.75 + 1, 0)
		bb.MaxDistance = if m:GetAttribute("Boss") then 250 else 90
		UI.label(tostring(m:GetAttribute("Name") or "?"), 14, { Size = UDim2.new(1, 0, 0, 16), TextColor3 = if m:GetAttribute("Boss") then Theme.Colors.Gold else Color3.new(1, 1, 1), Parent = bb })
		local back = UI.new("Frame", { BackgroundColor3 = Color3.fromRGB(20, 16, 30), Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, 0, 0, 10), Parent = bb }, { UI.corner(UDim.new(1, 0)) })
		rec.bar = UI.new("Frame", { BackgroundColor3 = Theme.Colors.Danger, Size = UDim2.fromScale(1, 1), Parent = back }, { UI.corner(UDim.new(1, 0)) })
		bb.Parent = root
	end
	m:GetAttributeChangedSignal("HP"):Connect(function()
		local hp, max = m:GetAttribute("HP") or 0, m:GetAttribute("MaxHP") or 1
		if rec.bar then
			rec.bar.Size = UDim2.fromScale(math.clamp(hp / max, 0, 1), 1)
		end
		if hp &lt;= 0 then
			local col = root and (root :: BasePart).Color or Color3.new(1, 1, 1)
			poof(rec.last, size, col)
		end
	end)
	tracked[m] = rec
end

local function slam(center: Vector3, radius: number, delay: number)
	local ring = Instance.new("Part")
	ring.Anchored, ring.CanCollide, ring.CanQuery, ring.CanTouch = true, false, false, false
	ring.Shape = Enum.PartType.Cylinder
	ring.Material = Enum.Material.Neon
	ring.Color = Theme.Colors.Danger
	ring.Transparency = 0.5
	ring.Size = Vector3.new(0.3, 2, 2)
	ring.CFrame = CFrame.new(center + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90))
	ring.Parent = Workspace
	TweenService:Create(ring, TweenInfo.new(delay, Enum.EasingStyle.Linear), { Size = Vector3.new(0.3, radius * 2, radius * 2) }):Play()
	task.delay(delay, function()
		ring.Transparency = 0.1
		TweenService:Create(ring, TweenInfo.new(0.3), { Transparency = 1 }):Play()
		task.wait(0.35)
		ring:Destroy()
	end)
end

function MonsterController.Init()
	local folder = Workspace:WaitForChild("Monsters", 30)
	if not folder then
		return
	end
	folder.ChildAdded:Connect(track)
	folder.ChildRemoved:Connect(function(m)
		tracked[m :: Model] = nil
	end)
	for _, m in ipairs(folder:GetChildren()) do
		track(m)
	end
	Net.listen("BossSlam", slam)

	local cam = Workspace.CurrentCamera
	local player = Players.LocalPlayer
	RunService.Heartbeat:Connect(function()
		local camPos = cam.CFrame.Position
		local char = player.Character
		local me = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		local t = os.clock()
		for m, rec in pairs(tracked) do
			local p = pos(m)
			if (p - camPos).Magnitude &lt; 260 then
				local dir = p - rec.last
				local look
				if me and (me.Position - p).Magnitude &lt; 40 then
					look = Vector3.new(me.Position.X, p.Y, me.Position.Z)
				elseif dir.Magnitude &gt; 0.01 then
					look = p + Vector3.new(dir.X, 0, dir.Z)
				end
				local bob = math.abs(math.sin(t * 6 + rec.size)) * rec.size * 0.12
				local at = p + Vector3.new(0, bob, 0)
				m:PivotTo(if look and (look - p).Magnitude &gt; 0.05 then CFrame.lookAt(at, Vector3.new(look.X, at.Y, look.Z)) else CFrame.new(at))
			end
			rec.last = p
		end
	end)
end

return MonsterController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000042"><Properties><string name="Name">PetsController</string><ProtectedString name="Source">-- Fusion Altar (odds always visible) + hatch reveal, pet inventory (equip/best/combine),
-- and client-side pet followers for every player (server only stores ids).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Theme = require(Shared.Theme)
local Net = require(Shared.Net)
local Pets = require(Shared.Config.Pets)
local Guns = require(Shared.Config.Guns)
local Materials = require(Shared.Config.Materials)
local UI = require(script.Parent.Parent.UIKit)
local W = require(script.Parent.Parent.Widgets)
local State = require(script.Parent.Parent.ClientState)
local UIController = require(script.Parent.UIController)
local Effects = require(script.Parent.EffectsController)

local C = Theme.Colors
local PetsC = {}
local body, tab = nil, "FUSE"
local LVL = { [0] = "", [1] = "Golden ", [2] = "Rainbow " }

local function oddsText(core): string
	local total = 0
	for _, w in pairs(core.odds) do
		total += w
	end
	local parts = {}
	for id, w in pairs(core.odds) do
		table.insert(parts, { t = ("%s %.1f%%"):format(Pets.Pets[id].name, w / total * 100), w = w })
	end
	table.sort(parts, function(a, b)
		return a.w &gt; b.w
	end)
	local out = {}
	for _, p in ipairs(parts) do
		table.insert(out, p.t)
	end
	return table.concat(out, " • ")
end

local function hatch(core)
	local res = Net.invoke("Fuse", core.id)
	if not res or not res.ok then
		UIController.Toast(res and res.err or "Can't fuse", "error")
		return
	end
	UIController.Close("Pets")
	local box, close = W.modal(UIController.Gui(), core.name, C.Forge)
	local egg = UI.icon(nil, "🥚", C.Energy, 140)
	egg.AnchorPoint = Vector2.new(0.5, 0.5)
	egg.Position = UDim2.fromScale(0.5, 0.48)
	egg.Parent = box
	for i = 1, 6 do -- shake, faster and faster
		TweenService:Create(egg, TweenInfo.new(0.12 - i * 0.012), { Rotation = if i % 2 == 0 then 14 else -14 }):Play()
		task.wait(0.14 - i * 0.012)
	end
	local def = Pets.Pets[res.pet]
	W.flash(UIController.Gui(), Guns.Rarities[def.rarity].color)
	egg:Destroy()
	local card = W.card(box, 0, def.rarity, "🐾", def.name, ("%s  •  +%d%% Power  +%d%% Coins"):format(Guns.Rarities[def.rarity].name, def.power * 100, def.coins * 100))
	card.AnchorPoint = Vector2.new(0.5, 0)
	card.Position = UDim2.new(0.5, 0, 0, 80)
	card.Size = UDim2.fromOffset(240, 160)
	local s = UI.new("UIScale", { Scale = 0.2, Parent = card })
	TweenService:Create(s, TweenInfo.new(0.5, Enum.EasingStyle.Back), { Scale = 1.25 }):Play()
	if res.lucky then
		UI.label("LUCKY FORGE upgrade!", 20, { Position = UDim2.fromOffset(0, 300), Size = UDim2.new(1, 0, 0, 24), TextColor3 = C.Gold, Parent = box })
	end
	UI.button("AWESOME!", C.Primary, close, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -16), Size = UDim2.fromOffset(220, 54), Parent = box })
end

local function renderFuse()
	UIController.List(body)
	for i, core in ipairs(Pets.Cores) do
		local inv = State.Inv.materials
		local ok = State.Coins() &gt;= core.coins
		local need = {}
		for id, n in pairs(core.mats) do
			ok = ok and (inv[id] or 0) &gt;= n
			table.insert(need, ("%s %d/%d"):format(Materials[id].glyph, inv[id] or 0, n))
		end
		table.insert(need, "🪙 " .. W.short(core.coins))
		UIController.Row(body, i, core.name .. "  —  " .. table.concat(need, " "), oddsText(core), "FUSE", C.Forge, ok, function()
			hatch(core)
		end)
	end
end

local function renderMine()
	W.grid(body, Vector2.new(140, 170))
	local groups, list = {}, {}
	for uid, it in pairs(State.Inv.items) do
		if it.kind == "pet" and Pets.Pets[it.id] then
			local key = it.id .. ":" .. (it.lvl or 0)
			groups[key] = (groups[key] or 0) + 1
			table.insert(list, { uid = uid, it = it })
		end
	end
	table.sort(list, function(a, b)
		local pa, pb = Pets.Pets[a.it.id], Pets.Pets[b.it.id]
		return pa.power * (1 + (a.it.lvl or 0) * 2) &gt; pb.power * (1 + (b.it.lvl or 0) * 2)
	end)
	local equipped = State.Inv.equipped.pets
	for i, e in ipairs(list) do
		local def = Pets.Pets[e.it.id]
		local lvl = e.it.lvl or 0
		local eq = table.find(equipped, e.uid) ~= nil
		local mult = if lvl == 2 then Pets.RainbowMult elseif lvl == 1 then Pets.GoldenMult else 1
		local card = W.card(body, i, math.min(5, def.rarity + lvl), "🐾", LVL[lvl] .. def.name, ("+%d%% Power"):format(def.power * mult * 100),
			if eq then "UNEQUIP" else "EQUIP", function()
				Net.send("EquipPet", e.uid)
			end, if eq then "ON" else nil)
		local key = e.it.id .. ":" .. lvl
		if lvl &lt; 2 and (groups[key] or 0) &gt;= Pets.CombineCount then
			local b = UI.button("x5↑", C.Gold, function()
				Net.send("CombinePets", e.it.id, lvl)
			end, { Size = UDim2.fromOffset(40, 26), Position = UDim2.new(1, -42, 0, 2), Parent = card })
			b.Label.TextSize = 13
		end
	end
end

local function render()
	if not body then
		return
	end
	W.clear(body)
	if tab == "FUSE" then
		renderFuse()
	else
		renderMine()
	end
end

-------------------------------------------------- followers
local followers: { [Player]: { Model } } = {}

local function petModel(id: string, lvl: number): Model
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local src = assets and assets:FindFirstChild("Pets") and assets.Pets:FindFirstChild(id)
	local m: Model
	if src and src:IsA("Model") then
		m = src:Clone()
	else
		m = Instance.new("Model")
		local def = Pets.Pets[id]
		local body = Instance.new("Part")
		body.Shape = Enum.PartType.Ball
		body.Size = Vector3.one * 1.8
		body.Color = if lvl == 1 then Color3.fromRGB(255, 205, 60) else def.color
		body.Material = if lvl == 2 then Enum.Material.Neon else Enum.Material.SmoothPlastic
		body.Parent = m
		for sx = -1, 1, 2 do
			local eye = Instance.new("Part")
			eye.Shape = Enum.PartType.Ball
			eye.Size = Vector3.one * 0.4
			eye.Color = Color3.new(0.05, 0.05, 0.08)
			eye.CFrame = CFrame.new(sx * 0.35, 0.2, -0.75)
			eye.Parent = m
		end
		m.PrimaryPart = body
	end
	for _, p in ipairs(m:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
		end
	end
	m.Parent = Workspace
	return m
end

local function rebuild(p: Player)
	for _, m in ipairs(followers[p] or {}) do
		m:Destroy()
	end
	followers[p] = {}
	local attr = p:GetAttribute("Pets")
	if type(attr) ~= "string" or attr == "" then
		return
	end
	for entry in attr:gmatch("[^,]+") do
		local id, lvl = entry:match("^(.-):(%d)$")
		if id and Pets.Pets[id] then
			table.insert(followers[p], petModel(id, tonumber(lvl) or 0))
		end
	end
end

local function watch(p: Player)
	p:GetAttributeChangedSignal("Pets"):Connect(function()
		rebuild(p)
	end)
	rebuild(p)
end

function PetsC.Init()
	local win, b = UIController.MakeWindow("Pets", "PETS &amp; FUSION", C.Gold)
	body = b
	local select = W.tabs(win, b, { "FUSE", "MY PETS" }, function(name)
		tab = name
		render()
	end)
	UI.button("EQUIP BEST", C.Primary, function()
		Net.send("EquipBestPets")
	end, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -60, 0, 52), Size = UDim2.fromOffset(160, 40), Parent = win }).Label.TextSize = 14
	UIController.AddMenuButton(7, "PETS", C.Gold, "Pets").Activated:Connect(function()
		task.defer(render)
	end)
	State.InvChanged:Connect(function()
		if UIController.IsOpen("Pets") then
			render()
		end
	end)
	select("FUSE")

	Players.PlayerAdded:Connect(watch)
	for _, p in ipairs(Players:GetPlayers()) do
		watch(p)
	end
	Players.PlayerRemoving:Connect(function(p)
		for _, m in ipairs(followers[p] or {}) do
			m:Destroy()
		end
		followers[p] = nil
	end)
	local cam = Workspace.CurrentCamera
	RunService.Heartbeat:Connect(function(dt)
		local t = os.clock()
		for p, list in pairs(followers) do
			local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root and (root.Position - cam.CFrame.Position).Magnitude &lt; 160 and not Effects.LowFx or (root and p == Players.LocalPlayer) then
				local r = root :: BasePart
				for i, m in ipairs(list) do
					local angle = math.rad(150 + (i - 1) * 30 - (#list - 1) * 15)
					local offset = r.CFrame:VectorToWorldSpace(Vector3.new(math.sin(angle) * 5, 0, -math.cos(angle) * 5))
					local goal = r.Position + offset + Vector3.new(0, -1.5 + math.sin(t * 4 + i) * 0.4, 0)
					local cur = m:GetPivot()
					local pos = cur.Position:Lerp(goal, math.clamp(dt * 8, 0, 1))
					m:PivotTo(CFrame.lookAt(pos, pos + r.CFrame.LookVector))
				end
			end
		end
	end)
end

return PetsC
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000043"><Properties><string name="Name">StationController</string><ProtectedString name="Source">-- Routes hub ProximityPrompts (attribute "Panel", set by StationService) to the right UI.
local ProximityPromptService = game:GetService("ProximityPromptService")

local UIController = require(script.Parent.UIController)
local MG = require(script.Parent.MinigameController)
local Forge = require(script.Parent.ForgeController)
local Inv = require(script.Parent.InventoryController)
local Arena = require(script.Parent.ArenaController)
local Clan = require(script.Parent.ClanController)

local Station = {}

function Station.Init()
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		local panel = prompt:GetAttribute("Panel")
		if type(panel) ~= "string" then
			return
		end
		local game_ = panel:match("^Minigame:(%w+)$")
		if game_ then
			MG.Play(game_)
			return
		end
		UIController.Open(panel)
		if panel == "Forge" then
			Forge.Render()
		elseif panel == "Rebirth" then
			task.spawn(Inv.DrawRebirth)
		elseif panel == "Arena" then
			task.spawn(Arena.Render)
		elseif panel == "Clan" then
			task.spawn(Clan.Render)
		end
	end)
end

return Station
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000044"><Properties><string name="Name">UIController</string><ProtectedString name="Source">-- Builds the whole HUD + menus in code: currency bar, side menu, Shop (passes + products),
-- Rewards (daily + playtime), Quests, Settings, toasts. Mobile-safe via UIScale on viewport.
local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Theme = require(Shared.Theme)
local Net = require(Shared.Net)
local GamePasses = require(Shared.Config.GamePasses)
local Products = require(Shared.Config.Products)
local Economy = require(Shared.Config.Economy)
local Settings = require(Shared.Config.Settings)
local UI = require(script.Parent.Parent.UIKit)

local C = Theme.Colors
local ROBUX = utf8.char(0xE002) -- renders as the Robux icon in Roblox fonts
local player = Players.LocalPlayer
local UIController = { State = { currencies = {}, passes = {}, settings = {} } }

local gui, panels, currencyLabels = nil, {}, {}
local shownCoins = {}

local function sorted(tbl)
	local list = {}
	for k, v in pairs(tbl) do
		table.insert(list, { key = k, def = v })
	end
	table.sort(list, function(a, b)
		return (a.def.order or 99) &lt; (b.def.order or 99)
	end)
	return list
end

local function rewardText(reward)
	local parts = {}
	for cur, n in pairs(reward) do
		table.insert(parts, UI.formatNumber(n) .. " " .. cur)
	end
	return table.concat(parts, " + ")
end

---------------------------------------------------------------- toasts
local toastHolder
function UIController.Toast(text: string, kind: string?)
	local color = if kind == "success" then C.Primary elseif kind == "error" then C.Danger else C.PanelLight
	local t = UI.panel({ Size = UDim2.fromOffset(360, 48), BackgroundColor3 = color, Parent = toastHolder }, {
		UI.label(text, 20, { Size = UDim2.fromScale(1, 1) }),
	})
	UI.pop(t, true)
	task.delay(2.6, function()
		UI.pop(t, false)
		task.wait(0.2)
		t:Destroy()
	end)
end

---------------------------------------------------------------- panels
local function makeWindow(name: string, title: string, accent: Color3)
	local win = UI.panel({
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(640, 420),
		Visible = false,
		Parent = gui,
	})
	UI.gradient(C.Panel, C.Bg).Parent = win
	local header = UI.panel({ Size = UDim2.new(1, 0, 0, 56), BackgroundColor3 = accent, Parent = win }, {
		UI.label(title, 30, { Size = UDim2.fromScale(1, 1) }),
	})
	UI.button("X", C.Danger, function()
		UI.pop(win, false)
	end, { Size = UDim2.fromOffset(48, 48), Position = UDim2.new(1, -52, 0, 4), Parent = header })
	local body = UI.new("ScrollingFrame", {
		Name = "Body",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(12, 68),
		Size = UDim2.new(1, -24, 1, -80),
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = win,
	})
	panels[name] = win
	return win, body
end

local function toggle(name: string)
	for n, p in pairs(panels) do
		if n ~= name and p.Visible then
			UI.pop(p, false)
		end
	end
	local p = panels[name]
	UI.pop(p, not p.Visible)
end

local function buyPass(key, def)
	if def.id == 0 then
		if RunService:IsStudio() then
			Net.send("StudioTestBuy", "pass", key)
		else
			UIController.Toast("Coming soon!", "info")
		end
		return
	end
	MarketplaceService:PromptGamePassPurchase(player, def.id)
end

local function buyProduct(key, def)
	if def.id == 0 then
		if RunService:IsStudio() then
			Net.send("StudioTestBuy", "product", key)
		else
			UIController.Toast("Coming soon!", "info")
		end
		return
	end
	MarketplaceService:PromptProductPurchase(player, def.id)
end

local shopBody
local function buildShop()
	local _, body = makeWindow("Shop", "SHOP", C.Accent)
	shopBody = body
	UI.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(190, 250),
		CellPadding = UDim2.fromOffset(12, 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = body,
	})
end

local function renderShop()
	for _, ch in ipairs(shopBody:GetChildren()) do
		if ch:IsA("GuiObject") then
			ch:Destroy()
		end
	end
	local order = 0
	local function card(title, desc, priceText, color, image, glyph, owned, onBuy, tag)
		order += 1
		local c = UI.panel({ LayoutOrder = order, BackgroundColor3 = C.PanelLight, Parent = shopBody })
		UI.gradient(color:Lerp(C.PanelLight, 0.55), C.Panel).Parent = c
		local ic = UI.icon(image, glyph, color, 76)
		ic.AnchorPoint = Vector2.new(0.5, 0)
		ic.Position = UDim2.new(0.5, 0, 0, 10)
		ic.Parent = c
		UI.label(title, 22, { Position = UDim2.fromOffset(0, 92), Parent = c })
		UI.label(desc, 14, {
			Font = Theme.FontBody,
			TextColor3 = C.TextDim,
			Position = UDim2.fromOffset(8, 120),
			Size = UDim2.new(1, -16, 0, 66),
			TextYAlignment = Enum.TextYAlignment.Top,
			Parent = c,
		})
		if tag then
			UI.panel({ Size = UDim2.fromOffset(96, 24), Position = UDim2.fromOffset(-6, -8), BackgroundColor3 = C.Danger, Rotation = -8, Parent = c }, {
				UI.label(tag, 14, { Size = UDim2.fromScale(1, 1) }),
			})
		end
		local btn = UI.button(owned and "OWNED" or priceText, owned and C.PanelLight or C.Robux, function()
			if not owned then
				onBuy()
			end
		end, { Size = UDim2.new(1, -20, 0, 44), Position = UDim2.new(0, 10, 1, -54), Parent = c })
		btn.Active = not owned
	end
	for _, e in ipairs(sorted(GamePasses)) do
		local owned = table.find(UIController.State.passes, e.key) ~= nil
		card(e.def.name, e.def.desc, ROBUX .. " " .. e.def.price, e.def.color, e.def.icon, "⭐", owned, function()
			buyPass(e.key, e.def)
		end, nil)
	end
	for _, e in ipairs(sorted(Products)) do
		local cur = next(e.def.grant or {}) or "Coins"
		local col = Economy.Currencies[cur] and Economy.Currencies[cur].color or C.Accent
		card(e.def.name, "Instant delivery. Buy as many as you like!", ROBUX .. " " .. e.def.price, col, e.def.icon, cur == "Gems" and "💎" or "🪙", false, function()
			buyProduct(e.key, e.def)
		end, e.def.tag)
	end
end

local rewardsBody, questsBody
local function list(body)
	UI.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = body })
end

local function row(body, order, title, sub, btnText, btnColor, enabled, onClick, progress)
	local r = UI.panel({ LayoutOrder = order, Size = UDim2.new(1, -8, 0, 72), BackgroundColor3 = C.PanelLight, Parent = body })
	UI.label(title, 20, { Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -190, 0, 26), TextXAlignment = Enum.TextXAlignment.Left, Parent = r })
	UI.label(sub, 15, { Font = Theme.FontBody, TextColor3 = C.TextDim, Position = UDim2.fromOffset(14, 38), Size = UDim2.new(1, -190, 0, 22), TextXAlignment = Enum.TextXAlignment.Left, Parent = r })
	if progress then
		local bar = UI.new("Frame", { BackgroundColor3 = C.Bg, Position = UDim2.new(0, 14, 1, -12), Size = UDim2.new(1, -200, 0, 6), Parent = r }, { UI.corner(UDim.new(1, 0)) })
		UI.new("Frame", { BackgroundColor3 = C.Primary, Size = UDim2.fromScale(math.clamp(progress, 0, 1), 1), Parent = bar }, { UI.corner(UDim.new(1, 0)) })
	end
	local b = UI.button(btnText, enabled and btnColor or C.Panel, function()
		if enabled then
			onClick()
		end
	end, { Size = UDim2.fromOffset(160, 50), Position = UDim2.new(1, -170, 0.5, -25), Parent = r })
	b.Active = enabled
end

local function clear(body)
	for _, ch in ipairs(body:GetChildren()) do
		if ch:IsA("GuiObject") then
			ch:Destroy()
		end
	end
end

function UIController.RenderRewards(state)
	clear(rewardsBody)
	local d = state.daily
	row(rewardsBody, 0, "Daily Reward — Day " .. (d.streak + 1), rewardText(d.rewards[d.nextIndex]), d.canClaim and "CLAIM" or "TOMORROW", C.Primary, d.canClaim, function()
		Net.send("ClaimDaily")
	end)
	for i, p in ipairs(state.playtime) do
		local label = p.claimed and "CLAIMED" or (p.ready and "CLAIM" or (p.minutes .. " MIN"))
		row(rewardsBody, i, "Play " .. p.minutes .. " minutes", rewardText(p.reward), label, C.Accent, p.ready and not p.claimed, function()
			Net.send("ClaimPlaytime", i)
		end, state.sessionMinutes / p.minutes)
	end
	panels.Rewards:SetAttribute("Ready", d.canClaim)
end

function UIController.RenderQuests(quests)
	clear(questsBody)
	for i, q in ipairs(quests) do
		local done = q.progress &gt;= q.goal
		row(questsBody, i, q.text, ("%d / %d  •  %s"):format(q.progress, q.goal, rewardText(q.reward)), q.claimed and "DONE" or (done and "CLAIM" or "IN PROGRESS"), C.Primary, done and not q.claimed, function()
			Net.send("ClaimQuest", i)
		end, q.progress / q.goal)
	end
end

local settingsBody
local function renderSettings()
	clear(settingsBody)
	local names = { { "music", "Music" }, { "sfx", "Sound Effects" }, { "lowFx", "Low Graphics Mode (less lag)" } }
	for i, pair in ipairs(names) do
		local key, title = pair[1], pair[2]
		local on = UIController.State.settings[key] == true
		row(settingsBody, i, title, on and "ON" or "OFF", on and "TURN OFF" or "TURN ON", on and C.Danger or C.Primary, true, function()
			UIController.State.settings[key] = not on
			Net.send("SetSetting", key, not on)
			renderSettings()
			UIController.SettingsChanged(UIController.State.settings)
		end)
	end
end
UIController.SettingsChanged = function(_) end -- overwritten by Main

---------------------------------------------------------------- public helpers for genre controllers
local menuFrame
function UIController.AddMenuButton(order: number, text: string, color: Color3, windowName: string)
	local b = UI.button(text, color, function()
		toggle(windowName)
	end, { LayoutOrder = order, Size = UDim2.fromOffset(88, 64), Parent = menuFrame })
	b.Label.TextSize = 16
	return b
end
UIController.MakeWindow = makeWindow
UIController.Toggle = toggle
UIController.Row = row
UIController.Clear = clear
UIController.List = list
function UIController.Open(name: string)
	local p = panels[name]
	if p and not p.Visible then
		toggle(name)
	end
end
function UIController.Close(name: string)
	local p = panels[name]
	if p and p.Visible then
		UI.pop(p, false)
	end
end
function UIController.IsOpen(name: string): boolean
	return panels[name] ~= nil and panels[name].Visible
end
function UIController.Gui(): ScreenGui
	return gui
end

---------------------------------------------------------------- HUD
local function currencyPill(name: string, def, order: number, parent)
	local pill = UI.panel({ LayoutOrder = order, Size = UDim2.fromOffset(190, 46), BackgroundColor3 = C.Bg, Parent = parent })
	local ic = UI.icon(nil, name == "Gems" and "💎" or "🪙", def.color, 40)
	ic.Position = UDim2.fromOffset(3, 3)
	ic.Parent = pill
	currencyLabels[name] = UI.label("0", 24, { Position = UDim2.fromOffset(48, 0), Size = UDim2.new(1, -56, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, Parent = pill })
	shownCoins[name] = 0
end

local function animateCurrency(name: string, target: number)
	local label = currencyLabels[name]
	if not label then
		return
	end
	local from = shownCoins[name] or 0
	shownCoins[name] = target
	if from == target then
		label.Text = UI.formatNumber(target)
		return
	end
	local nv = Instance.new("NumberValue")
	nv.Value = from
	nv.Changed:Connect(function(v)
		label.Text = UI.formatNumber(v)
	end)
	local t = TweenService:Create(nv, TweenInfo.new(0.5, Enum.EasingStyle.Quad), { Value = target })
	t.Completed:Once(function()
		nv:Destroy()
		label.Text = UI.formatNumber(target)
	end)
	t:Play()
	local pill = label.Parent
	local s = pill:FindFirstChildOfClass("UIScale") or UI.new("UIScale", { Parent = pill })
	s.Scale = 1.12
	TweenService:Create(s, Theme.Tween, { Scale = 1 }):Play()
end

function UIController.Apply(state)
	UIController.State = state
	for name, v in pairs(state.currencies or {}) do
		animateCurrency(name, v)
	end
	if shopBody then
		renderShop()
	end
	if settingsBody then
		renderSettings()
	end
end

function UIController.Init()
	gui = UI.new("ScreenGui", {
		Name = "GameUI",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	-- responsive scale: design at 1280x720, scale down on phones
	local scale = UI.new("UIScale", { Parent = gui })
	local function rescale()
		local vp = workspace.CurrentCamera.ViewportSize
		scale.Scale = math.clamp(math.min(vp.X / 1280, vp.Y / 720) * 1.1, 0.55, 1.25)
	end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	rescale()

	-- currency bar (top-left)
	local bar = UI.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 12), Size = UDim2.fromOffset(400, 46), Parent = gui })
	UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = bar })
	local i = 0
	for _, e in ipairs(sorted(Economy.Currencies)) do
		i += 1
		currencyPill(e.key, e.def, i, bar)
	end

	-- side menu (left middle): 2-column grid so genre controllers can add buttons
	local menu = UI.new("Frame", { Name = "Menu", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 12, 0.5, 0), Size = UDim2.fromOffset(186, 460), Parent = gui })
	UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(88, 64), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = menu })
	menuFrame = menu
	UIController.AddMenuButton(1, "SHOP", C.Accent, "Shop")
	local rewardsBtn = UIController.AddMenuButton(2, "REWARDS", C.Primary, "Rewards")
	UIController.AddMenuButton(3, "QUESTS", Color3.fromRGB(90, 150, 255), "Quests")
	UIController.AddMenuButton(99, "SETTINGS", C.PanelLight, "Settings")

	buildShop()
	local _, rb = makeWindow("Rewards", "REWARDS", C.Primary)
	rewardsBody = rb
	list(rb)
	local _, qb = makeWindow("Quests", "DAILY QUESTS", Color3.fromRGB(90, 150, 255))
	questsBody = qb
	list(qb)
	local _, sb = makeWindow("Settings", "SETTINGS", C.PanelLight)
	settingsBody = sb
	list(sb)

	-- "!" badge bounce on rewards when claimable
	local dot = UI.panel({ Size = UDim2.fromOffset(26, 26), Position = UDim2.new(1, -18, 0, -8), BackgroundColor3 = C.Danger, Visible = false, Parent = rewardsBtn }, {
		UI.label("!", 18, { Size = UDim2.fromScale(1, 1) }),
	})
	panels.Rewards:GetAttributeChangedSignal("Ready"):Connect(function()
		dot.Visible = panels.Rewards:GetAttribute("Ready") == true
	end)

	toastHolder = UI.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 70), Size = UDim2.fromOffset(360, 300), Parent = gui })
	UI.new("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center, Parent = toastHolder })

	-- title splash
	local splash = UI.label(Settings.GameName, 64, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.3), Size = UDim2.fromOffset(900, 90), TextColor3 = C.Accent, Parent = gui })
	task.delay(2.5, function()
		TweenService:Create(splash, TweenInfo.new(0.6), { TextTransparency = 1 }):Play()
		TweenService:Create(splash:FindFirstChildOfClass("UIStroke"), TweenInfo.new(0.6), { Transparency = 1 }):Play()
		task.wait(0.7)
		splash:Destroy()
	end)
	renderShop()
end

return UIController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000045"><Properties><string name="Name">ZoneLightingController</string><ProtectedString name="Source">-- Applies the current zone's lighting preset locally and shows a zone-name banner on change.
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local World = require(ReplicatedStorage.Shared.Config.World)
local Zones = require(ReplicatedStorage.Shared.Config.Zones)

local ZoneLightingController = {}

local current: string? = nil
local banner: TextLabel? = nil

local function ensure(className: string, name: string)
	local inst = Lighting:FindFirstChild(name) or Instance.new(className)
	inst.Name = name
	inst.Parent = Lighting
	return inst
end

local function apply(inst: Instance, props, fade: boolean)
	local tweenable = {}
	for k, v in pairs(props or {}) do
		if fade and (typeof(v) == "number" or typeof(v) == "Color3") then
			tweenable[k] = v
		else
			pcall(function()
				(inst :: any)[k] = v
			end)
		end
	end
	if next(tweenable) then
		pcall(function()
			TweenService:Create(inst, TweenInfo.new(1.2), tweenable):Play()
		end)
	end
end

local function applyPreset(name: string)
	local p = World.Presets[name]
	if not p then
		return
	end
	apply(Lighting, p.Lighting, true)
	apply(ensure("Atmosphere", "Atmosphere"), p.Atmosphere, true)
	apply(ensure("BloomEffect", "Bloom"), p.Bloom, true)
	apply(ensure("ColorCorrectionEffect", "ColorCorrection"), p.ColorCorrection, true)
	local rays = ensure("SunRaysEffect", "SunRays")
	rays.Enabled = p.SunRays ~= nil
	apply(rays, p.SunRays, false)
end

local function getBanner(): TextLabel
	if banner and banner.Parent then
		return banner
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "ZoneBanner"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 20
	local t = Instance.new("TextLabel")
	t.AnchorPoint = Vector2.new(0.5, 0.5)
	t.Position = UDim2.fromScale(0.5, 0.22)
	t.Size = UDim2.fromScale(0.6, 0.1)
	t.BackgroundTransparency = 1
	t.Font = Enum.Font.GothamBlack
	t.TextScaled = true
	t.TextColor3 = Color3.fromRGB(255, 255, 255)
	t.TextStrokeColor3 = Color3.fromRGB(22, 20, 42)
	t.TextStrokeTransparency = 0
	t.TextTransparency = 1
	t.Parent = gui
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	banner = t
	return t
end

local function showBanner(text: string, color: Color3)
	local t = getBanner()
	t.Text = string.upper(text)
	t.TextColor3 = color
	t.TextTransparency = 1
	t.Position = UDim2.fromScale(0.5, 0.26)
	TweenService:Create(t, TweenInfo.new(0.4, Enum.EasingStyle.Back), { TextTransparency = 0, Position = UDim2.fromScale(0.5, 0.22) }):Play()
	local mine = text
	task.delay(2.4, function()
		if banner and banner.Text == string.upper(mine) then
			TweenService:Create(banner, TweenInfo.new(0.6), { TextTransparency = 1 }):Play()
		end
	end)
end

-- returns key, preset, display name, color
local function locate(pos: Vector3): (string, string, string, Color3)
	for _, z in ipairs(Zones) do
		if math.abs(pos.X - z.center.X) &lt;= z.size.X / 2 and math.abs(pos.Z - z.center.Z) &lt;= z.size.Z / 2 then
			return z.id, z.preset, z.name, z.color:Lerp(Color3.new(1, 1, 1), 0.35)
		end
	end
	local A = World.Arena
	if math.abs(pos.Z - A.Origin.Z) &lt;= A.Size / 2 + 20 and math.abs(pos.X - A.Origin.X) &lt;= A.Spacing + A.Size / 2 + 20 then
		return "arena", "NeonCity", "PvP Arena", Color3.fromRGB(255, 79, 216)
	end
	return "hub", World.Preset, "Training Hub", Color3.fromRGB(58, 216, 255)
end

function ZoneLightingController.Init()
	local player = Players.LocalPlayer
	while true do -- lint-ok (task.wait)
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			local key, preset, name, color = locate(root.Position)
			if key ~= current then
				local first = current == nil
				current = key
				applyPreset(preset)
				if not first or key ~= "hub" then
					showBanner(name, color)
				end
			end
		end
		task.wait(0.5)
	end
end

return ZoneLightingController
</ProtectedString></Properties></Item></Item><Item class="LocalScript" referent="RBX00000047"><Properties><string name="Name">Main</string><ProtectedString name="Source">-- Client entry: controllers only do presentation; the server owns all game state.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Net = require(ReplicatedStorage.Shared.Net)

local Controllers = script.Parent:WaitForChild("Controllers")
local UIController = require(Controllers.UIController)
local EffectsController = require(Controllers.EffectsController)

local ZoneLightingController = require(Controllers.ZoneLightingController)
local ClientState = require(script.Parent:WaitForChild("ClientState"))
ClientState.Init()
UIController.Init()
task.spawn(ZoneLightingController.Init)
task.spawn(EffectsController.Init)

-- Gun Forge controllers (order = menu button order is set inside each)
for _, name in ipairs({ "HudController", "MonsterController", "GunController", "MinigameController", "ForgeController",
	"InventoryController", "PetsController", "ArenaController", "ClanController", "StationController" }) do
	local ok, err = pcall(function()
		require(Controllers:WaitForChild(name)).Init()
	end)
	if not ok then
		warn("[Client] " .. name .. " failed:", err)
	end
end

UIController.SettingsChanged = function(settings)
	EffectsController.SetLowFx(settings.lowFx == true)
end

Net.listen("DataSync", function(state)
	UIController.Apply(state)
	EffectsController.SetLowFx(state.settings and state.settings.lowFx == true)
end)
Net.listen("Toast", UIController.Toast)
Net.listen("RewardState", UIController.RenderRewards)
Net.listen("QuestState", UIController.RenderQuests)

-- initial pull (in case DataSync fired before listeners connected)
task.spawn(function()
	local state = Net.invoke("GetData")
	if state then
		UIController.Apply(state)
	end
end)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000048"><Properties><string name="Name">UIKit</string><ProtectedString name="Source">-- Code-drawn UI kit: every element is built from Theme tokens so the whole game can be
-- restyled from Shared/Theme.luau. Uses UICorner/UIStroke/UIGradient (no image uploads needed);
-- pass an image id to Icon() to use AI-generated / Blender-rendered art instead.
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Theme = require(ReplicatedStorage.Shared.Theme)

local UI = {}
local C = Theme.Colors

function UI.new(className: string, props: { [string]: any }, children: { Instance }?)
	local inst = Instance.new(className)
	for k, v in pairs(props) do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	if props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

function UI.corner(radius: UDim?)
	return UI.new("UICorner", { CornerRadius = radius or Theme.Corner })
end

function UI.stroke(color: Color3?, thickness: number?)
	return UI.new("UIStroke", {
		Color = color or C.Stroke,
		Thickness = thickness or Theme.StrokeThickness,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function UI.gradient(top: Color3, bottom: Color3)
	return UI.new("UIGradient", { Color = ColorSequence.new(top, bottom), Rotation = 90 })
end

function UI.padding(px: number)
	local u = UDim.new(0, px)
	return UI.new("UIPadding", { PaddingTop = u, PaddingBottom = u, PaddingLeft = u, PaddingRight = u })
end

function UI.label(text: string, size: number, props: { [string]: any }?)
	local p = {
		Text = text,
		Font = Theme.Font,
		TextSize = size,
		TextColor3 = C.Text,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, size + 6),
		TextWrapped = true,
	}
	for k, v in pairs(props or {}) do
		p[k] = v
	end
	local l = UI.new("TextLabel", p)
	UI.new("UIStroke", { Color = C.Stroke, Thickness = 2, Parent = l }) -- text outline = readable on any bg
	return l
end

function UI.panel(props: { [string]: any }, children: { Instance }?)
	local p = { BackgroundColor3 = C.Panel, BorderSizePixel = 0 }
	for k, v in pairs(props) do
		p[k] = v
	end
	local f = UI.new("Frame", p, children)
	UI.corner().Parent = f
	UI.stroke().Parent = f
	return f
end

-- Chunky "candy" button with hover/press scale animation.
function UI.button(text: string, color: Color3, onClick: () -&gt; (), props: { [string]: any }?)
	local p = {
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.fromOffset(160, 52),
	}
	for k, v in pairs(props or {}) do
		p[k] = v
	end
	local b = UI.new("TextButton", p)
	UI.corner().Parent = b
	UI.stroke().Parent = b
	local h, s, v = color:ToHSV()
	UI.gradient(Color3.fromHSV(h, s * 0.85, math.min(1, v * 1.15)), Color3.fromHSV(h, s, v * 0.8)).Parent = b
	local scale = UI.new("UIScale", { Parent = b })
	UI.label(text, 22, { Size = UDim2.fromScale(1, 1), Name = "Label", Parent = b })

	b.MouseEnter:Connect(function()
		TweenService:Create(scale, Theme.Tween, { Scale = 1.06 }):Play()
	end)
	b.MouseLeave:Connect(function()
		TweenService:Create(scale, Theme.Tween, { Scale = 1 }):Play()
	end)
	b.MouseButton1Down:Connect(function()
		TweenService:Create(scale, Theme.TweenFast, { Scale = 0.92 }):Play()
	end)
	b.MouseButton1Up:Connect(function()
		TweenService:Create(scale, Theme.Tween, { Scale = 1.06 }):Play()
	end)
	b.Activated:Connect(onClick)
	return b
end

-- Image icon if an asset id is set, otherwise a code-drawn glossy circle with an emoji/glyph.
function UI.icon(image: string?, glyph: string, color: Color3, size: number)
	if image and image ~= "" and image ~= "rbxassetid://0" then
		return UI.new("ImageLabel", {
			Image = image,
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(size, size),
			ScaleType = Enum.ScaleType.Fit,
		})
	end
	local f = UI.new("Frame", { Size = UDim2.fromOffset(size, size), BackgroundColor3 = Color3.new(1, 1, 1) })
	UI.corner(UDim.new(1, 0)).Parent = f
	UI.stroke(C.Stroke, 2).Parent = f
	local h, s, v = color:ToHSV()
	UI.gradient(Color3.fromHSV(h, s * 0.6, 1), Color3.fromHSV(h, s, v * 0.75)).Parent = f
	UI.label(glyph, math.floor(size * 0.55), { Size = UDim2.fromScale(1, 1), Parent = f })
	return f
end

-- Open/close with pop animation
function UI.pop(gui: GuiObject, open: boolean)
	local scale = gui:FindFirstChildOfClass("UIScale") or UI.new("UIScale", { Parent = gui })
	if open then
		gui.Visible = true
		scale.Scale = 0.6
		TweenService:Create(scale, Theme.Tween, { Scale = 1 }):Play()
	else
		local t = TweenService:Create(scale, Theme.TweenFast, { Scale = 0.6 })
		t.Completed:Once(function()
			gui.Visible = false
		end)
		t:Play()
	end
end

function UI.formatNumber(n: number): string
	n = math.floor(n)
	if n &gt;= 1e9 then
		return ("%.1fB"):format(n / 1e9)
	elseif n &gt;= 1e6 then
		return ("%.1fM"):format(n / 1e6)
	elseif n &gt;= 1e4 then
		return ("%.1fK"):format(n / 1e3)
	end
	local s = tostring(n)
	return (s:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", ""))
end

return UI
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000049"><Properties><string name="Name">Widgets</string><ProtectedString name="Source">-- Higher-level UI pieces built on UIKit (tabs, item cards, popups, number formatting helpers).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Theme = require(ReplicatedStorage.Shared.Theme)
local Guns = require(ReplicatedStorage.Shared.Config.Guns)
local UI = require(script.Parent.UIKit)

local W = {}
local C = Theme.Colors

function W.short(n: number): string
	n = math.floor(n)
	for _, u in ipairs({ { 1e15, "Q" }, { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" } }) do
		if n &gt;= u[1] then
			return (("%.2f%s"):format(n / u[1], u[2]):gsub("%.?0+([A-Z])", "%1"))
		end
	end
	return tostring(n)
end

-- Tab bar inside a window (moves body down). onSelect(name) re-renders the body.
function W.tabs(win: Frame, body: ScrollingFrame, names: { string }, onSelect: (string) -&gt; ())
	local bar = UI.new("Frame", { Name = "Tabs", BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 64), Size = UDim2.new(1, -24, 0, 40), Parent = win })
	UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), Parent = bar })
	body.Position = UDim2.fromOffset(12, 112)
	body.Size = UDim2.new(1, -24, 1, -124)
	local buttons = {}
	local function select(name)
		for n, b in pairs(buttons) do
			b.BackgroundTransparency = if n == name then 0 else 0.5
		end
		onSelect(name)
	end
	for _, n in ipairs(names) do
		buttons[n] = UI.button(n, C.PanelLight, function()
			select(n)
		end, { Size = UDim2.fromOffset(math.floor(600 / #names) - 6, 38), Parent = bar })
		buttons[n].Label.TextSize = 16
	end
	return select
end

function W.grid(body: ScrollingFrame, cell: Vector2)
	UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(cell.X, cell.Y), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = body })
end

function W.clear(body: Instance)
	for _, ch in ipairs(body:GetChildren()) do
		if ch:IsA("GuiObject") or ch:IsA("UIGridLayout") or ch:IsA("UIListLayout") then
			ch:Destroy()
		end
	end
end

-- item card: rarity-coloured gradient + glyph + title/sub + optional button
function W.card(parent: Instance, order: number, rarity: number, glyph: string, title: string, sub: string, btnText: string?, onClick: (() -&gt; ())?, badge: string?)
	local col = Theme.Rarity and Theme.Rarity[rarity] or Guns.Rarities[rarity].color
	local c = UI.panel({ LayoutOrder = order, BackgroundColor3 = C.PanelLight, Parent = parent })
	UI.gradient(col:Lerp(C.Panel, 0.35), C.Panel).Parent = c
	local ic = UI.icon(nil, glyph, col, 52)
	ic.AnchorPoint = Vector2.new(0.5, 0)
	ic.Position = UDim2.new(0.5, 0, 0, 6)
	ic.Parent = c
	UI.label(title, 15, { Position = UDim2.fromOffset(4, 60), Size = UDim2.new(1, -8, 0, 18), Parent = c })
	UI.label(sub, 12, { Font = Theme.FontBody, TextColor3 = C.TextDim, Position = UDim2.fromOffset(4, 80), Size = UDim2.new(1, -8, 0, 30), TextYAlignment = Enum.TextYAlignment.Top, Parent = c })
	if badge then
		UI.panel({ Size = UDim2.fromOffset(58, 20), Position = UDim2.fromOffset(-4, -4), BackgroundColor3 = C.Primary, Parent = c }, {
			UI.label(badge, 12, { Size = UDim2.fromScale(1, 1) }),
		})
	end
	if btnText and onClick then
		local b = UI.button(btnText, C.Primary, onClick, { Size = UDim2.new(1, -12, 0, 30), Position = UDim2.new(0, 6, 1, -36), Parent = c })
		b.Label.TextSize = 14
	end
	return c
end

-- Fullscreen modal used by minigames / forge / hatch. Returns frame + close fn.
function W.modal(gui: ScreenGui, title: string, accent: Color3)
	local dim = UI.new("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, Size = UDim2.fromScale(1, 1), ZIndex = 20, Parent = gui })
	local box = UI.panel({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(620, 420), ZIndex = 21, Parent = dim })
	UI.gradient(C.Panel, C.Bg).Parent = box
	UI.panel({ Size = UDim2.new(1, 0, 0, 52), BackgroundColor3 = accent, Parent = box }, { UI.label(title, 28, { Size = UDim2.fromScale(1, 1) }) })
	UI.pop(box, true)
	local function close()
		dim:Destroy()
	end
	return box, close
end

function W.flash(gui: Instance, color: Color3)
	local f = UI.new("Frame", { BackgroundColor3 = color, BackgroundTransparency = 0.3, Size = UDim2.fromScale(1, 1), ZIndex = 50, Parent = gui })
	TweenService:Create(f, TweenInfo.new(0.5), { BackgroundTransparency = 1 }):Play()
	task.delay(0.6, function()
		f:Destroy()
	end)
end

return W
