}

return {
	Preset = "NeonCity", -- hub look (zones/arena override client-side via ZoneLightingController)
	HubRadius = 80,
	Arena = { Origin = Vector3.new(0, 0, 900), Spacing = 200, Size = 120 }, -- Arena1..3 along X
	Presets = Presets,

	-- Built only when workspace has no "Map" model (i.e. nobody built one in Studio yet).
	-- Lets a fresh template run as a real little level. Units = studs.
	StarterMap = {
		Enabled = false, -- MapService builds the real map
		GroundSize = Vector3.new(400, 4, 400),
		GroundColor = Color3.fromRGB(106, 190, 96),
		GroundMaterial = Enum.Material.Grass,
		-- floating islands / platforms (Position, Size, Color)
		Platforms = {
			{ Vector3.new(60, 12, 0), Vector3.new(30, 3, 30), Color3.fromRGB(120, 200, 255) },
			{ Vector3.new(-50, 18, 40), Vector3.new(24, 3, 24), Color3.fromRGB(255, 170, 90) },
			{ Vector3.new(0, 26, -70), Vector3.new(36, 3, 20), Color3.fromRGB(200, 130, 255) },
		},
		Decorations = 60, -- trees/rocks scattered (uses ReplicatedStorage.Assets models if present)
	},
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001A"><Properties><string name="Name">Zones</string><ProtectedString name="Source">-- LINEAR LANE: 5 stages chained on ONE long straight road leaving the hub towards -Z.
-- Hub (origin) -&gt; Gate1 -&gt; Stage 1 (300 studs) -&gt; Gate2 -&gt; Stage 2 -&gt; ... -&gt; Stage 5 (boss at each end).
-- center/size = the stage rectangle (width 48 along X, length 300 along Z). gatePos = gate at the stage
-- start (hub side). bossPos = far end. portalPos = return/teleport pad at the stage start.
local LANE_WIDTH, STAGE_LEN, GAP, HUB_EDGE = 48, 300, 30, 90
local function stage(i: number)
	local startZ = -(HUB_EDGE + (i - 1) * (STAGE_LEN + GAP))
	local endZ = startZ - STAGE_LEN
	return Vector3.new(0, 0, (startZ + endZ) / 2), Vector3.new(LANE_WIDTH, 0, STAGE_LEN), Vector3.new(0, 0, startZ), Vector3.new(0, 0, endZ + 25)
end

local Z = {
	{ id = "meadow", name = "Slime Meadow", powerReq = 0, tier = 1, stage = 1,
		preset = "SunnyCartoon", color = Color3.fromRGB(110, 200, 95), monsters = { "slime", "big_slime", "bouncer" }, boss = "slime_king", maxAlive = 12 },
	{ id = "desert", name = "Scrap Desert", powerReq = 2000, tier = 2, stage = 2,
		preset = "DesertDusk", color = Color3.fromRGB(225, 190, 120), monsters = { "scrap_bot", "sand_crab", "rust_drone" }, boss = "sand_titan", maxAlive = 12 },
	{ id = "frost", name = "Frost Cavern", powerReq = 25000, tier = 3, stage = 3,
		preset = "FrostHaze", color = Color3.fromRGB(200, 235, 255), monsters = { "snowling", "ice_bat", "frost_golem" }, boss = "yeti_lord", maxAlive = 12 },
	{ id = "magma", name = "Magma Foundry", powerReq = 300000, tier = 4, stage = 4,
		preset = "MagmaGlow", color = Color3.fromRGB(80, 50, 45), monsters = { "ember", "lava_hound", "forge_brute" }, boss = "magma_overseer", maxAlive = 12 },
	{ id = "void", name = "Neon Void", powerReq = 5000000, tier = 5, stage = 5,
		preset = "VoidNeon", color = Color3.fromRGB(40, 20, 70), monsters = { "void_wisp", "glitch", "void_knight" }, boss = "void_emperor", maxAlive = 12 },
}
Z.LaneWidth, Z.StageLength, Z.Gap = LANE_WIDTH, STAGE_LEN, GAP
for _, z in ipairs(Z) do
	z.center, z.size, z.gatePos, z.bossPos = stage(z.stage)
end
return Z
</ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX0000001C"><Properties><string name="Name">Net</string><ProtectedString name="Source">-- Remote networking with per-player rate limiting.
-- Server: Net.on(name, handler, perSecond?)  /  Net.fire(player, name, ...)  /  Net.fireAll(name, ...)
-- Client: Net.send(name, ...)  /  Net.listen(name, handler)  /  Net.invoke(name, ...)
-- Server : Net.handle(name, handler, perSecond?) for RemoteFunctions.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local IS_SERVER = RunService:IsServer()
local Net = {}

local folder: Folder
if IS_SERVER then
	folder = ReplicatedStorage:FindFirstChild("Remotes") or Instance.new("Folder")
	folder.Name = "Remotes"
	folder.Parent = ReplicatedStorage
else
	folder = ReplicatedStorage:WaitForChild("Remotes")
end

local function getRemote(name: string, className: string)
	local r = folder:FindFirstChild(name)
	if r then
		return r
	end
	if IS_SERVER then
		r = Instance.new(className)
		r.Name = name
		r.Parent = folder
		return r
	end
	return folder:WaitForChild(name, 15)
end

-- token bucket per player per remote
local buckets = {}
local function allow(player: Player, name: string, perSecond: number): boolean
	local key = name
	buckets[player] = buckets[player] or {}
	local b = buckets[player][key]
	local now = os.clock()
	if not b then
		b = { tokens = perSecond, t = now }
		buckets[player][key] = b
	end
	b.tokens = math.min(perSecond, b.tokens + (now - b.t) * perSecond)
	b.t = now
	if b.tokens &lt; 1 then
		return false
	end
	b.tokens -= 1
	return true
end

if IS_SERVER then
	Players.PlayerRemoving:Connect(function(p)
		buckets[p] = nil
	end)

	-- Declare a remote ahead of time so clients can find it immediately.
	function Net.declare(name: string)
		getRemote(name, "RemoteEvent")
	end

	function Net.on(name: string, handler: (Player, ...any) -&gt; (), perSecond: number?)
		local rate = perSecond or 10
		getRemote(name, "RemoteEvent").OnServerEvent:Connect(function(player, ...) -- lint-ok (rate limited)
			if allow(player, name, rate) then
				handler(player, ...)
			end
		end)
	end

	function Net.handle(name: string, handler: (Player, ...any) -&gt; ...any, perSecond: number?)
		local rate = perSecond or 5
		getRemote(name, "RemoteFunction").OnServerInvoke = function(player, ...)
			if not allow(player, name, rate) then
				return nil
			end
			return handler(player, ...)
		end
	end

	function Net.fire(player: Player, name: string, ...)
		getRemote(name, "RemoteEvent"):FireClient(player, ...)
	end

	function Net.fireAll(name: string, ...)
		getRemote(name, "RemoteEvent"):FireAllClients(...) -- lint-ok
	end
else
	function Net.send(name: string, ...)
		getRemote(name, "RemoteEvent"):FireServer(...)
	end

	function Net.listen(name: string, handler: (...any) -&gt; ())
		return getRemote(name, "RemoteEvent").OnClientEvent:Connect(handler)
	end

	function Net.invoke(name: string, ...)
		return getRemote(name, "RemoteFunction"):InvokeServer(...)
	end
end

return Net
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001D"><Properties><string name="Name">Signal</string><ProtectedString name="Source">-- Tiny signal (no BindableEvent overhead). Used by services/controllers.
local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal:Connect(fn)
	local handlers = self._handlers
	table.insert(handlers, fn)
	return {
		Disconnect = function()
			local i = table.find(handlers, fn)
			if i then
				table.remove(handlers, i)
			end
		end,
	}
end

function Signal:Fire(...)
	for _, fn in ipairs(table.clone(self._handlers)) do
		task.spawn(fn, ...)
	end
end

return Signal
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001E"><Properties><string name="Name">Theme</string><ProtectedString name="Source">-- UI design tokens. The UI/UX designer changes THIS file to restyle the whole game.
return {
	Font = Enum.Font.FredokaOne,
	FontBody = Enum.Font.GothamBold,
	Colors = {
		Bg = Color3.fromRGB(22, 20, 38),
		Panel = Color3.fromRGB(38, 34, 64),
		PanelLight = Color3.fromRGB(58, 52, 96),
		Stroke = Color3.fromRGB(12, 10, 24),
		Text = Color3.fromRGB(255, 255, 255),
		TextDim = Color3.fromRGB(190, 185, 220),
		Primary = Color3.fromRGB(58, 216, 255), -- neon cyan
		PrimaryDark = Color3.fromRGB(20, 130, 190),
		Accent = Color3.fromRGB(255, 79, 216), -- neon magenta
		AccentDark = Color3.fromRGB(170, 30, 140),
		Danger = Color3.fromRGB(255, 79, 106),
		Robux = Color3.fromRGB(0, 176, 111),
		Energy = Color3.fromRGB(58, 216, 255),
		Forge = Color3.fromRGB(255, 79, 216),
		Gold = Color3.fromRGB(255, 201, 53),
	},
	-- matches Config/Guns.luau Rarities (Common..Mythic)
	Rarity = {
		Color3.fromRGB(200, 200, 208),
		Color3.fromRGB(58, 216, 255),
		Color3.fromRGB(181, 108, 255),
		Color3.fromRGB(255, 201, 53),
		Color3.fromRGB(255, 79, 106),
	},
	Corner = UDim.new(0, 14),
	StrokeThickness = 3,
	Tween = TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
	TweenFast = TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
}
</ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX0000004D"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX0000004C"><Properties><string name="Name">Server</string></Properties><Item class="Script" referent="RBX00000021"><Properties><string name="Name">Main</string><ProtectedString name="Source">-- Server entry. Services are plain modules with Init(services); order matters only
-- for who connects to DataService.Loaded first (all connect before any player loads).
local Services = script.Parent.Services

local order = {
	"DataService",
	"WorldService",
	"MapService",
	"MonetizationService",
	"EconomyService",
	"AnalyticsService",
	"QuestService",
	"RewardService",
	"LeaderboardService",
	"CollectibleService",
	-- Gun Forge
	"EventService",
	"SocialService",
	"PlayerService",
	"InventoryService",
	"PetService",
	"ClanService",
	"TrainingService",
	"ZoneService",
	"MonsterService",
	"GunService",
	"ForgeService",
	"MinigameService",
	"StationService",
	"RebirthService",
	"CodesService",
	"WorldBossService",
	"ArenaService",
	"TournamentService",
	"GemShopService",
	"RaidService",
	"SeasonService", -- wraps QuestService.Progress (must be the only wrapper)
	"AchievementService",
	"SpinService",
	"StoryService",
	"TradeService",
}

local services = {}
for _, name in ipairs(order) do
	services[name] = require(Services:WaitForChild(name))
end

-- DataService.Init last-but-first: other services must subscribe to Loaded before players load
for _, name in ipairs(order) do
	if name ~= "DataService" and services[name].Init then
		local ok, err = pcall(services[name].Init, services) -- one broken service must not stop DataService.Init
		if not ok then
			warn("[Server] " .. name .. " Init failed:", err)
		end
	end
end
services.DataService.Init()

print(("[Server] %d services started"):format(#order))
</ProtectedString></Properties></Item><Item class="Folder" referent="RBX0000004B"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX00000022"><Properties><string name="Name">AchievementService</string><ProtectedString name="Source">-- Achievements (checked every 10 s + on demand) and equippable titles shown above the head.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config.Achievements)
local Net = require(ReplicatedStorage.Shared.Net)
local Rewards = require(script.Parent.ProgressRewards)

local AchievementService = {}
local S

local function applyTag(player: Player)
	local d = S.DataService.Get(player)
	local head = player.Character and player.Character:FindFirstChild("Head")
	if not d or not head then
		return
	end
	local old = head:FindFirstChild("TitleTag")
	if old then
		old:Destroy()
	end
	local def = Config.Titles[d.title]
	player:SetAttribute("Title", def and def.name or nil)
	if not def then
		return
	end
	local g = Instance.new("BillboardGui")
	g.Name = "TitleTag"
	g.Size = UDim2.fromOffset(120, 20)
	g.StudsOffset = Vector3.new(0, 2.6, 0)
	g.MaxDistance = 50
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.Text = def.name
	l.TextColor3 = def.color
	l.TextStrokeTransparency = 0.3
	l.Parent = g
	g.Parent = head
end

function AchievementService.Check(player: Player)
	local d = S.DataService.Get(player)
	if not d then
		return
	end
	for _, a in ipairs(Config.List) do
		if not d.achievements[a.id] and Config.Value(d, a.kind, a.stat) &gt;= a.goal then
			S.DataService.Update(player, function(x)
				x.achievements[a.id] = true
			end)
			Rewards.Grant(S, player, { Gems = a.gems, title = a.title }, "achievement")
			S.EconomyService.Toast(player, ("Achievement: %s  (+%d Gems)"):format(a.name, a.gems), "success")
			if a.announce then
				Net.fireAll("Toast", ("%s earned \"%s\"!"):format(player.DisplayName, a.name), "success")
			end
		end
	end
end

local function info(player: Player)
	local d = S.DataService.Get(player)
	if not d then
		return nil
	end
	local values = {}
	for _, a in ipairs(Config.List) do
		values[a.id] = Config.Value(d, a.kind, a.stat)
	end
	local owned = {}
	for key in pairs(d.achievements) do
		if key:sub(1, 6) == "title:" then
			owned[key:sub(7)] = true
		end
	end
	return { earned = d.achievements, values = values, owned = owned, title = d.title }
end

function AchievementService.Init(services)
	S = services

	S.DataService.Loaded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			task.wait(0.5)
			applyTag(player)
		end)
		AchievementService.Check(player)
		applyTag(player)
	end)

	task.spawn(function()
		while true do -- lint-ok (task.wait)
			task.wait(10)
			for _, p in ipairs(Players:GetPlayers()) do
				AchievementService.Check(p)
			end
		end
	end)

	Net.handle("AchInfo", function(player)
		AchievementService.Check(player)
		return info(player)
	end, 3)

	Net.handle("EquipTitle", function(player, id)
		local d = S.DataService.Get(player)
		if not d or type(id) ~= "string" or #id &gt; 40 then
			return nil
		end
		if id ~= "" and not (Config.Titles[id] and d.achievements["title:" .. id]) then
			return info(player)
		end
		S.DataService.Update(player, function(x)
			x.title = id
		end)
		applyTag(player)
		return info(player)
	end, 4)
end

return AchievementService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000023"><Properties><string name="Name">AnalyticsService</string><ProtectedString name="Source">-- Thin wrappers: Roblox AnalyticsService (funnels/economy dashboards) + BadgeService.
-- All calls are pcall-wrapped so analytics can never break gameplay.
local RbxAnalytics = game:GetService("AnalyticsService")
local BadgeService = game:GetService("BadgeService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Economy = require(ReplicatedStorage.Shared.Config.Economy)

local AnalyticsService = {}

function AnalyticsService.Event(player: Player, name: string, value: number?)
	pcall(function()
		RbxAnalytics:LogCustomEvent(player, name, value or 1)
	end)
end

-- Onboarding funnel: call with steps 1..n in order (e.g. 1 Joined, 2 FirstCollect, 3 OpenedShop)
function AnalyticsService.Funnel(player: Player, step: number, stepName: string)
	pcall(function()
		RbxAnalytics:LogOnboardingFunnelStepEvent(player, step, stepName)
	end)
end

function AnalyticsService.Economy(player: Player, flow: "Source" | "Sink", currency: string, amount: number, balance: number, txType: string, sku: string?)
	pcall(function()
		local flowType = if flow == "Source" then Enum.AnalyticsEconomyFlowType.Source else Enum.AnalyticsEconomyFlowType.Sink
		RbxAnalytics:LogEconomyEvent(player, flowType, currency, amount, balance, txType, sku)
	end)
end

function AnalyticsService.Purchase(player: Player, sku: string, robux: number?)
	AnalyticsService.Event(player, "Purchase_" .. sku, robux or 0)
	AnalyticsService.Badge(player, "FirstPurchase")
end

function AnalyticsService.Badge(player: Player, key: string)
	local id = Economy.Badges[key]
	if not id or id == 0 then
		return
	end
	task.spawn(function()
		pcall(function()
			if not BadgeService:UserHasBadgeAsync(player.UserId, id) then
				BadgeService:AwardBadge(player.UserId, id)
			end
		end)
	end)
end

function AnalyticsService.Init(services)
	services.DataService.Loaded:Connect(function(player)
		AnalyticsService.Funnel(player, 1, "Joined")
		AnalyticsService.Badge(player, "Welcome")
	end)
	services.EconomyService.Earned:Connect(function(player, currency, amount, source)
		local bal = services.EconomyService.Get(player, currency)
		AnalyticsService.Economy(player, "Source", currency, amount, bal, Enum.AnalyticsEconomyTransactionType.Gameplay.Name, source)
	end)
end

return AnalyticsService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000024"><Properties><string name="Name">ArenaService</string><ProtectedString name="Source">-- PvP arena: queues (Duel/Duo/Squad), matches in Map.Arena.Arena1..3, normalized HP/damage
-- (Power &amp; passes never matter), no real deaths (respawn at team spawn), Elo rating.
-- StartMatch() is reused by TournamentService.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Combat = require(Shared.Config.Combat)
local Net = require(Shared.Net)

local ArenaService = {}
local S
local A = Combat.Arena
local arenas: { Model } = {}
local busy: { [number]: any } = {}
local queues: { [string]: { Player } } = { Duel = {}, Duo = {}, Squad = {} }
local pending = {} -- matches waiting for a free arena
local matches: { [number]: any } = {}
local nextId = 0

local function root(p: Player): BasePart?
	return p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function hum(p: Player): Humanoid?
	return p.Character and p.Character:FindFirstChildOfClass("Humanoid")
end

local function spawnAt(match, p: Player)
	local team = p:GetAttribute("Team")
	local spawnPart = match.arena:FindFirstChild(team == "A" and "SpawnA" or "SpawnB") :: BasePart?
	local r = root(p)
	if spawnPart and r then
		r.CFrame = spawnPart.CFrame + Vector3.new(math.random(-4, 4), 4, math.random(-4, 4))
	end
	local h = hum(p)
	if h then
		h.Health = h.MaxHealth
	end
	if p.Character then
		local ff = Instance.new("ForceField")
		ff.Visible = true
		ff.Parent = p.Character
		task.delay(2, function()
			ff:Destroy()
		end)
	end
end

local function removeFromQueues(p: Player)
	for _, q in pairs(queues) do
		local i = table.find(q, p)
		if i then
			table.remove(q, i)
		end
	end
end

local function pushQueue(mode: string)
	local q = queues[mode]
	for _, p in ipairs(q) do
		Net.fire(p, "QueueState", { mode = mode, count = #q, need = A.Modes[mode].teamSize * 2 })
	end
end

local function sendState(match)
	local names = { A = {}, B = {} }
	for team, list in pairs(match.teams) do
		for _, p in ipairs(list) do
			table.insert(names[team], p.DisplayName)
		end
	end
	for _, list in pairs(match.teams) do
		for _, p in ipairs(list) do
			Net.fire(p, "MatchState", { id = match.id, mode = match.modeName, team = p:GetAttribute("Team"), names = names,
				kills = match.kills, killsToWin = match.killsToWin, endsAt = match.endsAt })
		end
	end
end

local function avgRating(list: { Player }): number
	local sum, n = 0, 0
	for _, p in ipairs(list) do
		local d = S.DataService.Get(p)
		if d then
			sum += d.pvp.rating
			n += 1
		end
	end
	return if n &gt; 0 then sum / n else 1000
end

local function finish(match, winner: string?)
	if match.done then
		return
	end
	match.done = true
	matches[match.id] = nil
	busy[match.arenaIndex] = nil
	local ra, rb = avgRating(match.teams.A), avgRating(match.teams.B)
	for team, list in pairs(match.teams) do
		local mine, theirs = if team == "A" then ra else rb, if team == "A" then rb else ra
		local expected = 1 / (1 + 10 ^ ((theirs - mine) / 400))
		local score = if winner == nil then 0.5 elseif winner == team then 1 else 0
		local delta = if match.ranked then math.floor(A.EloK * (score - expected) + 0.5) else 0
		for _, p in ipairs(list) do
			if p.Parent then
				S.DataService.Update(p, function(d)
					d.pvp.rating = math.max(0, d.pvp.rating + delta)
					if winner == team then
						d.pvp.wins += 1
					elseif winner then
						d.pvp.losses += 1
					end
				end)
				if match.ranked then
					S.EconomyService.Add(p, "Coins", if winner == team then A.WinCoins else A.LoseCoins, "pvp", false)
				end
				if winner == team then
					S.QuestService.Progress(p, "PvpWins", 1)
					S.ClanService.AddXp(p, Combat.Clan.XpPerPvpWin)
				end
				p:SetAttribute("MatchId", nil)
				p:SetAttribute("Team", nil)
				S.PlayerService.RefreshCharacter(p)
				local r = root(p)
				if r then
					r.CFrame = CFrame.new(0, 5, 0)
				end
				Net.fire(p, "MatchEnd", { winner = winner, team = team, delta = delta, ranked = match.ranked })
			end
		end
	end
	if match.onEnd then
		task.spawn(match.onEnd, winner, match)
	end
end

local function begin(match)
	-- drop players who left while the match was pending
	for team, list in pairs(match.teams) do
		for i = #list, 1, -1 do
			if not list[i].Parent then
				table.remove(list, i)
			end
		end
		if #list == 0 then
			match.arenaIndex = 0
			finish(match, if team == "A" then "B" else "A")
			return true
		end
	end
	for i, arena in ipairs(arenas) do
		if not busy[i] then
			busy[i] = match
			match.arena, match.arenaIndex = arena, i
			match.endsAt = Workspace:GetServerTimeNow() + match.minutes * 60
			matches[match.id] = match
			for team, list in pairs(match.teams) do
				for _, p in ipairs(list) do
					removeFromQueues(p)
					p:SetAttribute("MatchId", match.id)
					p:SetAttribute("Team", team)
					S.PlayerService.RefreshCharacter(p)
					spawnAt(match, p)
				end
			end
			sendState(match)
			return true
		end
	end
	return false
end

function ArenaService.Dequeue(p: Player)
	removeFromQueues(p)
	Net.fire(p, "QueueState", nil)
end

-- teamA/teamB: lists of players. opts: { killsToWin, minutes, ranked, onEnd(winnerTeam|nil, match) }
function ArenaService.StartMatch(teamA: { Player }, teamB: { Player }, modeName: string, opts)
	nextId += 1
	local match = { id = nextId, teams = { A = teamA, B = teamB }, kills = { A = 0, B = 0 }, modeName = modeName,
		killsToWin = opts.killsToWin, minutes = opts.minutes, ranked = opts.ranked, onEnd = opts.onEnd }
	if not begin(match) then
		table.insert(pending, match)
	end
	return match
end

function ArenaService.Damage(attacker: Player, victim: Player, dmg: number): boolean
	local mid = attacker:GetAttribute("MatchId")
	local match = mid and matches[mid]
	if not match or victim:GetAttribute("MatchId") ~= mid or victim:GetAttribute("Team") == attacker:GetAttribute("Team") then
		return false
	end
	local h = hum(victim)
	if not h or h.Health &lt;= 0 or (victim.Character and victim.Character:FindFirstChildOfClass("ForceField")) then
		return false
	end
	if h.Health - dmg &gt; 0 then
		h.Health -= dmg
		return true
	end
	local team = attacker:GetAttribute("Team")
	match.kills[team] += 1
	Net.fire(attacker, "Announce", "You eliminated " .. victim.DisplayName .. "!")
	S.ClanService.AddXp(attacker, Combat.Clan.XpPerKill)
	if match.kills[team] &gt;= match.killsToWin then
		finish(match, team)
	else
		task.delay(0, function()
			spawnAt(match, victim)
		end)
		sendState(match)
	end
	return true
end

local function leave(p: Player)
	removeFromQueues(p)
	local mid = p:GetAttribute("MatchId")
	local match = mid and matches[mid]
	if not match then
		return
	end
	for team, list in pairs(match.teams) do
		local i = table.find(list, p)
		if i then
			table.remove(list, i)
			if #list == 0 then
				finish(match, if team == "A" then "B" else "A")
			end
		end
	end
end

local function matchmake()
	for mode, q in pairs(queues) do
		local size = A.Modes[mode].teamSize
		while #q &gt;= size * 2 do
			local group = {}
			for _ = 1, size * 2 do
				table.insert(group, table.remove(q, 1))
			end
			table.sort(group, function(a, b) -- snake draft by rating for fair teams
				local da, db = S.DataService.Get(a), S.DataService.Get(b)
				return (da and da.pvp.rating or 0) &gt; (db and db.pvp.rating or 0)
			end)
			local ta, tb = {}, {}
			for i, p in ipairs(group) do
				table.insert(if (i % 4 == 1 or i % 4 == 0) then ta else tb, p)
			end
			local m = A.Modes[mode]
			ArenaService.StartMatch(ta, tb, m.name, { killsToWin = m.killsToWin, minutes = m.minutes, ranked = true })
		end
		pushQueue(mode)
	end
	for i = #pending, 1, -1 do
		if begin(pending[i]) then
			table.remove(pending, i)
		end
	end
	local t = Workspace:GetServerTimeNow()
	for _, match in pairs(matches) do
		if t &gt;= match.endsAt then
			local a, b = match.kills.A, match.kills.B
			finish(match, if a &gt; b then "A" elseif b &gt; a then "B" else nil)
		end
	end
end

function ArenaService.Init(services)
	S = services
	for _, n in ipairs({ "QueueState", "MatchState", "MatchEnd" }) do
		Net.declare(n)
	end
	task.spawn(function()
		local root = Workspace:WaitForChild("Map", 30)
		local arenaFolder = root and root:WaitForChild("Arena", 30)
		for i = 1, 3 do
			local a = arenaFolder and arenaFolder:WaitForChild("Arena" .. i, 10)
			if a then
				table.insert(arenas, a :: Model)
			end
		end
	end)

	Net.on("QueueJoin", function(player, mode)
		if type(mode) ~= "string" or not queues[mode] or player:GetAttribute("MatchId") or player:GetAttribute("InTournament") then
			return
		end
		removeFromQueues(player)
		table.insert(queues[mode], player)
		pushQueue(mode)
	end, 2)
	Net.on("QueueLeave", function(player)
		removeFromQueues(player)
		Net.fire(player, "QueueState", nil)
	end, 2)
	Net.handle("PvpStats", function(player)
		local d = S.DataService.Get(player)
		return d and d.pvp
	end, 2)

	Players.PlayerRemoving:Connect(leave)
	Players.PlayerAdded:Connect(function(p)
		p.CharacterAdded:Connect(function()
			local mid = p:GetAttribute("MatchId")
			if mid and matches[mid] then
				task.wait(0.3)
				S.PlayerService.RefreshCharacter(p)
				spawnAt(matches[mid], p)
			end
		end)
	end)
	task.spawn(function()
		while true do -- lint-ok (task.wait)
			task.wait(2)
			matchmake()
		end
	end)
end

return ArenaService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000025"><Properties><string name="Name">ClanService</string><ProtectedString name="Source">-- Clans (cross-server): DataStore records, roles, invites, filtered names/tags, clan XP + perks,
-- weekly Clan War leaderboard (OrderedDataStore per week). All web calls pcall-wrapped.
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")

local Shared = ReplicatedStorage.Shared
local Combat = require(Shared.Config.Combat)
local Net = require(Shared.Net)

local ClanService = {}
local S
local C = Combat.Clan
local okStore, store = pcall(DataStoreService.GetDataStore, DataStoreService, "Clans_v1")
local cache: { [string]: { data: any, t: number } } = {}
local localClans: { [string]: any } = {} -- offline fallback (Studio without API access)
local pendingXp: { [string]: number } = {}
local invites: { [Player]: { [string]: boolean } } = {}
local warCache = { t = 0, list = {} }
local busy: { [Player]: boolean } = {} -- one clan mutation per player at a time (handlers yield)

-- wraps a RemoteFunction handler: serialises per player and never throws back at the client
local function guarded(fn)
	return function(player: Player, ...)
		if busy[player] then
			return "Busy"
		end
		busy[player] = true
		local ok, res = pcall(fn, player, ...)
		busy[player] = nil
		if not ok then
			warn("[Clan]", res)
			return "Error"
		end
		return res
	end
end

local function week(): number
	return math.floor((os.time() - 345600) / 604800) -- weeks starting Monday UTC
end

local function warStore()
	local ok, s = pcall(DataStoreService.GetOrderedDataStore, DataStoreService, "ClanWar_" .. week())
	return ok and s or nil
end

-- returns data, fetched (fetched=false: the DataStore read failed, data is only a fallback)
local function load(id: string, fresh: boolean?)
	local c = cache[id]
	if c and not fresh and os.clock() - c.t &lt; 60 then
		return c.data, true
	end
	local data = localClans[id]
	local fetched = not okStore
	if okStore then
		local ok, res = pcall(store.GetAsync, store, id)
		if ok then
			data, fetched = res, true
		end
	end
	if fetched then
		cache[id] = { data = data, t = os.clock() }
	end
	return data, fetched
end

-- atomic modify; fn(data) returns data or nil to abort
local function modify(id: string, fn)
	local result
	local useLocal = not okStore
	if okStore then
		local ok, err = pcall(function()
			store:UpdateAsync(id, function(old) -- lint-ok (pcall)
				result = fn(old)
				return result
			end)
		end)
		if not ok then
			warn("[Clan] update failed", err)
			if not tostring(err):find("API") then
				return nil
			end
			result, useLocal = nil, true -- Studio without API access: keep clans in memory
		end
	end
	if useLocal then
		result = fn(localClans[id])
	end
	if result ~= nil then
		localClans[id] = result
		cache[id] = { data = result, t = os.clock() }
	end
	return result
end

local function level(xp: number): number
	return math.floor(xp / C.XpPerLevel)
end

function ClanService.Perk(player: Player): number
	return (player:GetAttribute("ClanPerk") :: number?) or 0
end

local function applyTag(player: Player, clan)
	player:SetAttribute("ClanTag", clan and clan.tag or nil)
	player:SetAttribute("ClanPerk", clan and math.min(0.5, level(clan.xp) * C.PerkPerLevel) or 0)
	local head = player.Character and player.Character:FindFirstChild("Head")
	local old = head and head:FindFirstChild("ClanTag")
	if old then
		old:Destroy()
	end
	if clan and head then
		local g = Instance.new("BillboardGui")
		g.Name = "ClanTag"
		g.Size = UDim2.fromOffset(100, 24)
		g.StudsOffset = Vector3.new(0, 3.3, 0)
		g.MaxDistance = 60
		local l = Instance.new("TextLabel")
		l.Size = UDim2.fromScale(1, 1)
		l.BackgroundTransparency = 1
		l.Font = Enum.Font.FredokaOne
		l.TextScaled = true
		l.Text = "[" .. clan.tag .. "]"
		l.TextColor3 = Color3.fromRGB(58, 216, 255)
		l.TextStrokeTransparency = 0.2
		l.Parent = g
		g.Parent = head
	end
end

local function filter(text: string, userId: number): string?
	local ok, res = pcall(function()
		return TextService:FilterStringAsync(text, userId):GetNonChatStringForBroadcastAsync()
	end)
	return if ok then res else nil
end

local function myClan(player: Player)
	local d = S.DataService.Get(player)
	if not d or d.clan == "" then
		return nil, nil
	end
	return d.clan, load(d.clan)
end

local function setClan(player: Player, id: string)
	S.DataService.Update(player, function(d)
		d.clan = id
	end)
end

function ClanService.AddXp(player: Player, n: number)
	local d = S.DataService.Get(player)
	if d and d.clan ~= "" then
		pendingXp[d.clan] = (pendingXp[d.clan] or 0) + n
	end
end

local function flush()
	local batch = pendingXp
	pendingXp = {}
	local ws = warStore()
	for id, xp in pairs(batch) do
		modify(id, function(c)
			if c then
				c.xp += xp
			end
			return c
		end)
		if ws then
			pcall(ws.IncrementAsync, ws, id, xp)
		end
	end
	for _, p in ipairs(Players:GetPlayers()) do
		local _, clan = myClan(p)
		if clan then
			p:SetAttribute("ClanPerk", math.min(0.5, level(clan.xp) * C.PerkPerLevel))
		end
	end
end

local function info(player: Player)
	local id, clan = myClan(player)
	if not clan or not clan.members[tostring(player.UserId)] then
		return { clan = nil }
	end
	local members = {}
	for uid, m in pairs(clan.members) do
		table.insert(members, { userId = tonumber(uid), name = m.name, role = m.role, online = Players:GetPlayerByUserId(tonumber(uid) or 0) ~= nil })
	end
	table.sort(members, function(a, b)
		return a.role &lt; b.role
	end)
	return { clan = { id = id, name = clan.name, tag = clan.tag, xp = clan.xp, level = level(clan.xp), perk = math.min(0.5, level(clan.xp) * C.PerkPerLevel),
		max = C.MaxMembers, members = members }, role = clan.members[tostring(player.UserId)].role }
end

function ClanService.Init(services)
	S = services
	Net.declare("ClanInvite")

	S.DataService.Loaded:Connect(function(player, data)
		if data.clan ~= "" then
			local clan, fetched = load(data.clan, true)
			if fetched and (not clan or not clan.members[tostring(player.UserId)]) then
				setClan(player, "") -- kicked / disbanded while away
			elseif clan and clan.members[tostring(player.UserId)] then
				applyTag(player, clan)
			end
		end
		player.CharacterAdded:Connect(function()
			task.wait(0.5)
			local _, clan = myClan(player)
			applyTag(player, clan)
		end)
	end)
	Players.PlayerRemoving:Connect(function(p)
		invites[p] = nil
		busy[p] = nil
	end)

	Net.handle("ClanInfo", info, 3)

	Net.handle("ClanCreate", guarded(function(player, name, tag)
		if type(name) ~= "string" or type(tag) ~= "string" then
			return "Invalid"
		end
		name, tag = name:sub(1, C.NameMaxLen), tag:upper():sub(1, C.TagMaxLen)
		if #name &lt; 3 or #tag &lt; 2 or not tag:match("^[A-Z0-9]+$") then
			return "Name 3+ chars, tag 2-4 letters/numbers"
		end
		if myClan(player) then
			return "Leave your clan first"
		end
		local fName, fTag = filter(name, player.UserId), filter(tag, player.UserId)
		if fName ~= name or fTag ~= tag then
			return "That name is not allowed"
		end
		if not S.EconomyService.Spend(player, "Coins", C.CreateCoins) then
			return ("Need %d Coins"):format(C.CreateCoins)
		end
		local id = HttpService:GenerateGUID(false)
		local made = modify(id, function()
			return { name = name, tag = tag, owner = player.UserId, xp = 0, created = os.time(),
				members = { [tostring(player.UserId)] = { role = "1Leader", name = player.DisplayName } } }
		end)
		if not made then
			S.EconomyService.Add(player, "Coins", C.CreateCoins, "clan_refund", false)
			return "Could not create clan, try again"
		end
		setClan(player, id)
		applyTag(player, made)
		return "OK"
	end), 1)

	Net.on("ClanInviteSend", function(player, targetUserId)
		local id, clan = myClan(player)
		local target = type(targetUserId) == "number" and Players:GetPlayerByUserId(targetUserId)
		if not clan or not target or target == player then
			return
		end
		local mine = clan.members[tostring(player.UserId)]
		if not mine or mine.role == "3Member" then
			return
		end
		invites[target] = invites[target] or {}
		invites[target][id] = true
		Net.fire(target, "ClanInvite", { id = id, name = clan.name, tag = clan.tag, from = player.DisplayName })
	end, 3)

	Net.handle("ClanAccept", guarded(function(player, id)
		if type(id) ~= "string" or not (invites[player] and invites[player][id]) or myClan(player) then
			return "No invite"
		end
		local full = false
		local res = modify(id, function(c)
			if not c then
				return nil
			end
			local n = 0
			for _ in pairs(c.members) do
				n += 1
			end
			if n &gt;= C.MaxMembers then
				full = true
				return nil
			end
			c.members[tostring(player.UserId)] = { role = "3Member", name = player.DisplayName }
			return c
		end)
		if full or not res then
			return "Clan is full"
		end
		invites[player] = nil
		setClan(player, id)
		applyTag(player, res)
		return "OK"
	end), 2)

	Net.handle("ClanLeave", guarded(function(player)
		local id, clan = myClan(player)
		if not id then
			return "Not in a clan"
		end
		if not clan then -- stale reference to a missing clan record: just detach
			setClan(player, "")
			applyTag(player, nil)
			return "OK"
		end
		local uid = tostring(player.UserId)
		modify(id :: string, function(c)
			if not c then
				return nil
			end
			c.members[uid] = nil
			if c.owner == player.UserId then -- hand over to an officer, else anyone
				local heir, best = nil, "9"
				for k, m in pairs(c.members) do
					if m.role &lt; best then
						heir, best = k, m.role
					end
				end
				if heir then
					c.owner = tonumber(heir)
					c.members[heir].role = "1Leader"
				end
			end
			return c
		end)
		setClan(player, "")
		applyTag(player, nil)
		return "OK"
	end), 2)

	-- action: "kick" | "promote" | "demote"
	Net.handle("ClanManage", guarded(function(player, targetUserId, action)
		local id, clan = myClan(player)
		if not clan or type(targetUserId) ~= "number" then
			return "Invalid"
		end
		local mine = clan.members[tostring(player.UserId)]
		local me = mine and mine.role
		local key = tostring(targetUserId)
		local them = clan.members[key]
		if not me or not them or me &gt;= them.role then
			return "No permission"
		end
		if action ~= "kick" and action ~= "promote" and action ~= "demote" then
			return "Invalid"
		end
		modify(id :: string, function(c)
			local m = c and c.members[key]
			if not m then
				return c
			end
			if action == "kick" then
				c.members[key] = nil
			elseif action == "promote" and me == "1Leader" then
				m.role = "2Officer"
			elseif action == "demote" and me == "1Leader" then
				m.role = "3Member"
			end
			return c
		end)
		local target = Players:GetPlayerByUserId(targetUserId)
		if target and action == "kick" then
			setClan(target, "")
			applyTag(target, nil)
		end
		return "OK"
	end), 3)

	Net.handle("ClanWarTop", function()
		if os.clock() - warCache.t &gt; 120 then
			warCache.t = os.clock()
			local ws = warStore()
			local ok, pages = false, nil
			if ws then
				ok, pages = pcall(ws.GetSortedAsync, ws, false, 10)
			end
			local list = {}
			if ok and pages then
				for rank, e in ipairs(pages:GetCurrentPage()) do
					local clan = load(e.key)
					table.insert(list, { rank = rank, name = clan and clan.name or "?", tag = clan and clan.tag or "", xp = e.value })
				end
			end
			warCache.list = list
		end
		return warCache.list
	end, 2)

	task.spawn(function()
		while true do -- lint-ok (task.wait)
			task.wait(60)
			flush()
		end
	end)
	game:BindToClose(flush)
end

return ClanService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000026"><Properties><string name="Name">CodesService</string><ProtectedString name="Source">-- Redeem codes from Config/Codes.luau (once per player).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Codes = require(ReplicatedStorage.Shared.Config.Codes)
local Net = require(ReplicatedStorage.Shared.Net)

local CodesService = {}

function CodesService.Init(S)
	Net.handle("Redeem", function(player, code)
		if type(code) ~= "string" or #code &gt; 30 then
			return "Invalid code"
		end
		code = code:upper():gsub("%s", "")
		local def = Codes[code]
		local d = S.DataService.Get(player)
		if not def or not d then
			return "Invalid code"
		end
		if def.expires ~= 0 and os.time() &gt; def.expires then
			return "Code expired"
		end
		if d.codes[code] then
			return "Already redeemed"
		end
		S.DataService.Update(player, function(data)
			data.codes[code] = true
		end)
		S.EconomyService.Grant(player, def.reward, "code")
		return "OK"
	end, 1)
end

return CodesService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000027"><Properties><string name="Name">CollectibleService</string><ProtectedString name="Source">-- DEMO gameplay loop so a fresh template is instantly playable: glowing coins spawn
-- around the map, touching one pays out. Replace/extend with the genre's core loop
-- (keep the pattern: server spawns + validates, client only does visuals).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Cfg = require(Shared.Config.Settings).Collectibles
local Net = require(Shared.Net)

local CollectibleService = {}

function CollectibleService.Init(services)
	if not Cfg.Enabled then
		return
	end
	Net.declare("Collected")
	local folder = Instance.new("Folder")
	folder.Name = "Collectibles"
	folder.Parent = workspace

	-- Optional designer-placed spawn points: workspace.CoinSpawns (Parts)
	local spawns = workspace:FindFirstChild("CoinSpawns")
	local rng = Random.new()
	local active = 0

	local function spawnPoint(): Vector3
		if spawns and #spawns:GetChildren() &gt; 0 then
			local list = spawns:GetChildren()
			return list[rng:NextInteger(1, #list)].Position + Vector3.new(0, 3, 0)
		end
		local r = Cfg.SpawnRadius
		local origin = Vector3.new(rng:NextNumber(-r, r), 60, rng:NextNumber(-r, r))
		local hit = workspace:Raycast(origin, Vector3.new(0, -120, 0))
		return (hit and hit.Position or Vector3.new(origin.X, 0, origin.Z)) + Vector3.new(0, 2.5, 0)
	end

	local template = ReplicatedStorage:FindFirstChild("CoinModel") -- artist can supply a MeshPart named CoinModel

	local function spawnOne()
		local coin: BasePart
		if template then
			coin = template:Clone()
		else
			local part = Instance.new("Part")
			part.Shape = Enum.PartType.Cylinder
			part.Size = Vector3.new(0.4, 2.2, 2.2)
			part.Color = Color3.fromRGB(255, 200, 40)
			part.Material = Enum.Material.Neon
			coin = part
		end
		coin.Name = "Coin"
		coin.Anchored = true
		coin.CanCollide = false
		coin.CanQuery = false
		coin.CastShadow = false
		coin.CFrame = CFrame.new(spawnPoint()) * CFrame.Angles(0, 0, math.rad(90))
		coin:SetAttribute("Spin", true) -- client spins it locally (no server physics cost)
		local taken = false
		coin.Touched:Connect(function(hit)
			if taken then
				return
			end
			local player = Players:GetPlayerFromCharacter(hit.Parent)
			if not player then
				return
			end
			taken = true
			local pos = coin.Position
			coin:Destroy()
			active -= 1
			local got = services.EconomyService.Add(player, "Coins", Cfg.Value, "collect", true)
			services.QuestService.Progress(player, "Collect", got)
			services.QuestService.Progress(player, "Earn", got)
			Net.fire(player, "Collected", pos, got)
			task.delay(Cfg.RespawnSeconds, function()
				if active &lt; Cfg.MaxActive then
					active += 1
					spawnOne()
				end
			end)
		end)
		coin.Parent = folder
	end

	for _ = 1, Cfg.MaxActive do
		active += 1
		spawnOne()
	end
end

return CollectibleService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000028"><Properties><string name="Name">DataService</string><ProtectedString name="Source">-- Player data: session-locked DataStore with retries, autosave, reconcile, BindToClose.
-- Falls back to an in-memory profile (not saved) when DataStores are unavailable
-- (e.g. Studio without "Enable Studio Access to API Services"), so the game stays playable.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Settings = require(Shared.Config.Settings)
local Template = require(Shared.Config.DataTemplate)
local Signal = require(Shared.Signal)

local LOCK_EXPIRE = 600 -- seconds; a lock older than this is considered dead
local MAX_LOAD_TRIES = 6

local DataService = {}
DataService.Loaded = Signal.new() -- (player, data)
DataService.Changed = Signal.new() -- (player, data)

local profiles: { [Player]: { data: any, offline: boolean, dirty: boolean } } = {}
local loadedWaiters: { [Player]: { thread } } = {}

local okStore, store = pcall(function()
	return DataStoreService:GetDataStore(Settings.DataStoreName)
end)
if not okStore then
	store = nil
	warn("[DataService] DataStore unavailable, running OFFLINE (data will not save)")
end

local function deepCopy(t)
	if type(t) ~= "table" then
		return t
	end
	local c = {}
	for k, v in pairs(t) do
		c[k] = deepCopy(v)
	end
	return c
end

local function reconcile(data, template)
	for k, v in pairs(template) do
		if data[k] == nil then
			data[k] = deepCopy(v)
		elseif type(v) == "table" and type(data[k]) == "table" then
			reconcile(data[k], v)
		end
	end
	return data
end

local function key(player: Player)
	return "u_" .. player.UserId
end

local function load(player: Player)
	if not store then
		return deepCopy(Template), true
	end
	for attempt = 1, MAX_LOAD_TRIES do
		local locked = false
		local ok, result = pcall(function()
			return store:UpdateAsync(key(player), function(old) -- lint-ok (pcall above)
				old = old or deepCopy(Template)
				local lock = old._lock
				if lock and lock.job ~= game.JobId and os.time() - lock.t &lt; LOCK_EXPIRE then
					locked = true
					return nil -- abort write, another server still owns it
				end
				old._lock = { job = game.JobId, t = os.time() }
				return old
			end)
		end)
		if ok and result and not locked then
			return reconcile(result, Template), false
		end
		if not ok then
			warn("[DataService] load error:", result)
			if tostring(result):find("API Services") or tostring(result):find("StudioAccess") then
				return deepCopy(Template), true
			end
		end
		task.wait(math.min(2 ^ attempt, 15))
	end
	-- Could not acquire: kick to protect data from duplication
	player:Kick("Your data is still saving on another server. Please rejoin in a minute.")
	return nil, false
end

local function save(player: Player, release: boolean): boolean
	local p = profiles[player]
	if not p or p.offline or not store then
		return true
	end
	local data = p.data
	for attempt = 1, 4 do
		local ok, err = pcall(function()
			store:UpdateAsync(key(player), function(old) -- lint-ok (pcall above)
				if old and old._lock and old._lock.job ~= game.JobId then
					return nil -- someone stole the lock (expired); do not overwrite
				end
				data._lock = if release then nil else { job = game.JobId, t = os.time() }
				return data
			end)
		end)
		if ok then
			p.dirty = false
			return true
		end
		warn("[DataService] save error:", err)
		task.wait(attempt * 2)
	end
	return false
end

function DataService.Get(player: Player): any?
	local p = profiles[player]
	return p and p.data
end

-- Yields until the player's data is loaded (or the player leaves).
function DataService.WaitFor(player: Player): any?
	if profiles[player] then
		return profiles[player].data
	end
	if not player.Parent then
		return nil
	end
	loadedWaiters[player] = loadedWaiters[player] or {}
	table.insert(loadedWaiters[player], coroutine.running())
	return coroutine.yield()
end

-- Mutate data safely: DataService.Update(player, function(data) data.currencies.Coins += 5 end)
function DataService.Update(player: Player, fn: (any) -&gt; ())
	local p = profiles[player]
	if not p then
		return false
	end
	fn(p.data)
	p.dirty = true
	DataService.Changed:Fire(player, p.data)
	return true
end

function DataService.Save(player: Player): boolean
	return save(player, false)
end

function DataService.IsOffline(player: Player): boolean
	local p = profiles[player]
	return p == nil or p.offline
end

local function onJoin(player: Player)
	local data, offline = load(player)
	if not data or not player.Parent then
		return
	end
	if data.firstJoin == 0 then
		data.firstJoin = os.time()
	end
	profiles[player] = { data = data, offline = offline, dirty = false }
	DataService.Loaded:Fire(player, data)
	for _, th in ipairs(loadedWaiters[player] or {}) do
		task.spawn(th, data)
	end
	loadedWaiters[player] = nil
end

local function onLeave(player: Player)
	if profiles[player] then
		save(player, true)
	end
	profiles[player] = nil
	for _, th in ipairs(loadedWaiters[player] or {}) do
		task.spawn(th, nil)
	end
	loadedWaiters[player] = nil
end

function DataService.Init()
	Players.PlayerAdded:Connect(onJoin)
	Players.PlayerRemoving:Connect(onLeave)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(onJoin, p)
	end

	task.spawn(function()
		while true do -- lint-ok (task.wait)
			task.wait(Settings.AutosaveSeconds)
			for player, p in pairs(profiles) do
				if p.dirty then
					task.spawn(save, player, false)
				end
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in pairs(profiles) do
			pending += 1
			task.spawn(function()
				save(player, true)
				pending -= 1
			end)
		end
		local t = os.clock()
		while pending &gt; 0 and os.clock() - t &lt; 25 do
			task.wait(0.1)
		end
	end)
end

return DataService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000029"><Properties><string name="Name">EconomyService</string><ProtectedString name="Source">-- Currencies (server-authoritative), leaderstats, and client sync.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Economy = require(Shared.Config.Economy)
local Net = require(Shared.Net)
local Signal = require(Shared.Signal)

local EconomyService = {}
EconomyService.Earned = Signal.new() -- (player, currency, amount, source)

local DataService, MonetizationService -- injected in Init

local function syncLeaderstats(player: Player, data)
	local ls = player:FindFirstChild("leaderstats")
	if not ls then
		return
	end
	for name, def in pairs(Economy.Currencies) do
		if def.leaderstat then
			local v = ls:FindFirstChild(name)
			if v then
				v.Value = data.currencies[name] or 0
			end
		end
	end
end

-- Push a compact snapshot to the client (HUD, shop, quests read this).
function EconomyService.Sync(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	syncLeaderstats(player, data)
	Net.fire(player, "DataSync", {
		currencies = data.currencies,
		inventory = data.inventory,
		equipped = data.equipped,
		settings = data.settings,
		passes = MonetizationService.OwnedList(player),
	})
end

function EconomyService.Get(player: Player, currency: string): number
	local data = DataService.Get(player)
	return data and data.currencies[currency] or 0
end

-- Adds currency. applyMultiplier=true for gameplay earnings (game passes boost them),
-- false for purchases/rewards with a fixed amount.
function EconomyService.Add(player: Player, currency: string, amount: number, source: string?, applyMultiplier: boolean?)
	assert(Economy.Currencies[currency], "unknown currency " .. tostring(currency))
	if amount &lt;= 0 then
		return 0
	end
	if applyMultiplier and currency == "Coins" then
		amount = math.floor(amount * MonetizationService.GetMultiplier(player, "coinMultiplier"))
	end
	local ok = DataService.Update(player, function(d)
		d.currencies[currency] = (d.currencies[currency] or 0) + amount
	end)
	if ok then
		EconomyService.Earned:Fire(player, currency, amount, source or "unknown")
		EconomyService.Sync(player)
		return amount
	end
	return 0
end

function EconomyService.Spend(player: Player, currency: string, amount: number): boolean
	if amount &lt; 0 then
		return false
	end
	local data = DataService.Get(player)
	if not data or (data.currencies[currency] or 0) &lt; amount then
		return false
	end
	DataService.Update(player, function(d)
		d.currencies[currency] -= amount
	end)
	EconomyService.Sync(player)
	return true
end

-- reward = { Coins = 100, Gems = 5 }
function EconomyService.Grant(player: Player, reward: { [string]: number }, source: string?)
	for currency, amount in pairs(reward) do
		if Economy.Currencies[currency] then
			EconomyService.Add(player, currency, amount, source, false)
		end
	end
end

function EconomyService.Init(services)
	DataService = services.DataService
	MonetizationService = services.MonetizationService
	Net.declare("DataSync")
	Net.declare("Toast")

	DataService.Loaded:Connect(function(player, data)
		local ls = Instance.new("Folder")
		ls.Name = "leaderstats"
		for name, def in pairs(Economy.Currencies) do
			if def.leaderstat then
				local v = Instance.new("IntValue")
				v.Name = name
				v.Value = data.currencies[name] or 0
				v.Parent = ls
			end
		end
		ls.Parent = player
		EconomyService.Sync(player)
	end)

	Net.handle("GetData", function(player)
		local data = DataService.WaitFor(player)
		if not data then
			return nil
		end
		return {
			currencies = data.currencies,
			inventory = data.inventory,
			equipped = data.equipped,
			settings = data.settings,
			passes = MonetizationService.OwnedList(player),
		}
	end)

	Net.on("SetSetting", function(player, name, value)
		if type(name) ~= "string" or type(value) ~= "boolean" then
			return
		end
		DataService.Update(player, function(d)
			if d.settings[name] ~= nil then
				d.settings[name] = value
			end
		end)
	end, 5)
end

function EconomyService.Toast(player: Player, text: string, kind: string?)
	Net.fire(player, "Toast", text, kind or "info")
end

return EconomyService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002A"><Properties><string name="Name">EventService</string><ProtectedString name="Source">-- Global events: weekly (2x weekend), special date ranges, hourly happy hour.
-- PlayerService multiplies training/drops/coins by EventService.Mult(kind).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Events = require(ReplicatedStorage.Shared.Config.Events)
local Net = require(ReplicatedStorage.Shared.Net)

local EventService = {}
local active = {}

local function compute()
	local now = os.time()
	local t = os.date("!*t", now)
	local wday = t.wday - 1 -- 0 = Sunday
	local list = {}
	for _, e in ipairs(Events.Weekly) do
		if table.find(e.days, wday) then
			-- ends at next UTC midnight after the last listed day; good enough for a banner timer
			table.insert(list, { name = e.name, train = e.train, drops = e.drops, coins = e.coins, color = e.color, endsAt = now - (t.hour * 3600 + t.min * 60 + t.sec) + 86400 })
		end
	end
	for _, e in ipairs(Events.Special) do
		if e.start &gt; 0 and now &gt;= e.start and now &lt; e.finish then
			table.insert(list, { name = e.name, train = e.train, drops = e.drops, coins = e.coins, color = e.color, endsAt = e.finish })
		end
	end
	local h = Events.HappyHour
	if t.min &lt; h.minutes then
		table.insert(list, { name = h.name, train = h.train, drops = h.drops, coins = h.coins, color = h.color, endsAt = now - t.min * 60 - t.sec + h.minutes * 60 })
	end
	return list
end

function EventService.Mult(kind: string): number
	local m = 1
	for _, e in ipairs(active) do
		m *= e[kind] or 1
	end
	return m
end

function EventService.Init()
	Net.declare("EventState")
	Players.PlayerAdded:Connect(function(p)
		task.wait(3)
		Net.fire(p, "EventState", active)
	end)
	task.spawn(function()
		local last = ""
		while true do -- lint-ok (task.wait)
			active = compute()
			local sig = ""
			for _, e in ipairs(active) do
				sig ..= e.name
			end
			if sig ~= last then
				last = sig
				Net.fireAll("EventState", active)
				for _, e in ipairs(active) do
					Net.fireAll("Announce", "🎉 " .. e.name .. " is LIVE!")
				end
			end
			task.wait(20)
		end
	end)
end

return EventService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002B"><Properties><string name="Name">ForgeService</string><ProtectedString name="Source">-- Forge: recipe -&gt; take materials/coins -&gt; assembly minigame session -&gt; rarity/quality roll -&gt; item.
-- Minigame only nudges odds (bump chance + quality), so client-reported results are low-risk; the
-- server still enforces min duration, clamps hits and auto-finishes abandoned sessions (no lost mats).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Recipes = require(Shared.Config.Recipes)
local Guns = require(Shared.Config.Guns)
local Net = require(Shared.Net)

local ForgeService = {}
local S
local rng = Random.new()
local sessions: { [Player]: { recipe: any, t0: number, id: number } } = {}
local sid = 0

local function rollRarity(): number
	local total = 0
	for _, r in ipairs(Guns.Rarities) do
		total += r.weight
	end
	local x = rng:NextNumber() * total
	for i, r in ipairs(Guns.Rarities) do
		x -= r.weight
		if x &lt;= 0 then
			return i
		end
	end
	return 1
end

local function finish(player: Player, perfects: number)
	local sess = sessions[player]
	if not sess then
		return nil
	end
	sessions[player] = nil
	local cfg = Recipes.Minigame
	perfects = math.clamp(math.floor(perfects), 0, cfg.Parts)
	local recipe = sess.recipe
	local rarity = rollRarity()
	local bump = perfects * cfg.PerfectBump
	if S.MonetizationService.GetPerk(player, "forgeLuck") then
		bump += cfg.PassBump
	end
	local bumped = false
	if rarity &lt; #Guns.Rarities and rng:NextNumber() &lt; bump then
		rarity += 1
		bumped = true
	end
	local skill = perfects / cfg.Parts
	local quality = cfg.QualityMin + (cfg.QualityMax - cfg.QualityMin) * (skill * 0.7 + rng:NextNumber() * 0.3)
	quality = math.floor(quality * 100) / 100
	local item = if recipe.kind == "gun"
		then S.InventoryService.MakeGun(recipe.item, recipe.tier, rarity, quality)
		else S.InventoryService.MakeArmor(recipe.item, recipe.tier, rarity, quality)
	local uid = S.InventoryService.CreateItem(player, item)
	S.QuestService.Progress(player, "Crafts", 1)
	if rarity &gt;= 4 then
		S.AnalyticsService.Badge(player, "FirstLegendary")
		if rarity == 5 then
			Net.fireAll("Announce", ("%s forged a MYTHIC %s!"):format(player.DisplayName, recipe.item))
		end
	end
	return { uid = uid, item = item, bumped = bumped, perfects = perfects }
end

function ForgeService.Init(services)
	S = services
	Net.declare("Announce")

	Net.handle("ForgeStart", function(player, recipeId)
		local recipe = type(recipeId) == "string" and Recipes.ById[recipeId]
		if not recipe or sessions[player] then
			return { ok = false, err = "busy" }
		end
		if not S.InventoryService.CanAdd(player, "gun") then
			return { ok = false, err = "Inventory full — salvage some items" }
		end
		if not S.InventoryService.Take(player, recipe.mats, recipe.coins) then
			return { ok = false, err = "Missing materials or coins" }
		end
		sid += 1
		local id = sid
		sessions[player] = { recipe = recipe, t0 = os.clock(), id = id }
		task.delay(60, function() -- abandoned -&gt; finish with 0 perfects
			if sessions[player] and sessions[player].id == id then
				local res = finish(player, 0)
				if res then
					Net.fire(player, "ForgeAuto", res)
				end
			end
		end)
		return { ok = true, session = id, parts = Recipes.Minigame.Parts }
	end, 2)
	Net.declare("ForgeAuto")

	Net.handle("ForgeFinish", function(player, sessionId, perfects)
		local sess = sessions[player]
		if not sess or sess.id ~= sessionId or type(perfects) ~= "number" or perfects ~= perfects then
			return nil
		end
		if os.clock() - sess.t0 &lt; Recipes.Minigame.MinSeconds then
			perfects = 0 -- too fast = bot; still give the item
		end
		return finish(player, perfects)
	end, 2)

	-- Enchant: Gems + 2 rare cores of the gun's tier -&gt; random bonus (replaces previous)
	Net.handle("Enchant", function(player, uid)
		local item = type(uid) == "string" and S.InventoryService.GetItem(player, uid)
		if not item or item.kind ~= "gun" then
			return nil
		end
		local core = Recipes.TierMats[item.tier][2]
		local cost = Guns.EnchantCost
		local d = S.DataService.Get(player)
		if not d or (d.currencies.Gems or 0) &lt; cost.Gems then
			return { err = ("Need %d Gems"):format(cost.Gems) }
		end
		if not S.InventoryService.Take(player, { [core] = cost.RareCores }, 0) then
			return { err = "Need 2 rare cores of this tier" }
		end
		if not S.EconomyService.Spend(player, "Gems", cost.Gems) then
			S.InventoryService.AddMaterial(player, core, cost.RareCores) -- refund
			return { err = "Not enough Gems" }
		end
		local e = Guns.Enchants[rng:NextInteger(1, #Guns.Enchants)]
		local val = math.floor((e.min + (e.max - e.min) * rng:NextNumber() ^ 1.6) * 100) / 100 -- high rolls are rarer
		S.DataService.Update(player, function()
			item.ench = { kind = e.kind, val = val }
		end)
		S.InventoryService.Sync(player)
		if d.equipped.gun == uid then
			S.GunService.GiveGun(player)
		end
		return { kind = e.kind, name = e.name, val = val }
	end, 2)

	Players.PlayerRemoving:Connect(function(p)
		if sessions[p] then
			finish(p, 0) -- runs before DataService releases the profile in practice; item is saved with it
		end
	end)
end

return ForgeService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002C"><Properties><string name="Name">GemShopService</string><ProtectedString name="Source">-- Gem shop: boosts, cooldown resets, coin/material packs scaled to the player's best zone.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local GemShop = require(Shared.Config.GemShop)
local Zones = require(Shared.Config.Zones)
local Monsters = require(Shared.Config.Monsters)
local Recipes = require(Shared.Config.Recipes)
local Net = require(Shared.Net)

local GemShopService = {}

function GemShopService.Init(S)
	local byKey = {}
	for _, it in ipairs(GemShop) do
		byKey[it.key] = it
	end
	Net.handle("GemBuy", function(player, key)
		local it = type(key) == "string" and byKey[key]
		if not it then
			return false
		end
		if not S.EconomyService.Spend(player, "Gems", it.gems) then
			S.EconomyService.Toast(player, "Not enough Gems", "error")
			return false
		end
		local tier = S.ZoneService.BestTier(S.PlayerService.GetPower(player))
		if it.boostSeconds then
			S.DataService.Update(player, function(d)
				d.boostUntil = math.max(os.time(), d.boostUntil) + it.boostSeconds
			end)
			S.TrainingService.Push(player)
		elseif key == "ResetGames" then
			S.MinigameService.ResetCooldowns(player)
		elseif it.coinsBossKills then
			local boss = Monsters[Zones[tier].boss]
			S.EconomyService.Add(player, "Coins", boss.coins * it.coinsBossKills, "gemshop", false)
		elseif it.common then
			S.InventoryService.AddMaterial(player, Recipes.TierMats[tier][1], it.common)
			S.InventoryService.AddMaterial(player, Recipes.TierMats[tier][2], it.rare)
		end
		S.EconomyService.Toast(player, "Bought " .. it.name, "success")
		return true
	end, 2)
end

return GemShopService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002D"><Properties><string name="Name">GunService</string><ProtectedString name="Source">-- Guns: gives the equipped gun as a Tool, validates every shot server-side (rate, range, target),
-- applies PvE damage (Power-scaled) or PvP damage (normalized, via ArenaService), relays tracers.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Guns = require(Shared.Config.Guns)
local Combat = require(Shared.Config.Combat)
local Net = require(Shared.Net)

local GunService = {}
local S
local lastShot: { [Player]: number } = {}
local headStats: { [Player]: { n: number, h: number } } = {}
local burst: { [Player]: number } = {} -- shots fired in the current burst
local ammo: { [Player]: { mag: number, max: number, reloadUntil: number, reload: number } } = {}
local rng = Random.new()

local function resetAmmo(player: Player, typeId: string)
	local t = Guns.Types[typeId]
	ammo[player] = { mag = t.mag, max = t.mag, reloadUntil = 0, reload = t.reload }
	burst[player] = 0
	Net.fire(player, "Ammo", t.mag, t.mag, 0)
end

local function startReload(player: Player)
	local a = ammo[player]
	if not a or os.clock() &lt; a.reloadUntil or a.mag &gt;= a.max then
		return
	end
	a.reloadUntil = os.clock() + a.reload - 0.15 -- small slack for latency
	Net.fire(player, "Ammo", 0, a.max, a.reload)
	task.delay(a.reload - 0.15, function()
		if ammo[player] == a and a.reloadUntil &gt; 0 then
			a.mag, a.reloadUntil = a.max, 0
		end
	end)
end
local lastRelay: { [Player]: number } = {}

-- effective stats incl. enchant (PvE); PvP uses base type stats
local function ench(item, kind: string): number
	return if item.ench and item.ench.kind == kind then item.ench.val else 0
end
function GunService.Rate(item): number
	return Guns.Types[item.id].rate * (1 + ench(item, "rate"))
end
function GunService.Range(item): number
	return Guns.Types[item.id].range * (1 + ench(item, "range"))
end

local function buildHandle(item): BasePart
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local folder = assets and assets:FindFirstChild("Guns")
	-- per-rarity model (&lt;type&gt;_r&lt;N&gt;) first, then the generic &lt;type&gt; model, else code-built fallback
	local src = folder and (folder:FindFirstChild(item.id .. "_r" .. item.rarity) or folder:FindFirstChild(item.id))
	local rarityColor = Guns.Rarities[item.rarity].color
	if src and src:IsA("BasePart") then
		local h = src:Clone()
		h.Name = "Handle"
		return h
	end
	-- code-built fallback: body + barrel + glowing rarity strip, welded to Handle
	local t = Guns.Types[item.id]
	local len = 1.6 + t.range / 60
	local h = Instance.new("Part")
	h.Name = "Handle"
	h.Size = Vector3.new(0.45, 0.9, len * 0.55)
	h.Color = t.color
	h.Material = Enum.Material.SmoothPlastic
	local function add(size: Vector3, offset: CFrame, color: Color3, mat: Enum.Material): Part
		local p = Instance.new("Part")
		p.Size = size
		p.Color = color
		p.Material = mat
		p.CanCollide, p.CanQuery, p.CanTouch, p.Massless = false, false, false, true
		p.CFrame = h.CFrame * offset
		local w = Instance.new("WeldConstraint")
		w.Part0, w.Part1 = h, p
		w.Parent = p
		p.Parent = h
		return p
	end
	add(Vector3.new(0.35, 0.35, len), CFrame.new(0, 0.45, -len * 0.35), t.color:Lerp(Color3.new(0, 0, 0), 0.3), Enum.Material.Metal)
	add(Vector3.new(0.5, 0.12, len * 0.7), CFrame.new(0, 0.7, -len * 0.2), rarityColor, Enum.Material.Neon)
	-- named moving parts (WeaponAnim cycles the slide and drops/reinserts the magazine on the client)
	add(Vector3.new(0.4, 0.3, len * 0.4), CFrame.new(0, 0.2, -len * 0.05), t.color:Lerp(Color3.new(1, 1, 1), 0.15), Enum.Material.Metal).Name = "Slide"
	add(Vector3.new(0.34, 0.7, 0.4), CFrame.new(0, -0.55, len * 0.12), Color3.fromRGB(40, 40, 46), Enum.Material.Metal).Name = "Magazine"
	local eject = Instance.new("Attachment")
	eject.Name = "Eject"
	eject.Position = Vector3.new(0.2, 0.55, -len * 0.1)
	eject.Parent = h
	local muzzle = Instance.new("Attachment")
	muzzle.Name = "Muzzle"
	muzzle.Position = Vector3.new(0, 0.45, -len * 0.85 - 0.2)
	muzzle.Parent = h
	return h
end

function GunService.GiveGun(player: Player)
	local item = S.InventoryService.EquippedGun(player)
	local backpack = player:FindFirstChildOfClass("Backpack")
	local char = player.Character
	if not item or not backpack then
		return
	end
	for _, container in ipairs({ backpack, char }) do
		if container then
			for _, tool in ipairs(container:GetChildren()) do
				if tool:IsA("Tool") and tool:GetAttribute("Gun") then
					tool:Destroy()
				end
			end
		end
	end
	local tool = Instance.new("Tool")
	tool.Name = Guns.Rarities[item.rarity].name .. " " .. Guns.Types[item.id].name
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.GripPos = Vector3.new(0, -0.2, 0.3)
	tool:SetAttribute("Gun", item.id)
	tool:SetAttribute("Rarity", item.rarity)
	tool:SetAttribute("Rate", GunService.Rate(item))
	tool:SetAttribute("Range", GunService.Range(item))
	tool:SetAttribute("Level", item.lvl or 0)
	buildHandle(item).Parent = tool
	tool.Parent = backpack
	resetAmmo(player, item.id)
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum:EquipTool(tool) -- AFK friendly: always holding the gun
	end
end

local function hrp(player: Player): BasePart?
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function relay(player: Player, toPos: Vector3)
	local t = os.clock()
	if t - (lastRelay[player] or 0) &lt; 0.3 then
		return
	end
	lastRelay[player] = t
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			Net.fire(other, "Shot", player, toPos)
		end
	end
end

-- Fire: kind "m" monster id | "p" player userId | "n" no target (miss, consumes ammo, tracer only)
-- headOff = aim point height relative to the monster centre (clamped here), mode = fire mode (checked against the gun)
local function onFire(player: Player, kind, targetId, headOff, mode, aimPos)
	local item = S.InventoryService.EquippedGun(player)
	local root = hrp(player)
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if not item or not root or not hum or hum.Health &lt;= 0 or type(targetId) ~= "number" then
		return
	end
	local t = Guns.Types[item.id]
	local now = os.clock()
	local inArena = S.PlayerService.InArena(player)
	local rate = if inArena then t.rate else GunService.Rate(item)
	-- fire mode: unknown/unsupported modes fall back to the gun's default. Burst fires N shots fast, then waits so
	-- the average stays at `rate`, so no mode out-damages another
	if type(mode) ~= "string" or not table.find(t.modes, mode) then
		mode = t.modes[1]
	end
	local interval = 1 / rate
	local gap = now - (lastShot[player] or 0)
	local n = burst[player] or 0
	local need = interval
	local inBurst = false
	if mode == "burst" then
		local fast = interval / Guns.Burst.RateMult
		inBurst = n &gt; 0 and n &lt; t.burst and gap &lt; interval
		need = if inBurst then fast else t.burst * interval - (t.burst - 1) * fast
	end
	if gap &lt; need * Combat.FireTolerance then
		return
	end
	local a = ammo[player]
	if not a or now &lt; a.reloadUntil then
		return
	end
	if a.reloadUntil &gt; 0 then -- reload finished but the delay callback has not run yet
		a.mag, a.reloadUntil = a.max, 0
	end
	if a.mag &lt;= 0 then
		startReload(player)
		return
	end
	lastShot[player] = now
	burst[player] = if inBurst then n + 1 else 1
	a.mag -= 1
	if a.mag &lt;= 0 then
		startReload(player)
	end

	if kind == "n" then
		if typeof(aimPos) == "Vector3" and aimPos == aimPos then
			local off = aimPos - root.Position
			if off.Magnitude &gt; 1 then
				relay(player, root.Position + off.Unit * math.min(off.Magnitude, GunService.Range(item)))
			end
		end
	elseif kind == "m" then
		if S.PlayerService.InArena(player) then
			return
		end
		local rec = S.MonsterService.Get(targetId)
		if not rec then
			return
		end
		local pos = S.MonsterService.Position(rec)
		if (pos - root.Position).Magnitude &gt; GunService.Range(item) + rec.def.size + 6 then
			return
		end
		local dist = (pos - root.Position).Magnitude
		-- weak point: the aim point must lie in the top HeadFraction of the monster (offset clamped; never raw damage)
		local size = rec.def.size
		local head = false
		if type(headOff) == "number" and headOff == headOff then
			local off = math.clamp(headOff, -size * 0.6, size * 0.6)
			head = off &gt;= size * (0.5 - Guns.HeadFraction) and off &lt;= size * 0.55
		end
		-- anti-cheat: humans can't headshot almost every shot; if the last 40 hits claim &gt; 65% heads,
		-- stop honouring head claims for this player (random crits still work)
		local hs = headStats[player] or { n = 0, h = 0 }
		headStats[player] = hs
		hs.n += 1
		if head then
			hs.h += 1
		end
		if hs.n &gt; 40 then
			hs.n, hs.h = hs.n * 0.5, hs.h * 0.5
		end
		if head and hs.n &gt;= 20 and hs.h / hs.n &gt; 0.65 then
			head = false
		end
		local crit = head or rng:NextNumber() &lt; t.crit + ench(item, "crit")
		local mastery = 1 + (item.lvl or 0) * Guns.Mastery.DamagePerLevel
		local dmg = item.dmg * Guns.PowerFactor(S.PlayerService.GetPower(player)) * Guns.Falloff(item.id, dist * (1 - ench(item, "range")))
			* mastery * (1 + ench(item, "dmg"))
		if crit then
			dmg *= Guns.CritMultiplier
		end
		local wasBoss = rec.def.boss
		S.MonsterService.Damage(targetId, player, dmg)
		Net.fire(player, "Hit", pos, math.floor(dmg), crit)
		if not S.MonsterService.Get(targetId) then -- this shot killed it: gun mastery xp
			GunService.AddMastery(player, if wasBoss then Guns.Mastery.BossXp else 1)
		end
		relay(player, pos)
	elseif kind == "p" then
		local target = Players:GetPlayerByUserId(targetId)
		local troot = target and hrp(target)
		if not troot or (troot.Position - root.Position).Magnitude &gt; t.range + 4 then
			return
		end
		local dist = (troot.Position - root.Position).Magnitude
		local dmg = t.dmg * t.pellets * (1 + Guns.PvP.RarityBonus * (item.rarity - 1)) * Guns.PvP.DamageScale * Guns.Falloff(item.id, dist)
		if S.ArenaService.Damage(player, target :: Player, dmg) then
			Net.fire(player, "Hit", troot.Position, math.floor(dmg), false)
			relay(player, troot.Position)
		end
	end
end

function GunService.AddMastery(player: Player, xp: number)
	local d = S.DataService.Get(player)
	local item = d and d.items[d.equipped.gun]
	if not item or (item.lvl or 0) &gt;= Guns.Mastery.MaxLevel then
		return
	end
	local leveled = false
	S.DataService.Update(player, function()
		item.xp = (item.xp or 0) + xp
		item.lvl = item.lvl or 0
		while item.lvl &lt; Guns.Mastery.MaxLevel and item.xp &gt;= Guns.MasteryXpNeeded(item.lvl) do
			item.xp -= Guns.MasteryXpNeeded(item.lvl)
			item.lvl += 1
			leveled = true
		end
	end)
	if leveled then
		S.EconomyService.Toast(player, ("%s reached MASTERY Lv %d! (+%d%% dmg)"):format(Guns.Types[item.id].name, item.lvl,
			math.floor(item.lvl * Guns.Mastery.DamagePerLevel * 100)), "success")
		S.InventoryService.SyncSoon(player)
		local tool = player.Character and player.Character:FindFirstChildOfClass("Tool")
		if tool then
			tool:SetAttribute("Level", item.lvl)
		end
	end
end

function GunService.Init(services)
	S = services
	Net.declare("Shot")
	Net.declare("Hit")
	Net.declare("Ammo")
	Net.on("Fire", onFire, 20)
	Net.on("Reload", startReload, 2)

	S.InventoryService.GearChanged:Connect(function(player, slot)
		if slot == "gun" then
			GunService.GiveGun(player)
		end
	end)
	local function hook(player: Player)
		player.CharacterAdded:Connect(function(char)
			char:WaitForChild("Humanoid", 5)
			task.wait(0.2)
			GunService.GiveGun(player)
		end)
	end
	Players.PlayerAdded:Connect(hook)
	for _, p in ipairs(Players:GetPlayers()) do
		hook(p)
	end
	Players.PlayerRemoving:Connect(function(p)
		lastShot[p] = nil
		headStats[p] = nil
		lastRelay[p] = nil
		ammo[p] = nil
		burst[p] = nil
	end)
end

return GunService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002E"><Properties><string name="Name">InventoryService</string><ProtectedString name="Source">-- Materials + unique items (guns, armor, pets), equip/salvage, index, client sync.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Guns = require(Shared.Config.Guns)
local Recipes = require(Shared.Config.Recipes)
local Pets = require(Shared.Config.Pets)
local Materials = require(Shared.Config.Materials)
local Net = require(Shared.Net)
local Signal = require(Shared.Signal)

local InventoryService = {}
InventoryService.GearChanged = Signal.new() -- (player, slot)
local S

local function countKind(items, kind: string): number
	local n = 0
	for _, it in pairs(items) do
		if (kind == "pet") == (it.kind == "pet") then
			n += 1
		end
	end
	return n
end

function InventoryService.Sync(player: Player)
	local d = S.DataService.Get(player)
	if not d then
		return
	end
	Net.fire(player, "Inv", { materials = d.inventory, items = d.items, equipped = d.equipped, index = d.index, rebirths = d.rebirths })
end

-- debounce syncs within the same frame burst
local pending: { [Player]: boolean } = {}
function InventoryService.SyncSoon(player: Player)
	if pending[player] then
		return
	end
	pending[player] = true
	task.delay(0.4, function()
		pending[player] = nil
		if player.Parent then
			InventoryService.Sync(player)
		end
	end)
end

function InventoryService.AddMaterial(player: Player, id: string, n: number)
	if not Materials[id] or n &lt;= 0 then
		return
	end
	S.DataService.Update(player, function(d)
		d.inventory[id] = (d.inventory[id] or 0) + n
	end)
	InventoryService.SyncSoon(player)
end

function InventoryService.Has(player: Player, mats: { [string]: number }, coins: number?): boolean
	local d = S.DataService.Get(player)
	if not d then
		return false
	end
	for id, n in pairs(mats) do
		if (d.inventory[id] or 0) &lt; n then
			return false
		end
	end
	return (coins or 0) &lt;= (d.currencies.Coins or 0)
end

-- Atomically take materials + coins. Returns false if anything is missing.
function InventoryService.Take(player: Player, mats: { [string]: number }, coins: number?): boolean
	if not InventoryService.Has(player, mats, coins) then
		return false
	end
	if coins and coins &gt; 0 and not S.EconomyService.Spend(player, "Coins", coins) then
		return false
	end
	S.DataService.Update(player, function(d)
		for id, n in pairs(mats) do
			d.inventory[id] -= n
			if d.inventory[id] &lt;= 0 then
				d.inventory[id] = nil
			end
		end
	end)
	InventoryService.SyncSoon(player)
	return true
end

function InventoryService.ItemCount(player: Player, kind: string): number
	local d = S.DataService.Get(player)
	return d and countKind(d.items, kind) or 0
end

function InventoryService.CanAdd(player: Player, kind: string): boolean
	local limit = if kind == "pet" then Pets.MaxPets else Recipes.MaxItems
	return InventoryService.ItemCount(player, kind) &lt; limit
end

-- item = { kind, id, tier, rarity, ... } -&gt; uid
function InventoryService.CreateItem(player: Player, item): string?
	local uid
	S.DataService.Update(player, function(d)
		uid = "i" .. d.nextUid
		d.nextUid += 1
		d.items[uid] = item
		if item.kind == "gun" then
			d.index.guns[item.id .. "_" .. item.rarity] = true
		elseif item.kind == "pet" then
			d.index.pets[item.id] = true
		end
	end)
	InventoryService.SyncSoon(player)
	return uid
end

function InventoryService.RemoveItem(player: Player, uid: string)
	S.DataService.Update(player, function(d)
		d.items[uid] = nil
		for slot, v in pairs(d.equipped) do
			if v == uid then
				d.equipped[slot] = ""
			end
		end
		local i = table.find(d.equipped.pets, uid)
		if i then
			table.remove(d.equipped.pets, i)
		end
	end)
	InventoryService.SyncSoon(player)
end

function InventoryService.GetItem(player: Player, uid: string)
	local d = S.DataService.Get(player)
	return d and d.items[uid]
end

function InventoryService.EquippedGun(player: Player)
	local d = S.DataService.Get(player)
	return d and d.items[d.equipped.gun]
end

function InventoryService.MakeGun(typeId: string, tier: number, rarity: number, quality: number)
	return { kind = "gun", id = typeId, tier = tier, rarity = rarity, q = quality, dmg = Guns.GunDamage(typeId, tier, rarity, quality) }
end

function InventoryService.MakeArmor(slot: string, tier: number, rarity: number, quality: number)
	return { kind = "armor", id = slot, tier = tier, rarity = rarity, q = quality, hp = Guns.ArmorHp(slot, tier, rarity, quality) }
end

local function equip(player: Player, uid: string)
	local d = S.DataService.Get(player)
	local item = d and d.items[uid]
	if not item or item.kind == "pet" then
		return
	end
	local slot = if item.kind == "gun" then "gun" else item.id
	S.DataService.Update(player, function(data)
		data.equipped[slot] = uid
	end)
	InventoryService.GearChanged:Fire(player, slot)
	InventoryService.Sync(player)
end
InventoryService.Equip = equip

local function salvage(player: Player, uid: string)
	local d = S.DataService.Get(player)
	local item = d and d.items[uid]
	if not item or item.kind == "pet" then
		return
	end
	for slot, v in pairs(d.equipped) do
		if v == uid and slot ~= "pets" then
			S.EconomyService.Toast(player, "Unequip it first!", "error")
			return
		end
	end
	local recipe = Recipes.ById[item.id .. "_t" .. item.tier]
	local refund = recipe and math.floor(recipe.coins * Recipes.SalvageRefund * (1 + (item.rarity - 1) * 0.5)) or 10
	InventoryService.RemoveItem(player, uid)
	S.EconomyService.Add(player, "Coins", refund, "salvage", false)
	S.EconomyService.Toast(player, ("Salvaged for %d Coins"):format(refund), "info")
end

function InventoryService.Init(services)
	S = services
	Net.declare("Inv")

	S.DataService.Loaded:Connect(function(player, data)
		if next(data.items) == nil then -- starter pistol
			local st = Guns.Starter
			local uid = InventoryService.CreateItem(player, InventoryService.MakeGun(st.id, st.tier, st.rarity, st.quality))
			if uid then
				S.DataService.Update(player, function(d)
					d.equipped.gun = uid
				end)
			end
		end
		InventoryService.Sync(player)
		InventoryService.GearChanged:Fire(player, "gun")
	end)
	Players.PlayerRemoving:Connect(function(p)
		pending[p] = nil
	end)

	Net.on("Equip", function(player, uid)
		if type(uid) == "string" then
			equip(player, uid)
		end
	end, 4)
	Net.on("Unequip", function(player, slot)
		if slot == "helmet" or slot == "vest" or slot == "boots" then
			S.DataService.Update(player, function(d)
				d.equipped[slot] = ""
			end)
			InventoryService.GearChanged:Fire(player, slot)
			InventoryService.Sync(player)
		end
	end, 4)
	Net.on("Salvage", function(player, uid)
		if type(uid) == "string" then
			salvage(player, uid)
		end
	end, 6)
	Net.on("SalvageAllCommon", function(player)
		local d = S.DataService.Get(player)
		if not d then
			return
		end
		for uid, item in pairs(table.clone(d.items)) do
			if item.kind ~= "pet" and item.rarity == 1 and d.equipped.gun ~= uid and d.equipped[item.id] ~= uid then
				salvage(player, uid)
			end
		end
	end, 1)

	InventoryService.GearChanged:Connect(function(player, slot)
		if slot ~= "gun" then
			S.PlayerService.RefreshCharacter(player)
		end
	end)
end

return InventoryService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002F"><Properties><string name="Name">LeaderboardService</string><ProtectedString name="Source">-- Global leaderboard via OrderedDataStore. Writes the top list to
-- ReplicatedStorage.Leaderboard (StringValue JSON) for any in-world board / UI.
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Settings = require(ReplicatedStorage.Shared.Config.Settings).Leaderboard

local LeaderboardService = {}

function LeaderboardService.Init(services)
	if not Settings.Enabled then
		return
	end
	local ok, store = pcall(DataStoreService.GetOrderedDataStore, DataStoreService, Settings.StoreName)
	if not ok then
		return
	end
	local out = Instance.new("StringValue")
	out.Name = "Leaderboard"
	out.Value = "[]"
	out.Parent = ReplicatedStorage

	local function score(player)
		local data = services.DataService.Get(player)
		if not data then
			return nil
		end
		return data.currencies[Settings.Stat] or data.stats[Settings.Stat]
	end

	task.spawn(function()
		while true do -- lint-ok (task.wait)
			for _, player in ipairs(Players:GetPlayers()) do
				local s = score(player)
				if s and not services.DataService.IsOffline(player) then
					pcall(store.SetAsync, store, tostring(player.UserId), math.floor(s))
				end
				task.wait(0.5) -- spread writes (DataStore budget)
			end
			local okPage, pages = pcall(store.GetSortedAsync, store, false, Settings.Top)
			if okPage then
				local list = {}
				for rank, entry in ipairs(pages:GetCurrentPage()) do
					local okName, name = pcall(Players.GetNameFromUserIdAsync, Players, tonumber(entry.key))
					table.insert(list, { rank = rank, name = okName and name or "?", value = entry.value })
				end
				out.Value = HttpService:JSONEncode(list)
			end
			task.wait(Settings.RefreshSeconds)
		end
	end)
end

return LeaderboardService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000030"><Properties><string name="Name">MapHub</string><ProtectedString name="Source">-- Sci-fi plaza dressing for the Hub (added on top of MapService.buildHub): holographic monument, neon floor
-- patterns, light pillars over stations, floating skyline towers, undercarriage. All decor (&lt;= ~190 parts).
local P = require(script.Parent.MapParts)

local V3, CF, ANG = Vector3.new, CFrame.new, CFrame.Angles
local NEON, M = Enum.Material.Neon, Enum.Material
local PI = math.pi

local H = {}

function H.decorate(hub: Instance, R: number, stations)
	local d = Instance.new("Folder")
	d.Name = "Plaza"
	local floorCol = P.Dark

	-- concentric neon rings + radial spokes (above the existing floor layers, below pads/bases)
	for i, r in ipairs({ 54, 36 }) do -- big first, so the smaller ring sits on top
		local y = 0.4 + (i - 1) * 0.04
		P.cyl(d, "FloorRing", r * 2, 0.04, CF(0, y, 0), r == 36 and P.Cyan or P.Pink, NEON, true)
		P.cyl(d, "FloorRingFill", r * 2 - 1, 0.04, CF(0, y + 0.01, 0), floorCol, M.SmoothPlastic, true)
	end
	for i = 0, 11 do
		local a = i / 12 * PI * 2
		if not (math.sin(a) &lt; -0.6) then -- keep the lane mouth clean
			local len = R - 20
			local mid = 14 + len / 2
			local ln = P.part(d, "Spoke", V3(0.6, 0.04, len), CF(math.cos(a) * mid, 0.5, math.sin(a) * mid) * ANG(0, -a + PI / 2, 0), i % 2 == 0 and P.Cyan or P.Pink, NEON, true)
			ln.Transparency = 0.3
		end
	end

	-- holographic monument: pedestal + spinning forge-gun hologram + 3 orbit rings
	local mz = 24
	local center = V3(0, 20, mz)
	P.cyl(d, "MonumentBase", 17, 1.2, CF(0, 0.9, mz), P.Dark, M.Metal, true)
	P.cyl(d, "MonumentRing", 15, 1.3, CF(0, 0.95, mz), P.Cyan, NEON, true)
	P.cyl(d, "MonumentTop", 11, 1.4, CF(0, 1, mz), P.Dark, M.Metal, true)
	local col = P.part(d, "MonumentColumn", V3(3.4, 10, 3.4), CF(0, 6, mz), P.Dark, M.Metal, true)
	P.part(d, "MonumentColumnGlow", V3(0.6, 9, 3.8), CF(0, 6, mz), P.Cyan, NEON, true)
	local emit = P.part(d, "MonumentEmitterPlate", V3(7, 0.6, 7), CF(0, 11.3, mz), P.Cyan, NEON, true)
	P.light(emit, P.Cyan, 46, 1.8)
	local function holo(name: string, size: Vector3, off: Vector3, c: Color3)
		local p = P.part(d, name, size, CF(center + off), c, NEON, true)
		p.Transparency = 0.25
		P.spin(p, center, Vector3.yAxis, 0.9)
		return p
	end
	holo("HoloSlide", V3(1.8, 2.2, 10), V3(0, 1, 0), P.Cyan)
	holo("HoloBarrel", V3(1, 1, 4), V3(0, 1.2, -6.5), P.Pink)
	holo("HoloGrip", V3(1.6, 4.5, 2.2), V3(0, -2.4, 3.2), P.Cyan)
	holo("HoloMag", V3(1.2, 3, 1.6), V3(0, -3.2, 0.4), P.Gold)
	P.ring(d, "HoloRing", center, 11, 14, "Z", 0.7, { P.Cyan, P.Pink }, NEON, 0.5)
	P.ring(d, "HoloRing", center, 13, 14, "X", 0.7, { P.Pink, P.Gold }, NEON, -0.4)
	P.ring(d, "HoloRing", center + V3(0, -5, 0), 9, 10, "Y", 0.7, { P.Cyan }, NEON, 0.8)
	P.label(col, "GUN FORGE", P.Gold, 22, 260, UDim2.fromOffset(300, 60))
	P.emitter(d, "MonumentSparks", CF(0, 12, mz), V3(9, 2, 9), { rate = 12, life = NumberRange.new(3, 4), speed = NumberRange.new(3, 6), size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0.1) }), glow = 1, color = ColorSequence.new(Color3.fromRGB(110, 230, 255), Color3.fromRGB(255, 110, 230)), spread = Vector2.new(25, 25) })
	P.emitter(d, "PlazaMotes", CF(0, 14, 0), V3(150, 24, 150), { rate = 10, life = NumberRange.new(6, 9), speed = NumberRange.new(0.5, 1.5), size = NumberSequence.new(0.5), glow = 1, color = ColorSequence.new(Color3.fromRGB(120, 220, 255)), accel = V3(0, 0.3, 0), spread = Vector2.new(180, 180) })

	-- station light pillars (faint neon shafts)
	for _, s in ipairs(stations) do
		local sh = P.part(d, "StationShaft", V3(1.2, 34, 1.2), CF(s[3], 17, s[4]), s[5], NEON, true)
		sh.Transparency = 0.78
		P.pulse(sh, 0.65, 0.9, 1.6, s[3] * 0.05)
	end

	-- floating skyline towers around the rim (skip the lane mouth)
	local n = 0
	for i = 1, 14 do
		local a = i / 14 * PI * 2
		local px, pz = math.cos(a) * (R + 22), math.sin(a) * (R + 22)
		if not (pz &lt; 0 and math.abs(px) &lt; 56) and n &lt; 10 then
			n += 1
			local h = 30 + (i * 17 % 40)
			local c = i % 2 == 0 and P.Cyan or P.Pink
			P.cyl(d, "TowerPlate", 24, 1.6, CF(px, -1, pz), P.Dark, M.Metal, true)
			P.part(d, "Tower", V3(13, h, 13), CF(px, h / 2, pz), Color3.fromRGB(34, 30, 66), M.Metal, true)
			P.part(d, "TowerBand", V3(13.4, 1.2, 13.4), CF(px, h * 0.35, pz), c, NEON, true)
			P.part(d, "TowerBand", V3(13.4, 1.2, 13.4), CF(px, h * 0.7, pz), c == P.Cyan and P.Pink or P.Cyan, NEON, true)
			P.part(d, "TowerAntenna", V3(0.8, 12, 0.8), CF(px, h + 6, pz), P.Dark, M.Metal, true)
			P.ball(d, "TowerBeacon", 2.2, CF(px, h + 12.5, pz), c, NEON)
		end
	end

	-- undercarriage so the plaza reads as a floating station
	P.cyl(d, "HubUnder", R * 2 - 6, 3, CF(0, -3.5, 0), Color3.fromRGB(30, 28, 56), M.Metal, true)
	P.cyl(d, "HubUnderGlow", R * 2 - 10, 0.5, CF(0, -5.2, 0), P.Cyan, NEON, true)
	P.cyl(d, "HubUnder", R * 1.4, 8, CF(0, -9, 0), Color3.fromRGB(26, 24, 50), M.Metal, true)
	P.cyl(d, "HubUnder", R * 0.7, 10, CF(0, -18, 0), Color3.fromRGB(22, 20, 42), M.Metal, true)

	d.Parent = hub
end

return H
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000031"><Properties><string name="Name">MapParts</string><ProtectedString name="Source">-- Part helpers + landmark builders for MapService. Everything Anchored; decor has collision/query/touch off.
local P = {}

P.Cyan = Color3.fromRGB(58, 216, 255)
P.Pink = Color3.fromRGB(255, 79, 216)
P.Gold = Color3.fromRGB(255, 201, 53)
P.Dark = Color3.fromRGB(22, 20, 42)

function P.part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, mat: Enum.Material?, decor: boolean?)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if decor then
		p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = false, false, false, false
	end
	p.Parent = parent
	return p
end

-- Upright cylinder (Roblox cylinders lie along X, so rotate).
function P.cyl(parent: Instance, name: string, diameter: number, height: number, cf: CFrame, color: Color3, mat: Enum.Material?, decor: boolean?)
	local p = P.part(parent, name, Vector3.new(height, diameter, diameter), cf * CFrame.Angles(0, 0, math.pi / 2), color, mat, decor)
	p.Shape = Enum.PartType.Cylinder
	return p
end

function P.label(adornee: BasePart, text: string, color: Color3?, offsetY: number?, maxDist: number?, size: UDim2?)
	local g = Instance.new("BillboardGui")
	g.Name = "NameLabel"
	g.Size = size or UDim2.fromOffset(220, 44)
	g.StudsOffset = Vector3.new(0, offsetY or 8, 0)
	g.MaxDistance = maxDist or 80
	g.AlwaysOnTop = true
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Text = text
	t.Font = Enum.Font.GothamBlack
	t.TextScaled = true
	t.TextColor3 = color or Color3.new(1, 1, 1)
	t.TextStrokeTransparency = 0
	t.TextStrokeColor3 = P.Dark
	t.Parent = g
	g.Parent = adornee
end

-- decor ball (diameter d)
function P.ball(parent: Instance, name: string, d: number, cf: CFrame, color: Color3, mat: Enum.Material?)
	local p = P.part(parent, name, Vector3.new(d, d, d), cf, color, mat, true)
	p.Shape = Enum.PartType.Ball
	return p
end

-- ===== Shared helpers for MapZones / MapHub =====
local CollectionService = game:GetService("CollectionService")

-- beam-shaped part between two points
function P.beam(parent: Instance, name: string, a: Vector3, b: Vector3, th: number, color: Color3, mat: Enum.Material?, decor: boolean?)
	local len = math.max((b - a).Magnitude, 0.05)
	return P.part(parent, name, Vector3.new(th, th, len), CFrame.lookAt((a + b) / 2, b), color, mat, decor)
end

-- client-animated decor (ZoneLightingController reads the tag + attributes)
function P.anim(inst: Instance, kind: string, attrs: { [string]: any }?)
	inst:SetAttribute("AnimKind", kind)
	for k, v in pairs(attrs or {}) do
		inst:SetAttribute(k, v)
	end
	CollectionService:AddTag(inst, "MapAnim")
end
function P.spin(part: BasePart, pivot: Vector3, axis: Vector3, speed: number)
	P.anim(part, "Spin", { AnimPivot = pivot, AnimAxis = axis, AnimSpeed = speed })
end
function P.pulse(part: BasePart, lo: number, hi: number, speed: number, ph: number?)
	P.anim(part, "Pulse", { AnimLo = lo, AnimHi = hi, AnimSpeed = speed, AnimPh = ph or 0 })
end

function P.light(parent: Instance, color: Color3, range: number, brightness: number)
	local l = Instance.new("PointLight")
	l.Color, l.Range, l.Brightness, l.Shadows = color, range, brightness, false
	l.Parent = parent
	return l
end

-- ambient particle volume: invisible anchored box with a ParticleEmitter (Decor=true -&gt; Low Graphics disables it)
function P.emitter(parent: Instance, name: string, cf: CFrame, size: Vector3, cfg: { [string]: any })
	local box = P.part(parent, name, size, cf, Color3.new(1, 1, 1), nil, true)
	box.Transparency = 1
	local e = Instance.new("ParticleEmitter")
	e.Shape = Enum.ParticleEmitterShape.Box
	e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	e.Texture = cfg.texture or "rbxasset://textures/particles/sparkles_main.dds"
	e.Rate = math.min(cfg.rate or 10, 15)
	e.Lifetime = cfg.life or NumberRange.new(4, 6)
	e.Speed = cfg.speed or NumberRange.new(1, 3)
	e.Size = cfg.size or NumberSequence.new(1)
	e.Transparency = cfg.transp or NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.2, 0.2), NumberSequenceKeypoint.new(0.8, 0.2), NumberSequenceKeypoint.new(1, 1) })
	e.Color = cfg.color or ColorSequence.new(Color3.new(1, 1, 1))
	e.LightEmission = cfg.glow or 0
	e.LightInfluence = cfg.influence or 0
	e.Acceleration = cfg.accel or Vector3.zero
	e.EmissionDirection = cfg.dir or Enum.NormalId.Top
	e.SpreadAngle = cfg.spread or Vector2.new(30, 30)
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = cfg.rot or NumberRange.new(-20, 20)
	e.Drag = cfg.drag or 0
	e.LockedToPart = false
	e:SetAttribute("Decor", true)
	e.Parent = box
	return box, e
end

-- vertical-ish ring of beam segments in a plane. normal = "Z" (XY plane), "X" (YZ plane) or "Y" (XZ plane)
function P.ring(parent: Instance, name: string, center: Vector3, radius: number, segs: number, normal: string, th: number, colors: { Color3 }, mat: Enum.Material?, speed: number?)
	local out = {}
	local function pt(a: number): Vector3
		local c, s = math.cos(a) * radius, math.sin(a) * radius
		if normal == "Z" then
			return center + Vector3.new(c, s, 0)
		elseif normal == "X" then
			return center + Vector3.new(0, c, s)
		end
		return center + Vector3.new(c, 0, s)
	end
	local axis = normal == "Z" and Vector3.zAxis or (normal == "X" and Vector3.xAxis or Vector3.yAxis)
	for i = 1, segs do
		local p = P.beam(parent, name, pt((i - 1) / segs * math.pi * 2), pt(i / segs * math.pi * 2), th, colors[(i - 1) % #colors + 1], mat or Enum.Material.Neon, true)
		if speed then
			P.spin(p, center, axis, speed)
		end
		out[i] = p
	end
	return out
end

local NEON, ROCK = Enum.Material.Neon, Enum.Material.Slate

-- ===== Roadside scenery (OUTSIDE the lane walls). All decor. GY = outland ground height. =====
P.GY = -1
local GY = P.GY
local V3, CF, ANG = Vector3.new, CFrame.new, CFrame.Angles
local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end
local function tilt(rng: Random, a: number): CFrame
	return ANG(rng:NextNumber(-a, a), rng:NextNumber(0, 6.28), rng:NextNumber(-a, a))
end

-- Slot scenery: (parent, x, z, rng). One cluster per slot (~4-8 parts).
local S = {}
function S.meadow(m, x, z, rng)
	local k = rng:NextInteger(1, 3)
	if k &lt;= 2 then
		local h = rng:NextNumber(7, 11)
		P.cyl(m, "Trunk", 2.2, h, CF(x, GY + h / 2, z), rgb(120, 82, 52), Enum.Material.Wood, true)
		local g1 = rgb(86, 190, 90):Lerp(rgb(150, 225, 100), rng:NextNumber())
		P.ball(m, "Leaf", 10, CF(x, GY + h + 2, z), g1, Enum.Material.Grass)
		P.ball(m, "Leaf", 7.5, CF(x + 1.5, GY + h + 7, z - 1), g1:Lerp(Color3.new(1, 1, 1), 0.12), Enum.Material.Grass)
		P.ball(m, "Leaf", 5.5, CF(x - 2.5, GY + h + 0.5, z + 2.5), g1:Lerp(Color3.new(0, 0, 0), 0.1), Enum.Material.Grass)
	else
		P.part(m, "Rock", V3(6, 4, 5), CF(x, GY + 1.6, z) * tilt(rng, 0.2), rgb(150, 156, 150), ROCK, true)
		P.part(m, "Rock", V3(3.5, 2.5, 3), CF(x + 4, GY + 1, z + 2) * tilt(rng, 0.3), rgb(130, 140, 135), ROCK, true)
		P.ball(m, "Bush", 5, CF(x - 4, GY + 1.6, z - 1), rgb(70, 170, 80), Enum.Material.Grass)
	end
	local cols = { rgb(255, 120, 190), rgb(255, 220, 90), rgb(255, 255, 255), rgb(130, 220, 255) }
	for i = 1, 3 do
		P.ball(m, "Flower", 1.2, CF(x + rng:NextNumber(-7, 7), GY + 0.7, z + rng:NextNumber(-7, 7)), cols[(i + rng:NextInteger(0, 3)) % 4 + 1], NEON)
	end
end

function S.desert(m, x, z, rng)
	local k = rng:NextInteger(1, 3)
	if k == 1 then
		P.cyl(m, "Cactus", 2.4, 9, CF(x, GY + 4.5, z), rgb(80, 140, 80), Enum.Material.Grass, true)
		P.part(m, "Arm", V3(3, 1.4, 1.4), CF(x + 2, GY + 4.5, z), rgb(80, 140, 80), Enum.Material.Grass, true)
		P.part(m, "Arm", V3(1.4, 4, 1.4), CF(x + 3.3, GY + 6.3, z), rgb(80, 140, 80), Enum.Material.Grass, true)
	elseif k == 2 then
		local yaw = ANG(0, rng:NextNumber(0, 3), 0)
		P.part(m, "Mesa", V3(14, 16, 12), CF(x, GY + 8, z) * yaw, rgb(196, 112, 72), Enum.Material.Sandstone, true)
		P.part(m, "MesaBand", V3(14.3, 3, 12.3), CF(x, GY + 11, z) * yaw, rgb(235, 175, 110), Enum.Material.Sandstone, true)
		P.part(m, "MesaCap", V3(15, 1.2, 13), CF(x, GY + 16.4, z) * yaw, rgb(150, 85, 60), Enum.Material.Rock, true)
	else
		P.part(m, "Rock", V3(6, 4, 5), CF(x, GY + 1.6, z) * tilt(rng, 0.2), rgb(214, 170, 112), Enum.Material.Sandstone, true)
		P.part(m, "Rock", V3(3.5, 2.5, 3), CF(x + 4, GY + 1, z + 2) * tilt(rng, 0.3), rgb(190, 140, 95), Enum.Material.Sandstone, true)
		P.part(m, "Bone", V3(0.8, 0.8, 7), CF(x - 3, GY + 0.5, z - 3) * ANG(0, rng:NextNumber(0, 3), 0), rgb(235, 230, 215), Enum.Material.SmoothPlastic, true)
	end
end

function S.frost(m, x, z, rng)
	local k = rng:NextInteger(1, 3)
	if k == 1 then
		local pine, snow = rgb(52, 105, 110), rgb(240, 250, 255)
		P.part(m, "Trunk", V3(1.6, 3, 1.6), CF(x, GY + 1.5, z), rgb(90, 70, 60), Enum.Material.Wood, true)
		P.part(m, "Tier", V3(10, 3, 10), CF(x, GY + 4, z) * ANG(0, 0.78, 0), pine, Enum.Material.Slate, true)
		P.part(m, "Tier", V3(7.5, 3, 7.5), CF(x, GY + 7, z) * ANG(0, 0.78, 0), pine, Enum.Material.Slate, true)
		P.part(m, "Tier", V3(5, 3, 5), CF(x, GY + 10, z) * ANG(0, 0.78, 0), snow, Enum.Material.Snow, true)
	elseif k == 2 then
		for i = 1, 3 do
			local h = rng:NextNumber(9, 17)
			P.part(m, "Crystal", V3(2.6, h, 2.6), CF(x + (i - 2) * 3.4, GY + h / 2 - 0.5, z + rng:NextNumber(-2, 2)) * ANG(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 3), rng:NextNumber(-0.3, 0.3)), rgb(150, 220, 255), Enum.Material.Glass, true)
		end
		P.ball(m, "Glow", 2, CF(x, GY + 2, z), rgb(140, 230, 255), NEON)
	else
		P.cyl(m, "Drift", 10, 3, CF(x, GY + 1, z), rgb(245, 250, 255), Enum.Material.Snow, true)
		P.part(m, "Rock", V3(4, 3, 4), CF(x + 3, GY + 1.5, z + 1) * tilt(rng, 0.3), rgb(120, 135, 160), ROCK, true)
		P.ball(m, "Drift", 5, CF(x - 3, GY + 0.5, z - 2), rgb(235, 245, 255), Enum.Material.Snow)
	end
end

function S.magma(m, x, z, rng)
	local k = rng:NextInteger(1, 3)
	if k == 1 then
		local cf = CF(x, GY + 8, z) * tilt(rng, 0.15)
		P.part(m, "Spire", V3(6, 18, 6), cf, rgb(48, 36, 36), Enum.Material.Basalt, true)
		P.part(m, "Vein", V3(0.8, 14, 0.8), cf * CF(2.9, 0, 0), rgb(255, 110, 30), NEON, true)
		P.part(m, "Rock", V3(5, 3, 5), CF(x + 5, GY + 1.2, z + 1) * tilt(rng, 0.3), rgb(60, 44, 42), Enum.Material.Basalt, true)
	elseif k == 2 then
		P.cyl(m, "PoolRim", 14, 0.5, CF(x, GY + 0.1, z), rgb(40, 30, 30), Enum.Material.Basalt, true)
		P.cyl(m, "Lava", 11, 0.5, CF(x, GY + 0.2, z), rgb(255, 110, 30), NEON, true)
		P.ball(m, "Ember", 1.1, CF(x + 1, GY + rng:NextNumber(5, 12), z), rgb(255, 190, 70), NEON)
		P.ball(m, "Ember", 0.8, CF(x - 2, GY + rng:NextNumber(3, 9), z + 2), rgb(255, 140, 40), NEON)
	else
		P.part(m, "Rock", V3(7, 5, 6), CF(x, GY + 2, z) * tilt(rng, 0.25), rgb(55, 42, 40), Enum.Material.Basalt, true)
		P.part(m, "Rock", V3(4, 3, 4), CF(x + 4, GY + 1, z - 2) * tilt(rng, 0.3), rgb(70, 50, 44), Enum.Material.Basalt, true)
		P.part(m, "Crack", V3(0.6, 0.2, 9), CF(x - 3, GY + 0.15, z) * ANG(0, rng:NextNumber(0, 3), 0), rgb(255, 100, 30), NEON, true)
	end
end

function S.void(m, x, z, rng)
	local k = rng:NextInteger(1, 3)
	local c = (z // 24) % 2 == 0 and P.Pink or P.Cyan
	if k == 1 then
		local h = rng:NextNumber(18, 34)
		P.part(m, "Base", V3(4.5, 1, 4.5), CF(x, GY + 0.5, z), P.Dark, Enum.Material.Metal, true)
		P.part(m, "Pillar", V3(2, h, 2), CF(x, GY + h / 2, z), c, NEON, true)
		P.ball(m, "Orb", 3, CF(x, GY + h + 2, z), c:Lerp(Color3.new(1, 1, 1), 0.4), NEON)
	elseif k == 2 then
		for i = 1, 2 do
			local s = rng:NextNumber(3, 5)
			local cf = CF(x + (i - 1.5) * 5, GY + rng:NextNumber(9, 18), z) * tilt(rng, 0.8)
			P.part(m, "Cube", V3(s, s, s), cf, rgb(90, 50, 170), Enum.Material.Glass, true)
			P.part(m, "Core", V3(s * 0.4, s * 0.4, s * 0.4), cf, c, NEON, true)
		end
	else
		P.part(m, "Base", V3(5, 1, 5), CF(x, GY + 0.5, z), P.Dark, Enum.Material.Metal, true)
		P.part(m, "Crystal", V3(3, 11, 3), CF(x, GY + 6, z) * tilt(rng, 0.25), c, NEON, true)
		P.part(m, "Crystal", V3(2, 7, 2), CF(x + 3, GY + 4, z + 1) * tilt(rng, 0.4), c:Lerp(Color3.new(1, 1, 1), 0.3), NEON, true)
	end
end
P.Scenery = S

-- Background silhouettes far outside the walls (hills / mesas / ice / basalt / monoliths).
local B = {}
function B.meadow(m, x, z, rng)
	local d = rng:NextNumber(40, 64)
	P.ball(m, "Hill", d, CF(x, GY - d * 0.28, z), rgb(96, 176, 84):Lerp(rgb(140, 210, 100), rng:NextNumber()), Enum.Material.Grass)
end
function B.desert(m, x, z, rng)
	local h = rng:NextNumber(30, 52)
	local yaw = ANG(0, rng:NextNumber(0, 3), 0)
	P.part(m, "Butte", V3(rng:NextNumber(22, 32), h, rng:NextNumber(20, 28)), CF(x, GY + h / 2, z) * yaw, rgb(190, 108, 70), Enum.Material.Sandstone, true)
	P.part(m, "ButteCap", V3(34, 2, 30), CF(x, GY + h, z) * yaw, rgb(240, 190, 120), Enum.Material.Sandstone, true)
end
function B.frost(m, x, z, rng)
	local h = rng:NextNumber(36, 64)
	P.part(m, "Berg", V3(rng:NextNumber(18, 26), h, rng:NextNumber(18, 26)), CF(x, GY + h / 2 - 2, z) * tilt(rng, 0.12), rgb(190, 225, 245), Enum.Material.Ice, true)
	P.part(m, "BergCap", V3(10, 6, 10), CF(x, GY + h - 1, z) * ANG(0, rng:NextNumber(0, 3), 0.2), rgb(250, 253, 255), Enum.Material.Snow, true)
end
function B.magma(m, x, z, rng)
	local h = rng:NextNumber(38, 70)
	local cf = CF(x, GY + h / 2, z) * tilt(rng, 0.1)
	P.part(m, "Crag", V3(rng:NextNumber(20, 30), h, rng:NextNumber(18, 26)), cf, rgb(44, 32, 32), Enum.Material.Basalt, true)
	P.part(m, "CragGlow", V3(1.6, h * 0.8, 1.6), cf * CF(10, -h * 0.05, 0), rgb(255, 100, 30), NEON, true)
end
function B.void(m, x, z, rng)
	local h = rng:NextNumber(50, 100)
	P.part(m, "Monolith", V3(12, h, 12), CF(x, GY + h / 2, z) * ANG(0, rng:NextNumber(0, 1.5), 0), rgb(26, 18, 52), Enum.Material.Slate, true)
	P.part(m, "MonolithEdge", V3(0.8, h, 0.8), CF(x + 6, GY + h / 2, z + 6), (z // 30) % 2 == 0 and P.Pink or P.Cyan, NEON, true)
end
P.Backdrop = B

return P
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000032"><Properties><string name="Name">MapService</string><ProtectedString name="Source">-- Builds workspace.Map in code (Hub, linear Lane of 5 Zones, Arena). Names are contracts for other services:
--   Map.Hub{TrainingPads/Pad1..6, TrainingDummies/Dummy1..6, Booth_*, Forge, FusionAltar, RebirthStatue, ArenaPortal,
--           ClanBoard, CodesBoard, SpawnLocation, BossPit, Portal_&lt;zoneId&gt;}
--   Map.Zones.&lt;id&gt;{Ground, SpawnArea, Gate(PowerReq, ZoneId), ReturnPortal_&lt;id&gt;, Landmark, Scenery}   Map.Arena.Arena1..3{SpawnA, SpawnB}
-- Layout: hub at origin, ONE straight road towards -Z (48 wide), stage i = Zones[i].center/size, 30-stud bridges between stages.
-- Stage set-pieces live in MapZones (Terrain + decor + emitters), hub plaza dressing in MapHub. Perf: all Anchored; decor has
-- CanCollide/CanQuery/CanTouch/CastShadow off; part count is printed at init (budget 4000).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Zones = require(ReplicatedStorage.Shared.Config.Zones)
local World = require(ReplicatedStorage.Shared.Config.World)
local Combat = require(ReplicatedStorage.Shared.Config.Combat)
local P = require(script.Parent.MapParts)
local MapZones = require(script.Parent.MapZones)
local MapHub = require(script.Parent.MapHub)

local part, cyl = P.part, P.cyl
local NEON = Enum.Material.Neon
local MapService = {}

local ZONE_MAT = {
	meadow = Enum.Material.Grass, desert = Enum.Material.Sand, frost = Enum.Material.Snow,
	magma = Enum.Material.Basalt, void = Enum.Material.Slate,
}
local ZONE_ACCENT = {
	meadow = P.Cyan, desert = P.Gold, frost = Color3.fromRGB(150, 220, 255),
	magma = Color3.fromRGB(255, 110, 30), void = P.Pink,
}

local function folder(parent: Instance, name: string)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function model(parent: Instance, name: string)
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

local function invisible(p: Part)
	p.Transparency = 1
	p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = false, false, false, false
end

-- ===== Hub =====
local function fmtPower(n: number): string
	if n &gt;= 1e6 then
		return string.format("%gM", n / 1e6)
	elseif n &gt;= 1e3 then
		return string.format("%gK", n / 1e3)
	end
	return tostring(n)
end

local STATIONS = { -- name, label, x, z, color  (all on the +Z side / flanks; the -Z side is the lane mouth)
	{ "Booth_TargetRush", "TARGET RUSH", -54, 40, P.Cyan },
	{ "Booth_ReloadRhythm", "RELOAD RHYTHM", -27, 40, P.Pink },
	{ "Booth_LuckyCrate", "LUCKY CRATE", 0, 40, P.Gold },
	{ "Forge", "THE FORGE", 27, 40, Color3.fromRGB(255, 120, 40) },
	{ "FusionAltar", "FUSION ALTAR", 54, 40, P.Pink },
	{ "RebirthStatue", "REBIRTH", -66, 16, P.Gold },
	{ "ArenaPortal", "PVP ARENA", 66, 16, Color3.fromRGB(255, 80, 80) },
	{ "ClanBoard", "CLAN HALL", -66, -14, P.Cyan },
	{ "CodesBoard", "CODES", 66, -14, Color3.fromRGB(120, 255, 150) },
}
local MOUTH_Z = -68 -- where the lane walls / arch start (inside the hub rim)

local function buildHub(map: Model)
	local hub = model(map, "Hub")
	local R = World.HubRadius
	local halfLane = Zones.LaneWidth / 2
	cyl(hub, "Floor", R * 2, 2, CFrame.new(0, -1, 0), P.Dark, Enum.Material.Metal)
	cyl(hub, "FloorInlay", R * 2 - 16, 0.2, CFrame.new(0, 0.05, 0), Color3.fromRGB(40, 36, 80), Enum.Material.SmoothPlastic, true)
	cyl(hub, "NeonRing", R * 2 - 4, 0.3, CFrame.new(0, 0.1, 0), P.Cyan, NEON, true)
	cyl(hub, "NeonRingInner", R * 2 - 8, 0.4, CFrame.new(0, 0.12, 0), P.Dark, Enum.Material.SmoothPlastic, true)
	cyl(hub, "SpawnRing", 24, 0.3, CFrame.new(0, 0.55, 0), P.Pink, NEON, true)
	cyl(hub, "SpawnRingInner", 21, 0.35, CFrame.new(0, 0.57, 0), Color3.fromRGB(40, 36, 80), Enum.Material.SmoothPlastic, true)
	for i = 1, 28 do -- edge pylons (skip the lane mouth)
		local a = i / 28 * math.pi * 2
		local px, pz = math.cos(a) * (R - 1), math.sin(a) * (R - 1)
		if not (pz &lt; 0 and math.abs(px) &lt; 34) then
			local c = CFrame.new(px, 0, pz)
			part(hub, "Pylon", Vector3.new(2, 7, 2), c * CFrame.new(0, 3.5, 0), P.Dark, Enum.Material.Metal, true)
			part(hub, "PylonLight", Vector3.new(2.4, 1.2, 2.4), c * CFrame.new(0, 7.4, 0), i % 2 == 0 and P.Cyan or P.Pink, NEON, true)
		end
	end

	-- lane mouth: apron (hub edge -&gt; stage 1 gate), clear and wide
	local apronLen = math.abs(Zones[1].gatePos.Z - MOUTH_Z)
	part(hub, "LaneApron", Vector3.new(Zones.LaneWidth, 2, apronLen), CFrame.new(0, -1.05, (MOUTH_Z + Zones[1].gatePos.Z) / 2), P.Dark, Enum.Material.Metal)
	for side = -1, 1, 2 do
		part(hub, "ApronEdge", Vector3.new(0.8, 0.2, apronLen), CFrame.new(side * (halfLane - 0.6), 0.12, (MOUTH_Z + Zones[1].gatePos.Z) / 2), P.Cyan, NEON, true)
	end
	for n = 0, 5 do -- chevrons leading the eye down the lane
		part(hub, "Chevron", Vector3.new(14, 0.1, 1.2), CFrame.new(0, 0.56, -12 - n * 11), P.Gold, NEON, true).Transparency = 0.2 + n * 0.1
	end
	-- big arch "ADVENTURE -&gt;"
	for side = -1, 1, 2 do
		part(hub, "ArchPillar", Vector3.new(4, 30, 4), CFrame.new(side * 28, 15, MOUTH_Z), P.Dark, Enum.Material.Metal, true)
		part(hub, "ArchGlow", Vector3.new(1, 28, 4.4), CFrame.new(side * 28 - side * 2.1, 15, MOUTH_Z), P.Gold, NEON, true)
	end
	local beam = part(hub, "ArchBeam", Vector3.new(64, 7, 5), CFrame.new(0, 31, MOUTH_Z), P.Dark, Enum.Material.Metal, true)
	part(hub, "ArchTrim", Vector3.new(64.4, 1, 5.4), CFrame.new(0, 27.4, MOUTH_Z), P.Gold, NEON, true)
	part(hub, "ArchTrim", Vector3.new(64.4, 1, 5.4), CFrame.new(0, 34.6, MOUTH_Z), P.Cyan, NEON, true)
	P.label(beam, "ADVENTURE  →", P.Gold, 0, 600, UDim2.fromOffset(520, 100))

	local sp = Instance.new("SpawnLocation")
	sp.Anchored, sp.Size, sp.Position = true, Vector3.new(14, 1, 14), Vector3.new(0, 0.5, 0)
	sp.Material, sp.Neutral, sp.Duration, sp.TopSurface = NEON, true, 0, Enum.SurfaceType.Smooth
	sp.Color = Color3.fromRGB(58, 120, 200)
	sp.Parent = hub

	-- training range: Pad1..3 left column, Pad4..6 right column; dummy 14 studs in front (outwards)
	local pads = folder(hub, "TrainingPads")
	local dummies = folder(hub, "TrainingDummies")
	local dDecor = folder(hub, "TrainingDummyDecor")
	for i = 1, 6 do
		local side = i &lt;= 3 and -1 or 1
		local z = ({ -25, -5, 15 })[(i - 1) % 3 + 1]
		local pos = Vector3.new(side * 30, 0.5, z)
		local face = CFrame.lookAt(pos, pos + Vector3.new(side, 0, 0))
		part(pads, "Pad" .. i, Vector3.new(10, 1, 10), face, P.Dark, Enum.Material.Metal)
		part(pads, "PadGlow", Vector3.new(8, 0.3, 8), face + Vector3.new(0, 0.55, 0), P.Cyan, NEON, true)
		part(pads, "PadArrow", Vector3.new(2, 0.2, 4), face * CFrame.new(0, 0.7, -2), P.Gold, NEON, true)
		local dx = side * (30 + 14)
		local board = cyl(dummies, "Dummy" .. i, 8, 1, CFrame.new(dx, 7, z) * CFrame.Angles(0, 0, math.pi / 2) * CFrame.Angles(0, 0, 0), Color3.fromRGB(240, 240, 240), Enum.Material.SmoothPlastic)
		board.CFrame = CFrame.new(dx, 7, z) -- cylinder axis = X, i.e. the face points at the pad
		board.CanCollide = false
		part(dDecor, "DummyRing", Vector3.new(0.3, 5.6, 5.6), CFrame.new(dx - side * 0.6, 7, z), Color3.fromRGB(255, 70, 70), Enum.Material.SmoothPlastic, true).Shape = Enum.PartType.Cylinder
		part(dDecor, "DummyRing", Vector3.new(0.3, 3.2, 3.2), CFrame.new(dx - side * 0.7, 7, z), Color3.fromRGB(245, 245, 245), Enum.Material.SmoothPlastic, true).Shape = Enum.PartType.Cylinder
		part(dDecor, "DummyBull", Vector3.new(0.3, 1.2, 1.2), CFrame.new(dx - side * 0.8, 7, z), Color3.fromRGB(255, 70, 70), NEON, true).Shape = Enum.PartType.Cylinder
		part(dDecor, "DummyPost", Vector3.new(1, 4, 1), CFrame.new(dx + side * 0.2, 2, z), P.Dark, Enum.Material.Metal, true)
		part(dDecor, "DummyBase", Vector3.new(4, 0.6, 4), CFrame.new(dx + side * 0.2, 0.3, z), P.Cyan, NEON, true)
	end

	for _, s in ipairs(STATIONS) do
		local pos = Vector3.new(s[3], 0, s[4])
		local face = CFrame.lookAt(pos, Vector3.new(0, 0, 0))
		cyl(hub, s[1] .. "_Base", 14, 0.6, CFrame.new(pos + Vector3.new(0, 0.3, 0)), P.Dark, Enum.Material.Metal, true)
		cyl(hub, s[1] .. "_Glow", 12.5, 0.7, CFrame.new(pos + Vector3.new(0, 0.32, 0)), s[5], NEON, true)
		local blk = part(hub, s[1], Vector3.new(8, 8, 8), face + Vector3.new(0, 4.6, 0), Color3.fromRGB(46, 42, 88), Enum.Material.Metal)
		part(hub, s[1] .. "_Trim", Vector3.new(8.4, 1, 8.4), face + Vector3.new(0, 9, 0), s[5], NEON, true)
		part(hub, s[1] .. "_Face", Vector3.new(5, 4, 0.4), face * CFrame.new(0, 5.6, -4.1), s[5], NEON, true)
		P.label(blk, s[2], s[5], 8)
	end

	-- teleport portals (StationService adds the prompts): glowing pad + small arch, in a row near the lane mouth
	for n, z in ipairs(Zones) do
		local acc = ZONE_ACCENT[z.id] or P.Cyan
		local px, pz = (n - 3) * 20, -50
		part(hub, "PortalRim_" .. z.id, Vector3.new(0.5, 12.6, 12.6), CFrame.new(px, 0.25, pz) * CFrame.Angles(0, 0, math.pi / 2), P.Dark, Enum.Material.Metal, true).Shape = Enum.PartType.Cylinder
		local pad = cyl(hub, "Portal_" .. z.id, 11, 0.5, CFrame.new(px, 0.35, pz), acc, NEON)
		pad.CanCollide = false
		pad:SetAttribute("ZoneId", z.id)
		pad:SetAttribute("PowerReq", z.powerReq)
		pad.CastShadow = false
		for side = -1, 1, 2 do
			part(hub, "PortalPost", Vector3.new(1, 13, 1), CFrame.new(px + side * 5.5, 6.5, pz), P.Dark, Enum.Material.Metal, true)
			part(hub, "PortalGlow", Vector3.new(0.6, 12, 1.2), CFrame.new(px + side * 5.5, 6.5, pz), acc, NEON, true)
		end
		part(hub, "PortalTop", Vector3.new(12, 1, 1.4), CFrame.new(px, 13.2, pz), acc, NEON, true)
		part(hub, "PortalVeil", Vector3.new(10, 12, 0.2), CFrame.new(px, 6.6, pz), acc, Enum.Material.ForceField, true)
		P.label(pad, z.name .. "\nPower " .. fmtPower(z.powerReq), acc, 11, 120, UDim2.fromOffset(240, 64))
	end

	local bp = Combat.WorldBoss.Position
	local pit = part(hub, "BossPit", Vector3.new(60, 1, 60), CFrame.new(bp.X, bp.Y - 0.3, bp.Z), Color3.fromRGB(60, 25, 40), Enum.Material.Basalt)
	for i = 1, 4 do
		local a = i * math.pi / 2
		local d = Vector3.new(math.cos(a), 0, math.sin(a))
		local sz = Vector3.new(i % 2 == 0 and 60 or 1.2, 0.4, i % 2 == 0 and 1.2 or 60)
		part(hub, "BossRim", sz, CFrame.new(pit.Position + d * 30 + Vector3.new(0, 0.7, 0)), Color3.fromRGB(255, 60, 90), NEON, true)
	end
	P.label(pit, "WORLD BOSS", Color3.fromRGB(255, 90, 110), 10)
	MapHub.decorate(hub, R, STATIONS)
end

-- ===== Zones (one straight lane) =====
local THEME = { -- outland ground + bridge look + road patch style
	meadow = { out = Color3.fromRGB(92, 168, 80), outMat = Enum.Material.Grass, bridge = Color3.fromRGB(150, 110, 70), bridgeMat = Enum.Material.WoodPlanks, patch = Color3.fromRGB(135, 215, 110), patchMat = Enum.Material.Grass },
	desert = { out = Color3.fromRGB(205, 160, 105), outMat = Enum.Material.Sand, bridge = Color3.fromRGB(120, 95, 75), bridgeMat = Enum.Material.CorrodedMetal, patch = Color3.fromRGB(200, 160, 100), patchMat = Enum.Material.Sand },
	frost = { out = Color3.fromRGB(215, 235, 250), outMat = Enum.Material.Snow, bridge = Color3.fromRGB(150, 200, 235), bridgeMat = Enum.Material.Ice, patch = Color3.fromRGB(170, 215, 245), patchMat = Enum.Material.Ice },
	magma = { out = Color3.fromRGB(38, 28, 28), outMat = Enum.Material.Basalt, bridge = Color3.fromRGB(30, 26, 28), bridgeMat = Enum.Material.Metal, patch = Color3.fromRGB(255, 100, 30), patchMat = NEON },
	void = { out = Color3.fromRGB(20, 12, 40), outMat = Enum.Material.Slate, bridge = Color3.fromRGB(26, 18, 50), bridgeMat = Enum.Material.Metal, patch = Color3.fromRGB(150, 70, 255), patchMat = NEON },
}

local function buildZone(parent: Folder, z, index: number)
	local m = model(parent, z.id)
	local accent = ZONE_ACCENT[z.id] or P.Cyan
	local th = THEME[z.id]
	local W, L, G = Zones.LaneWidth, Zones.StageLength, Zones.Gap
	local half = W / 2
	local cx = z.center.X
	local startZ, endZ = z.gatePos.Z, z.center.Z - L / 2
	local wallStart = index == 1 and MOUTH_Z or startZ + G -- hub-side end of this stage's walls (incl. bridge)
	local wallLen = wallStart - endZ
	local wallMid = (wallStart + endZ) / 2
	local rng = Random.new(index * 7919)

	part(m, "Ground", Vector3.new(W, 2, L), CFrame.new(cx, -1, z.center.Z), z.color, ZONE_MAT[z.id] or Enum.Material.Slate)
	local sa = part(m, "SpawnArea", Vector3.new(W, 1, L), CFrame.new(cx, 0, z.center.Z), accent, nil)
	invisible(sa)

	-- bridge over the 30-stud gap (hub side of the gate), same straight road
	if index &gt; 1 then
		part(m, "Bridge", Vector3.new(W, 2, G), CFrame.new(cx, -1, startZ + G / 2), th.bridge, th.bridgeMat)
		for side = -1, 1, 2 do
			part(m, "BridgeRail", Vector3.new(0.8, 0.2, G), CFrame.new(cx + side * (half - 0.6), 0.12, startZ + G / 2), accent, NEON, true)
		end
		for n = 1, 4 do
			part(m, "BridgePlank", Vector3.new(W - 2, 0.1, 0.5), CFrame.new(cx, 0.06, startZ + n * G / 5), th.bridge:Lerp(Color3.new(1, 1, 1), 0.15), th.bridgeMat, true)
		end
	end

	-- invisible side walls (+ end wall on the last stage)
	for side = -1, 1, 2 do
		local w = part(m, "SideWall", Vector3.new(2, 60, wallLen), CFrame.new(cx + side * (half + 1), 30, wallMid), accent, nil)
		w.Transparency = 1
		w.CanQuery, w.CanTouch, w.CastShadow = false, false, false
	end
	if index == #Zones then
		local ew = part(m, "EndWall", Vector3.new(W + 4, 60, 2), CFrame.new(cx, 30, endZ - 1), accent, nil)
		ew.Transparency = 1
		ew.CanQuery, ew.CanTouch, ew.CastShadow = false, false, false
	end

	-- lane dressing: curbs, edge lines, dashed centre line, themed path patches
	local decor = folder(m, "Dressing")
	for side = -1, 1, 2 do
		part(decor, "Curb", Vector3.new(1.6, 1.2, wallLen), CFrame.new(cx + side * (half - 0.2), 0.4, wallMid), P.Dark:Lerp(z.color, 0.25), Enum.Material.Concrete, true)
		part(decor, "EdgeLine", Vector3.new(0.5, 0.15, L), CFrame.new(cx + side * (half - 1.4), 0.08, z.center.Z), accent, NEON, true)
	end
	for zz = startZ - 12, endZ + 8, -24 do
		part(decor, "Dash", Vector3.new(1.2, 0.1, 9), CFrame.new(cx, 0.06, zz), accent, NEON, true).Transparency = 0.45
	end
	for _ = 1, 14 do
		local s = rng:NextNumber(6, 12)
		local c = th.patch:Lerp(z.color, rng:NextNumber(0.2, 0.6))
		local p = part(decor, "Patch", Vector3.new(s, 0.06, s * rng:NextNumber(0.6, 1.2)), CFrame.new(cx + rng:NextNumber(-half + 7, half - 7), 0.03, rng:NextNumber(endZ + 15, startZ - 15)) * CFrame.Angles(0, rng:NextNumber(0, 3), 0), c, th.patchMat, true)
		if th.patchMat == NEON then
			p.Size = Vector3.new(rng:NextNumber(0.4, 0.9), 0.06, rng:NextNumber(8, 18))
			p.Transparency = 0.25
		end
	end
	for zz = startZ - 40, endZ + 40, -60 do -- lamps on the wall line
		for side = -1, 1, 2 do
			part(decor, "LampPost", Vector3.new(0.8, 9, 0.8), CFrame.new(cx + side * (half + 2.2), 4.5, zz), P.Dark, Enum.Material.Metal, true)
			P.ball(decor, "LampBulb", 2, CFrame.new(cx + side * (half + 2.2), 9.4, zz), accent, NEON)
		end
	end

	-- gate (force field) at the stage start + frame + label
	local gate = part(m, "Gate", Vector3.new(W, 30, 2), CFrame.new(cx, 15, startZ), accent, Enum.Material.ForceField)
	gate:SetAttribute("PowerReq", z.powerReq)
	gate:SetAttribute("ZoneId", z.id)
	gate.CastShadow = false
	for side = -1, 1, 2 do
		part(decor, "GatePost", Vector3.new(4, 34, 4), CFrame.new(cx + side * (half + 3), 17, startZ), P.Dark, Enum.Material.Metal, true)
		part(decor, "GateLight", Vector3.new(4.6, 2, 4.6), CFrame.new(cx + side * (half + 3), 35, startZ), accent, NEON, true)
	end
	part(decor, "GateBeam", Vector3.new(W + 10, 3, 4), CFrame.new(cx, 32, startZ), P.Dark, Enum.Material.Metal, true)
	part(decor, "GateBeamGlow", Vector3.new(W + 10.4, 0.8, 4.4), CFrame.new(cx, 30.2, startZ), accent, NEON, true)
	P.label(gate, z.name .. "  |  Power " .. fmtPower(z.powerReq), accent, 21, 400, UDim2.fromOffset(420, 60))

	-- return portal just inside the gate
	local rp = cyl(m, "ReturnPortal_" .. z.id, 10, 0.5, CFrame.new(cx, 0.35, startZ - 12), accent, NEON)
	rp.CanCollide, rp.CastShadow = false, false
	rp:SetAttribute("ZoneId", z.id)
	cyl(decor, "ReturnRim", 11.6, 0.4, CFrame.new(cx, 0.25, startZ - 12), P.Dark, Enum.Material.Metal, true)
	P.label(rp, "Back to Hub", Color3.new(1, 1, 1), 4, 70, UDim2.fromOffset(180, 36))

	-- boss arena decoration (inside the road: flat, walkable)
	local bp = z.bossPos
	cyl(decor, "BossRing", 42, 0.3, CFrame.new(bp.X, 0.15, bp.Z), accent, NEON)
	cyl(decor, "BossDisc", 39, 0.4, CFrame.new(bp.X, 0.18, bp.Z), P.Dark:Lerp(z.color, 0.3), Enum.Material.Slate)
	cyl(decor, "BossCore", 12, 0.5, CFrame.new(bp.X, 0.22, bp.Z), accent, NEON)
	for n = 1, 8 do
		local a = n / 8 * math.pi * 2
		part(decor, "BossRune", Vector3.new(1, 0.2, 5), CFrame.new(bp.X + math.cos(a) * 15, 0.3, bp.Z + math.sin(a) * 15) * CFrame.Angles(0, -a, 0), accent, NEON, true)
	end
	for side = -1, 1, 2 do -- tall banner towers outside the walls + arch at the far end
		part(decor, "BossTower", Vector3.new(7, 40, 7), CFrame.new(cx + side * (half + 8), 20, bp.Z), P.Dark:Lerp(z.color, 0.2), Enum.Material.Slate, true)
		part(decor, "BossTowerGlow", Vector3.new(7.4, 3, 7.4), CFrame.new(cx + side * (half + 8), 41, bp.Z), accent, NEON, true)
		part(decor, "EndPillar", Vector3.new(4, 36, 4), CFrame.new(cx + side * (half + 3), 18, endZ + 2), P.Dark, Enum.Material.Metal, true)
	end
	part(decor, "EndBeam", Vector3.new(W + 10, 4, 4), CFrame.new(cx, 34, endZ + 2), P.Dark, Enum.Material.Metal, true)
	part(decor, "EndGlow", Vector3.new(W + 10.4, 1, 4.4), CFrame.new(cx, 31.6, endZ + 2), accent, NEON, true)

	-- stage identity: terrain, set-pieces, arches, road detail, particles, landmark (MapZones)
	local lside = index % 2 == 1 and 1 or -1
	MapZones.build({ m = m, z = z, cx = cx, half = half, startZ = startZ, endZ = endZ, accent = accent, rng = Random.new(index * 104729), lside = lside })

	-- outland ground + roadside scenery + background silhouettes (decor only)
	local sc = folder(m, "Scenery")
	local outLen = wallStart - endZ + 20
	for side = -1, 1, 2 do
		part(sc, "Outland", Vector3.new(130, 4, outLen), CFrame.new(cx + side * (half + 65), -3, wallStart - outLen / 2 + 10), th.out, th.outMat, true)
	end
	local slotTop = index == 1 and wallStart - 10 or startZ + G - 6
	for zz = slotTop, endZ + 10, -30 do
		for side = -1, 1, 2 do
			do
				P.Scenery[z.id](sc, cx + side * (half + 8 + rng:NextNumber(0, 12)), zz + rng:NextNumber(-5, 5), rng)
			end
		end
	end
	if z.id == "void" then -- other stages use Terrain hills/cliffs instead of part silhouettes
		for zz = slotTop, endZ + 10, -56 do
			for side = -1, 1, 2 do
				P.Backdrop[z.id](sc, cx + side * (half + 62 + rng:NextNumber(0, 40)), zz + rng:NextNumber(-8, 8), rng)
			end
		end
	end
end

-- ===== Arena =====
local COVER = { -- x, z, sx, sz  (mirrored by 180 degrees -&gt; symmetric)
	{ { 20, 0, 12, 12 }, { 0, 25, 24, 6 }, { 38, 30, 8, 8 } },
	{ { 25, 10, 6, 6 }, { 10, 30, 6, 6 }, { 38, -10, 6, 6 }, { 0, 0, 14, 14 } },
	{ { 0, 14, 40, 5 }, { 28, 28, 10, 10 }, { 30, -8, 5, 20 } },
}

local function buildArenas(map: Model)
	local root = model(map, "Arena")
	local A = World.Arena
	for i = 1, 3 do
		local m = model(root, "Arena" .. i)
		local c = A.Origin + Vector3.new((i - 2) * A.Spacing, 0, 0)
		local h = A.Size / 2
		local col = ({ P.Cyan, P.Pink, P.Gold })[i]
		part(m, "Floor", Vector3.new(A.Size, 2, A.Size), CFrame.new(c.X, -1, c.Z), Color3.fromRGB(38, 34, 74), Enum.Material.Metal)
		part(m, "FloorGlow", Vector3.new(A.Size - 6, 0.2, A.Size - 6), CFrame.new(c.X, 0.1, c.Z), col, NEON, true).Transparency = 0.75
		for _, w in ipairs({ { 0, h, A.Size, 1 }, { 0, -h, A.Size, 1 }, { h, 0, 1, A.Size }, { -h, 0, 1, A.Size } }) do
			local wall = part(m, "Wall", Vector3.new(w[3], 40, w[4]), CFrame.new(c.X + w[1], 20, c.Z + w[2]), col, Enum.Material.ForceField)
			wall.Transparency = 0.6
			part(m, "WallTrim", Vector3.new(w[3] + 1, 1, w[4] + 1), CFrame.new(c.X + w[1], 0.5, c.Z + w[2]), col, NEON, true)
		end
		for _, b in ipairs(COVER[i]) do
			for sgn = -1, 1, 2 do
				local blk = part(m, "Cover", Vector3.new(b[3], 9, b[4]), CFrame.new(c.X + b[1] * sgn, 4.5, c.Z + b[2] * sgn), Color3.fromRGB(70, 64, 120), Enum.Material.Concrete)
				part(m, "CoverTop", Vector3.new(b[3] + 0.2, 0.6, b[4] + 0.2), blk.CFrame * CFrame.new(0, 4.6, 0), col, NEON, true)
			end
		end
		for n, zz in ipairs({ -h + 12, h - 12 }) do
			local s = part(m, n == 1 and "SpawnA" or "SpawnB", Vector3.new(10, 1, 10), CFrame.new(c.X, 2, c.Z + zz), col, nil)
			invisible(s)
		end
	end
end

function MapService.Init(_services)
	if workspace:FindFirstChild("Map") then
		return
	end
	local base = workspace:FindFirstChild("Baseplate")
	if base then
		base:Destroy()
	end
	pcall(MapZones.setup)
	local map = Instance.new("Model")
	map.Name = "Map"
	map.ModelStreamingMode = Enum.ModelStreamingMode.Default
	buildHub(map)
	local zf = folder(map, "Zones")
	for i, z in ipairs(Zones) do
		buildZone(zf, z, i)
	end
	buildArenas(map)
	map.Parent = workspace
	local n = 0
	for _, d in ipairs(map:GetDescendants()) do
		if d:IsA("BasePart") then
			n += 1
		end
	end
	print(string.format("[MapService] built Map: %d parts (budget 4000)", n))
end

return MapService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000033"><Properties><string name="Name">MapZones</string><ProtectedString name="Source">-- Per-stage identity + set-pieces for MapService (Terrain + decor parts + ambient emitters). Everything here is decor:
-- non-collidable, non-queryable, no shadows, anchored. Terrain is only filled OUTSIDE the 48-wide road (|x| &gt; 40).
-- Budget per stage: &lt;= ~250 parts, &lt;= 6 PointLights, &lt;= 6 ParticleEmitters (Rate &lt;= 15, Decor=true).
-- Client-animated bits use P.spin / P.pulse / Beam "Beam" anims (ZoneLightingController).
local P = require(script.Parent.MapParts)

local V3, CF, ANG, V2 = Vector3.new, CFrame.new, CFrame.Angles, Vector2.new
local NEON = Enum.Material.Neon
local M = Enum.Material
local T = workspace.Terrain
local PI = math.pi

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local Z = {}

-- ===== one-time terrain palette / water =====
function Z.setup()
	local function col(mat: Enum.Material, c: Color3)
		pcall(function()
			T:SetMaterialColor(mat, c)
		end)
	end
	col(M.Grass, rgb(92, 178, 78))
	col(M.Rock, rgb(128, 122, 128))
	col(M.Sand, rgb(228, 190, 124))
	col(M.Sandstone, rgb(198, 120, 80))
	col(M.Snow, rgb(242, 249, 255))
	col(M.Glacier, rgb(165, 218, 246))
	col(M.Basalt, rgb(46, 38, 42))
	col(M.CrackedLava, rgb(255, 96, 24))
	col(M.Slate, rgb(46, 34, 82))
	pcall(function()
		T.WaterColor = rgb(70, 190, 225)
		T.WaterTransparency = 0.72
		T.WaterWaveSize = 0.25
		T.WaterWaveSpeed = 8
		T.WaterReflectance = 0.6
	end)
end

-- ===== shared pieces =====

-- Arches framing the road every ~60 studs. o: pillarCol/Mat, segCol/segCol2/segMat, keyCol, trimCol, h, rise, ts
local function arch(c, o)
	local d, cx = c.d, c.cx
	local h, rise = o.h or 20, o.rise or 9
	local R = c.half + 2
	for _, t in ipairs(o.ts or { 60, 120, 180, 240 }) do
		local z = c.startZ - t
		for s = -1, 1, 2 do
			P.part(d, "ArchPillar", V3(3.4, h, 3.4), CF(cx + s * R, h / 2, z), o.pillarCol, o.pillarMat, true)
			P.part(d, "ArchTrim", V3(0.5, h - 2, 1.4), CF(cx + s * (R - 1.75), h / 2, z), o.trimCol, NEON, true)
		end
		local prev: Vector3? = nil
		for k = 0, 6 do
			local a = PI * (k / 6)
			local p = V3(cx - R * math.cos(a), h + rise * math.sin(a), z)
			if prev then
				P.beam(d, "ArchSeg", prev, p, 2.4, k % 2 == 0 and o.segCol or o.segCol2, o.segMat, true)
			end
			prev = p
		end
		P.ball(d, "ArchKey", 3.6, CF(cx, h + rise + 1.4, z), o.keyCol, NEON)
	end
end

-- Road surface detail: centre band, tile plates, side strips, puddles, cracks
local function road(c, o)
	local d, cx, rng = c.d, c.cx, c.rng
	local midZ = c.startZ - 150
	P.part(d, "RoadBand", V3(o.bandW or 16, 0.04, 300), CF(cx, 0.02, midZ), o.bandCol, o.bandMat, true)
	for s = -1, 1, 2 do
		P.part(d, "RoadSide", V3(o.sideW or 5, 0.04, 300), CF(cx + s * (c.half - 5), 0.02, midZ), o.sideCol, o.sideMat, true)
	end
	for t = 20, 280, 30 do
		P.part(d, "RoadPlate", V3((o.bandW or 16) - 1.2, 0.05, 14), CF(cx, 0.03, c.startZ - t), o.plateCol, o.plateMat or o.bandMat, true)
	end
	for _ = 1, o.puddles or 6 do
		local dia = rng:NextNumber(4, 9)
		local p = P.cyl(d, "Puddle", dia, 0.05, CF(cx + rng:NextNumber(-19, 19), 0.07, c.startZ - rng:NextNumber(30, 250)), o.puddleCol, o.puddleMat or M.Glass, true)
		p.Transparency = o.puddleTr or 0.3
	end
	for _ = 1, o.cracks or 8 do
		local cr = P.part(d, "Crack", V3(rng:NextNumber(0.2, 0.45), 0.05, rng:NextNumber(5, 12)), CF(cx + rng:NextNumber(-20, 20), 0.08, c.startZ - rng:NextNumber(25, 255)) * ANG(0, rng:NextNumber(-0.7, 0.7), 0), o.crackCol, o.crackMat or NEON, true)
		cr.Transparency = o.crackTr or 0.15
	end
end

-- Boss gate: spinning halo ring over the end of the road + dais under the boss ring
local function bossGate(c, o)
	local cx, d = c.cx, c.d
	local z = c.endZ + 9
	P.ring(d, "BossHalo", V3(cx, 30, z), 20, 14, "Z", 2.2, { o.c1, o.c2 }, o.mat or NEON, 0.22)
	P.ring(d, "BossHaloInner", V3(cx, 30, z), 14, 8, "Z", 1.2, { o.c2 }, NEON, -0.5)
	local orb = P.ball(d, "BossOrb", 7, CF(cx, 30, z), o.c1, NEON)
	orb.Transparency = 0.3
	P.pulse(orb, 0.2, 0.7, 2, 0)
	local bz = c.z.bossPos.Z
	P.cyl(d, "BossDais", 47, 0.4, CF(cx, 0, bz), o.dark or P.Dark, M.Slate, true)
	for s = -1, 1, 2 do -- flanking crystal horns
		for k = 1, 2 do
			P.part(d, "BossHorn", V3(2.4, 14 + k * 4, 2.4), CF(cx + s * (c.half + 3 + k * 3.5), 7 + k * 2, c.endZ + 6) * ANG(0, 0, -s * (0.18 + k * 0.1)), o.c1, NEON, true)
		end
	end
end

local function skyBeam(c, x: number, z: number, col: Color3)
	local b = P.part(c.lm, "SkyBeam", V3(2.6, 320, 2.6), CF(x, 150, z), col, NEON, true)
	b.Transparency = 0.72
	P.pulse(b, 0.6, 0.85, 1.2, 0)
end

-- terrain helpers
local function hill(x: number, z: number, r: number, mat: Enum.Material, peak: number?)
	T:FillBall(V3(x, -r + (peak or r * 0.45), z), r, mat)
end

local function near(list, x: number, z: number, d: number): boolean
	for _, p in ipairs(list) do
		if (p.X - x) ^ 2 + (p.Z - z) ^ 2 &lt; d * d then
			return true
		end
	end
	return false
end

-- =====================================================================
-- STAGE 1: MEADOW  - floating islands, waterfalls, ponds, fireflies
-- =====================================================================
function Z.meadow(c)
	local rng, cx, d, lm = c.rng, c.cx, c.d, c.lm
	local islands = {
		{ t = 45, s = 1, xo = 100, y = 78, r = 16, fall = true }, { t = 110, s = -1, xo = 106, y = 98, r = 19, fall = true },
		{ t = 170, s = 1, xo = 114, y = 70, r = 14, fall = false }, { t = 230, s = -1, xo = 98, y = 90, r = 17, fall = true },
		{ t = 282, s = 1, xo = 106, y = 104, r = 20, fall = false },
	}
	local ponds = {}
	local lights = 0
	local mists = 0
	for n, isl in ipairs(islands) do
		local s, xo, y, r = isl.s, isl.xo, isl.y, isl.r
		local x, z = cx + s * xo, c.startZ - isl.t
		local top = y + r * 0.35
		T:FillBall(V3(x, y - r * 0.35, z), r, M.Rock)
		T:FillBall(V3(x, y + r * 0.1, z), r * 0.92, M.Grass)
		T:FillBlock(CF(x, top + 10, z), V3(r * 2 + 6, 20, r * 2 + 6), M.Air)
		-- crown dressing
		local tx, tz = x + rng:NextNumber(-r * 0.35, r * 0.35), z + rng:NextNumber(-r * 0.35, r * 0.35)
		P.cyl(d, "IslandTrunk", 2.4, 9, CF(tx, top + 3.5, tz), rgb(120, 82, 52), M.Wood, true)
		P.ball(d, "IslandLeaf", 13, CF(tx, top + 10, tz), rgb(90, 200, 100), M.Grass)
		P.ball(d, "IslandLeaf", 9, CF(tx + 3, top + 15, tz), rgb(130, 226, 110), M.Grass)
		for k = 1, 2 do
			local cr = P.part(d, "IslandCrystal", V3(2, rng:NextNumber(5, 9), 2), CF(x + rng:NextNumber(-r * 0.5, r * 0.5), top + 2.5, z + rng:NextNumber(-r * 0.5, r * 0.5)) * ANG(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 3), rng:NextNumber(-0.3, 0.3)), k == 1 and P.Cyan or P.Pink, NEON, true)
			if k == 1 and lights &lt; 2 then
				lights += 1
				P.light(cr, P.Cyan, 34, 1.4)
			end
		end
		for _ = 1, 3 do
			P.ball(d, "IslandFlower", 1.4, CF(x + rng:NextNumber(-r * 0.6, r * 0.6), top + 0.4, z + rng:NextNumber(-r * 0.6, r * 0.6)), rgb(255, 150, 200), NEON)
		end
		-- waterfall (3 stacked Glass/Neon sheets, client pulse) into a terrain pond
		if isl.fall then
			local ex = x - s * r * 0.85
			local topY = top - 3
			local H = topY - 1.5
			local layers = {
				{ mat = M.Glass, col = rgb(150, 225, 255), tr = 0.35, w = 6, ph = 0 },
				{ mat = NEON, col = rgb(110, 215, 255), tr = 0.55, w = 4, ph = 0.7 },
				{ mat = NEON, col = rgb(235, 250, 255), tr = 0.7, w = 2, ph = 1.9 },
			}
			for li, L in ipairs(layers) do
				local sh = P.part(d, "Waterfall", V3(0.6 + li * 0.2, H, L.w), CF(ex - s * li * 0.15, topY - H / 2, z), L.col, L.mat, true)
				sh.Transparency = L.tr
				if li &gt; 1 then
					P.pulse(sh, L.tr - 0.15, L.tr + 0.25, 2.2 + li * 0.4, L.ph)
				end
			end
			local sp = P.ball(d, "Splash", 8, CF(ex, 1.5, z), rgb(235, 250, 255), NEON)
			sp.Transparency = 0.6
			P.pulse(sp, 0.45, 0.8, 3, n)
			ponds[#ponds + 1] = V3(ex, 0, z)
			T:FillBlock(CF(ex, 0, z), V3(32, 8, 32), M.Grass)
			T:FillBlock(CF(ex, -0.5, z), V3(22, 4, 22), M.Water)
			if mists &lt; 2 then
				mists += 1
				P.emitter(d, "Mist", CF(ex, 5, z), V3(18, 6, 18), { rate = 6, life = NumberRange.new(3, 5), speed = NumberRange.new(1, 3), size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 5), NumberSequenceKeypoint.new(1, 13) }), texture = "rbxasset://textures/particles/smoke_main.dds", color = ColorSequence.new(rgb(235, 250, 255)), transp = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.8), NumberSequenceKeypoint.new(1, 1) }) })
			end
		end
	end
	-- rolling hills outside the scenery strip (skip around ponds)
	for zz = c.startZ - 5, c.endZ, -34 do
		for s = -1, 1, 2 do
			local x = cx + s * (64 + rng:NextNumber(0, 44))
			local z = zz + rng:NextNumber(-10, 10)
			if not near(ponds, x, z, 38) then
				hill(x, z, rng:NextNumber(20, 32), M.Grass)
			end
		end
	end
	-- fireflies
	for _, t in ipairs({ 70, 150, 230 }) do
		P.emitter(d, "Fireflies", CF(cx, 8, c.startZ - t), V3(110, 14, 70), { rate = 12, life = NumberRange.new(4, 7), speed = NumberRange.new(0.5, 2), size = NumberSequence.new(0.7), glow = 1, color = ColorSequence.new(rgb(220, 255, 120), rgb(120, 255, 200)), accel = V3(0, 0.4, 0), spread = V2(180, 180) })
	end
	arch(c, { pillarCol = rgb(150, 105, 65), pillarMat = M.Wood, segCol = rgb(135, 95, 60), segCol2 = rgb(90, 190, 90), segMat = M.Wood, keyCol = rgb(255, 120, 190), trimCol = P.Cyan, h = 20, rise = 9 })
	road(c, { bandCol = rgb(176, 160, 134), bandMat = M.Cobblestone, plateCol = rgb(150, 136, 112), plateMat = M.Slate, sideCol = rgb(110, 190, 90), sideMat = M.Grass, puddleCol = rgb(120, 205, 245), crackCol = rgb(255, 214, 90), crackTr = 0.3, cracks = 5 })
	bossGate(c, { c1 = P.Gold, c2 = P.Cyan, dark = rgb(40, 70, 50) })
	-- landmark: crystal spire crowning the first island (visible from the hub)
	local lx, lz = cx + 100, c.startZ - 45
	for i = 1, 5 do
		local w = 12 - i * 1.8
		P.part(lm, "Spire", V3(w, 16, w), CF(lx, 84 + i * 14, lz) * ANG(0, i * 0.5, 0), i % 2 == 0 and P.Cyan or rgb(140, 235, 255), i % 2 == 0 and NEON or M.Glass, true)
	end
	P.part(lm, "Tip", V3(5, 10, 5), CF(lx, 168, lz) * ANG(0.6, 0.8, 0), P.Gold, NEON, true)
	skyBeam(c, lx, lz, P.Cyan)
end

-- =====================================================================
-- STAGE 2: DESERT - canyon walls, crashed spaceship, sandstorm, bone ribs
-- =====================================================================
function Z.desert(c)
	local rng, cx, d, lm = c.rng, c.cx, c.d, c.lm
	local ls = c.lside
	local lz = c.startZ - 60
	for zz = c.startZ + 5, c.endZ - 5, -30 do -- dunes
		for s = -1, 1, 2 do
			T:FillBall(V3(cx + s * (52 + rng:NextNumber(0, 14)), -12, zz + rng:NextNumber(-8, 8)), rng:NextNumber(18, 24), M.Sand)
		end
	end
	for zz = c.startZ + 10, c.endZ - 10, -44 do -- canyon walls with a lighter cap
		for s = -1, 1, 2 do
			if not (s == ls and math.abs(zz - lz) &lt; 34) then
				local h, w = rng:NextNumber(34, 72), rng:NextNumber(26, 38)
				local x = cx + s * (64 + w / 2)
				T:FillBlock(CF(x, h / 2 - 6, zz) * ANG(0, rng:NextNumber(-0.12, 0.12), 0), V3(w, h, rng:NextNumber(42, 54)), M.Sandstone)
				T:FillBlock(CF(x - s * 3, h - 3, zz), V3(w - 8, 6, 34), M.Sand)
			end
		end
	end

	-- crashed spaceship (opposite side of the antenna)
	local sx, sz = cx - ls * 48, c.startZ - 150
	local B = CF(sx, 8, sz) * ANG(0, 0.45 * -ls, 0) * ANG(-0.2, 0, 0)
	local function piece(name: string, size: Vector3, off: CFrame, col: Color3, mat: Enum.Material)
		return P.part(d, name, size, B * off, col, mat, true)
	end
	piece("ShipHull", V3(12, 9, 36), CF(), rgb(140, 146, 158), M.Metal)
	piece("ShipBelly", V3(12.6, 2.5, 36.4), CF(0, -3.4, 0), rgb(112, 72, 52), M.CorrodedMetal)
	piece("ShipNose", V3(11, 9, 11), CF(0, 0, -19), rgb(150, 154, 166), M.Metal).Shape = Enum.PartType.Ball
	local ck = piece("ShipCockpit", V3(6, 3, 8), CF(0, 5, -10), rgb(120, 200, 255), M.Glass)
	ck.Transparency = 0.35
	piece("ShipWing", V3(20, 1.2, 12), CF(-14, -1, 4) * ANG(0, 0, -0.12), rgb(130, 136, 148), M.Metal)
	piece("ShipWingBroken", V3(9, 1.2, 10), CF(10, -2.5, 6) * ANG(0, 0.5, 0.4), rgb(110, 90, 80), M.CorrodedMetal)
	piece("ShipFin", V3(1.2, 12, 9), CF(0, 9, 15), rgb(150, 154, 166), M.Metal)
	for s = -1, 1, 2 do
		local en = piece("ShipEngine", V3(6, 5, 5), CF(s * 4, 0, 19) * ANG(0, PI / 2, 0), rgb(80, 82, 92), M.Metal)
		en.Shape = Enum.PartType.Cylinder
		local gl = piece("ShipEngineGlow", V3(0.6, 4.2, 4.2), CF(s * 4, 0, 21.6) * ANG(0, PI / 2, 0), rgb(255, 130, 40), NEON)
		gl.Shape = Enum.PartType.Cylinder
		if s == 1 then
			P.light(gl, rgb(255, 140, 50), 38, 2)
		end
	end
	for k = 1, 3 do
		piece("ShipPlate", V3(3, 0.4, 8), CF(rng:NextNumber(-3, 3), 4.7, -2 + k * 6) * ANG(rng:NextNumber(-0.3, 0.3), rng:NextNumber(-0.5, 0.5), rng:NextNumber(-0.3, 0.3)), rgb(120, 126, 138), M.Metal)
		piece("ShipSpark", V3(0.6, 0.6, 3), CF(rng:NextNumber(-4, 4), 4.6, -4 + k * 5) * ANG(0, rng:NextNumber(0, 3), 0), P.Cyan, NEON)
	end
	for _ = 1, 8 do
		local s = rng:NextNumber(1.5, 4.5)
		P.part(d, "ShipDebris", V3(s, s * 0.5, s * 1.4), CF(sx + rng:NextNumber(-22, 22), 0.3, sz + rng:NextNumber(-12, 40)) * ANG(rng:NextNumber(-0.5, 0.5), rng:NextNumber(0, 3), rng:NextNumber(-0.5, 0.5)), rgb(120, 110, 105), M.CorrodedMetal, true)
	end
	P.part(d, "ShipScorch", V3(12, 0.1, 50), CF(sx, -0.9, sz + 38) * ANG(0, 0.45 * -ls, 0), rgb(30, 26, 26), M.Slate, true)
	P.emitter(d, "ShipFire", B * CF(0, 5, 20), V3(7, 4, 5), { rate = 12, life = NumberRange.new(1, 2), speed = NumberRange.new(5, 9), size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3), NumberSequenceKeypoint.new(1, 0.5) }), glow = 0.8, color = ColorSequence.new(rgb(255, 190, 60), rgb(255, 70, 20)), spread = V2(20, 20) })
	P.emitter(d, "ShipSmoke", B * CF(0, 8, 8), V3(8, 3, 8), { rate = 7, life = NumberRange.new(4, 6), speed = NumberRange.new(4, 7), size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 4), NumberSequenceKeypoint.new(1, 14) }), texture = "rbxasset://textures/particles/smoke_main.dds", color = ColorSequence.new(rgb(60, 56, 54)), transp = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(0.2, 0.55), NumberSequenceKeypoint.new(1, 1) }) })

	-- giant bone ribcage
	local bx, z0 = cx + ls * 46, c.startZ - 225
	local bone = rgb(236, 226, 200)
	for k = 0, 5 do
		local zk = z0 - k * 5
		local sc = 1 - math.abs(k - 2.5) * 0.12
		local prev: Vector3? = nil
		for q = 0, 4 do
			local a = PI * (0.08 + q / 4 * 0.84)
			local p = V3(bx + math.cos(a) * 11 * sc, 1 + math.sin(a) * 13 * sc, zk)
			if prev then
				P.beam(d, "Rib", prev, p, 1.6, bone, M.Slate, true)
			end
			prev = p
		end
	end
	P.beam(d, "Spine", V3(bx, 14, z0), V3(bx, 14, z0 - 25), 2, bone, M.Slate, true)
	P.ball(d, "Skull", 9, CF(bx, 5, z0 + 8), bone, M.Slate)
	P.ball(d, "SkullEye", 1.8, CF(bx - 2.2, 6, z0 + 12), rgb(255, 160, 40), NEON)
	P.ball(d, "SkullEye", 1.8, CF(bx + 2.2, 6, z0 + 12), rgb(255, 160, 40), NEON)

	-- sandstorm sweeping across the lane
	for _, t in ipairs({ 70, 160, 245 }) do
		P.emitter(d, "Sandstorm", CF(cx - 90, 14, c.startZ - t), V3(20, 34, 70), { rate = 15, life = NumberRange.new(4, 6), speed = NumberRange.new(30, 45), size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 5), NumberSequenceKeypoint.new(1, 11) }), texture = "rbxasset://textures/particles/smoke_main.dds", color = ColorSequence.new(rgb(226, 184, 120)), dir = Enum.NormalId.Right, spread = V2(8, 8), transp = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.15, 0.78), NumberSequenceKeypoint.new(0.8, 0.82), NumberSequenceKeypoint.new(1, 1) }) })
	end

	arch(c, { pillarCol = rgb(200, 150, 100), pillarMat = M.Sandstone, segCol = rgb(150, 95, 60), segCol2 = rgb(205, 160, 105), segMat = M.CorrodedMetal, keyCol = P.Gold, trimCol = P.Gold, h = 22, rise = 8 })
	road(c, { bandCol = rgb(196, 152, 106), bandMat = M.Cobblestone, plateCol = rgb(170, 128, 88), plateMat = M.Slate, sideCol = rgb(150, 110, 76), sideMat = M.Concrete, puddleCol = rgb(24, 22, 34), puddleTr = 0.15, crackCol = rgb(255, 190, 70), crackTr = 0.35 })
	bossGate(c, { c1 = P.Gold, c2 = rgb(255, 120, 50), mat = M.Metal, dark = rgb(70, 52, 40) })

	-- landmark: radio antenna tower with a beacon, standing in a gap of the canyon
	local lx = cx + ls * 85
	local rust = rgb(140, 100, 70)
	for sx2 = -1, 1, 2 do
		for sz2 = -1, 1, 2 do
			P.beam(lm, "Leg", V3(lx + sx2 * 8, -1, lz + sz2 * 8), V3(lx + sx2 * 1.5, 82, lz + sz2 * 1.5), 2.2, rust, M.Metal, true)
		end
	end
	for _, y in ipairs({ 20, 48 }) do
		local w = 8 - y / 82 * 6.5
		for k = 0, 3 do
			local a, b = k * PI / 2, (k + 1) * PI / 2
			P.beam(lm, "Brace", V3(lx + math.cos(a) * w * 1.41, y, lz + math.sin(a) * w * 1.41), V3(lx + math.cos(b) * w * 1.41, y, lz + math.sin(b) * w * 1.41), 1.2, rust, M.Metal, true)
		end
	end
	P.part(lm, "Mast", V3(1.4, 40, 1.4), CF(lx, 100, lz), rgb(100, 100, 112), M.Metal, true)
	local bc = P.ball(lm, "Beacon", 7, CF(lx, 122, lz), P.Gold, NEON)
	P.light(bc, P.Gold, 44, 1.6)
	P.pulse(bc, 0, 0.5, 2.5, 0)
	skyBeam(c, lx, lz, P.Gold)
end

-- =====================================================================
-- STAGE 3: FROST - ice cathedral arches, aurora, glacier peaks, frozen lake
-- =====================================================================
function Z.frost(c)
	local rng, cx, d, lm = c.rng, c.cx, c.d, c.lm
	local ls = c.lside
	local lz = c.startZ - 55
	local lakeZ = c.startZ - 150
	for zz = c.startZ - 3, c.endZ, -30 do -- snow drifts
		for s = -1, 1, 2 do
			if not (s == -ls and math.abs(zz - lakeZ) &lt; 48) then
				hill(cx + s * (52 + rng:NextNumber(0, 12)), zz + rng:NextNumber(-8, 8), rng:NextNumber(16, 22), M.Snow, 6)
			end
		end
	end
	for zz = c.startZ - 3, c.endZ, -48 do -- glacier peaks (stacked balls) with snow caps
		for s = -1, 1, 2 do
			if not (s == ls and math.abs(zz - lz) &lt; 50) then
				local x = cx + s * (84 + rng:NextNumber(0, 30))
				local r = rng:NextNumber(24, 32)
				T:FillBall(V3(x, -6, zz), r, M.Glacier)
				T:FillBall(V3(x + rng:NextNumber(-3, 3), r * 0.6, zz), r * 0.66, M.Glacier)
				T:FillBall(V3(x, r * 1.15, zz), r * 0.4, M.Glacier)
				T:FillBall(V3(x, r * 1.5, zz), r * 0.3, M.Snow)
			end
		end
	end

	-- frozen lake on the far side
	local lkx = cx - ls * 62
	local lake = P.part(d, "FrozenLake", V3(46, 0.4, 70), CF(lkx, -0.8, lakeZ), rgb(140, 205, 245), M.Ice, true)
	lake.Transparency = 0.15
	for k = 1, 5 do
		local cr = P.part(d, "LakeCrack", V3(0.3, 0.05, rng:NextNumber(10, 22)), CF(lkx + rng:NextNumber(-16, 16), -0.55, lakeZ + rng:NextNumber(-22, 22)) * ANG(0, rng:NextNumber(-1, 1), 0), rgb(220, 248, 255), NEON, true)
		cr.Transparency = 0.45
	end
	-- ice crystal clusters
	local lights = 0
	for k = 1, 12 do
		local s = k % 2 == 0 and 1 or -1
		local h = rng:NextNumber(8, 17)
		local cr = P.part(d, "IceCrystal", V3(3, h, 3), CF(cx + s * rng:NextNumber(50, 76), h / 2 - 1, c.startZ - 10 - k * 23) * ANG(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 3), rng:NextNumber(-0.3, 0.3)), rgb(150, 220, 255), M.Glass, true)
		cr.Transparency = 0.2
		if k % 5 == 0 and lights &lt; 2 then
			lights += 1
			P.light(cr, P.Cyan, 34, 1.5)
		end
	end

	-- cathedral arches: pointed gothic ribs over the road
	local R = c.half + 2
	local ice, glow = rgb(196, 232, 255), rgb(120, 225, 255)
	for _, t in ipairs({ 60, 120, 180, 240 }) do
		local z = c.startZ - t
		for s = -1, 1, 2 do
			P.part(d, "GothPillar", V3(3.6, 34, 3.6), CF(cx + s * R, 17, z), ice, M.Ice, true)
			P.beam(d, "GothRib", V3(cx + s * R, 34, z), V3(cx, 54, z), 3.2, ice, M.Ice, true)
			P.beam(d, "GothGlow", V3(cx + s * (R - 1.6), 33, z), V3(cx, 51.4, z), 0.9, glow, NEON, true)
			P.part(d, "GothSpire", V3(2.2, 16, 2.2), CF(cx + s * (R + 3.4), 8, z) * ANG(0, 0, -s * 0.08), rgb(215, 242, 255), M.Ice, true)
		end
		P.ball(d, "GothKey", 4, CF(cx, 52.5, z), glow, NEON)
		local ch = P.part(d, "Chandelier", V3(2.4, 8, 2.4), CF(cx, 47, z), rgb(170, 230, 255), M.Glass, true)
		ch.Transparency = 0.25
	end

	-- aurora ribbons (Beams with gradients; client animates width/transparency)
	local A = P.part(d, "AuroraA", V3(1, 1, 1), CF(cx, 150, c.startZ - 10), P.Cyan, nil, true)
	A.Transparency = 1
	local Bp = P.part(d, "AuroraB", V3(1, 1, 1), CF(cx, 168, c.startZ - 290), P.Cyan, nil, true)
	Bp.Transparency = 1
	local ribbons = {
		{ x = -70, y = 0, k = 40, c0 = rgb(90, 255, 170), c1 = rgb(70, 220, 255), c2 = rgb(170, 100, 255) },
		{ x = -10, y = 14, k = -50, c0 = rgb(110, 255, 200), c1 = rgb(90, 190, 255), c2 = rgb(200, 120, 255) },
		{ x = 55, y = 4, k = 35, c0 = rgb(70, 255, 150), c1 = rgb(120, 230, 255), c2 = rgb(150, 90, 255) },
		{ x = 115, y = 22, k = -30, c0 = rgb(130, 255, 190), c1 = rgb(80, 200, 255), c2 = rgb(220, 130, 255) },
	}
	for i, r in ipairs(ribbons) do
		local a0 = Instance.new("Attachment")
		a0.Position = V3(r.x, r.y, 0)
		a0.Parent = A
		local a1 = Instance.new("Attachment")
		a1.Position = V3(r.x * 0.6 + 20, r.y + 10, 0)
		a1.Parent = Bp
		local b = Instance.new("Beam")
		b.Attachment0, b.Attachment1 = a0, a1
		b.FaceCamera = true
		b.LightEmission = 1
		b.LightInfluence = 0
		b.Width0, b.Width1 = 50, 70
		b.Segments = 24
		b.CurveSize0, b.CurveSize1 = r.k, -r.k
		b.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, r.c0), ColorSequenceKeypoint.new(0.5, r.c1), ColorSequenceKeypoint.new(1, r.c2) })
		b.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(0.5, 0.55), NumberSequenceKeypoint.new(1, 0.9) })
		P.anim(b, "Beam", { AnimSpeed = 0.8, AnimPh = i * 1.3, AnimLo = 0.4, AnimHi = 0.85 })
		b.Parent = A
	end

	-- snowfall + ice glitter
	for _, t in ipairs({ 50, 130, 210, 275 }) do
		P.emitter(d, "Snow", CF(cx, 60, c.startZ - t), V3(110, 2, 70), { rate = 15, life = NumberRange.new(7, 9), speed = NumberRange.new(6, 9), size = NumberSequence.new(0.55), dir = Enum.NormalId.Bottom, spread = V2(18, 18), accel = V3(3, 0, 0), glow = 0.2 })
	end
	P.emitter(d, "IceGlitter", CF(cx, 6, c.startZ - 150), V3(120, 10, 240), { rate = 10, life = NumberRange.new(3, 5), speed = NumberRange.new(0.5, 1.5), size = NumberSequence.new(0.6), glow = 1, color = ColorSequence.new(rgb(170, 235, 255)), spread = V2(180, 180) })

	road(c, { bandCol = rgb(176, 220, 246), bandMat = M.Ice, plateCol = rgb(210, 238, 255), plateMat = M.Glacier, sideCol = rgb(236, 246, 255), sideMat = M.Snow, puddleCol = rgb(215, 242, 255), puddleMat = M.Ice, puddleTr = 0.1, crackCol = rgb(190, 240, 255), crackTr = 0.35 })
	bossGate(c, { c1 = rgb(150, 230, 255), c2 = rgb(200, 150, 255), mat = M.Ice, dark = rgb(60, 90, 130) })

	-- landmark: cathedral facade with a rose window and spires
	local lx = cx + ls * 92
	P.part(lm, "Hall", V3(26, 46, 40), CF(lx, 22, lz), rgb(196, 232, 255), M.Ice, true)
	for i = 1, 5 do
		local w = 14 - i * 2.4
		P.part(lm, "Spire", V3(w, 22, w), CF(lx, 46 + (i - 1) * 22 + 11, lz) * ANG(0, 0.78, 0), i % 2 == 0 and rgb(236, 248, 255) or rgb(185, 226, 255), M.Ice, true)
	end
	P.part(lm, "Tip", V3(3, 10, 3), CF(lx, 168, lz), glow, NEON, true)
	for s = -1, 1, 2 do
		for i = 1, 4 do
			local w = 9 - i * 1.8
			P.part(lm, "Tower", V3(w, 20, w), CF(lx, 26 + (i - 1) * 18 + 10, lz + s * 22) * ANG(0, 0.78, 0), i % 2 == 0 and rgb(236, 248, 255) or rgb(185, 226, 255), M.Ice, true)
		end
	end
	local face = lx - ls * 13.5
	P.ring(lm, "RoseWindow", V3(face, 30, lz), 8, 12, "X", 1.2, { glow }, NEON)
	local core = P.ball(lm, "RoseCore", 10, CF(face, 30, lz), rgb(180, 240, 255), NEON)
	core.Transparency = 0.45
	P.light(core, glow, 50, 1.8)
	P.pulse(core, 0.3, 0.7, 1.5, 0)
	skyBeam(c, lx, lz, glow)
end

-- =====================================================================
-- STAGE 4: MAGMA - foundry, lava rivers, giant gears, volcano
-- =====================================================================
function Z.magma(c)
	local rng, cx, d, lm = c.rng, c.cx, c.d, c.lm
	local ls = c.lside
	local orange = rgb(255, 110, 30)
	local vx, vz = cx + ls * 138, c.startZ - 70
	local sheds = { { -ls, 130 }, { ls, 215 } } -- side, t

	-- lava rivers (terrain CrackedLava, basalt banks) following gentle zigzags
	local pts = {}
	for s = -1, 1, 2 do
		pts[s] = {}
		for k = 0, 8 do
			pts[s][k] = V3(cx + s * (58 + 6 * math.sin(k * 1.1 + (s &gt; 0 and 0 or 2))), 0, c.startZ - 6 - k * 36)
		end
		for k = 0, 7 do
			local a, b = pts[s][k], pts[s][k + 1]
			local mid = (a + b) / 2
			local len = (b - a).Magnitude
			T:FillBlock(CFrame.lookAt(V3(mid.X, -2, mid.Z), V3(b.X, -2, b.Z)), V3(24, 5, len + 4), M.Basalt)
			T:FillBlock(CFrame.lookAt(V3(mid.X, -3, mid.Z), V3(b.X, -3, b.Z)), V3(11, 6, len + 4), M.CrackedLava)
		end
	end
	-- glowing lava blobs with lights (&lt;= 4), plus bubbling pulses
	local li = 0
	for s = -1, 1, 2 do
		for _, k in ipairs({ 2, 6 }) do
			local p = pts[s][k]
			local g = P.cyl(d, "LavaGlow", 7, 0.4, CF(p.X, 0.15, p.Z), orange, NEON, true)
			g.Transparency = 0.2
			P.pulse(g, 0.1, 0.5, 2.5, k + s)
			if li &lt; 4 then
				li += 1
				P.light(g, orange, 42, 2)
			end
		end
	end

	-- basalt crags + volcano
	for zz = c.startZ - 3, c.endZ, -55 do
		for s = -1, 1, 2 do
			local x = cx + s * (84 + rng:NextNumber(0, 24))
			local skip = false
			for _, sh in ipairs(sheds) do
				if sh[1] == s and math.abs(zz - (c.startZ - sh[2])) &lt; 40 then
					skip = true
				end
			end
			if (vx - x) ^ 2 + (vz - zz) ^ 2 &lt; 70 * 70 then
				skip = true
			end
			if not skip then
				local r = rng:NextNumber(22, 30)
				T:FillBall(V3(x, -8, zz), r, M.Basalt)
				T:FillBall(V3(x + rng:NextNumber(-4, 4), r * 0.5, zz), r * 0.55, M.Basalt)
			end
		end
	end
	for k = 0, 6 do -- volcano cone
		T:FillCylinder(CF(vx, -6 + k * 14 + 7, vz), 14, 46 - k * 5.5, M.Basalt)
	end
	T:FillCylinder(CF(vx, -6 + 6 * 14 + 10, vz), 8, 9, M.CrackedLava)
	for k = 1, 3 do
		local a = k * PI * 2 / 3 + 0.4
		local st = P.beam(lm, "LavaStream", V3(vx + math.cos(a) * 12, 90, vz + math.sin(a) * 12), V3(vx + math.cos(a) * 48, -1, vz + math.sin(a) * 48), 3.2, orange, NEON, true)
		st.Transparency = 0.1
	end
	P.emitter(d, "VolcanoEmbers", CF(vx, 98, vz), V3(14, 4, 14), { rate = 15, life = NumberRange.new(3, 5), speed = NumberRange.new(14, 22), size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.4), NumberSequenceKeypoint.new(1, 0.2) }), glow = 1, color = ColorSequence.new(rgb(255, 200, 80), rgb(255, 80, 20)), spread = V2(30, 30), accel = V3(0, -8, 0) })

	-- foundry sheds with smokestacks
	for n, sh in ipairs(sheds) do
		local s, zc = sh[1], c.startZ - sh[2]
		local x = cx + s * 92
		local fx = x - s * 15.2
		P.part(d, "ShedBody", V3(30, 20, 36), CF(x, 9, zc), rgb(48, 42, 50), M.Metal, true)
		for k = -1, 1 do
			P.part(d, "ShedRoof", V3(30, 3, 12), CF(x, 20.5, zc + k * 12) * ANG(0.28, 0, 0), rgb(36, 32, 40), M.Metal, true)
		end
		for k = -2, 2 do
			if k ~= 0 then
				P.part(d, "ShedWindow", V3(0.6, 2.5, 4), CF(fx, 13, zc + k * 7), orange, NEON, true)
			end
		end
		local door = P.part(d, "ShedDoor", V3(0.6, 10, 8), CF(fx, 5, zc), rgb(255, 150, 50), NEON, true)
		door.Transparency = 0.1
		P.pulse(door, 0, 0.35, 3, n)
		for k = 1, 2 do
			local sx2 = x + s * 6
			local stackZ = zc + (k == 1 and -10 or 10)
			P.cyl(d, "Stack", 6, 44, CF(sx2, 22, stackZ), rgb(58, 50, 56), M.Metal, true)
			P.cyl(d, "StackRim", 6.6, 1.4, CF(sx2, 44.5, stackZ), orange, NEON, true)
			if k == 1 then
				P.emitter(d, "StackSmoke", CF(sx2, 48, stackZ), V3(4, 2, 4), { rate = 7, life = NumberRange.new(5, 7), speed = NumberRange.new(5, 8), size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 4), NumberSequenceKeypoint.new(1, 16) }), texture = "rbxasset://textures/particles/smoke_main.dds", color = ColorSequence.new(rgb(60, 54, 54)), spread = V2(12, 12), transp = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(0.2, 0.55), NumberSequenceKeypoint.new(1, 1) }) })
			end
		end
	end

	-- giant gears (client-spun)
	local function gear(x: number, y: number, z: number, Rg: number, speed: number)
		local center = V3(x, y, z)
		local body = P.part(d, "GearBody", V3(6, Rg * 2, Rg * 2), CF(center), rgb(74, 66, 76), M.Metal, true)
		body.Shape = Enum.PartType.Cylinder
		P.spin(body, center, Vector3.xAxis, speed)
		for k = 1, 8 do
			local a = k / 8 * PI * 2
			local tooth = P.part(d, "GearTooth", V3(6, 5, 6), CF(center + V3(0, math.cos(a) * (Rg + 1.5), math.sin(a) * (Rg + 1.5))) * ANG(a, 0, 0), rgb(88, 78, 90), M.Metal, true)
			P.spin(tooth, center, Vector3.xAxis, speed)
		end
		for k = 0, 2 do
			local sp = P.part(d, "GearSpoke", V3(6.4, Rg * 1.7, 3), CF(center) * ANG(k * PI / 3, 0, 0), orange, NEON, true)
			sp.Transparency = 0.15
			P.spin(sp, center, Vector3.xAxis, speed)
		end
	end
	gear(cx + 118, 40, c.startZ - 30, 26, 0.2)
	gear(cx - 120, 38, c.startZ - 195, 24, -0.22)
	gear(cx + 108, 34, c.startZ - 255, 20, 0.28)

	-- lava cauldron gantry pouring into the river
	local cp = pts[1][5]
	for k = -1, 1, 2 do
		P.part(d, "CauldronPylon", V3(4, 40, 4), CF(cp.X + 10, 20, cp.Z + k * 9), rgb(50, 44, 52), M.Metal, true)
	end
	P.part(d, "CauldronBeam", V3(4, 3, 22), CF(cp.X + 10, 41, cp.Z), rgb(50, 44, 52), M.Metal, true)
	P.cyl(d, "Cauldron", 10, 8, CF(cp.X + 4, 34, cp.Z) * ANG(0, 0, 0.6), rgb(70, 60, 66), M.Metal, true)
	local fall = P.part(d, "LavaFall", V3(2.6, 34, 2.6), CF(cp.X, 16, cp.Z), orange, NEON, true)
	fall.Transparency = 0.1
	P.pulse(fall, 0, 0.3, 4, 0)

	-- embers over the lane
	for _, t in ipairs({ 60, 150, 240 }) do
		P.emitter(d, "Embers", CF(cx, 6, c.startZ - t), V3(110, 8, 70), { rate = 14, life = NumberRange.new(4, 6), speed = NumberRange.new(3, 7), size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0.1) }), glow = 1, color = ColorSequence.new(rgb(255, 200, 90), rgb(255, 90, 30)), accel = V3(0, 2, 0), spread = V2(40, 40) })
	end

	arch(c, { pillarCol = rgb(46, 40, 48), pillarMat = M.Metal, segCol = rgb(62, 54, 62), segCol2 = rgb(96, 70, 52), segMat = M.Metal, keyCol = orange, trimCol = orange, h = 22, rise = 3 })
	road(c, { bandCol = rgb(52, 42, 46), bandMat = M.Basalt, plateCol = rgb(70, 54, 54), plateMat = M.Slate, sideCol = orange, sideMat = NEON, sideW = 0.6, puddleCol = orange, puddleMat = NEON, puddleTr = 0.2, puddles = 5, crackCol = orange, crackTr = 0.1, cracks = 10 })
	bossGate(c, { c1 = orange, c2 = P.Gold, mat = M.Metal, dark = rgb(50, 36, 36) })
	skyBeam(c, vx, vz, orange)
end

-- =====================================================================
-- STAGE 5: VOID - floating neon platforms, gyroscope rings, starfield, obelisk
-- =====================================================================
function Z.void(c)
	local rng, cx, d, lm = c.rng, c.cx, c.d, c.lm
	local ls = c.lside

	-- asteroids (terrain) with neon crystals
	for k = 1, 12 do
		local s = k % 2 == 0 and 1 or -1
		local r = rng:NextNumber(8, 16)
		local pos = V3(cx + s * rng:NextNumber(76, 150), rng:NextNumber(25, 95), c.startZ - 10 - k * 23)
		T:FillBall(pos, r, k % 3 == 0 and M.Basalt or M.Slate)
		P.part(d, "AsteroidCrystal", V3(2.2, r * 0.9, 2.2), CF(pos + V3(0, r * 0.9, 0)) * ANG(rng:NextNumber(-0.3, 0.3), 0, rng:NextNumber(-0.3, 0.3)), k % 2 == 0 and P.Pink or P.Cyan, NEON, true)
	end

	-- floating neon platforms (hover tiles) with pulsing under-glow and light shafts
	for k = 1, 16 do
		local s = k % 2 == 0 and 1 or -1
		local y = rng:NextNumber(6, 40)
		local sz = rng:NextNumber(12, 16)
		local x, z = cx + s * rng:NextNumber(50, 78), c.startZ - 8 - k * 17
		local col = k % 2 == 0 and P.Pink or P.Cyan
		P.part(d, "HoverTile", V3(sz, 1.5, sz), CF(x, y, z) * ANG(0, rng:NextNumber(0, 3), 0), P.Dark, M.Metal, true)
		local g = P.part(d, "HoverGlow", V3(sz + 0.6, 0.4, sz + 0.6), CF(x, y - 0.9, z), col, NEON, true)
		P.pulse(g, 0, 0.5, 2, k)
		local sh = P.part(d, "HoverShaft", V3(0.7, y, 0.7), CF(x, y / 2, z), col, NEON, true)
		sh.Transparency = 0.75
	end

	-- giant rotating gyroscope rings over the road
	local cols = { P.Pink, P.Cyan }
	for n, t in ipairs({ 80, 170, 250 }) do
		P.ring(d, "GyroRing", V3(cx, 46, c.startZ - t), 36, 16, "Z", 2.4, cols, NEON, n % 2 == 0 and -0.35 or 0.35)
	end
	P.ring(d, "GyroInner", V3(cx, 46, c.startZ - 170), 27, 12, "Z", 1.4, { P.Gold }, NEON, 0.6)

	-- neon grid across the road
	for t = 20, 280, 20 do
		local ln = P.part(d, "GridLine", V3(c.half * 2 - 6, 0.05, 0.35), CF(cx, 0.09, c.startZ - t), (t / 20) % 2 == 0 and P.Pink or P.Cyan, NEON, true)
		ln.Transparency = 0.55
	end

	-- starfield + rising void sparks
	for _, t in ipairs({ 60, 150, 240 }) do
		P.emitter(d, "Stars", CF(cx, 70, c.startZ - t), V3(260, 80, 90), { rate = 12, life = NumberRange.new(18, 24), speed = NumberRange.new(0, 0.2), size = NumberSequence.new(1.2), glow = 1, color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)), ColorSequenceKeypoint.new(0.5, rgb(150, 220, 255)), ColorSequenceKeypoint.new(1, rgb(255, 150, 240)) }), spread = V2(180, 180) })
	end
	for _, t in ipairs({ 100, 210 }) do
		P.emitter(d, "VoidSparks", CF(cx, 4, c.startZ - t), V3(100, 8, 80), { rate = 12, life = NumberRange.new(3, 5), speed = NumberRange.new(3, 6), size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0.1) }), glow = 1, color = ColorSequence.new(rgb(255, 90, 220), rgb(80, 220, 255)), accel = V3(0, 3, 0), spread = V2(30, 30) })
	end

	arch(c, { pillarCol = rgb(24, 18, 48), pillarMat = M.Metal, segCol = rgb(36, 26, 70), segCol2 = rgb(90, 60, 170), segMat = M.Metal, keyCol = P.Pink, trimCol = P.Cyan, h = 22, rise = 9 })
	road(c, { bandCol = rgb(30, 24, 56), bandMat = M.Metal, plateCol = rgb(40, 30, 78), plateMat = M.Slate, sideCol = P.Pink, sideMat = NEON, sideW = 0.6, puddleCol = rgb(110, 60, 220), puddleTr = 0.35, crackCol = P.Cyan, crackTr = 0.25 })
	bossGate(c, { c1 = P.Pink, c2 = P.Cyan, dark = rgb(30, 18, 60) })

	-- landmark: obelisk with three orbiting rings
	local lx, lz = cx + ls * 98, c.startZ - 45
	P.part(lm, "Obelisk", V3(9, 74, 9), CF(lx, 36, lz), rgb(26, 18, 52), M.Slate, true)
	for sx2 = -1, 1, 2 do
		for sz2 = -1, 1, 2 do
			if sx2 == sz2 then
				P.part(lm, "ObeliskEdge", V3(0.9, 74, 0.9), CF(lx + sx2 * 4.6, 36, lz + sz2 * 4.6), P.Cyan, NEON, true)
			else
				P.part(lm, "ObeliskEdge", V3(0.9, 74, 0.9), CF(lx + sx2 * 4.6, 36, lz + sz2 * 4.6), P.Pink, NEON, true)
			end
		end
	end
	local orb = P.ball(lm, "ObeliskOrb", 11, CF(lx, 84, lz), P.Pink, NEON)
	P.light(orb, P.Pink, 50, 1.8)
	P.pulse(orb, 0, 0.4, 2, 0)
	for n = 1, 3 do
		P.ring(lm, "OrbitRing", V3(lx, 40 + n * 14, lz), 16 + n * 3, 12, "Y", 1.2, cols, NEON, (n % 2 == 0 and -1 or 1) * (0.5 + n * 0.15))
	end
	skyBeam(c, lx, lz, P.Pink)
end

-- Entry point: builds one stage's set-piece. c = { m, cx, half, startZ, endZ, accent, rng, lside, z }
function Z.build(c)
	local f = Instance.new("Folder")
	f.Name = "SetPiece"
	c.d = f
	local lm = Instance.new("Model")
	lm.Name = "Landmark"
	c.lm = lm
	local fn = Z[c.z.id]
	if fn then
		fn(c)
	end
	f.Parent = c.m
	lm.Parent = c.m
end

return Z
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000034"><Properties><string name="Name">MinigameService</string><ProtectedString name="Source">-- Training-break minigames: server starts a session (cooldown), client plays, server clamps score
-- and pays Power (seconds of training) + coins. Lucky Crate result is rolled on the server.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Minigames = require(Shared.Config.Minigames)
local Recipes = require(Shared.Config.Recipes)
local Net = require(Shared.Net)

local MinigameService = {}
local S
local rng = Random.new()
local cooldown: { [Player]: { [string]: number } } = {}
local active: { [Player]: { game: string, t0: number } } = {}

local function crate(player: Player)
	local prizes = Minigames.LuckyCrate.prizes
	local total = 0
	for _, p in ipairs(prizes) do
		total += p.w
	end
	local x = rng:NextNumber() * total
	for _, p in ipairs(prizes) do
		x -= p.w
		if x &lt;= 0 then
			if p.trainingSeconds then
				return { power = S.TrainingService.GrantSeconds(player, p.trainingSeconds) }
			elseif p.coins then
				S.EconomyService.Add(player, "Coins", p.coins, "crate", false)
				return { coins = p.coins }
			elseif p.gems then
				S.EconomyService.Add(player, "Gems", p.gems, "crate", false)
				return { gems = p.gems }
			elseif p.material then
				local tier = S.ZoneService.BestTier(S.PlayerService.GetPower(player))
				local mat = Recipes.TierMats[tier][1]
				S.InventoryService.AddMaterial(player, mat, p.amount)
				return { mat = mat, amount = p.amount }
			end
		end
	end
	return {}
end

function MinigameService.ResetCooldowns(player: Player)
	cooldown[player] = {}
end

function MinigameService.Init(services)
	S = services
	Players.PlayerRemoving:Connect(function(p)
		cooldown[p] = nil
		active[p] = nil
	end)

	Net.handle("MinigameStart", function(player, name)
		local cfg = type(name) == "string" and Minigames[name]
		if not cfg then
			return { ok = false }
		end
		cooldown[player] = cooldown[player] or {}
		local left = (cooldown[player][name] or 0) - os.clock()
		if left &gt; 0 then
			return { ok = false, wait = math.ceil(left) }
		end
		cooldown[player][name] = os.clock() + cfg.cooldown
		active[player] = { game = name, t0 = os.clock() }
		return { ok = true, duration = cfg.duration, maxScore = cfg.maxScore }
	end, 2)

	Net.handle("MinigameEnd", function(player, score)
		local a = active[player]
		if not a or type(score) ~= "number" or score ~= score then
			return nil
		end
		active[player] = nil
		local cfg = Minigames[a.game]
		S.QuestService.Progress(player, "Minigames", 1)
		if a.game == "LuckyCrate" then
			return crate(player)
		end
		if os.clock() - a.t0 &lt; cfg.minSeconds then
			score = 0
		end
		local frac = math.clamp(score, 0, cfg.maxScore) / cfg.maxScore
		local power = S.TrainingService.GrantSeconds(player, cfg.trainingSeconds * frac)
		local coins = math.floor(cfg.coins * frac)
		if coins &gt; 0 then
			S.EconomyService.Add(player, "Coins", coins, "minigame", true)
		end
		return { power = power, coins = coins, score = score }
	end, 2)

	Net.handle("MinigameCooldowns", function(player)
		local out = {}
		for name in pairs(Minigames) do
			out[name] = math.max(0, math.ceil(((cooldown[player] or {})[name] or 0) - os.clock()))
		end
		return out
	end, 2)
end

return MinigameService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000035"><Properties><string name="Name">MonetizationService</string><ProtectedString name="Source">-- Game passes + developer products (real Robux).
-- * Ownership is verified server-side with UserOwnsGamePassAsync (cached per session).
-- * Developer products use ProcessReceipt with PurchaseId idempotency saved in player data.
-- * Perks from Config.GamePasses[*].perks are applied on every character spawn.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Settings = require(Shared.Config.Settings)
local GamePasses = require(Shared.Config.GamePasses)
local Products = require(Shared.Config.Products)
local Net = require(Shared.Net)
local Signal = require(Shared.Signal)

local MonetizationService = {}
MonetizationService.PassGranted = Signal.new() -- (player, passKey)
MonetizationService.ProductBought = Signal.new() -- (player, productKey)

-- Custom product handlers for non-currency products: [productKey] = function(player) -&gt; boolean
MonetizationService.ProductHandlers = {}
-- Custom pass perk hooks: [passKey] = function(player, character)
MonetizationService.PerkHooks = {}

local DataService, EconomyService, AnalyticsService
local owned: { [Player]: { [string]: boolean } } = {}

local passById, productById = {}, {}
for k, v in pairs(GamePasses) do
	if v.id ~= 0 then
		passById[v.id] = k
	end
end
for k, v in pairs(Products) do
	if v.id ~= 0 then
		productById[v.id] = k
	end
end

function MonetizationService.HasPass(player: Player, passKey: string): boolean
	return owned[player] ~= nil and owned[player][passKey] == true
end

function MonetizationService.OwnedList(player: Player): { string }
	local list = {}
	for k, v in pairs(owned[player] or {}) do
		if v then
			table.insert(list, k)
		end
	end
	return list
end

-- Multiplicative perk across owned passes (e.g. VIP x2 and DoubleCoins x2 = x4)
function MonetizationService.GetMultiplier(player: Player, perk: string): number
	local m = 1
	for k in pairs(owned[player] or {}) do
		local p = GamePasses[k] and GamePasses[k].perks
		if p and p[perk] then
			m *= p[perk]
		end
	end
	return m
end

function MonetizationService.GetPerk(player: Player, perk: string): any
	for k in pairs(owned[player] or {}) do
		local p = GamePasses[k] and GamePasses[k].perks
		if p and p[perk] ~= nil then
			return p[perk]
		end
	end
	return nil
end

local function addTrail(character: Model, color: Color3)
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp or hrp:FindFirstChild("PassTrail") then
		return
	end
	local a0 = Instance.new("Attachment")
	a0.Name = "TrailTop"
	a0.Position = Vector3.new(0, 0.8, 0)
	a0.Parent = hrp
	local a1 = Instance.new("Attachment")
	a1.Name = "TrailBottom"
	a1.Position = Vector3.new(0, -0.8, 0)
	a1.Parent = hrp
	local trail = Instance.new("Trail")
	trail.Name = "PassTrail"
	trail.Attachment0, trail.Attachment1 = a0, a1
	trail.Color = ColorSequence.new(color)
	trail.Transparency = NumberSequence.new(0.2, 1)
	trail.Lifetime = 0.35
	trail.LightEmission = 0.6
	trail.Parent = hrp
end

local function addTag(character: Model, text: string)
	local head = character:FindFirstChild("Head")
	if not head or head:FindFirstChild("PassTag") then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "PassTag"
	gui.Size = UDim2.fromOffset(120, 32)
	gui.StudsOffset = Vector3.new(0, 2.4, 0)
	gui.MaxDistance = 60
	gui.AlwaysOnTop = false
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = "⭐ " .. text
	label.TextColor3 = Color3.fromRGB(255, 215, 70)
	label.TextStrokeTransparency = 0.2
	label.Parent = gui
	gui.Parent = head
end

local function applyPerks(player: Player)
	local character = player.Character
	if not character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	for passKey in pairs(owned[player] or {}) do
		local def = GamePasses[passKey]
		local perks = def and def.perks or {}
		if humanoid and perks.walkSpeed then
			humanoid.WalkSpeed = math.max(humanoid.WalkSpeed, perks.walkSpeed)
			humanoid:SetAttribute("BaseSpeed", math.max(humanoid:GetAttribute("BaseSpeed") or 0, perks.walkSpeed))
		end
		if humanoid and perks.jumpPower then
			humanoid.UseJumpPower = true
			humanoid.JumpPower = math.max(humanoid.JumpPower, perks.jumpPower)
		end
		if perks.trail then
			addTrail(character, perks.trail)
		end
		if perks.chatTag then
			addTag(character, perks.chatTag)
		end
		local hook = MonetizationService.PerkHooks[passKey]
		if hook then
			task.spawn(hook, player, character)
		end
	end
end

local function grantPass(player: Player, passKey: string, announce: boolean)
	owned[player] = owned[player] or {}
	if owned[player][passKey] then
		return
	end
	owned[player][passKey] = true
	applyPerks(player)
	MonetizationService.PassGranted:Fire(player, passKey)
	EconomyService.Sync(player)
	if announce then
		EconomyService.Toast(player, "Unlocked " .. GamePasses[passKey].name .. "!", "success")
	end
end

local function loadOwnership(player: Player)
	owned[player] = owned[player] or {}
	local studioFree = RunService:IsStudio() and Settings.StudioGrantUnconfiguredPasses
	for passKey, def in pairs(GamePasses) do
		if def.id == 0 then
			if studioFree then
				owned[player][passKey] = true
			end
		else
			for _ = 1, 3 do
				local ok, has = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, def.id)
				if ok then
					owned[player][passKey] = has or nil
					break
				end
				task.wait(1)
			end
		end
	end
end

local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = DataService.WaitFor(player)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local pid = tostring(receipt.PurchaseId)
	if table.find(data.receipts, pid) then
		DataService.Save(player)
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	local productKey = productById[receipt.ProductId]
	local def = productKey and Products[productKey]
	if not def then
		warn("[Monetization] unknown product id", receipt.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local granted = true
	local handler = MonetizationService.ProductHandlers[productKey]
	if handler then
		local ok, res = pcall(handler, player)
		granted = ok and res ~= false
	elseif def.grant then
		EconomyService.Grant(player, def.grant, "product:" .. productKey)
	end
	if not granted then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	DataService.Update(player, function(d)
		table.insert(d.receipts, pid)
		while #d.receipts &gt; 50 do
			table.remove(d.receipts, 1)
		end
		d.stats.Purchases += 1
	end)
	if not DataService.Save(player) and not DataService.IsOffline(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet -- retried later; receipt id is recorded in memory
	end
	MonetizationService.ProductBought:Fire(player, productKey)
	AnalyticsService.Purchase(player, productKey, def.price)
	EconomyService.Toast(player, "Thanks! You got " .. def.name, "success")
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function MonetizationService.Init(services)
	DataService = services.DataService
	EconomyService = services.EconomyService
	AnalyticsService = services.AnalyticsService

	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		local passKey = passById[passId]
		if purchased and passKey then
			grantPass(player, passKey, true)
			AnalyticsService.Purchase(player, passKey, GamePasses[passKey].price)
		end
	end)

	-- Studio test purchase of an unconfigured pass/product (id = 0) from the shop
	Net.on("StudioTestBuy", function(player, kind, key)
		if not RunService:IsStudio() then
			return
		end
		if kind == "pass" and GamePasses[key] then
			grantPass(player, key, true)
		elseif kind == "product" and Products[key] then
			local handler = MonetizationService.ProductHandlers[key]
			if handler then
				handler(player)
			elseif Products[key].grant then
				EconomyService.Grant(player, Products[key].grant, "studio-test")
			end
			EconomyService.Toast(player, "[Studio] Granted " .. Products[key].name, "success")
		end
	end, 2)

	local function setup(player: Player)
		loadOwnership(player)
		player.CharacterAdded:Connect(function(char)
			char:WaitForChild("Humanoid", 5)
			applyPerks(player)
		end)
		if player.Character then
			applyPerks(player)
		end
		EconomyService.Sync(player)
	end
	Players.PlayerAdded:Connect(setup)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(setup, p)
	end
	Players.PlayerRemoving:Connect(function(p)
		owned[p] = nil
	end)
end

return MonetizationService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000036"><Properties><string name="Name">MonsterService</string><ProtectedString name="Source">-- Server-simulated monsters (cheap): HP + logical position live on the server; models are anchored
-- and moved by the CLIENT from segment attributes (From/To/T0/Dur). Server never moves parts per frame.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Zones = require(Shared.Config.Zones)
local Monsters = require(Shared.Config.Monsters)
local Combat = require(Shared.Config.Combat)
local Net = require(Shared.Net)

local MonsterService = {}
local S
local rng = Random.new()
local folder: Folder
local nextId = 0
local recs: { [number]: any } = {}
local zoneCount: { [string]: number } = {}
local bossAlive: { [string]: boolean } = {}

local function now()
	return Workspace:GetServerTimeNow()
end

function MonsterService.Position(rec): Vector3
	if rec.dur &lt;= 0 then
		return rec.to
	end
	local a = math.clamp((now() - rec.t0) / rec.dur, 0, 1)
	return rec.from:Lerp(rec.to, a)
end

function MonsterService.Get(id: number)
	return recs[id]
end

function MonsterService.InZone(zone, pos: Vector3): boolean
	local c, s = zone.center, zone.size
	return math.abs(pos.X - c.X) &lt;= s.X / 2 and math.abs(pos.Z - c.Z) &lt;= s.Z / 2
end

local function setSegment(rec, to: Vector3, dur: number)
	rec.from = MonsterService.Position(rec)
	rec.to = to
	rec.t0 = now()
	rec.dur = dur
	local m = rec.model
	m:SetAttribute("From", rec.from)
	m:SetAttribute("To", to)
	m:SetAttribute("T0", rec.t0)
	m:SetAttribute("Dur", dur)
end

local function buildModel(defId: string, def, size: number): Model
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local src = assets and assets:FindFirstChild("Monsters") and assets.Monsters:FindFirstChild(defId)
	local m: Model
	if src and src:IsA("Model") then
		m = src:Clone()
		local _, ext = m:GetBoundingBox()
		if ext.Y &gt; 0 then
			m:ScaleTo(size / ext.Y)
		end
	else
		m = Instance.new("Model")
		local body = Instance.new("Part")
		body.Name = "Body"
		body.Shape = Enum.PartType.Ball
		body.Size = Vector3.one * size
		body.Color = def.color
		body.Material = Enum.Material.SmoothPlastic
		body.Parent = m
		for sx = -1, 1, 2 do
			local eye = Instance.new("Part")
			eye.Shape = Enum.PartType.Ball
			eye.Size = Vector3.one * size * 0.22
			eye.Color = Color3.new(0.05, 0.05, 0.08)
			eye.CFrame = CFrame.new(sx * size * 0.2, size * 0.12, -size * 0.42)
			eye.Parent = m
		end
		if def.boss then
			local crown = Instance.new("Part")
			crown.Size = Vector3.new(size * 0.5, size * 0.2, size * 0.5)
			crown.Color = Color3.fromRGB(255, 201, 53)
			crown.Material = Enum.Material.Neon
			crown.CFrame = CFrame.new(0, size * 0.55, 0)
			crown.Parent = m
		end
		m.PrimaryPart = body
	end
	for _, p in ipairs(m:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Anchored = true
			p.CanCollide = false
			p.CanTouch = false
			p.CanQuery = true -- mouse targeting
			p.CastShadow = def.boss == true
		end
	end
	m.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	return m
end

-- opts: { zone, static, onDeath(rec), name, hpOverride, def, raidId (only players with attribute RaidId==raidId are targeted) }
function MonsterService.Spawn(defId: string, pos: Vector3, opts)
	opts = opts or {}
	local def = opts.def or Monsters[defId]
	nextId += 1
	local id = nextId
	local hp = opts.hpOverride or def.hp
	local m = buildModel(defId, def, def.size)
	m.Name = "M" .. id
	local y = def.size / 2
	local start = Vector3.new(pos.X, y, pos.Z)
	m:PivotTo(CFrame.new(start))
	m:SetAttribute("MonsterId", id)
	m:SetAttribute("Name", opts.name or def.name)
	m:SetAttribute("HP", hp)
	m:SetAttribute("MaxHP", hp)
	m:SetAttribute("Boss", def.boss == true)
	m:SetAttribute("Size", def.size)
	local rec = { id = id, defId = defId, def = def, zone = opts.zone, model = m, hp = hp, maxHp = hp, y = y,
		from = start, to = start, t0 = now(), dur = 0, lastAttack = 0, contrib = {}, static = opts.static, onDeath = opts.onDeath, wanderAt = 0, raidId = opts.raidId }
	setSegment(rec, start, 0)
	m.Parent = folder
	recs[id] = rec
	return rec
end

local function rollDrops(def, mult: number)
	local out = {}
	for _, d in ipairs(def.drops) do
		local mat, chance, lo, hi = d[1], d[2], d[3], d[4]
		if rng:NextNumber() &lt; math.min(1, chance) then
			local raw = rng:NextInteger(lo, hi) * mult
			local n = math.floor(raw) + (if rng:NextNumber() &lt; raw % 1 then 1 else 0)
			if n &gt; 0 then
				out[mat] = (out[mat] or 0) + n
			end
		end
	end
	return out
end

local function reward(rec, player: Player, pos: Vector3)
	local def = rec.def
	local coins = S.EconomyService.Add(player, "Coins", math.max(1, math.floor(def.coins * S.PlayerService.CoinBonus(player))), "kill", true)
	local power = math.floor(def.power * S.PlayerService.TrainMultiplier(player))
	S.PlayerService.AddPower(player, power)
	local mats = rollDrops(def, S.PlayerService.DropMultiplier(player))
	for mat, n in pairs(mats) do
		S.InventoryService.AddMaterial(player, mat, n)
	end
	S.QuestService.Progress(player, "Kills", 1)
	S.QuestService.Progress(player, "Earn", coins)
	if def.boss then
		S.QuestService.Progress(player, "BossKills", 1)
	end
	S.DataService.Update(player, function(d)
		d.index.monsters[rec.defId] = true
	end)
	S.ClanService.AddXp(player, if def.boss then 20 else 1)
	Net.fire(player, "Loot", pos, { coins = coins, power = power, mats = mats })
end

local function kill(rec)
	recs[rec.id] = nil
	local pos = MonsterService.Position(rec)
	rec.model:SetAttribute("HP", 0)
	if rec.onDeath then
		task.spawn(rec.onDeath, rec, pos)
	else
		local top, topDmg = nil, 0
		for p, dmg in pairs(rec.contrib) do
			if dmg &gt; topDmg then
				top, topDmg = p, dmg
			end
		end
		for p, dmg in pairs(rec.contrib) do -- shared loot: anyone with &gt;= 10% damage (no kill stealing)
			if p.Parent and (p == top or dmg &gt;= rec.maxHp * 0.1) then
				reward(rec, p, pos)
			end
		end
	end
	task.delay(0.05, function()
		rec.model:Destroy()
	end)
	local zone = rec.zone
	if zone then
		if rec.def.boss then
			task.delay(rec.def.respawn, function()
				bossAlive[zone.id] = false
			end)
		else
			zoneCount[zone.id] -= 1
		end
	end
end

function MonsterService.Remove(id: number)
	local rec = recs[id]
	if rec then
		recs[id] = nil
		rec.model:Destroy()
	end
end

function MonsterService.Damage(id: number, player: Player, dmg: number): boolean
	local rec = recs[id]
	if not rec or rec.hp &lt;= 0 then
		return false
	end
	rec.hp -= dmg
	rec.contrib[player] = (rec.contrib[player] or 0) + dmg
	rec.aggro = player
	rec.model:SetAttribute("HP", math.max(0, math.floor(rec.hp)))
	if rec.hp &lt;= 0 then
		kill(rec)
	end
	return true
end

-- along the lane: keep the first 35 studs after the gate and the boss end (last 45) clear
local function randomPoint(zone, margin: number): Vector3
	local c, s = zone.center, zone.size
	local x = c.X + rng:NextNumber(-s.X / 2 + margin, s.X / 2 - margin)
	local z = c.Z + rng:NextNumber(-s.Z / 2 + 45, s.Z / 2 - 35)
	return Vector3.new(x, 0, z)
end

local function clampToZone(zone, p: Vector3, y: number): Vector3
	local c, s = zone.center, zone.size
	return Vector3.new(math.clamp(p.X, c.X - s.X / 2 + 4, c.X + s.X / 2 - 4), y, math.clamp(p.Z, c.Z - s.Z / 2 + 4, c.Z + s.Z / 2 - 4))
end

local function spawnTick()
	for _, zone in ipairs(Zones) do
		zoneCount[zone.id] = zoneCount[zone.id] or 0
		local n = 0
		while zoneCount[zone.id] &lt; zone.maxAlive and n &lt; 3 do -- max 3 per tick per zone (smooth)
			n += 1
			zoneCount[zone.id] += 1
			MonsterService.Spawn(zone.monsters[rng:NextInteger(1, #zone.monsters)], randomPoint(zone, 6), { zone = zone })
		end
		if not bossAlive[zone.id] then
			bossAlive[zone.id] = true
			MonsterService.Spawn(zone.boss, zone.bossPos or zone.center, { zone = zone })
		end
	end
end

local function hrpOf(p: Player): BasePart?
	local char = p.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health &lt;= 0 then
		return nil
	end
	return char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function aiTick()
	local t = now()
	local players = Players:GetPlayers()
	for _, rec in pairs(recs) do
		local pos = MonsterService.Position(rec)
		local def = rec.def
		local reach = Combat.MonsterAttackRange + def.size / 2
		-- pick target: last attacker if close, else nearest player in range
		local target, best = nil, if rec.raidId then 400 else Combat.MonsterAggroRange + def.size
		for _, p in ipairs(players) do
			local hrp = hrpOf(p)
			if hrp and not S.PlayerService.InArena(p) and (if rec.raidId then p:GetAttribute("RaidId") == rec.raidId else (not rec.zone or MonsterService.InZone(rec.zone, hrp.Position))) then
				local dist = (hrp.Position - pos).Magnitude
				if p == rec.aggro and dist &lt; best * 2 then
					target, best = hrp, -1
				elseif dist &lt; best then
					target, best = hrp, dist
				end
			end
		end
		if target then
			local tp = target.Position
			local flat = Vector3.new(tp.X, rec.y, tp.Z)
			local dist = (flat - pos).Magnitude
			if dist &lt;= reach then
				if os.clock() - rec.lastAttack &gt;= Combat.MonsterAttackCooldown then
					rec.lastAttack = os.clock()
					-- telegraph: clients play a wind-up + lunge from this attribute, damage lands after it
					rec.model:SetAttribute("Atk", now())
					local victim = target
					task.delay(0.35, function()
						if not recs[rec.id] or not victim.Parent then
							return
						end
						if (victim.Position - MonsterService.Position(rec)).Magnitude &lt;= reach * 1.4 then
							local hum = (victim.Parent :: Model):FindFirstChildOfClass("Humanoid")
							if hum then
								hum:TakeDamage(def.damage * Combat.MonsterDamageScale)
							end
						end
					end)
				end
			elseif not rec.static and (t &gt;= rec.t0 + rec.dur or (rec.to - flat).Magnitude &gt; 6) then
				local goal = pos + (flat - pos).Unit * math.min(def.speed, dist - reach * 0.7)
				if rec.zone then
					goal = clampToZone(rec.zone, goal, rec.y)
				end
				setSegment(rec, goal, math.max(0.2, (goal - pos).Magnitude / def.speed))
			end
		elseif not rec.static and rec.zone and t &gt;= rec.t0 + rec.dur and os.clock() &gt;= rec.wanderAt then
			rec.aggro = nil
			rec.wanderAt = os.clock() + rng:NextNumber(2, 5)
			local goal = clampToZone(rec.zone, pos + Vector3.new(rng:NextNumber(-12, 12), 0, rng:NextNumber(-25, 25)), rec.y)
			setSegment(rec, goal, (goal - pos).Magnitude / (def.speed * 0.5))
		end
	end
end

function MonsterService.Init(services)
	S = services
	Net.declare("Loot")
	folder = Instance.new("Folder")
	folder.Name = "Monsters"
	folder.Parent = Workspace
	task.spawn(function()
		while true do -- lint-ok (task.wait)
			spawnTick()
			task.wait(1)
		end
	end)
	task.spawn(function()
		while true do -- lint-ok (task.wait)
			task.wait(0.35)
			debug.profilebegin("MonsterAI")
			aiTick()
			debug.profileend()
		end
	end)
end

return MonsterService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000037"><Properties><string name="Name">PetService</string><ProtectedString name="Source">-- Fusion Altar pets: core (materials+coins) -&gt; weighted roll (odds public) -&gt; pet item.
-- Equip up to slots, combine 5 same -&gt; golden -&gt; rainbow, multipliers cached per player.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Pets = require(Shared.Config.Pets)
local Net = require(Shared.Net)

local PetService = {}
local S
local rng = Random.new()
local cache: { [Player]: { power: number, coins: number } } = {}
local coreById = {}
for _, c in ipairs(Pets.Cores) do
	coreById[c.id] = c
end

local function levelMult(lvl: number): number
	return if lvl &gt;= 2 then Pets.RainbowMult elseif lvl == 1 then Pets.GoldenMult else 1
end

function PetService.Slots(player: Player): number
	return Pets.BaseSlots + (S.MonetizationService.GetPerk(player, "extraPetSlots") or 0)
end

local function recompute(player: Player)
	local d = S.DataService.Get(player)
	local m = { power = 1, coins = 1 }
	local tags = {}
	if d then
		for _, uid in ipairs(d.equipped.pets) do
			local it = d.items[uid]
			local def = it and Pets.Pets[it.id]
			if def then
				m.power += def.power * levelMult(it.lvl or 0)
				m.coins += def.coins * levelMult(it.lvl or 0)
				table.insert(tags, it.id .. ":" .. (it.lvl or 0))
			end
		end
	end
	cache[player] = m
	player:SetAttribute("Pets", table.concat(tags, ",")) -- clients render followers from this
end

function PetService.Multipliers(player: Player)
	return cache[player] or { power = 1, coins = 1 }
end

local function roll(odds): string
	local total = 0
	for _, w in pairs(odds) do
		total += w
	end
	local x = rng:NextNumber() * total
	local last
	for id, w in pairs(odds) do
		last = id
		x -= w
		if x &lt;= 0 then
			return id
		end
	end
	return last
end

local function changed(player: Player)
	recompute(player)
	S.InventoryService.Sync(player)
	S.TrainingService.Push(player)
end

function PetService.Init(services)
	S = services
	S.DataService.Loaded:Connect(function(player)
		recompute(player)
	end)
	Players.PlayerRemoving:Connect(function(p)
		cache[p] = nil
	end)

	Net.handle("Fuse", function(player, coreId)
		local core = type(coreId) == "string" and coreById[coreId]
		if not core then
			return { ok = false }
		end
		if not S.InventoryService.CanAdd(player, "pet") then
			return { ok = false, err = "Pet storage full" }
		end
		if not S.InventoryService.Take(player, core.mats, core.coins) then
			return { ok = false, err = "Missing materials or coins" }
		end
		local petId = roll(core.odds)
		local lucky = false
		if S.MonetizationService.GetPerk(player, "forgeLuck") and rng:NextNumber() &lt; 0.1 then
			local second = roll(core.odds) -- Lucky Forge: 10% chance to roll twice, keep rarer
			if Pets.Pets[second].rarity &gt; Pets.Pets[petId].rarity then
				petId, lucky = second, true
			end
		end
		local uid = S.InventoryService.CreateItem(player, { kind = "pet", id = petId, lvl = 0 })
		S.QuestService.Progress(player, "Fusions", 1)
		if Pets.Pets[petId].rarity &gt;= 5 then
			Net.fireAll("Announce", ("%s hatched a MYTHIC %s!"):format(player.DisplayName, Pets.Pets[petId].name))
		end
		-- auto-equip if a slot is free
		local d = S.DataService.Get(player)
		if d and uid and #d.equipped.pets &lt; PetService.Slots(player) then
			S.DataService.Update(player, function(data)
				table.insert(data.equipped.pets, uid)
			end)
		end
		changed(player)
		return { ok = true, pet = petId, uid = uid, lucky = lucky }
	end, 2)

	Net.on("EquipPet", function(player, uid)
		local d = S.DataService.Get(player)
		local it = d and type(uid) == "string" and d.items[uid]
		if not it or it.kind ~= "pet" then
			return
		end
		S.DataService.Update(player, function(data)
			local i = table.find(data.equipped.pets, uid)
			if i then
				table.remove(data.equipped.pets, i)
			elseif #data.equipped.pets &lt; PetService.Slots(player) then
				table.insert(data.equipped.pets, uid)
			end
		end)
		changed(player)
	end, 6)

	Net.on("EquipBestPets", function(player)
		local d = S.DataService.Get(player)
		if not d then
			return
		end
		local list = {}
		for uid, it in pairs(d.items) do
			if it.kind == "pet" and Pets.Pets[it.id] then
				table.insert(list, { uid = uid, v = Pets.Pets[it.id].power * levelMult(it.lvl or 0) })
			end
		end
		table.sort(list, function(a, b)
			return a.v &gt; b.v
		end)
		S.DataService.Update(player, function(data)
			data.equipped.pets = {}
			for i = 1, math.min(#list, PetService.Slots(player)) do
				table.insert(data.equipped.pets, list[i].uid)
			end
		end)
		changed(player)
	end, 2)

	-- combine 5 identical (same id + level) into one of the next level
	Net.on("CombinePets", function(player, petId, lvl)
		local d = S.DataService.Get(player)
		if not d or type(petId) ~= "string" or type(lvl) ~= "number" or lvl &lt; 0 or lvl &gt; 1 then
			return
		end
		local uids = {}
		for uid, it in pairs(d.items) do
			if it.kind == "pet" and it.id == petId and (it.lvl or 0) == lvl then
				table.insert(uids, uid)
			end
		end
		if #uids &lt; Pets.CombineCount then
			S.EconomyService.Toast(player, ("Need %d of the same pet"):format(Pets.CombineCount), "error")
			return
		end
		for i = 1, Pets.CombineCount do
			S.InventoryService.RemoveItem(player, uids[i])
		end
		S.InventoryService.CreateItem(player, { kind = "pet", id = petId, lvl = lvl + 1 })
		S.EconomyService.Toast(player, (lvl == 0 and "GOLDEN " or "RAINBOW ") .. Pets.Pets[petId].name .. "!", "success")
		changed(player)
	end, 2)

	Net.on("DeletePet", function(player, uid)
		local it = type(uid) == "string" and S.InventoryService.GetItem(player, uid)
		if it and it.kind == "pet" then
			S.InventoryService.RemoveItem(player, uid)
			changed(player)
		end
	end, 6)
end

return PetService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000038"><Properties><string name="Name">PlayerService</string><ProtectedString name="Source">-- Central player stats: Power (leaderstat), combined multipliers, max HP, arena flag.
-- Genre services call these instead of re-implementing multiplier math.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage.Shared.Config
local Training = require(Config.Training)
local Guns = require(Config.Guns)
local Combat = require(Config.Combat)

local PlayerService = {}
local S -- services

function PlayerService.GetPower(player: Player): number
	local d = S.DataService.Get(player)
	return d and d.stats.Power or 0
end

local function setLeaderstat(player: Player, power: number)
	local ls = player:FindFirstChild("leaderstats")
	local v = ls and ls:FindFirstChild("Power")
	if v then
		(v :: IntValue).Value = math.floor(power)
	end
end

function PlayerService.AddPower(player: Player, amount: number)
	if not (amount &gt; 0) or amount == math.huge then -- also rejects NaN (would corrupt saved Power)
		return
	end
	local power = 0
	S.DataService.Update(player, function(d)
		d.stats.Power += amount
		power = d.stats.Power
	end)
	setLeaderstat(player, power)
end

function PlayerService.SetPower(player: Player, value: number)
	S.DataService.Update(player, function(d)
		d.stats.Power = value
	end)
	setLeaderstat(player, value)
end

function PlayerService.InArena(player: Player): boolean
	return player:GetAttribute("MatchId") ~= nil
end

-- Training gain multiplier (without the temporary x2 pulse, which TrainingService adds)
function PlayerService.TrainMultiplier(player: Player): number
	local d = S.DataService.Get(player)
	if not d then
		return 1
	end
	local m = S.MonetizationService.GetMultiplier(player, "trainMultiplier")
	m *= Training.RebirthMultiplier ^ d.rebirths
	m *= S.PetService.Multipliers(player).power
	if d.boostUntil &gt; os.time() then
		m *= Training.ProductBoost.Multiplier
	end
	if not PlayerService.InArena(player) then
		m *= S.EventService.Mult("train") * S.SocialService.Mult(player)
	end
	return m
end

function PlayerService.BaseGain(power: number): number
	return Training.Base + math.sqrt(math.max(0, power)) * Training.SqrtFactor
end

-- Extra coin multiplier on top of the pass multiplier EconomyService applies itself
function PlayerService.CoinBonus(player: Player): number
	return S.PetService.Multipliers(player).coins * (1 + S.ClanService.Perk(player)) * S.EventService.Mult("coins") * S.SocialService.Mult(player)
end

function PlayerService.DropMultiplier(player: Player): number
	return S.MonetizationService.GetMultiplier(player, "dropMultiplier") * (1 + S.ClanService.Perk(player)) * S.EventService.Mult("drops")
end

function PlayerService.ArmorHp(player: Player): number
	local d = S.DataService.Get(player)
	if not d then
		return 0
	end
	local hp = 0
	for _, slot in ipairs(Guns.ArmorOrder) do
		local item = d.items[d.equipped[slot]]
		if item and item.kind == "armor" then
			hp += item.hp
		end
	end
	return hp
end

function PlayerService.MaxHp(player: Player): number
	if PlayerService.InArena(player) then
		return Guns.PvP.BaseHp
	end
	return math.floor(Combat.PlayerBaseHp + math.sqrt(PlayerService.GetPower(player)) * Combat.PowerHpFactor + PlayerService.ArmorHp(player))
end

-- Apply max HP + boots speed to the current character (call after gear/arena changes)
function PlayerService.RefreshCharacter(player: Player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end
	local maxHp = PlayerService.MaxHp(player)
	local ratio = if hum.MaxHealth &gt; 0 then hum.Health / hum.MaxHealth else 1
	hum.MaxHealth = maxHp
	hum.Health = math.max(1, maxHp * ratio)
	local speed = 16
	local d = S.DataService.Get(player)
	if d and not PlayerService.InArena(player) then
		local boots = d.items[d.equipped.boots]
		if boots and boots.kind == "armor" then
			speed += (Guns.Armor.boots.speed or 0) * boots.tier * 2
		end
		local passSpeed = S.MonetizationService.GetPerk(player, "walkSpeed")
		if passSpeed then
			speed = math.max(speed, passSpeed)
		end
	end
	hum.WalkSpeed = speed
	hum:SetAttribute("BaseSpeed", speed)
end

function PlayerService.Init(services)
	S = services
	S.DataService.Loaded:Connect(function(player, data)
		local ls = player:WaitForChild("leaderstats", 10)
		if ls and not ls:FindFirstChild("Power") then
			local v = Instance.new("IntValue")
			v.Name = "Power"
			v.Value = math.floor(data.stats.Power)
			v.Parent = ls
		end
		PlayerService.RefreshCharacter(player)
	end)

	-- regen out of combat
	local lastHit: { [Player]: number } = {}
	PlayerService.MarkHit = function(player: Player)
		lastHit[player] = os.clock()
	end
	Players.PlayerRemoving:Connect(function(p)
		lastHit[p] = nil
	end)
	local function hook(player: Player)
		player.CharacterAdded:Connect(function(char)
			local hum = char:WaitForChild("Humanoid", 5) :: Humanoid?
			if not hum then
				return
			end
			hum.BreakJointsOnDeath = false
			task.wait()
			PlayerService.RefreshCharacter(player)
			hum.Health = hum.MaxHealth
			local last = hum.Health
			hum.HealthChanged:Connect(function(h)
				if h &lt; last then
					lastHit[player] = os.clock()
				end
				last = h
			end)
		end)
	end
	Players.PlayerAdded:Connect(hook)
	for _, p in ipairs(Players:GetPlayers()) do
		hook(p)
	end
	task.spawn(function()
		while true do -- lint-ok (task.wait)
			task.wait(1)
			for _, p in ipairs(Players:GetPlayers()) do
				local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
				if hum and hum.Health &gt; 0 and hum.Health &lt; hum.MaxHealth and os.clock() - (lastHit[p] or 0) &gt; Combat.RegenDelay then
					hum.Health = math.min(hum.MaxHealth, hum.Health + hum.MaxHealth * Combat.RegenPerSecond)
				end
			end
		end
	end)
end

PlayerService.MarkHit = function(_player: Player) end

return PlayerService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000039"><Properties><string name="Name">ProgressRewards</string><ProtectedString name="Source">-- Shared reward granter for Season / Achievements / Spin / Story.
-- reward = { Coins, Gems, mats = {id=n}, boostMin, title }
local ProgressRewards = {}

function ProgressRewards.Grant(S, player: Player, reward, source: string)
	local cur = {}
	for _, k in ipairs({ "Coins", "Gems" }) do
		if reward[k] then
			cur[k] = reward[k]
		end
	end
	if next(cur) then
		S.EconomyService.Grant(player, cur, source)
	end
	if reward.mats or reward.boostMin or reward.title then
		S.DataService.Update(player, function(d)
			for id, n in pairs(reward.mats or {}) do
				d.inventory[id] = (d.inventory[id] or 0) + n
			end
			if reward.boostMin then
				d.boostUntil = math.max(os.time(), d.boostUntil) + reward.boostMin * 60
			end
			if reward.title then
				d.achievements["title:" .. reward.title] = true
			end
		end)
		S.EconomyService.Sync(player)
	end
end

return ProgressRewards
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003A"><Properties><string name="Name">QuestService</string><ProtectedString name="Source">-- Daily quests rolled from Economy.QuestPool. Call QuestService.Progress(player, stat, n)
-- from any gameplay code (e.g. "Collect", "Kill", "Win", "Minutes").
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Economy = require(Shared.Config.Economy)
local Net = require(Shared.Net)

local QuestService = {}
local DataService, EconomyService

local function today(): number
	return math.floor(os.time() / 86400)
end

local function roll(data)
	local pool = table.clone(Economy.QuestPool)
	local rng = Random.new(today() * 7919 + (data.firstJoin % 1000))
	local list = {}
	for _ = 1, math.min(Economy.QuestsPerDay, #pool) do
		local q = table.remove(pool, rng:NextInteger(1, #pool))
		table.insert(list, { id = q.id, progress = 0, claimed = false })
	end
	data.quests = { day = today(), list = list }
end

local function find(id)
	for _, q in ipairs(Economy.QuestPool) do
		if q.id == id then
			return q
		end
	end
	return nil
end

local function push(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local out = {}
	for i, q in ipairs(data.quests.list) do
		local def = find(q.id)
		if def then
			out[i] = { text = def.text, goal = def.goal, progress = math.min(q.progress, def.goal), claimed = q.claimed, reward = def.reward }
		end
	end
	Net.fire(player, "QuestState", out)
end

local function ensure(player: Player)
	local data = DataService.Get(player)
	if data and data.quests.day ~= today() then
		DataService.Update(player, roll)
	end
end

function QuestService.Progress(player: Player, stat: string, amount: number)
	ensure(player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local changed = false
	DataService.Update(player, function(d)
		d.stats[stat] = (d.stats[stat] or 0) + amount
		for _, q in ipairs(d.quests.list) do
			local def = find(q.id)
			if def and def.stat == stat and not q.claimed and q.progress &lt; def.goal then
				q.progress += amount
				changed = true
			end
		end
	end)
	if changed then
		push(player)
	end
end

function QuestService.Init(services)
	DataService = services.DataService
	EconomyService = services.EconomyService
	Net.declare("QuestState")

	DataService.Loaded:Connect(function(player)
		ensure(player)
		push(player)
	end)

	Net.on("ClaimQuest", function(player, index)
		ensure(player)
		local data = DataService.Get(player)
		local q = data and type(index) == "number" and data.quests.list[index]
		local def = q and find(q.id)
		if not def or q.claimed or q.progress &lt; def.goal then
			return
		end
		DataService.Update(player, function()
			q.claimed = true
		end)
		EconomyService.Grant(player, def.reward, "quest")
		EconomyService.Toast(player, "Quest complete: " .. def.text, "success")
		push(player)
	end, 3)
end

return QuestService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003B"><Properties><string name="Name">RaidArena</string><ProtectedString name="Source">-- Raid arena builder (flat floor, walls, cover, spawn pad), one instance per slot.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Cfg = require(ReplicatedStorage.Shared.Config.Raid)
local Zones = require(ReplicatedStorage.Shared.Config.Zones)

local Arena = { Built = {} :: { [number]: Model } }
local arenas = Arena.Built

function Arena.ZoneOfTier(tier: number)
	for _, z in ipairs(Zones) do
		if z.tier == tier then
			return z
		end
	end
	return Zones[1]
end


local function part(parent: Instance, name: string, size: Vector3, pos: Vector3, color: Color3, transparency: number?)
	local p = Instance.new("Part")
	p.Name, p.Size, p.Position, p.Color, p.Anchored = name, size, pos, color, true
	p.Material = Enum.Material.SmoothPlastic
	p.Transparency = transparency or 0
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end


function Arena.Origin(slot: number): Vector3
	return Cfg.ArenaOrigin + Vector3.new(slot * Cfg.ArenaSpacing, 0, 0)
end


function Arena.Build(slot: number): Model
	if arenas[slot] then
		return arenas[slot]
	end
	local map = Workspace:FindFirstChild("Map") or Workspace
	local root = map:FindFirstChild("Raid") or Instance.new("Folder")
	root.Name = "Raid"
	if not root.Parent then
		root.Parent = map
	end
	local m = Instance.new("Model")
	m.Name = "Arena" .. slot
	local o, s = Arena.Origin(slot), Cfg.ArenaSize
	part(m, "Floor", Vector3.new(s, 2, s), o + Vector3.new(0, -1, 0), Color3.fromRGB(55, 50, 70))
	for _, d in ipairs({ { 0, 1 }, { 0, -1 }, { 1, 0 }, { -1, 0 } }) do -- walls (20 high, invisible-ish top)
		local horiz = d[1] == 0
		part(m, "Wall", if horiz then Vector3.new(s, 24, 2) else Vector3.new(2, 24, s), o + Vector3.new(d[1] * (s / 2 + 1), 12, d[2] * (s / 2 + 1)), Color3.fromRGB(90, 70, 120), 0.4)
	end
	for _, c in ipairs({ { -30, -30 }, { 30, -30 }, { -30, 30 }, { 30, 30 }, { 0, -45 }, { 0, 45 } }) do
		part(m, "Cover", Vector3.new(10, 6, 10), o + Vector3.new(c[1], 3, c[2]), Color3.fromRGB(120, 100, 150))
	end
	local pad = part(m, "SpawnPad", Vector3.new(14, 1, 14), o + Vector3.new(0, 0.5, 0), Color3.fromRGB(80, 220, 160))
	pad.Material = Enum.Material.Neon
	m.Parent = root
	arenas[slot] = m
	return m
end

return Arena
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003C"><Properties><string name="Name">RaidRewards</string><ProtectedString name="Source">-- Raid rewards + Raid Token shop logic.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Cfg = require(Shared.Config.Raid)
local Monsters = require(Shared.Config.Monsters)
local Arena = require(script.Parent.RaidArena)
local rng = Random.new()
local Rewards = {}

function Rewards.Grant(S, raid, p: Player, cleared: number, won: boolean)
	local tier = raid.tier
	local z = Arena.ZoneOfTier(tier)
	local common, core, rare = Monsters[z.monsters[1]].drops, Monsters[z.monsters[3]].drops, Monsters[z.boss].drops
	local coins = Cfg.CoinsPerWave[tier] * cleared
	local gems, tokens = Cfg.GemsPerWave * cleared, Cfg.TokensPerWave * cleared
	local mats = { [common[1][1]] = cleared * 2, [core[2][1]] = cleared // 2 }
	if won then
		gems += Cfg.ClearBonus.Gems
		tokens += Cfg.ClearBonus.Tokens
		mats[rare[2][1]] = rng:NextInteger(1, 2)
	end
	local daily = false
	if won then
		local day = os.time() // 86400
		S.DataService.Update(p, function(d)
			if (d.raid.daily or 0) &lt; day then
				d.raid.daily = day
				daily = true
			end
		end)
		if daily then
			coins += Cfg.CoinsPerWave[tier] * Cfg.DailyFirstClear.CoinsMult
			gems += Cfg.DailyFirstClear.Gems
			tokens += Cfg.DailyFirstClear.Tokens
		end
	end
	S.DataService.Update(p, function(d)
		d.raid.tokens += tokens
		d.raid.best = math.max(d.raid.best, cleared)
		if won then
			d.raid.clears += 1
		end
	end)
	if coins &gt; 0 then
		S.EconomyService.Add(p, "Coins", coins, "raid", false)
	end
	if gems &gt; 0 then
		S.EconomyService.Add(p, "Gems", gems, "raid", false)
	end
	for id, n in pairs(mats) do
		S.InventoryService.AddMaterial(p, id, n)
	end
	return { coins = coins, gems = gems, tokens = tokens, mats = mats, daily = daily }
end


function Rewards.Buy(S, p: Player, id): boolean
	local item
	for _, it in ipairs(Cfg.Shop) do
		if it.id == id then
			item = it
		end
	end
	local d = S.DataService.Get(p)
	if not item or not d then
		return false
	end
	if item.kind == "title" and d.raid.owned and d.raid.owned[item.id] then
		S.DataService.Update(p, function(dd)
			dd.title = item.title
		end)
		return true -- already owned: just re-equip
	end
	if d.raid.tokens &lt; item.cost then
		return false
	end
	local z = Arena.ZoneOfTier(S.ZoneService.BestTier(S.PlayerService.GetPower(p)))
	S.DataService.Update(p, function(dd)
		dd.raid.tokens -= item.cost
		if item.kind == "boost" then
			dd.boostUntil = math.max(os.time(), dd.boostUntil) + item.seconds
		elseif item.kind == "title" then
			dd.raid.owned = dd.raid.owned or {}
			dd.raid.owned[item.id] = true
			dd.achievements["title:" .. item.title] = true
			dd.title = item.title
		end
	end)
	if item.kind == "gems" then
		S.EconomyService.Add(p, "Gems", item.amount, "raidshop", false)
	elseif item.kind == "mats" then
		S.InventoryService.AddMaterial(p, Monsters[z.monsters[1]].drops[1][1], 30)
		S.InventoryService.AddMaterial(p, Monsters[z.monsters[2]].drops[2][1], 6)
	elseif item.kind == "rare" then
		S.InventoryService.AddMaterial(p, Monsters[z.boss].drops[2][1], 2)
	end
	S.EconomyService.Toast(p, "Purchased " .. item.name, "success")
	return true
end

return Rewards
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003D"><Properties><string name="Name">RaidService</string><ProtectedString name="Source">-- Co-op raid: lobby (1-4 players) -&gt; 10 waves of tier-scaled monsters in a code-built arena -&gt; rewards + Raid Token shop.
-- Players in a raid carry attribute "RaidId" (never MatchId). Raid monsters give no normal kill rewards.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Cfg = require(Shared.Config.Raid)
local Arena = require(script.Parent.RaidArena)
local Rewards = require(script.Parent.RaidRewards)
local Monsters = require(Shared.Config.Monsters)

local RaidService = {}
local S
local rng = Random.new()
local lobbies: { [number]: any } = {} -- by raid id (open or running)
local ofPlayer: { [Player]: any } = {}
local slotBusy: { [number]: boolean } = {}
local nextId = 0


local function members(raid): { Player }
	local out = {}
	for _, p in ipairs(raid.members) do
		if p.Parent then
			table.insert(out, p)
		end
	end
	return out
end

local function fireAll(raid, name: string, ...)
	for _, p in ipairs(members(raid)) do
		Net.fire(p, name, ...)
	end
end

local function lobbyView(raid)
	local names = {}
	for _, p in ipairs(raid.members) do
		table.insert(names, p.DisplayName)
	end
	return { id = raid.id, leader = raid.leader.DisplayName, leaderId = raid.leader.UserId, names = names, count = #names, started = raid.started }
end

local function pushLobby(raid)
	fireAll(raid, "RaidLobby", lobbyView(raid))
end

local function toHub(p: Player)
	local r = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if r then
		r.CFrame = CFrame.new(0, 5, 0)
	end
end

local function teleportIn(raid, p: Player)
	local r = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if r then
		r.CFrame = CFrame.new(Arena.Origin(raid.slot) + Vector3.new(rng:NextInteger(-5, 5), 4, rng:NextInteger(-5, 5)))
	end
end

local function removeMember(raid, p: Player, silent: boolean?)
	local i = table.find(raid.members, p)
	if i then
		table.remove(raid.members, i)
	end
	ofPlayer[p] = nil
	p:SetAttribute("RaidId", nil)
	p:SetAttribute("RaidDead", nil)
	if p.Parent then
		if raid.started then
			toHub(p)
			S.PlayerService.RefreshCharacter(p)
		end
		if not silent then
			Net.fire(p, "RaidLobby", nil)
		end
	end
	if #raid.members == 0 then
		raid.over = true
		for id in pairs(raid.mons or {}) do -- don't leak monsters into the next raid on this slot
			S.MonsterService.Remove(id)
		end
		raid.mons = {}
		lobbies[raid.id] = nil
		if raid.slot then
			slotBusy[raid.slot] = false
		end
	elseif raid.leader == p then
		raid.leader = raid.members[1]
		pushLobby(raid)
	else
		pushLobby(raid)
	end
end

local function bestTier(raid): number
	local t = 1
	for _, p in ipairs(members(raid)) do
		t = math.max(t, S.ZoneService.BestTier(S.PlayerService.GetPower(p)))
	end
	return t
end

local function finish(raid, cleared: number, won: boolean)
	if raid.over then
		return
	end
	raid.over = true
	for id in pairs(raid.mons) do
		S.MonsterService.Remove(id)
	end
	raid.mons = {}
	local list = members(raid)
	for _, p in ipairs(list) do
		local ok, res = pcall(Rewards.Grant, S, raid, p, cleared, won)
		Net.fire(p, "RaidEnd", { won = won, cleared = cleared, waves = Cfg.Waves, rewards = if ok then res else nil })
		ofPlayer[p] = nil
		p:SetAttribute("RaidId", nil)
		p:SetAttribute("RaidDead", nil)
		Net.fire(p, "RaidState", nil)
		Net.fire(p, "RaidLobby", nil)
		toHub(p)
		S.PlayerService.RefreshCharacter(p)
	end
	raid.members = {}
	lobbies[raid.id] = nil
	slotBusy[raid.slot] = false
end

local function scaled(raid, id: string, wave: number, frac: number?)
	local def = Monsters[id]
	local hp = def.hp * (frac or 1) * (1 + Cfg.HpPerWave * (wave - 1)) * (1 + Cfg.PartyHpBonus * (#raid.members - 1))
	local copy = table.clone(def)
	copy.hp = hp
	return copy, math.floor(hp)
end

local function spawnWave(raid, wave: number)
	local z = Arena.ZoneOfTier(raid.tier)
	local list = {} -- defIds + hp fraction
	local boss = wave == Cfg.BossWave
	local mini = wave == Cfg.MiniBossWave
	if boss or mini then
		table.insert(list, { z.boss, if boss then Cfg.BossHp else Cfg.MiniBossHp })
	end
	local n = math.min(Cfg.MaxAlive, math.floor(Cfg.BaseCount + Cfg.CountPerWave * wave))
	if boss or mini then
		n = math.floor(n / 2)
	end
	for _ = 1, n do
		table.insert(list, { z.monsters[rng:NextInteger(1, #z.monsters)], 1 })
	end
	raid.total, raid.killed, raid.wave = #list, 0, wave
	raid.endsAt = Workspace:GetServerTimeNow() + Cfg.WaveSeconds
	raid.deadline = os.clock() + Cfg.WaveSeconds
	local o = Arena.Origin(raid.slot)
	for i, e in ipairs(list) do
		if raid.over then
			return
		end
		local def, hp = scaled(raid, e[1], wave, e[2])
		local a = rng:NextNumber(0, math.pi * 2)
		local rad = rng:NextNumber(45, 62)
		local rec = S.MonsterService.Spawn(e[1], o + Vector3.new(math.cos(a) * rad, 0, math.sin(a) * rad), { def = def, hpOverride = hp, raidId = raid.id,
			onDeath = function(r)
				raid.mons[r.id] = nil
				if not raid.over and raid.wave == wave then
					raid.killed += 1
					fireAll(raid, "RaidState", { wave = wave, waves = Cfg.Waves, killed = raid.killed, total = raid.total, endsAt = raid.endsAt, boss = boss or mini })
				end
			end })
		raid.mons[rec.id] = true
		if i % 4 == 0 then
			task.wait(0.3)
		end
	end
end

local function run(raid)
	local cleared = 0
	for wave = 1, Cfg.Waves do
		if raid.over then
			return
		end
		spawnWave(raid, wave)
		fireAll(raid, "RaidState", { wave = wave, waves = Cfg.Waves, killed = 0, total = raid.total, endsAt = raid.endsAt, boss = wave == Cfg.BossWave or wave == Cfg.MiniBossWave, banner = true })
		while not raid.over and raid.killed &lt; raid.total and os.clock() &lt; raid.deadline and not raid.failed do
			task.wait(0.5)
		end
		if raid.over then
			return
		end
		if raid.killed &lt; raid.total then
			finish(raid, cleared, false)
			return
		end
		cleared = wave
		if wave &lt; Cfg.Waves then
			task.wait(Cfg.IntermissionSeconds)
		end
	end
	finish(raid, cleared, true)
end

local function allDead(raid): boolean
	for _, p in ipairs(raid.members) do
		if p.Parent and not p:GetAttribute("RaidDead") then
			return false
		end
	end
	return true
end

local function hook(p: Player)
	p.CharacterAdded:Connect(function(char)
		local raid = ofPlayer[p]
		p:SetAttribute("RaidDead", nil)
		local hum = char:WaitForChild("Humanoid", 5) :: Humanoid?
		if raid and raid.started and hum then
			task.wait(0.3) -- after PlayerService sets up the character
			if ofPlayer[p] == raid and not raid.over then
				teleportIn(raid, p)
			end
			hum.Died:Connect(function()
				if ofPlayer[p] == raid and not raid.over then
					p:SetAttribute("RaidDead", true)
					if allDead(raid) then
						raid.failed = true
					end
				end
			end)
		end
	end)
end

local function startRaid(raid)
	local slot
	for i = 0, Cfg.MaxArenas - 1 do
		if not slotBusy[i] then
			slot = i
			break
		end
	end
	if not slot then
		return false
	end
	slotBusy[slot] = true
	raid.slot, raid.started, raid.mons = slot, true, {}
	Arena.Build(slot)
	raid.tier = bestTier(raid)
	for _, p in ipairs(members(raid)) do
		p:SetAttribute("RaidId", raid.id)
		local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.Health = hum.MaxHealth
			hum.Died:Connect(function() -- first life (later lives are hooked on CharacterAdded)
				if ofPlayer[p] == raid and not raid.over then
					p:SetAttribute("RaidDead", true)
					if allDead(raid) then
						raid.failed = true
					end
				end
			end)
		end
		teleportIn(raid, p)
	end
	pushLobby(raid)
	task.spawn(run, raid)
	return true
end

local function inPvp(p: Player): boolean
	return p:GetAttribute("MatchId") ~= nil
end

function RaidService.Init(services)
	S = services
	for _, n in ipairs({ "RaidLobby", "RaidState", "RaidEnd" }) do
		Net.declare(n)
	end
	for _, p in ipairs(Players:GetPlayers()) do
		hook(p)
	end
	Players.PlayerAdded:Connect(hook)
	Players.PlayerRemoving:Connect(function(p)
		local raid = ofPlayer[p]
		if raid then
			removeMember(raid, p, true)
			if raid.started and not raid.over and #raid.members &gt; 0 and allDead(raid) then
				raid.failed = true
			end
		end
	end)

	Net.handle("RaidInfo", function(p)
		local d = S.DataService.Get(p)
		if not d then
			return nil
		end
		local open = {}
		for _, r in pairs(lobbies) do
			if not r.started and #r.members &lt; Cfg.MaxPlayers then
				table.insert(open, lobbyView(r))
			end
		end
		local mine = ofPlayer[p]
		return { open = open, mine = if mine then lobbyView(mine) else nil, tokens = d.raid.tokens, best = d.raid.best, clears = d.raid.clears,
			dailyReady = (d.raid.daily or 0) &lt; os.time() // 86400, shop = Cfg.Shop, title = d.title, owned = d.raid.owned or {}, tier = S.ZoneService.BestTier(S.PlayerService.GetPower(p)) }
	end, 2)

	Net.handle("RaidCreate", function(p)
		if ofPlayer[p] or inPvp(p) then
			return false
		end
		nextId += 1
		local raid = { id = nextId, leader = p, members = { p }, started = false }
		lobbies[raid.id] = raid
		ofPlayer[p] = raid
		pushLobby(raid)
		return true
	end, 2)

	Net.handle("RaidJoin", function(p, id)
		local raid = type(id) == "number" and lobbies[id]
		if not raid or raid.started or ofPlayer[p] or inPvp(p) or #raid.members &gt;= Cfg.MaxPlayers then
			return false
		end
		table.insert(raid.members, p)
		ofPlayer[p] = raid
		pushLobby(raid)
		return true
	end, 2)

	Net.on("RaidLeave", function(p)
		local raid = ofPlayer[p]
		if raid then
			removeMember(raid, p)
		end
	end, 2)

	Net.handle("RaidStart", function(p)
		local raid = ofPlayer[p]
		if not raid or raid.leader ~= p or raid.started or inPvp(p) then
			return false
		end
		if not startRaid(raid) then
			S.EconomyService.Toast(p, "All raid arenas are busy, try again soon", "error")
			return false
		end
		return true
	end, 1)

	Net.handle("RaidBuy", function(p, id)
		return Rewards.Buy(S, p, id)
	end, 3)
end

return RaidService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003E"><Properties><string name="Name">RebirthService</string><ProtectedString name="Source">-- Rebirth: reset Power + Coins (keep items/pets) for a permanent training multiplier.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Training = require(Shared.Config.Training)
local Net = require(Shared.Net)

local RebirthService = {}
local BASE_COST, GROWTH = 50000, 4

function RebirthService.Cost(rebirths: number): number
	return BASE_COST * GROWTH ^ rebirths
end

function RebirthService.Init(S)
	Net.handle("RebirthInfo", function(player)
		local d = S.DataService.Get(player)
		if not d then
			return nil
		end
		return { rebirths = d.rebirths, cost = RebirthService.Cost(d.rebirths), power = d.stats.Power,
			now = Training.RebirthMultiplier ^ d.rebirths, after = Training.RebirthMultiplier ^ (d.rebirths + 1) }
	end, 4)

	Net.handle("Rebirth", function(player)
		local d = S.DataService.Get(player)
		if not d or d.stats.Power &lt; RebirthService.Cost(d.rebirths) or S.PlayerService.InArena(player) then
			return false
		end
		S.DataService.Update(player, function(data)
			data.rebirths += 1
			data.currencies.Coins = 0
		end)
		S.PlayerService.SetPower(player, 0)
		S.EconomyService.Sync(player)
		S.InventoryService.Sync(player)
		S.TrainingService.Push(player)
		S.PlayerService.RefreshCharacter(player)
		S.AnalyticsService.Badge(player, "Rebirth1")
		S.EconomyService.Toast(player, ("REBIRTH %d! Training x%.2f"):format(d.rebirths, Training.RebirthMultiplier ^ d.rebirths), "success")
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			root.CFrame = CFrame.new(0, 5, 0)
		end
		return true
	end, 1)
end

return RebirthService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003F"><Properties><string name="Name">RewardService</string><ProtectedString name="Source">-- Retention: daily login streak + session playtime rewards.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Economy = require(Shared.Config.Economy)
local Net = require(Shared.Net)

local RewardService = {}
local DataService, EconomyService, AnalyticsService
local sessionStart: { [Player]: number } = {}
local claimedPlaytime: { [Player]: { [number]: boolean } } = {}

local function today(): number
	return math.floor(os.time() / 86400)
end

local function dailyState(data)
	local d = today()
	local canClaim = data.daily.lastDay &lt; d
	local streak = data.daily.streak
	if data.daily.lastDay &lt; d - 1 then
		streak = 0 -- missed a day
	end
	local nextIndex = (streak % #Economy.DailyRewards) + 1
	return canClaim, streak, nextIndex
end

local function pushState(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local canClaim, streak, nextIndex = dailyState(data)
	local minutes = (os.clock() - (sessionStart[player] or os.clock())) / 60
	local playtime = {}
	for i, r in ipairs(Economy.PlaytimeRewards) do
		playtime[i] = {
			minutes = r.minutes,
			reward = r.reward,
			claimed = claimedPlaytime[player] and claimedPlaytime[player][i] or false,
			ready = minutes &gt;= r.minutes,
		}
	end
	Net.fire(player, "RewardState", {
		daily = { canClaim = canClaim, streak = streak, nextIndex = nextIndex, rewards = Economy.DailyRewards },
		playtime = playtime,
		sessionMinutes = minutes,
	})
end

function RewardService.Init(services)
	DataService = services.DataService
	EconomyService = services.EconomyService
	AnalyticsService = services.AnalyticsService
	Net.declare("RewardState")

	DataService.Loaded:Connect(function(player)
		sessionStart[player] = os.clock()
		claimedPlaytime[player] = {}
		pushState(player)
	end)
	Players.PlayerRemoving:Connect(function(p)
		sessionStart[p] = nil
		claimedPlaytime[p] = nil
	end)

	Net.on("ClaimDaily", function(player)
		local data = DataService.Get(player)
		if not data then
			return
		end
		local canClaim, streak, nextIndex = dailyState(data)
		if not canClaim then
			return
		end
		DataService.Update(player, function(d)
			d.daily.lastDay = today()
			d.daily.streak = streak + 1
		end)
		EconomyService.Grant(player, Economy.DailyRewards[nextIndex], "daily")
		EconomyService.Toast(player, "Daily reward claimed! Day " .. (streak + 1), "success")
		if streak + 1 &gt;= 7 then
			AnalyticsService.Badge(player, "Streak7")
		end
		pushState(player)
	end, 2)

	Net.on("ClaimPlaytime", function(player, index)
		local r = type(index) == "number" and Economy.PlaytimeRewards[index]
		if not r or not sessionStart[player] or claimedPlaytime[player][index] then
			return
		end
		if (os.clock() - sessionStart[player]) / 60 &lt; r.minutes then
			return
		end
		claimedPlaytime[player][index] = true
		EconomyService.Grant(player, r.reward, "playtime")
		EconomyService.Toast(player, "Playtime reward claimed!", "success")
		pushState(player)
	end, 2)

	-- refresh timers once a minute (cheap) and count Minutes stat for quests
	task.spawn(function()
		while true do -- lint-ok (task.wait)
			task.wait(60)
			for _, player in ipairs(Players:GetPlayers()) do
				if sessionStart[player] then
					services.QuestService.Progress(player, "Minutes", 1)
					pushState(player)
				end
			end
		end
	end)
end

return RewardService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000040"><Properties><string name="Name">SeasonService</string><ProtectedString name="Source">-- Season pass: XP from gameplay stats (wraps QuestService.Progress), 30 tiers, free + premium tracks.
-- Init AFTER QuestService, DataService, EconomyService, MonetizationService.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config.Season)
local Net = require(ReplicatedStorage.Shared.Net)
local Rewards = require(script.Parent.ProgressRewards)

local SeasonService = {}
local S

local function ensure(player: Player)
	local d = S.DataService.Get(player)
	if d and d.season.id ~= Config.Id then
		S.DataService.Update(player, function(x)
			x.season = { id = Config.Id, xp = 0, claimed = {}, premiumClaimed = {} }
		end)
	end
	return S.DataService.Get(player)
end

local function tierOf(xp: number): number
	return math.min(Config.Tiers, math.floor(xp / Config.XpPerTier))
end

local function state(player: Player)
	local d = ensure(player)
	if not d then
		return nil
	end
	local se = d.season
	return {
		id = Config.Id,
		xp = math.floor(se.xp),
		tier = tierOf(se.xp),
		premium = S.MonetizationService.GetPerk(player, "seasonPremium") == true,
		claimed = se.claimed,
		premiumClaimed = se.premiumClaimed,
	}
end

function SeasonService.AddXp(player: Player, n: number)
	if n &lt;= 0 then
		return
	end
	local d = ensure(player)
	if not d then
		return
	end
	local before = tierOf(d.season.xp)
	S.DataService.Update(player, function(x)
		x.season.xp += n
	end)
	local after = tierOf(d.season.xp)
	if after &gt; before then
		S.EconomyService.Toast(player, ("Season tier %d reached! Open PASS to claim."):format(after), "success")
	end
end

function SeasonService.Init(services)
	S = services
	local original = S.QuestService.Progress
	S.QuestService.Progress = function(player: Player, stat: string, amount: number)
		original(player, stat, amount)
		local w = Config.Weights[stat]
		if w and type(amount) == "number" then
			SeasonService.AddXp(player, w * amount)
		end
	end

	S.DataService.Loaded:Connect(ensure)

	Net.handle("SeasonInfo", function(player)
		return state(player)
	end, 4)

	Net.handle("SeasonClaim", function(player, tier, premium)
		if type(tier) ~= "number" or tier % 1 ~= 0 or tier &lt; 1 or tier &gt; Config.Tiers or type(premium) ~= "boolean" then
			return state(player)
		end
		local st = state(player)
		if not st or tier &gt; st.tier or (premium and not st.premium) then
			return st
		end
		local key = tostring(tier)
		local map = premium and "premiumClaimed" or "claimed"
		if st[map][key] then
			return st
		end
		S.DataService.Update(player, function(d)
			d.season[map][key] = true
		end)
		local reward = (premium and Config.Premium or Config.Free)[tier]
		Rewards.Grant(S, player, reward, "season")
		S.EconomyService.Toast(player, ("Season tier %d claimed!"):format(tier), "success")
		return state(player)
	end, 4)
end

return SeasonService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000041"><Properties><string name="Name">SocialService</string><ProtectedString name="Source">-- Friend boost (friends in this server), Roblox Premium bonus, group membership bonus + daily chest.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Social = require(ReplicatedStorage.Shared.Config.Social)
local Net = require(ReplicatedStorage.Shared.Net)

local SocialService = {}
local S
local friendCount: { [Player]: number } = {}
local inGroup: { [Player]: boolean } = {}

function SocialService.Mult(player: Player): number
	local m = 1 + math.min(Social.FriendBoostMax, (friendCount[player] or 0) * Social.FriendBoostPer)
	if player.MembershipType == Enum.MembershipType.Premium then
		m += Social.PremiumBoost
	end
	if inGroup[player] then
		m += Social.GroupBoost
	end
	return m
end

local friends: { [Player]: { [Player]: boolean } } = {}

local function refresh(p: Player)
	local n = 0
	for _ in pairs(friends[p] or {}) do
		n += 1
	end
	friendCount[p] = n
	p:SetAttribute("SocialBoost", math.floor((SocialService.Mult(p) - 1) * 100 + 0.5))
end

-- O(n) per join: only check pairs that involve the new player (web call each), not all pairs
local function onJoin(newP: Player)
	friends[newP] = friends[newP] or {}
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= newP then
			local ok, yes = pcall(newP.IsFriendsWithAsync, newP, other.UserId)
			if ok and yes then
				friends[newP][other] = true
				friends[other] = friends[other] or {}
				friends[other][newP] = true
				refresh(other)
			end
		end
	end
	refresh(newP)
end

function SocialService.Init(services)
	S = services
	Players.PlayerAdded:Connect(function(p)
		if Social.GroupId ~= 0 then
			local ok, yes = pcall(p.IsInGroup, p, Social.GroupId)
			inGroup[p] = ok and yes or false
		end
		task.delay(2, onJoin, p)
	end)
	Players.PlayerRemoving:Connect(function(p)
		friendCount[p], inGroup[p] = nil, nil
		for other in pairs(friends[p] or {}) do
			if friends[other] then
				friends[other][p] = nil
				if other.Parent then
					refresh(other)
				end
			end
		end
		friends[p] = nil
	end)
	Net.handle("GroupChest", function(p)
		if Social.GroupId == 0 then
			return "Group chest is not set up yet"
		end
		if not inGroup[p] then
			local ok, yes = pcall(p.IsInGroup, p, Social.GroupId)
			inGroup[p] = ok and yes or false
			if not inGroup[p] then
				return "Join the group to open this chest!"
			end
		end
		local d = S.DataService.Get(p)
		if not d then
			return "Try again"
		end
		local last = d.social and d.social.chest or 0
		local wait = last + Social.GroupChest.cooldownHours * 3600 - os.time()
		if wait &gt; 0 then
			return ("Come back in %dh %dm"):format(wait // 3600, (wait % 3600) // 60)
		end
		S.DataService.Update(p, function(data)
			data.social = data.social or {}
			data.social.chest = os.time()
		end)
		S.EconomyService.Grant(p, Social.GroupChest.reward, "groupchest")
		return "OK"
	end, 1)
end

return SocialService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000042"><Properties><string name="Name">SpinService</string><ProtectedString name="Source">-- Daily spin wheel. Server picks the prize; client only animates to the returned index.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config.Spin)
local Net = require(ReplicatedStorage.Shared.Net)
local Rewards = require(script.Parent.ProgressRewards)

local SpinService = {}
local S
local rng = Random.new()

local function today(): number
	return math.floor(os.time() / 86400)
end

local function info(player: Player)
	local d = S.DataService.Get(player)
	if not d then
		return nil
	end
	local sp = d.spin
	local paid = (sp.paidDay == today()) and (sp.paidCount or 0) or 0
	return {
		freeIn = math.max(0, (sp.last or 0) + Config.FreeSeconds - os.time()),
		paidLeft = Config.MaxPaidPerDay - paid,
		cost = Config.GemCost,
	}
end

local function pick(): number
	local total = 0
	for _, p in ipairs(Config.Prizes) do
		total += p.weight
	end
	local r = rng:NextNumber() * total
	for i, p in ipairs(Config.Prizes) do
		r -= p.weight
		if r &lt;= 0 then
			return i
		end
	end
	return 1
end

function SpinService.Init(services)
	S = services

	Net.handle("SpinInfo", info, 3)

	Net.handle("Spin", function(player, usePaid)
		local d = S.DataService.Get(player)
		if not d or type(usePaid) ~= "boolean" then
			return nil
		end
		local st = info(player)
		if usePaid and st.freeIn &lt;= 0 then
			usePaid = false -- stale client UI: never charge Gems while a free spin is ready
		end
		if usePaid then
			if st.paidLeft &lt;= 0 or not S.EconomyService.Spend(player, "Gems", Config.GemCost) then
				return nil
			end
			S.DataService.Update(player, function(x)
				if x.spin.paidDay ~= today() then
					x.spin.paidDay, x.spin.paidCount = today(), 0
				end
				x.spin.paidCount += 1
			end)
		else
			if st.freeIn &gt; 0 then
				return nil
			end
			S.DataService.Update(player, function(x)
				x.spin.last = os.time()
			end)
		end
		local index = pick()
		local prize = Config.Prizes[index]
		Rewards.Grant(S, player, prize.reward, "spin")
		if prize.announce then
			Net.fireAll("Toast", ("%s hit the JACKPOT on the Daily Spin!"):format(player.DisplayName), "success")
		end
		return { index = index, info = info(player) }
	end, 1)
end

return SpinService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000043"><Properties><string name="Name">StationService</string><ProtectedString name="Source">-- ProximityPrompts on hub stations (names are MapService contracts). Client opens the matching
-- panel via ProximityPromptService.PromptTriggered + the prompt's "Panel" attribute.
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Zones = require(ReplicatedStorage.Shared.Config.Zones)

local StationService = {}

local STATIONS = {
	Booth_TargetRush = { "Target Rush", "Play", "Minigame:TargetRush" },
	Booth_ReloadRhythm = { "Reload Rhythm", "Play", "Minigame:ReloadRhythm" },
	Booth_LuckyCrate = { "Lucky Crate", "Open", "Minigame:LuckyCrate" },
	Forge = { "Forge", "Craft", "Forge" },
	FusionAltar = { "Fusion Altar", "Fuse", "Pets" },
	RebirthStatue = { "Rebirth", "Rebirth", "Rebirth" },
	ArenaPortal = { "PvP Arena", "Queue", "Arena" },
	ClanBoard = { "Clans", "Open", "Clan" },
	CodesBoard = { "Codes", "Redeem", "Codes" },
}

function StationService.Init(services)
	task.spawn(function()
		local map = Workspace:WaitForChild("Map", 30)
		local hub = map and map:WaitForChild("Hub", 30)
		if not hub then
			warn("[StationService] no Map.Hub")
			return
		end
		-- stage portals (hub) + return portals (inside each stage): server-side teleport
		local function teleport(player: Player, to: Vector3)
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root and not player:GetAttribute("MatchId") and not player:GetAttribute("RaidId") then
				root.CFrame = CFrame.new(to + Vector3.new(0, 4, 0))
			end
		end
		local zonesFolder = map:WaitForChild("Zones", 30)
		for _, z in ipairs(Zones) do
			local portal = hub:WaitForChild("Portal_" .. z.id, 10)
			if portal and portal:IsA("BasePart") then
				local pp = Instance.new("ProximityPrompt")
				pp.ObjectText = z.name
				pp.ActionText = "Teleport"
				pp.MaxActivationDistance = 12
				pp.RequiresLineOfSight = false
				pp.Parent = portal
				pp.Triggered:Connect(function(player)
					if services.PlayerService.GetPower(player) &lt; z.powerReq then
						services.EconomyService.Toast(player, ("Need %d Power for %s"):format(z.powerReq, z.name), "error")
						return
					end
					teleport(player, (z.gatePos :: Vector3) + Vector3.new(0, 0, -20))
				end)
			end
			local zm = zonesFolder and zonesFolder:FindFirstChild(z.id)
			local back = zm and zm:FindFirstChild("ReturnPortal_" .. z.id, true)
			if back and back:IsA("BasePart") then
				local pp = Instance.new("ProximityPrompt")
				pp.ObjectText = "Hub"
				pp.ActionText = "Return"
				pp.MaxActivationDistance = 12
				pp.RequiresLineOfSight = false
				pp.Parent = back
				pp.Triggered:Connect(function(player)
					teleport(player, Vector3.new(0, 0, 0))
				end)
			end
		end
		for name, s in pairs(STATIONS) do
			local part = hub:WaitForChild(name, 10)
			if part and part:IsA("BasePart") then
				local pp = Instance.new("ProximityPrompt")
				pp.ObjectText = s[1]
				pp.ActionText = s[2]
				pp.HoldDuration = 0
				pp.MaxActivationDistance = 14
				pp.RequiresLineOfSight = false
				pp:SetAttribute("Panel", s[3])
				pp.Parent = part
			end
		end
	end)
end

return StationService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000044"><Properties><string name="Name">StoryService</string><ProtectedString name="Source">-- Story quests (Commander Vex). Progress is derived from data.stats; data.story.progress is the stat baseline of the current step.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config.Story)
local Achievements = require(ReplicatedStorage.Shared.Config.Achievements)
local Net = require(ReplicatedStorage.Shared.Net)
local Rewards = require(script.Parent.ProgressRewards)

local StoryService = {}
local S
local lastSent = {}

local function value(d, step): number
	local st = d.story
	if step.kind == "power" then
		return d.stats.Power or 0
	elseif step.kind == "stat" then
		return math.max(0, (d.stats[step.stat] or 0) - (st.progress or 0))
	end
	return Achievements.Value(d, step.kind)
end

local function state(player: Player)
	local d = S.DataService.Get(player)
	if not d then
		return nil
	end
	local n = d.story.step
	local step = Config.Steps[n]
	if not step then
		return { step = n, total = #Config.Steps, finished = true }
	end
	local v = math.min(math.floor(value(d, step)), step.goal)
	return { step = n, total = #Config.Steps, text = step.text, value = v, goal = step.goal, done = v &gt;= step.goal, reward = step.reward }
end

local function push(player: Player, force: boolean?)
	local st = state(player)
	if not st then
		return
	end
	local key = ("%d:%s:%s"):format(st.step, tostring(st.value), tostring(st.done))
	if force or lastSent[player] ~= key then
		lastSent[player] = key
		Net.fire(player, "StoryState", st)
	end
end

function StoryService.Init(services)
	S = services
	Net.declare("StoryState")

	S.DataService.Loaded:Connect(function(player)
		push(player, true)
	end)
	Players.PlayerRemoving:Connect(function(p)
		lastSent[p] = nil
	end)

	task.spawn(function()
		while true do -- lint-ok (task.wait)
			task.wait(4)
			for _, p in ipairs(Players:GetPlayers()) do
				push(p)
			end
		end
	end)

	Net.handle("StoryInfo", state, 3)

	Net.on("StoryClaim", function(player)
		local d = S.DataService.Get(player)
		local st = state(player)
		if not d or not st or st.finished or not st.done then
			return
		end
		local nextStep = Config.Steps[st.step + 1]
		S.DataService.Update(player, function(x)
			x.story.step = st.step + 1
			x.story.progress = (nextStep and nextStep.kind == "stat") and (x.stats[nextStep.stat] or 0) or 0
		end)
		Rewards.Grant(S, player, Config.Steps[st.step].reward, "story")
		S.EconomyService.Toast(player, (Config.Npc .. ": Well done, soldier! Step %d complete."):format(st.step), "success")
		push(player, true)
	end, 3)
end

return StoryService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000045"><Properties><string name="Name">TournamentService</string><ProtectedString name="Source">-- Server tournament every N minutes: signup (entry fee) -&gt; single-elimination 1v1 bracket using
-- ArenaService.StartMatch -&gt; champion takes the pot + Gems + trophy + badge.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Combat = require(Shared.Config.Combat)
local Net = require(Shared.Net)

local TournamentService = {}
local S
local T = Combat.Tournament
local state = { phase = "idle", entrants = {} :: { Player }, rounds = {}, endsAt = 0, nextAt = 0, pot = 0 }

local function broadcast()
	local rounds = {}
	for r, list in ipairs(state.rounds) do
		rounds[r] = {}
		for i, m in ipairs(list) do
			rounds[r][i] = { a = m.a and m.a.DisplayName or "BYE", b = m.b and m.b.DisplayName or "BYE", winner = m.winner and m.winner.DisplayName }
		end
	end
	local names = {}
	for _, p in ipairs(state.entrants) do
		table.insert(names, p.DisplayName)
	end
	Net.fireAll("TourState", { phase = state.phase, endsAt = state.endsAt, nextAt = state.nextAt, entrants = names,
		size = T.Size, entry = T.EntryCoins, pot = state.pot, rounds = rounds })
end

local function startDuel(m, done)
	S.ArenaService.StartMatch({ m.a }, { m.b }, "Tournament", {
		killsToWin = T.KillsToWin, minutes = 3, ranked = false,
		onEnd = function(winnerTeam)
			if winnerTeam == "A" then
				done(m.a)
			elseif winnerTeam == "B" then
				done(m.b)
			else -- draw: higher rating advances
				local da, db = S.DataService.Get(m.a), S.DataService.Get(m.b)
				done(if (da and da.pvp.rating or 0) &gt;= (db and db.pvp.rating or 0) then m.a else m.b)
			end
		end,
	})
end

local function runRound(players: { Player }): { Player }
	local list = {}
	for i = 1, #players, 2 do
		table.insert(list, { a = players[i], b = players[i + 1] })
	end
	table.insert(state.rounds, list)
	broadcast()
	local open = 0
	for _, m in ipairs(list) do
		if not m.b or not m.b.Parent then
			m.winner = m.a
		elseif not m.a.Parent then
			m.winner = m.b
		else
			open += 1
			startDuel(m, function(winner)
				m.winner = winner
				open -= 1
				broadcast()
			end)
		end
	end
	local t0 = os.clock()
	while open &gt; 0 and os.clock() - t0 &lt; 600 do
		task.wait(1)
	end
	local winners = {}
	for _, m in ipairs(list) do
		if m.winner and m.winner.Parent then
			table.insert(winners, m.winner)
		end
	end
	return winners
end

local function run()
	state = { phase = "signup", entrants = {}, rounds = {}, endsAt = Workspace:GetServerTimeNow() + T.SignupSeconds, nextAt = 0, pot = 0 }
	Net.fireAll("Announce", ("TOURNAMENT signup open! Entry %d Coins — go to the Arena Portal"):format(T.EntryCoins))
	broadcast()
	task.wait(T.SignupSeconds)
	if #state.entrants &lt; 2 then
		for _, p in ipairs(state.entrants) do
			if p.Parent then
				S.EconomyService.Add(p, "Coins", T.EntryCoins, "tour_refund", false)
				p:SetAttribute("InTournament", nil)
			end
		end
		state.phase = "idle"
		broadcast()
		Net.fireAll("Announce", "Tournament cancelled (not enough players).")
		return
	end
	state.phase = "running"
	local players = table.clone(state.entrants)
	for i = #players, 2, -1 do -- shuffle
		local j = math.random(1, i)
		players[i], players[j] = players[j], players[i]
	end
	while #players &gt; 1 do
		players = runRound(players)
	end
	local champ = players[1]
	if champ and champ.Parent then
		S.EconomyService.Add(champ, "Coins", state.pot, "tournament", false)
		S.EconomyService.Add(champ, "Gems", T.PrizeGems, "tournament", false)
		S.DataService.Update(champ, function(d)
			d.pvp.trophies += 1
		end)
		S.AnalyticsService.Badge(champ, "TournamentWin")
		S.ClanService.AddXp(champ, 200)
		Net.fireAll("Announce", ("🏆 %s won the tournament and %d Coins!"):format(champ.DisplayName, state.pot))
	end
	for _, p in ipairs(state.entrants) do
		p:SetAttribute("InTournament", nil)
	end
	state.phase = "done"
	broadcast()
end

function TournamentService.Init(services)
	S = services
	Net.declare("TourState")
	Net.handle("TourJoin", function(player)
		if state.phase ~= "signup" or table.find(state.entrants, player) or #state.entrants &gt;= T.Size or player:GetAttribute("MatchId") then
			return false
		end
		if not S.EconomyService.Spend(player, "Coins", T.EntryCoins) then
			return false
		end
		S.ArenaService.Dequeue(player)
		table.insert(state.entrants, player)
		state.pot += T.EntryCoins
		player:SetAttribute("InTournament", true)
		broadcast()
		return true
	end, 2)
	Net.handle("TourInfo", function()
		local names = {}
		for _, p in ipairs(state.entrants) do
			table.insert(names, p.DisplayName)
		end
		return { phase = state.phase, endsAt = state.endsAt, nextAt = state.nextAt, entrants = names, size = T.Size, entry = T.EntryCoins, pot = state.pot }
	end, 4)
	Players.PlayerRemoving:Connect(function(p)
		local i = table.find(state.entrants, p)
		if i and state.phase == "signup" then
			table.remove(state.entrants, i)
		end
	end)
	task.spawn(function()
		while true do -- lint-ok (task.wait)
			state.nextAt = Workspace:GetServerTimeNow() + T.IntervalMinutes * 60
			task.wait(T.IntervalMinutes * 60)
			if #Players:GetPlayers() &gt;= 2 then
				run()
			end
		end
	end)
end

return TournamentService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000046"><Properties><string name="Name">TradeService</string><ProtectedString name="Source">-- Secure player trading (same server): request -&gt; accept -&gt; both pick items -&gt; both READY -&gt;
-- 3 s confirm countdown (any change cancels) -&gt; atomic swap re-validated at execution -&gt; both saved.
-- Items move as deep copies under fresh uids; equipped items can't be offered.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Net = require(ReplicatedStorage.Shared.Net)
local Pets = require(ReplicatedStorage.Shared.Config.Pets)
local Recipes = require(ReplicatedStorage.Shared.Config.Recipes)

local TradeService = {}
local S
local MAX_ITEMS, CONFIRM = 8, 3
type Trade = { a: Player, b: Player, offer: { [Player]: { string } }, ready: { [Player]: boolean }, confirmAt: number?, stamp: number?, done: boolean }
local trades: { [Player]: Trade } = {}
local requests: { [Player]: { [Player]: number } } = {} -- target -&gt; from -&gt; time

local function deepCopy(t)
	local c = {}
	for k, v in pairs(t) do
		c[k] = if type(v) == "table" then deepCopy(v) else v
	end
	return c
end

local function isEquipped(d, uid: string): boolean
	local e = d.equipped
	return e.gun == uid or e.helmet == uid or e.vest == uid or e.boots == uid or table.find(e.pets, uid) ~= nil
end

local function itemsView(p: Player, uids: { string })
	local d = S.DataService.Get(p)
	local out = {}
	for _, uid in ipairs(uids) do
		local it = d and d.items[uid]
		if it then
			table.insert(out, { uid = uid, item = it })
		end
	end
	return out
end

local function push(t: Trade)
	for _, me in ipairs({ t.a, t.b }) do
		local other = if me == t.a then t.b else t.a
		Net.fire(me, "TradeState", {
			partner = other.DisplayName,
			mine = itemsView(me, t.offer[me]), theirs = itemsView(other, t.offer[other]),
			myReady = t.ready[me], theirReady = t.ready[other],
			confirmAt = t.confirmAt,
		})
	end
end

local function close(t: Trade, reason: string)
	t.done = true
	for _, p in ipairs({ t.a, t.b }) do
		if trades[p] == t then
			trades[p] = nil
		end
		if p.Parent then
			Net.fire(p, "TradeClosed", reason)
		end
	end
end

local function canReceive(p: Player, incoming: { string }, outgoing: { string }, from: Player): boolean
	local fromData = S.DataService.Get(from)
	local pets, gear = 0, 0
	for _, uid in ipairs(incoming) do
		local it = fromData and fromData.items[uid]
		if it and it.kind == "pet" then
			pets += 1
		else
			gear += 1
		end
	end
	local d = S.DataService.Get(p)
	for _, uid in ipairs(outgoing) do
		local it = d and d.items[uid]
		if it and it.kind == "pet" then
			pets -= 1
		else
			gear -= 1
		end
	end
	return S.InventoryService.ItemCount(p, "pet") + pets &lt;= Pets.MaxPets and S.InventoryService.ItemCount(p, "gun") + gear &lt;= Recipes.MaxItems
end

local function valid(t: Trade): boolean
	for _, p in ipairs({ t.a, t.b }) do
		local d = S.DataService.Get(p)
		if not d or not p.Parent then
			return false
		end
		for _, uid in ipairs(t.offer[p]) do
			if not d.items[uid] or isEquipped(d, uid) then
				return false
			end
		end
	end
	return canReceive(t.a, t.offer[t.b], t.offer[t.a], t.b) and canReceive(t.b, t.offer[t.a], t.offer[t.b], t.a)
end

local function execute(t: Trade)
	if t.done or not valid(t) then
		close(t, "Trade failed: items changed")
		return
	end
	t.done = true
	local moveA, moveB = {}, {}
	local da, db = S.DataService.Get(t.a), S.DataService.Get(t.b)
	for _, uid in ipairs(t.offer[t.a]) do
		table.insert(moveA, deepCopy(da.items[uid]))
	end
	for _, uid in ipairs(t.offer[t.b]) do
		table.insert(moveB, deepCopy(db.items[uid]))
	end
	-- remove first (no window where both own the item), then grant
	for _, uid in ipairs(t.offer[t.a]) do
		S.InventoryService.RemoveItem(t.a, uid)
	end
	for _, uid in ipairs(t.offer[t.b]) do
		S.InventoryService.RemoveItem(t.b, uid)
	end
	for _, it in ipairs(moveA) do
		S.InventoryService.CreateItem(t.b, it)
	end
	for _, it in ipairs(moveB) do
		S.InventoryService.CreateItem(t.a, it)
	end
	task.spawn(S.DataService.Save, t.a)
	task.spawn(S.DataService.Save, t.b)
	S.AnalyticsService.Event(t.a, "Trade", #moveA + #moveB)
	t.done = false
	close(t, "Trade complete!")
end

local function setReady(p: Player, on: boolean)
	local t = trades[p]
	if not t or t.done then
		return
	end
	t.ready[p] = on
	if t.ready[t.a] and t.ready[t.b] then
		local stamp = os.clock()
		t.confirmAt = workspace:GetServerTimeNow() + CONFIRM
		t.stamp = stamp
		push(t)
		task.delay(CONFIRM, function()
			if trades[t.a] == t and t.stamp == stamp and t.ready[t.a] and t.ready[t.b] then
				execute(t)
			end
		end)
	else
		t.confirmAt = nil
		push(t)
	end
end

function TradeService.Init(services)
	S = services
	for _, n in ipairs({ "TradeInvite", "TradeState", "TradeClosed" }) do
		Net.declare(n)
	end

	Net.on("TradeRequest", function(p, targetId)
		local target = type(targetId) == "number" and Players:GetPlayerByUserId(targetId)
		if not target or target == p or trades[p] or trades[target] then
			return
		end
		requests[target] = requests[target] or {}
		if requests[target][p] and os.clock() - requests[target][p] &lt; 10 then
			return -- no invite spam
		end
		requests[target][p] = os.clock()
		Net.fire(target, "TradeInvite", { fromId = p.UserId, from = p.DisplayName })
		S.EconomyService.Toast(p, "Trade request sent to " .. target.DisplayName, "info")
	end, 1)

	Net.on("TradeAccept", function(p, fromId)
		local from = type(fromId) == "number" and Players:GetPlayerByUserId(fromId)
		local t0 = from and requests[p] and requests[p][from]
		if not from or not t0 or os.clock() - t0 &gt; 30 or trades[p] or trades[from] then
			return
		end
		requests[p][from] = nil
		local t: Trade = { a = from, b = p, offer = { [from] = {}, [p] = {} }, ready = { [from] = false, [p] = false }, done = false }
		trades[from], trades[p] = t, t
		push(t)
	end, 2)

	Net.on("TradeSetOffer", function(p, uids)
		local t = trades[p]
		local d = S.DataService.Get(p)
		if not t or t.done or not d or type(uids) ~= "table" then
			return
		end
		local clean, seen = {}, {}
		for _, uid in ipairs(uids) do
			if type(uid) == "string" and not seen[uid] and d.items[uid] and not isEquipped(d, uid) and #clean &lt; MAX_ITEMS then
				seen[uid] = true
				table.insert(clean, uid)
			end
		end
		t.offer[p] = clean
		t.ready[t.a], t.ready[t.b] = false, false -- any change un-readies both (anti-scam)
		t.confirmAt = nil
		push(t)
	end, 6)

	Net.on("TradeReady", function(p, on)
		if type(on) == "boolean" then
			setReady(p, on)
		end
	end, 4)
	Net.on("TradeCancel", function(p)
		local t = trades[p]
		if t then
			close(t, p.DisplayName .. " cancelled the trade")
		end
	end, 2)
	Players.PlayerRemoving:Connect(function(p)
		local t = trades[p]
		if t then
			close(t, "Partner left")
		end
		requests[p] = nil
	end)
end

return TradeService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000047"><Properties><string name="Name">TrainingService</string><ProtectedString name="Source">-- AFK training: Power every tick, x2 Pulse (tap to boost), offline earnings, x3 boost product.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Training = require(Shared.Config.Training)
local Net = require(Shared.Net)

local TrainingService = {}
local S
type State = { training: boolean, nextPulse: number, offerUntil: number, pulseUntil: number, pulses: number }
local state: { [Player]: State } = {}
local rng = Random.new()

local function push(player: Player)
	local st = state[player]
	local d = S.DataService.Get(player)
	if not st or not d then
		return
	end
	local power = d.stats.Power
	local mult = S.PlayerService.TrainMultiplier(player) * (if os.clock() &lt; st.pulseUntil then Training.Pulse.Multiplier else 1)
	Net.fire(player, "TrainState", {
		training = st.training,
		gain = S.PlayerService.BaseGain(power) * mult,
		mult = mult,
		pulseLeft = math.max(0, st.pulseUntil - os.clock()),
		boostLeft = math.max(0, d.boostUntil - os.time()),
		rebirths = d.rebirths,
	})
end
TrainingService.Push = push

function TrainingService.GainPerSecond(player: Player): number
	return S.PlayerService.BaseGain(S.PlayerService.GetPower(player)) * S.PlayerService.TrainMultiplier(player)
end

-- grant N seconds worth of training (minigames, crates)
function TrainingService.GrantSeconds(player: Player, seconds: number): number
	local amount = math.floor(TrainingService.GainPerSecond(player) * seconds)
	S.PlayerService.AddPower(player, amount)
	return amount
end

local function offline(player: Player, data)
	local cfg = Training.Offline
	local last = data.lastSeen
	S.DataService.Update(player, function(d) -- consume the offline window now (rejoin must not pay twice)
		d.lastSeen = os.time()
	end)
	if last &lt;= 0 then
		return
	end
	local elapsed = math.min(os.time() - last, cfg.MaxHours * 3600)
	if elapsed &lt; cfg.MinMinutes * 60 then
		return
	end
	local gain = math.floor(S.PlayerService.BaseGain(data.stats.Power) * S.PlayerService.TrainMultiplier(player) * cfg.Rate * elapsed)
	if gain &gt; 0 then
		S.PlayerService.AddPower(player, gain)
		task.delay(4, function()
			S.EconomyService.Toast(player, ("While you were away: +%d Power"):format(gain), "success")
		end)
	end
end

function TrainingService.Init(services)
	S = services
	Net.declare("TrainState")
	Net.declare("PulseOffer")

	S.DataService.Loaded:Connect(function(player, data)
		state[player] = { training = true, nextPulse = os.clock() + Training.Pulse.FirstAt, offerUntil = 0, pulseUntil = 0, pulses = 0 }
		offline(player, data)
		push(player)
	end)
	Players.PlayerRemoving:Connect(function(p)
		S.DataService.Update(p, function(d)
			d.lastSeen = os.time()
		end)
		state[p] = nil
	end)

	Net.on("SetTraining", function(player, on)
		local st = state[player]
		if st and type(on) == "boolean" then
			st.training = on
			push(player)
		end
	end, 4)

	Net.on("PulseTap", function(player)
		local st = state[player]
		if not st or os.clock() &gt; st.offerUntil + 0.5 then
			return
		end
		st.offerUntil = 0
		st.pulseUntil = os.clock() + Training.Pulse.BoostSeconds
		S.QuestService.Progress(player, "X2Taps", 1)
		S.EconomyService.Toast(player, "x2 TRAINING ACTIVE!", "success")
		push(player)
	end, 3)

	S.MonetizationService.ProductHandlers.TrainBoost = function(player)
		local cfg = Training.ProductBoost
		S.DataService.Update(player, function(d)
			d.boostUntil = math.max(os.time(), d.boostUntil) + cfg.Seconds
		end)
		push(player)
		return true
	end

	task.spawn(function()
		local tick = 0
		while true do -- lint-ok (task.wait)
			task.wait(Training.TickSeconds)
			tick += 1
			local now = os.clock()
			for player, st in pairs(state) do
				local d = S.DataService.Get(player)
				if d and st.training and not S.PlayerService.InArena(player) then
					local mult = S.PlayerService.TrainMultiplier(player) * (if now &lt; st.pulseUntil then Training.Pulse.Multiplier else 1)
					S.PlayerService.AddPower(player, S.PlayerService.BaseGain(d.stats.Power) * mult * Training.TickSeconds)
					if now &gt;= st.nextPulse then
						local p = Training.Pulse
						st.offerUntil = now + p.ShowSeconds
						st.nextPulse = now + rng:NextNumber(p.MinGap, p.MaxGap)
						Net.fire(player, "PulseOffer", p.ShowSeconds)
					end
				end
				if tick % 5 == 0 then
					push(player)
				end
				if tick % 60 == 0 then
					S.DataService.Update(player, function(data)
						data.lastSeen = os.time()
					end)
				end
			end
		end
	end)
end

return TrainingService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000048"><Properties><string name="Name">WorldBossService</string><ProtectedString name="Source">-- World boss in the hub every N minutes: HP scales to the players online, everyone who helps gets
-- rewards by damage share, top 3 get Gems. Telegraphed slam AoE keeps it active, not AFK.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Combat = require(Shared.Config.Combat)
local Guns = require(Shared.Config.Guns)
local Recipes = require(Shared.Config.Recipes)
local Net = require(Shared.Net)

local WorldBossService = {}
local S
local TIER_COINS = { 500, 8000, 120000, 1500000, 25000000 }
local DEF = { name = "TITAN OF THE FORGE", hp = 1, damage = 0, coins = 0, power = 0, drops = {},
	color = Color3.fromRGB(255, 79, 216), size = 22, boss = true, speed = 0, respawn = 0 }

local function scaledHp(): number
	local total = 0
	for _, p in ipairs(Players:GetPlayers()) do
		total += 30 * Guns.PowerFactor(S.PlayerService.GetPower(p)) * 1.5 -- ~starter dps with upgrades
	end
	return math.max(Combat.WorldBoss.Hp, math.floor(total * 90)) -- ~90 s with everyone shooting
end

local function onDeath(rec, pos)
	local total = 0
	for _, dmg in pairs(rec.contrib) do
		total += dmg
	end
	local ranking = {}
	for p, dmg in pairs(rec.contrib) do
		if p.Parent and dmg &gt;= total * 0.01 then
			table.insert(ranking, { p = p, dmg = dmg })
		end
	end
	table.sort(ranking, function(a, b)
		return a.dmg &gt; b.dmg
	end)
	for i, r in ipairs(ranking) do
		local p = r.p
		local tier = S.ZoneService.BestTier(S.PlayerService.GetPower(p))
		local coins = math.floor(TIER_COINS[tier] * (0.5 + r.dmg / total * #ranking))
		S.EconomyService.Add(p, "Coins", coins, "worldboss", true)
		S.InventoryService.AddMaterial(p, Recipes.TierMats[tier][2], 3)
		local gems = ({ 30, 20, 10 })[i]
		if gems then
			S.EconomyService.Add(p, "Gems", gems, "worldboss", false)
		end
		S.QuestService.Progress(p, "BossKills", 1)
		S.ClanService.AddXp(p, 50)
		Net.fire(p, "Loot", pos, { coins = coins, power = 0, mats = { [Recipes.TierMats[tier][2]] = 3 }, rank = i })
	end
	Net.fireAll("Announce", "The World Boss has been defeated!")
end

local function run()
	local pos = Combat.WorldBoss.Position
	Net.fireAll("Announce", "WORLD BOSS arrives in 60 seconds at the Boss Pit!")
	task.wait(60)
	local hp = scaledHp()
	local rec = S.MonsterService.Spawn("world_boss", pos, { def = DEF, static = true, onDeath = onDeath, hpOverride = hp })
	Net.fireAll("Announce", "The World Boss is here! Shoot it!")
	local t0 = os.clock()
	while S.MonsterService.Get(rec.id) and os.clock() - t0 &lt; 360 do
		task.wait(6)
		if not S.MonsterService.Get(rec.id) then
			break
		end
		local center = Vector3.new(pos.X, 0, pos.Z)
		Net.fireAll("BossSlam", center, 28, 1.4) -- telegraph: radius, delay
		task.wait(1.4)
		for _, p in ipairs(Players:GetPlayers()) do
			local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
			if root and hum and (Vector3.new(root.Position.X, 0, root.Position.Z) - center).Magnitude &lt; 28 then
				hum:TakeDamage(hum.MaxHealth * 0.3)
			end
		end
	end
	if S.MonsterService.Get(rec.id) then
		S.MonsterService.Remove(rec.id)
		Net.fireAll("Announce", "The World Boss escaped... next time!")
	end
end

function WorldBossService.Init(services)
	S = services
	Net.declare("BossSlam")
	task.spawn(function()
		while true do -- lint-ok (task.wait)
			task.wait(Combat.WorldBoss.IntervalMinutes * 60 - 60)
			if #Players:GetPlayers() &gt; 0 then
				run()
			end
		end
	end)
end

return WorldBossService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000049"><Properties><string name="Name">WorldService</string><ProtectedString name="Source">-- Applies the lighting preset and builds a starter map when none exists.
-- Perf: all static parts Anchored, decorations CanCollide/CanQuery/CanTouch off,
-- CastShadow off on small props, everything grouped under one Map model for streaming.
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local World = require(ReplicatedStorage.Shared.Config.World)

local WorldService = {}

local function ensure(className: string, name: string)
	local inst = Lighting:FindFirstChild(name) or Instance.new(className)
	inst.Name = name
	inst.Parent = Lighting
	return inst
end

local function setProps(inst: Instance, props)
	for k, v in pairs(props or {}) do
		local ok, err = pcall(function()
			(inst :: any)[k] = v
		end)
		if not ok then
			warn("[WorldService] bad prop", k, err)
		end
	end
end

function WorldService.ApplyPreset(name: string)
	local p = World.Presets[name]
	if not p then
		warn("[WorldService] unknown preset", name)
		return
	end
	setProps(Lighting, p.Lighting)
	setProps(ensure("Atmosphere", "Atmosphere"), p.Atmosphere)
	setProps(ensure("BloomEffect", "Bloom"), p.Bloom)
	setProps(ensure("ColorCorrectionEffect", "ColorCorrection"), p.ColorCorrection)
	local rays = ensure("SunRaysEffect", "SunRays")
	rays.Enabled = p.SunRays ~= nil
	setProps(rays, p.SunRays)
end

local function part(parent, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material, decor: boolean)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material
	p.TopSurface = Enum.SurfaceType.Smooth
	if decor then
		p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = false, false, false, false
	end
	p.Parent = parent
	return p
end

local function fallbackTree(parent, pos: Vector3, rng: Random)
	local m = Instance.new("Model")
	m.Name = "Tree"
	local h = rng:NextNumber(6, 10)
	local trunk = part(m, Vector3.new(1.6, h, 1.6), CFrame.new(pos + Vector3.new(0, h / 2, 0)), Color3.fromRGB(120, 80, 50), Enum.Material.Wood, false)
	trunk.CastShadow = false
	local leaf = part(m, Vector3.one * rng:NextNumber(7, 10), CFrame.new(pos + Vector3.new(0, h + 2, 0)), Color3.fromRGB(80, 180, 80):Lerp(Color3.fromRGB(150, 220, 90), rng:NextNumber()), Enum.Material.Grass, true)
	leaf.Shape = Enum.PartType.Ball
	m.Parent = parent
end

function WorldService.BuildStarterMap()
	local cfg = World.StarterMap
	if not cfg.Enabled or workspace:FindFirstChild("Map") then
		return
	end
	local map = Instance.new("Model")
	map.Name = "Map"
	map.ModelStreamingMode = Enum.ModelStreamingMode.Default

	local base = workspace:FindFirstChild("Baseplate")
	if base then
		base:Destroy()
	end
	part(map, cfg.GroundSize, CFrame.new(0, -cfg.GroundSize.Y / 2, 0), cfg.GroundColor, cfg.GroundMaterial, false).Name = "Ground"

	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Size = Vector3.new(14, 1, 14)
	spawn.Position = Vector3.new(0, 0.5, 0)
	spawn.Color = Color3.fromRGB(255, 255, 255)
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.Duration = 0
	spawn.Parent = map

	for _, pl in ipairs(cfg.Platforms) do
		part(map, pl[2], CFrame.new(pl[1]), pl[3], Enum.Material.SmoothPlastic, false)
	end

	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local decorList = assets and assets:FindFirstChild("Decor") and assets.Decor:GetChildren() or {}
	local rng = Random.new(42)
	local decor = Instance.new("Folder")
	decor.Name = "Decor"
	decor.Parent = map
	for _ = 1, cfg.Decorations do
		local r = cfg.GroundSize.X / 2 - 10
		local pos = Vector3.new(rng:NextNumber(-r, r), 0, rng:NextNumber(-r, r))
		if pos.Magnitude &gt; 30 then -- keep spawn clear
			if #decorList &gt; 0 then
				local m = decorList[rng:NextInteger(1, #decorList)]:Clone()
				m:PivotTo(CFrame.new(pos) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0))
				m.Parent = decor
			else
				fallbackTree(decor, pos, rng)
			end
		end
	end
	map.Parent = workspace
end

function WorldService.Init()
	WorldService.ApplyPreset(World.Preset)
	WorldService.BuildStarterMap()
end

return WorldService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000004A"><Properties><string name="Name">ZoneService</string><ProtectedString name="Source">-- Zone access by Power: server bounces under-powered players back to the hub (clients make the
-- gate non-collidable locally once unlocked). Sets player attribute "Zone".
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Zones = require(ReplicatedStorage.Shared.Config.Zones)

local ZoneService = {}

function ZoneService.ZoneAt(pos: Vector3)
	for _, z in ipairs(Zones) do
		if math.abs(pos.X - z.center.X) &lt;= z.size.X / 2 and math.abs(pos.Z - z.center.Z) &lt;= z.size.Z / 2 then
			return z
		end
	end
	return nil
end

-- best zone tier the player may enter (for minigame material prizes etc.)
function ZoneService.BestTier(power: number): number
	local tier = 1
	for _, z in ipairs(Zones) do
		if power &gt;= z.powerReq then
			tier = math.max(tier, z.tier)
		end
	end
	return tier
end

function ZoneService.Init(services)
	task.spawn(function()
		while true do -- lint-ok (task.wait)
			task.wait(1)
			for _, p in ipairs(Players:GetPlayers()) do
				local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
				if root then
					local z = ZoneService.ZoneAt(root.Position)
					p:SetAttribute("Zone", z and z.id or "hub")
					if z and services.PlayerService.GetPower(p) &lt; z.powerReq then
						root.CFrame = CFrame.new(0, 5, 0)
						services.EconomyService.Toast(p, ("Need %d Power for %s!"):format(z.powerReq, z.name), "error")
					end
				end
			end
		end
	end)
end

return ZoneService
</ProtectedString></Properties></Item></Item></Item></Item><Item class="StarterPlayer" referent="RBX0000006A"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX00000069"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX00000068"><Properties><string name="Name">Client</string></Properties><Item class="ModuleScript" referent="RBX0000004E"><Properties><string name="Name">ClientState</string><ProtectedString name="Source">-- Client-side mirror of server pushes (Inv, TrainState). Controllers read + subscribe here.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Net = require(ReplicatedStorage.Shared.Net)
local Signal = require(ReplicatedStorage.Shared.Signal)

local State = {
	Inv = { materials = {}, items = {}, equipped = { gun = "", helmet = "", vest = "", boots = "", pets = {} }, index = { guns = {}, pets = {}, monsters = {} }, rebirths = 0 },
	Train = { training = true, gain = 0, mult = 1, pulseLeft = 0, boostLeft = 0, rebirths = 0 },
	InvChanged = Signal.new(),
	TrainChanged = Signal.new(),
}

function State.Power(): number
	local ls = Players.LocalPlayer:FindFirstChild("leaderstats")
	local v = ls and ls:FindFirstChild("Power")
	return v and (v :: IntValue).Value or 0
end

function State.Coins(): number
	local ls = Players.LocalPlayer:FindFirstChild("leaderstats")
	local v = ls and ls:FindFirstChild("Coins")
	return v and (v :: IntValue).Value or 0
end

function State.Init()
	Net.listen("Inv", function(inv)
		State.Inv = inv
		State.InvChanged:Fire(inv)
	end)
	Net.listen("TrainState", function(t)
		State.Train = t
		State.TrainChanged:Fire(t)
	end)
end

return State
</ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000063"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX0000004F"><Properties><string name="Name">AfkController</string><ProtectedString name="Source">-- AFK MODE: turns off 3D rendering (saves battery/heat on long AFK sessions), shows a clean
-- overlay with live Power/coins gained this AFK session. Training keeps running server-side.
-- Also shows the social boost chip (friends / premium / group).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Theme = require(ReplicatedStorage.Shared.Theme)
local UI = require(script.Parent.Parent.UIKit)
local W = require(script.Parent.Parent.Widgets)
local State = require(script.Parent.Parent.ClientState)
local UIController = require(script.Parent.UIController)

local C = Theme.Colors
local Afk = {}

function Afk.Init()
	local gui = UIController.Gui()
	local player = Players.LocalPlayer
	local overlay = UI.new("Frame", { BackgroundColor3 = Color3.fromRGB(8, 6, 16), Size = UDim2.fromScale(1, 1), ZIndex = 40, Visible = false, Parent = gui })
	UI.gradient(Color3.fromRGB(22, 16, 44), Color3.fromRGB(6, 4, 12)).Parent = overlay
	UI.label("AFK MODE", 56, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.18), Size = UDim2.fromOffset(700, 70), TextColor3 = C.Energy, ZIndex = 41, Parent = overlay })
	local stats = UI.label("", 30, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.35), Size = UDim2.fromOffset(800, 160), ZIndex = 41, Parent = overlay })
	UI.label("Training continues • 3D rendering paused to save battery", 18, { Font = Theme.FontBody, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.62), Size = UDim2.fromOffset(800, 24), TextColor3 = C.TextDim, ZIndex = 41, Parent = overlay })
	local startPower, startCoins, startTime = 0, 0, 0
	local exit = UI.button("TAP TO RETURN", C.Primary, function() end, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.72), Size = UDim2.fromOffset(280, 64), ZIndex = 42, Parent = overlay })
	local function setAfk(on: boolean)
		overlay.Visible = on
		pcall(function()
			RunService:Set3dRenderingEnabled(not on)
		end)
		if on then
			startPower, startCoins, startTime = State.Power(), State.Coins(), os.clock()
		end
	end
	exit.Activated:Connect(function()
		setAfk(false)
	end)
	local btn = UI.button("AFK", C.PanelLight, function()
		setAfk(true)
	end, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 150, 1, -16), Size = UDim2.fromOffset(70, 56), Parent = gui })
	btn.Label.TextSize = 16

	local chip = UI.panel({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(0.5, -176, 0, 64), Size = UDim2.fromOffset(200, 24), BackgroundColor3 = C.Primary, Visible = false, Parent = gui })
	local chipL = UI.label("", 13, { Size = UDim2.fromScale(1, 1), Parent = chip })
	player:GetAttributeChangedSignal("SocialBoost"):Connect(function()
		local b = player:GetAttribute("SocialBoost") or 0
		chip.Visible = b &gt; 0
		chipL.Text = ("👥 SOCIAL BOOST +%d%%"):format(b)
	end)

	task.spawn(function()
		while true do -- lint-ok (task.wait)
			task.wait(1)
			if overlay.Visible then
				local mins = (os.clock() - startTime) / 60
				stats.Text = ("⚡ +%s Power\n🪙 +%s Coins\n⏱ %d min"):format(W.short(State.Power() - startPower), W.short(math.max(0, State.Coins() - startCoins)), math.floor(mins))
			end
		end
	end)
end

return Afk
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000050"><Properties><string name="Name">ArenaController</string><ProtectedString name="Source">-- PvP: queue window (1v1 / 2v2 / 4v4 + rating), tournament signup + bracket, in-match scoreboard.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Theme = require(Shared.Theme)
local Net = require(Shared.Net)
local Combat = require(Shared.Config.Combat)
local UI = require(script.Parent.Parent.UIKit)
local W = require(script.Parent.Parent.Widgets)
local UIController = require(script.Parent.UIController)

local C = Theme.Colors
local Arena = {}
local body, tab = nil, "QUEUE"
local tour = nil
local queuePill, queueLabel, score

local function renderQueue()
	UIController.List(body)
	local st = Net.invoke("PvpStats")
	if st then
		UIController.Row(body, 0, ("Rating %d   🏆 %d"):format(st.rating, st.trophies), ("Wins %d  •  Losses %d  •  PvP is fair: everyone has the same HP, passes don't count"):format(st.wins, st.losses), "", C.Panel, false, function() end)
	end
	local order = { "Duel", "Duo", "Squad" }
	for i, mode in ipairs(order) do
		local m = Combat.Arena.Modes[mode]
		UIController.Row(body, i, m.name .. " Ranked", ("First to %d kills • %d min • win +%d Coins"):format(m.killsToWin, m.minutes, Combat.Arena.WinCoins), "QUEUE", C.Danger, true, function()
			Net.send("QueueJoin", mode)
			UIController.Close("Arena")
		end, nil, "menu_pvp")
	end
end

local function renderTour()
	UIController.List(body)
	local t = tour or Net.invoke("TourInfo")
	if not t then
		return
	end
	local now = Workspace:GetServerTimeNow()
	local T = Combat.Tournament
	if t.phase == "signup" then
		UIController.Row(body, 0, ("SIGNUP OPEN — %ds left"):format(math.max(0, math.floor(t.endsAt - now))),
			("%d/%d players • entry %d Coins • pot %s + %d Gems"):format(#t.entrants, t.size, t.entry, W.short(t.pot), T.PrizeGems), "JOIN", C.Gold, true, function()
				if not Net.invoke("TourJoin") then
					UIController.Toast("Can't join (full, already in, or not enough Coins)", "error")
				end
			end)
	else
		local mins = math.max(0, math.floor(((t.nextAt or 0) - now) / 60))
		UIController.Row(body, 0, if t.phase == "running" then "TOURNAMENT IN PROGRESS" else ("Next tournament in ~%d min"):format(mins),
			("8-player 1v1 bracket • first to %d • entry %d Coins"):format(T.KillsToWin, T.EntryCoins), "", C.Panel, false, function() end)
	end
	for r, round in ipairs(t.rounds or {}) do
		for i, m in ipairs(round) do
			UIController.Row(body, r * 10 + i, ("Round %d: %s vs %s"):format(r, m.a, m.b), m.winner and ("Winner: " .. m.winner) or "fighting...", "", C.Panel, false, function() end)
		end
	end
end

local function render()
	if not body then
		return
	end
	W.clear(body)
	if tab == "QUEUE" then
		renderQueue()
	else
		renderTour()
	end
end
Arena.Render = render

function Arena.Init()
	local gui = UIController.Gui()
	local win, b = UIController.MakeWindow("Arena", "PVP ARENA", C.Danger)
	body = b
	local select = W.tabs(win, b, { "QUEUE", "TOURNAMENT" }, function(name)
		tab = name
		render()
	end)
	UIController.AddMenuButton(8, "PVP", C.Danger, "Arena").Activated:Connect(function()
		task.defer(render)
	end)

	-- queue pill
	queuePill = UI.panel({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 70), Size = UDim2.fromOffset(250, 50), BackgroundColor3 = C.Danger, Visible = false, Parent = gui })
	queueLabel = UI.label("", 16, { Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -90, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, Parent = queuePill })
	UI.button("LEAVE", C.PanelLight, function()
		Net.send("QueueLeave")
	end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -6, 0.5, 0), Size = UDim2.fromOffset(76, 38), Parent = queuePill }).Label.TextSize = 14
	Net.listen("QueueState", function(q)
		queuePill.Visible = q ~= nil
		if q then
			queueLabel.Text = ("Finding %s... %d/%d"):format(Combat.Arena.Modes[q.mode].name, q.count, q.need)
		end
	end)

	-- scoreboard
	score = UI.panel({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 100), Size = UDim2.fromOffset(420, 60), BackgroundColor3 = C.Bg, Visible = false, Parent = gui })
	local scoreL = UI.label("", 26, { Size = UDim2.fromScale(1, 1), Parent = score })
	local current = nil
	Net.listen("MatchState", function(s)
		current = s
		queuePill.Visible = false
		score.Visible = true
	end)
	task.spawn(function()
		while true do -- lint-ok (task.wait)
			task.wait(0.25)
			if current and score.Visible then
				local left = math.max(0, current.endsAt - Workspace:GetServerTimeNow())
				local mine = current.team
				local other = if mine == "A" then "B" else "A"
				scoreL.Text = ("%s  YOU %d — %d ENEMY  •  %d:%02d  (to %d)"):format(current.mode, current.kills[mine], current.kills[other], left // 60, left % 60, current.killsToWin)
			end
		end
	end)
	Net.listen("MatchEnd", function(r)
		score.Visible = false
		current = nil
		local won = r.winner == r.team
		local box, close = W.modal(gui, if r.winner == nil then "DRAW" elseif won then "VICTORY!" else "DEFEAT", if won then C.Primary else C.Danger)
		UI.label(if r.ranked then ("Rating %s%d"):format(if r.delta &gt;= 0 then "+" else "", r.delta) else "Tournament match", 30, { Position = UDim2.fromOffset(0, 140), Size = UDim2.new(1, 0, 0, 40), Parent = box })
		UI.button("OK", C.Primary, close, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -20), Size = UDim2.fromOffset(200, 54), Parent = box })
	end)
	Net.listen("TourState", function(t)
		tour = t
		if UIController.IsOpen("Arena") and tab == "TOURNAMENT" then
			render()
		end
	end)
	select("QUEUE")
end

return Arena
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000051"><Properties><string name="Name">ClanController</string><ProtectedString name="Source">-- Clans: create / info / members (promote, kick) / invite nearby players / weekly Clan War top 10.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Theme = require(Shared.Theme)
local Net = require(Shared.Net)
local Combat = require(Shared.Config.Combat)
local UI = require(script.Parent.Parent.UIKit)
local W = require(script.Parent.Parent.Widgets)
local UIController = require(script.Parent.UIController)

local C = Theme.Colors
local Clan = {}
local body, tab = nil, "MY CLAN"
local ROLE = { ["1Leader"] = "Leader", ["2Officer"] = "Officer", ["3Member"] = "Member" }

local function input(parent: Instance, placeholder: string, y: number): TextBox
	local box = UI.new("TextBox", { PlaceholderText = placeholder, Text = "", Font = Theme.Font, TextSize = 22, TextColor3 = C.Text, BackgroundColor3 = C.Bg,
		Size = UDim2.fromOffset(300, 48), Position = UDim2.fromOffset(140, y), ClearTextOnFocus = false, Parent = parent })
	UI.corner().Parent = box
	UI.stroke().Parent = box
	return box
end

local function renderCreate()
	local holder = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 260), Parent = body })
	UI.label("You are not in a clan. Create one or ask a clan member for an invite!", 16, { Size = UDim2.new(1, 0, 0, 24), Parent = holder })
	local name = input(holder, "Clan name (3-20)", 40)
	local tag = input(holder, "TAG (2-4)", 100)
	local res = UI.label("", 16, { Position = UDim2.fromOffset(0, 220), Size = UDim2.new(1, 0, 0, 24), Parent = holder })
	UI.button(("CREATE (%s Coins)"):format(W.short(Combat.Clan.CreateCoins)), C.Primary, function()
		local r = Net.invoke("ClanCreate", name.Text, tag.Text)
		res.Text = if r == "OK" then "Clan created!" else tostring(r)
		if r == "OK" then
			task.defer(Clan.Render)
		end
	end, { Position = UDim2.fromOffset(140, 160), Size = UDim2.fromOffset(300, 50), Parent = holder })
end

local function renderMine(info)
	UIController.List(body)
	local c = info.clan
	UIController.Row(body, 0, ("[%s] %s  •  Lv %d"):format(c.tag, c.name, c.level), ("%d/%d members • XP %s • perk +%d%% drops &amp; coins"):format(#c.members, c.max, W.short(c.xp), math.floor(c.perk * 100)),
		"LEAVE", C.Danger, true, function()
			Net.invoke("ClanLeave")
			task.defer(Clan.Render)
		end, (c.xp % Combat.Clan.XpPerLevel) / Combat.Clan.XpPerLevel)
	for i, m in ipairs(c.members) do
		local canManage = info.role &lt; m.role
		local action = if info.role == "1Leader" and m.role == "3Member" then "promote" elseif canManage then "kick" else nil
		UIController.Row(body, i, (if m.online then "🟢 " else "⚫ ") .. m.name, ROLE[m.role] or m.role, if action == "promote" then "PROMOTE" elseif action then "KICK" else "", C.PanelLight, action ~= nil, function()
			Net.invoke("ClanManage", m.userId, action)
			task.defer(Clan.Render)
		end)
	end
	if info.role ~= "3Member" then
		local o = 100
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= Players.LocalPlayer and not p:GetAttribute("ClanTag") then
				o += 1
				UIController.Row(body, o, "Invite " .. p.DisplayName, "Player in this server without a clan", "INVITE", C.Primary, true, function()
					Net.send("ClanInviteSend", p.UserId)
					UIController.Toast("Invite sent to " .. p.DisplayName, "success")
				end)
			end
		end
	end
end

local function renderWar()
	UIController.List(body)
	local list = Net.invoke("ClanWarTop") or {}
	UIController.Row(body, 0, "WEEKLY CLAN WAR", "Clans earn XP from kills, bosses and PvP wins. Resets every Monday.", "", C.Panel, false, function() end)
	for _, e in ipairs(list) do
		UIController.Row(body, e.rank, ("#%d  [%s] %s"):format(e.rank, e.tag, e.name), W.short(e.xp) .. " XP", "", C.Panel, false, function() end)
	end
end

function Clan.Render()
	if not body then
		return
	end
	W.clear(body)
	if tab == "WAR" then
		renderWar()
		return
	end
	local info = Net.invoke("ClanInfo")
	if info and info.clan then
		renderMine(info)
	else
		renderCreate()
	end
end

function Clan.Init()
	local win, b = UIController.MakeWindow("Clan", "CLANS", C.Energy)
	body = b
	local select = W.tabs(win, b, { "MY CLAN", "WAR" }, function(name)
		tab = name
		Clan.Render()
	end)
	UIController.AddMenuButton(10, "CLAN", C.Energy, "Clan").Activated:Connect(function()
		task.defer(Clan.Render)
	end)
	Net.listen("ClanInvite", function(inv)
		local box, close = W.modal(UIController.Gui(), "CLAN INVITE", C.Energy)
		UI.label(("%s invited you to [%s] %s"):format(inv.from, inv.tag, inv.name), 24, { Position = UDim2.fromOffset(20, 120), Size = UDim2.new(1, -40, 0, 80), Parent = box })
		UI.button("JOIN", C.Primary, function()
			local r = Net.invoke("ClanAccept", inv.id)
			UIController.Toast(if r == "OK" then "Joined clan!" else tostring(r), if r == "OK" then "success" else "error")
			close()
		end, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(0.5, -8, 1, -20), Size = UDim2.fromOffset(170, 54), Parent = box })
		UI.button("NO", C.PanelLight, close, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0.5, 8, 1, -20), Size = UDim2.fromOffset(170, 54), Parent = box })
	end)
	select("MY CLAN")
end

return Clan
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000052"><Properties><string name="Name">EffectsController</string><ProtectedString name="Source">-- Client-only visuals (zero server cost): coin spin, pickup burst + floating text,
-- and a quality governor that turns heavy effects off on weak devices / Low Graphics.
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local Net = require(ReplicatedStorage.Shared.Net)

local EffectsController = { LowFx = false }
local spinning: { BasePart } = {}

function EffectsController.SetLowFx(on: boolean)
	EffectsController.LowFx = on
	for _, e in ipairs(Lighting:GetChildren()) do
		if e:IsA("PostEffect") then
			e.Enabled = not on -- Bloom/SunRays/DepthOfField/ColorCorrection
		end
	end
	for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("ParticleEmitter") and d:GetAttribute("Decor") then
			d.Enabled = not on
		end
	end
end

local function burst(pos: Vector3, amount: number)
	if EffectsController.LowFx then
		return
	end
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
	p.Transparency = 1
	p.Size = Vector3.one
	p.Position = pos
	local a = Instance.new("Attachment")
	a.Parent = p
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	pe.Color = ColorSequence.new(Color3.fromRGB(255, 220, 80))
	pe.LightEmission = 0.8
	pe.Size = NumberSequence.new(0.6, 0)
	pe.Speed = NumberRange.new(8, 14)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Lifetime = NumberRange.new(0.4, 0.6)
	pe.Rate = 0
	pe.Parent = a
	p.Parent = workspace
	pe:Emit(12)

	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(120, 40)
	bb.AlwaysOnTop = true
	bb.Adornee = p
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.Font = Enum.Font.FredokaOne
	t.TextScaled = true
	t.Text = "+" .. amount
	t.TextColor3 = Color3.fromRGB(255, 220, 60)
	t.TextStrokeTransparency = 0
	t.Parent = bb
	bb.Parent = p
	TweenService:Create(bb, TweenInfo.new(0.8), { StudsOffset = Vector3.new(0, 4, 0) }):Play()
	TweenService:Create(t, TweenInfo.new(0.8), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	task.delay(1, function()
		p:Destroy()
	end)
end

function EffectsController.Init()
	-- coin spin: one RenderStepped loop for all coins, skipped when far away
	local function track(inst)
		if inst:IsA("BasePart") and inst:GetAttribute("Spin") then
			table.insert(spinning, inst)
		end
	end
	local folder = workspace:WaitForChild("Collectibles", 10)
	if folder then
		folder.ChildAdded:Connect(track)
		for _, c in ipairs(folder:GetChildren()) do
			track(c)
		end
	end
	local cam = workspace.CurrentCamera
	RunService.RenderStepped:Connect(function(dt) -- lint-ok (distance-culled spin)
		local camPos = cam.CFrame.Position
		for i = #spinning, 1, -1 do
			local part = spinning[i]
			if not part.Parent then
				table.remove(spinning, i)
			elseif (part.Position - camPos).Magnitude &lt; 150 then
				part.CFrame *= CFrame.Angles(dt * 2, 0, 0)
			end
		end
	end)

	Net.listen("Collected", function(pos, amount)
		burst(pos, amount)
	end)

	-- auto low-fx on very low quality settings
	local ok, q = pcall(function()
		return UserSettings().GameSettings.SavedQualityLevel.Value
	end)
	if ok and q &gt; 0 and q &lt;= 3 then
		EffectsController.SetLowFx(true)
	end
end

return EffectsController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000053"><Properties><string name="Name">ForgeController</string><ProtectedString name="Source">-- Forge UI: recipe list (guns / armor, by tier) -&gt; assembly minigame (timing taps per part)
-- -&gt; rarity reveal card -&gt; equip.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage.Shared
local Theme = require(Shared.Theme)
local Net = require(Shared.Net)
local Recipes = require(Shared.Config.Recipes)
local Guns = require(Shared.Config.Guns)
local Materials = require(Shared.Config.Materials)
local UI = require(script.Parent.Parent.UIKit)
local W = require(script.Parent.Parent.Widgets)
local State = require(script.Parent.Parent.ClientState)
local UIController = require(script.Parent.UIController)
local MG = require(script.Parent.MinigameController)

local C = Theme.Colors
local Forge = {}
local body, kindFilter = nil, "GUNS"
local PART_NAMES = { gun = { "Barrel", "Receiver", "Grip", "Sight", "Mag" }, armor = { "Plates", "Straps", "Core", "Padding", "Visor" } }
local GLYPH = { pistol = "🔫", smg = "🔫", shotgun = "🔫", rifle = "🔫", blaster = "✦", railgun = "⚡", helmet = "⛑", vest = "🦺", boots = "👢" }

local function matText(recipe): (string, boolean)
	local inv = State.Inv.materials
	local parts, ok = {}, true
	for id, n in pairs(recipe.mats) do
		local have = inv[id] or 0
		ok = ok and have &gt;= n
		table.insert(parts, ("%s %d/%d"):format(Materials[id].glyph, have, n))
	end
	ok = ok and State.Coins() &gt;= recipe.coins
	table.insert(parts, "🪙 " .. W.short(recipe.coins))
	return table.concat(parts, "  "), ok
end

local function enchText(item): string
	if not item.ench then
		return ""
	end
	for _, e in ipairs(Guns.Enchants) do
		if e.kind == item.ench.kind then
			return "  •  " .. e.name .. " " .. e.fmt:format(math.floor(item.ench.val * 100))
		end
	end
	return ""
end

local function statText(item): string
	if item.kind == "gun" then
		local t = Guns.Types[item.id]
		local lvl = item.lvl or 0
		local mastery = if lvl &gt; 0 then ("  •  Lv%d"):format(lvl) else ""
		return ("DMG %s  •  %s/s%s%s"):format(W.short(item.dmg * (1 + lvl * Guns.Mastery.DamagePerLevel)), tostring(t.rate), mastery, enchText(item))
	end
	return ("+%s HP  •  Q%d%%"):format(W.short(item.hp), math.floor(item.q * 100))
end
Forge.StatText = statText

local function reveal(box: Frame, close: () -&gt; (), res)
	for _, ch in ipairs(box:GetChildren()) do
		if ch.Name == "Play" then
			ch:Destroy()
		end
	end
	local item = res.item
	local r = Guns.Rarities[item.rarity]
	W.flash(UIController.Gui(), r.color)
	local name = if item.kind == "gun" then Guns.Types[item.id].name else Guns.Armor[item.id].name
	local card = W.card(box, 0, item.rarity, GLYPH[item.id] or "★", ("%s %s T%d"):format(r.name, name, item.tier), statText(item), nil, nil, nil, (if item.kind == "gun" then "gun_" else "armor_") .. item.id)
	card.AnchorPoint = Vector2.new(0.5, 0)
	card.Position = UDim2.new(0.5, 0, 0, 70)
	card.Size = UDim2.fromOffset(220, 150)
	local s = UI.new("UIScale", { Scale = 0.2, Parent = card })
	TweenService:Create(s, TweenInfo.new(0.5, Enum.EasingStyle.Back), { Scale = 1.3 }):Play()
	UI.label(("Perfect parts: %d%s"):format(res.perfects, if res.bumped then "  —  RARITY UP!" else ""), 18, { Position = UDim2.fromOffset(0, 300), Size = UDim2.new(1, 0, 0, 24), TextColor3 = if res.bumped then C.Gold else C.TextDim, Parent = box })
	UI.button("EQUIP", C.Primary, function()
		Net.send("Equip", res.uid)
		close()
	end, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(0.5, -8, 1, -16), Size = UDim2.fromOffset(170, 52), Parent = box })
	UI.button("KEEP", C.PanelLight, close, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0.5, 8, 1, -16), Size = UDim2.fromOffset(170, 52), Parent = box })
end

local function craft(recipe)
	local start = Net.invoke("ForgeStart", recipe.id)
	if not start or not start.ok then
		UIController.Toast(start and start.err or "Can't craft", "error")
		return
	end
	UIController.Close("Forge")
	local box, close = W.modal(UIController.Gui(), "ASSEMBLY", C.Forge)
	local names = PART_NAMES[recipe.kind]
	local perfects, index = 0, 1
	local partL = UI.label("", 30, { Name = "Play", Position = UDim2.fromOffset(0, 70), Size = UDim2.new(1, 0, 0, 36), TextColor3 = C.Gold, Parent = box })
	local slots = UI.new("Frame", { Name = "Play", BackgroundTransparency = 1, Position = UDim2.fromOffset(60, 120), Size = UDim2.new(1, -120, 0, 40), Parent = box })
	UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 10), Parent = slots })
	local slotFrames = {}
	for i = 1, start.parts do
		slotFrames[i] = UI.panel({ Size = UDim2.fromOffset(90, 36), BackgroundColor3 = C.Bg, Parent = slots }, { UI.label(names[i] or "Part", 13, { Size = UDim2.fromScale(1, 1) }) })
	end
	partL.Text = "Install: " .. names[1]
	local tap, stop
	local finished = false
	tap, stop = MG.TimingBar(box, 190, 1.1 + recipe.tier * 0.12, 0.14, function(perfect)
		if finished then
			return
		end
		local f = slotFrames[index]
		f.BackgroundColor3 = if perfect then C.Primary else C.Danger
		local sc = UI.new("UIScale", { Scale = 1.3, Parent = f })
		TweenService:Create(sc, Theme.Tween, { Scale = 1 }):Play()
		if perfect then
			perfects += 1
		end
		index += 1
		if index &gt; start.parts then
			finished = true
			stop()
			partL.Text = "Forging..."
			task.wait(0.8)
			local res = Net.invoke("ForgeFinish", start.session, perfects)
			if res then
				reveal(box, close, res)
			else
				close()
			end
		else
			partL.Text = "Install: " .. (names[index] or "Part")
		end
	end)
	local btn = UI.button("HAMMER!", C.Forge, function()
		tap()
	end, { Name = "Play", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 260), Size = UDim2.fromOffset(240, 70), Parent = box })
	btn.Label.TextSize = 30
end

local function renderEnchant()
	UIController.List(body)
	UIController.Row(body, 0, "ENCHANT &amp; MASTERY", ("Enchant: %d Gems + 2 rare cores of the gun's tier → random bonus (replaces old). Mastery: kills level guns up to Lv%d (+%d%% dmg/lv)."):format(
		Guns.EnchantCost.Gems, Guns.Mastery.MaxLevel, math.floor(Guns.Mastery.DamagePerLevel * 100)), "", C.Panel, false, function() end)
	local list = {}
	for uid, it in pairs(State.Inv.items) do
		if it.kind == "gun" then
			table.insert(list, { uid = uid, it = it })
		end
	end
	table.sort(list, function(a, b)
		return a.it.dmg &gt; b.it.dmg
	end)
	for i, e in ipairs(list) do
		local it = e.it
		local core = Recipes.TierMats[it.tier][2]
		local have = State.Inv.materials[core] or 0
		local lvl = it.lvl or 0
		local progress = if lvl &gt;= Guns.Mastery.MaxLevel then 1 else (it.xp or 0) / Guns.MasteryXpNeeded(lvl)
		UIController.Row(body, i, ("%s %s %s T%d  (Lv%d)"):format(GLYPH[it.id] or "", Guns.Rarities[it.rarity].name, Guns.Types[it.id].name, it.tier, lvl),
			statText(it) .. ("  •  %s %d/%d"):format(Materials[core].glyph, have, Guns.EnchantCost.RareCores), "ENCHANT", Color3.fromRGB(181, 108, 255),
			have &gt;= Guns.EnchantCost.RareCores, function()
				local r = Net.invoke("Enchant", e.uid)
				if r and r.kind then
					task.delay(0.3, function()
						Forge.Render()
					end)
					W.flash(UIController.Gui(), Color3.fromRGB(181, 108, 255))
					UIController.Toast(("%s! %s"):format(r.name, enchText({ ench = r }):sub(8)), "success")
				elseif r and r.err then
					UIController.Toast(r.err, "error")
				end
			end, progress, "gun_" .. it.id)
	end
end

local function render()
	if not body then
		return
	end
	W.clear(body)
	if kindFilter == "ENCHANT" then
		renderEnchant()
		return
	end
	UIController.List(body)
	local kind = if kindFilter == "GUNS" then "gun" else "armor"
	local list = {}
	for _, r in ipairs(Recipes.List) do
		if r.kind == kind then
			table.insert(list, r)
		end
	end
	table.sort(list, function(a, b)
		local _, oa = matText(a)
		local _, ob = matText(b)
		if oa ~= ob then
			return oa
		end
		return a.tier &lt; b.tier
	end)
	for i, r in ipairs(list) do
		local name = if kind == "gun" then Guns.Types[r.item].name else Guns.Armor[r.item].name
		local text, ok = matText(r)
		UIController.Row(body, i, ("%s %s  (Tier %d)"):format(GLYPH[r.item] or "", name, r.tier), text, "CRAFT", C.Forge, ok, function()
			craft(r)
		end, nil, (if kind == "gun" then "gun_" else "armor_") .. r.item)
	end
end
Forge.Render = render

function Forge.Init()
	local win, b = UIController.MakeWindow("Forge", "THE FORGE", C.Forge)
	body = b
	local select = W.tabs(win, b, { "GUNS", "ARMOR", "ENCHANT" }, function(name)
		kindFilter = name
		render()
	end)
	UIController.AddMenuButton(5, "FORGE", C.Forge, "Forge").Activated:Connect(function()
		task.defer(render)
	end)
	State.InvChanged:Connect(function()
		if UIController.IsOpen("Forge") then
			render()
		end
	end)
	Net.listen("ForgeAuto", function(res)
		UIController.Toast("Forge finished automatically: " .. Guns.Rarities[res.item.rarity].name, "info")
	end)
	select("GUNS")
end

return Forge
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000054"><Properties><string name="Name">GunController</string><ProtectedString name="Source">-- Shooting with realistic feel. Client picks the target, rolls spread, sends the server the fire request; the server
-- validates rate / fire mode / ammo / range and decides crits (weak point) itself.
--   Fire modes: semi / burst / auto per gun (B or MODE button)   ADS: hold right mouse / ADS button (zoom, tighter spread)
--   Recoil: spring-driven camera climb + random sideways, spread bloom while spraying, crosshair that breathes
--   Ballistics: travel-time tracers, impact decals on misses, shell casings, muzzle smoke, railgun charge-up
--   Animation + extra audio layers: WeaponAnim.luau / Config.Sounds (Mech, Tail)
-- Public (used by the HUD): Mag, MaxMag, ReloadUntil, ReloadTime, Auto, Reloading(), Reload(), MuzzlePos(tool, char)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Theme = require(Shared.Theme)
local Net = require(Shared.Net)
local Guns = require(Shared.Config.Guns)
local Sounds = require(Shared.Config.Sounds)
local UI = require(script.Parent.Parent.UIKit)
local UIController = require(script.Parent.UIController)
local MonsterController = require(script.Parent.MonsterController)
local Vfx = require(script.Parent.VfxController)
local WeaponFx = require(script.Parent.WeaponFx)
local WeaponAnim = require(script.Parent.WeaponAnim)
local Effects = require(script.Parent.EffectsController)

local player = Players.LocalPlayer
local GunController = { Auto = false, Mag = 0, MaxMag = 0, ReloadUntil = 0, ReloadTime = 0 }
local rng = Random.new()

-- trigger / mode state
local holding = false
local pull = 0 -- os.clock() of an unconsumed trigger pull (semi/burst), 0 = none
local lastShot = 0
local burstLeft = 0
local modeIdx = 1
local modeFor = ""
local chargeEnd = 0 -- railgun charge-up in progress until this time
-- aim / recoil state
local adsWanted = false
local adsA = 0 -- 0 hip .. 1 fully aimed
local bloom = 0 -- extra spread degrees from spraying
local shotIdx = 0
local recoilP, recoilPV, recoilY, recoilYV = 0, 0, 0, 0 -- radians (camera offset, springs back to 0)
local baseFov = 70
local origSens = UserInputService.MouseDeltaSensitivity
local hitFlashUntil = 0
-- ui
local modeBtn: TextButton?
local cross: { Frame } = {}
local crossRoot: Frame? = nil
local scopeBars: { Frame } = {}
local scopeRoot: Frame? = nil

local function tool(): Tool?
	local c = player.Character
	local t = c and c:FindFirstChildOfClass("Tool")
	return if t and t:GetAttribute("Gun") then t else nil
end

local function muzzlePos(t: Tool?, char: Model?): Vector3?
	local h = t and t:FindFirstChild("Handle") :: BasePart?
	local att = h and h:FindFirstChild("Muzzle") :: Attachment?
	if att then
		return att.WorldPosition
	end
	local head = char and char:FindFirstChild("Head") :: BasePart?
	return head and head.Position
end
GunController.MuzzlePos = muzzlePos

local function ejectPos(t: Tool?, muzzle: Vector3): Vector3
	local h = t and t:FindFirstChild("Handle") :: BasePart?
	if not h then
		return muzzle
	end
	local att = h:FindFirstChild("Eject") :: Attachment?
	if att then
		return att.WorldPosition
	end
	return h.Position + (muzzle - h.Position) * 0.25 + Vector3.new(0, 0.25, 0)
end

local function currentMode(def): string
	return def.modes[math.clamp(modeIdx, 1, #def.modes)]
end

local function lowFx(): boolean
	return Effects.LowFx
end

function GunController.Reloading(): boolean
	return os.clock() &lt; GunController.ReloadUntil
end

function GunController.Reload()
	if GunController.Reloading() or GunController.Mag &gt;= GunController.MaxMag then
		return
	end
	GunController.ReloadUntil = os.clock() + GunController.ReloadTime
	burstLeft, pull, chargeEnd = 0, 0, 0
	Net.send("Reload")
	task.delay(GunController.ReloadTime, function()
		if os.clock() &gt;= GunController.ReloadUntil - 0.01 then
			GunController.Mag = GunController.MaxMag
		end
	end)
end

local function cycleMode(def)
	if #def.modes &lt;= 1 then
		return
	end
	modeIdx = modeIdx % #def.modes + 1
	burstLeft = 0
	Vfx.Sound(Sounds.Mech.Switch)
end

-- aim-assist target pick: nearest to the aim ray within `cone` degrees (or nearest in range without a ray)
local function pickTarget(root: BasePart, range: number, aimRay: Ray?, cone: number)
	local bestScore, kind, id, at, model = math.huge, nil, nil, nil, nil
	local function consider(p: Vector3, k: string, tid: number, m: Model?)
		local d = (p - root.Position).Magnitude
		if d &gt; range then
			return
		end
		local score = d
		if aimRay then
			local to = (p - aimRay.Origin).Unit
			local ang = math.deg(math.acos(math.clamp(to:Dot(aimRay.Direction.Unit), -1, 1)))
			if ang &gt; cone then
				return
			end
			score = ang * 4 + d * 0.1
		end
		if score &lt; bestScore then
			bestScore, kind, id, at, model = score, k, tid, p, m
		end
	end
	local mid = player:GetAttribute("MatchId")
	if mid then
		for _, other in ipairs(Players:GetPlayers()) do
			if other ~= player and other:GetAttribute("MatchId") == mid and other:GetAttribute("Team") ~= player:GetAttribute("Team") then
				local r = other.Character and other.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
				local h = other.Character and other.Character:FindFirstChildOfClass("Humanoid")
				if r and h and h.Health &gt; 0 then
					consider(r.Position, "p", other.UserId, other.Character)
				end
			end
		end
	else
		for _, m in ipairs(MonsterController.Alive()) do
			consider(MonsterController.Pos(m) + Vector3.new(0, MonsterController.Bob(m), 0), "m", m:GetAttribute("MonsterId"), m)
		end
	end
	return kind, id, at, model
end

-- current spread cone in degrees (hip -&gt; ADS, + bloom, + movement / airborne)
local function spreadDeg(def, root: BasePart?): number
	local base = def.spread * (1 + (def.adsSpread - 1) * adsA) + bloom * (1 - adsA * 0.5)
	local speed = root and Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z).Magnitude or 0
	local move = 1 + math.clamp(speed / 16, 0, 1.2) * 0.9 * (1 - adsA * 0.5)
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if hum and hum.FloorMaterial == Enum.Material.Air then
		move += 1.2
	end
	return base * move
end

local function randomCone(dir: Vector3, deg: number): Vector3
	local ang = math.rad(deg) * math.sqrt(rng:NextNumber())
	local az = rng:NextNumber(0, math.pi * 2)
	return (CFrame.lookAt(Vector3.zero, dir) * CFrame.Angles(0, 0, az) * CFrame.Angles(ang, 0, 0)).LookVector
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
-- travel end of a bullet that hit nothing: world point + (surface normal if it struck map geometry, not a creature)
local function trace(origin: Vector3, dir: Vector3, range: number): (Vector3, Vector3?)
	rayParams.FilterDescendantsInstances = { player.Character :: Instance }
	local r = Workspace:Raycast(origin, dir * range, rayParams)
	if not r then
		return origin + dir * range, nil
	end
	local m = r.Instance:FindFirstAncestorOfClass("Model")
	if m and (m:GetAttribute("MonsterId") or m:FindFirstChildOfClass("Humanoid")) then
		return r.Position, nil
	end
	return r.Position, r.Normal
end

local function doFire(t: Tool, def, typeId: string, root: BasePart, char: Model, mode: string)
	local aimRay = nil
	if not (GunController.Auto and not holding) and UserInputService.MouseEnabled and not UserInputService.TouchEnabled then
		local m = UserInputService:GetMouseLocation()
		aimRay = Workspace.CurrentCamera:ViewportPointToRay(m.X, m.Y)
	end
	local isPvp = player:GetAttribute("MatchId") ~= nil
	local range = if isPvp then def.range else (t:GetAttribute("Range") or def.range)
	local kind, id, at, model = pickTarget(root, range, aimRay, if adsA &gt; 0.5 then 8 else 18)
	if not kind and not aimRay then
		return false -- touch / auto farm never wastes ammo
	end
	local from = muzzlePos(t, char)
	if not from then
		return false
	end
	local spread = spreadDeg(def, root)
	local multi = def.pellets &gt; 1
	local color = Guns.Rarities[t:GetAttribute("Rarity") or 1].color

	-- decide: hit the picked target or miss (PC aims with the mouse; spread decides)
	local hit, headOff, shotDir = false, nil, nil
	if aimRay then
		shotDir = if multi then aimRay.Direction.Unit else randomCone(aimRay.Direction.Unit, spread)
		if kind then
			local toC = at - aimRay.Origin
			local dist = math.max(toC.Magnitude, 1)
			local ang = math.acos(math.clamp(toC.Unit:Dot(shotDir), -1, 1))
			local size = if model then (model:GetAttribute("Size") or 4) else 4
			local tol = math.atan(size * 0.5 / dist) + math.rad(2.5) + (if multi then math.rad(spread) * 0.7 else 0)
			hit = ang &lt;= tol
			if hit and kind == "m" then
				local pt = aimRay.Origin + shotDir * toC:Dot(shotDir)
				headOff = math.clamp(pt.Y - at.Y, -size * 0.6, size * 0.6)
			end
		end
	else
		hit = kind ~= nil
	end

	lastShot = os.clock()
	GunController.Mag -= 1
	local aimPos: Vector3? = nil
	local aimNormal: Vector3? = nil
	if not hit then
		local o = aimRay and aimRay.Origin or from
		aimPos, aimNormal = trace(o, shotDir or (at :: Vector3 - o).Unit, range)
	end
	if hit then
		Net.send("Fire", kind, id, headOff, mode)
	else
		Net.send("Fire", "n", 0, nil, mode, aimPos)
	end

	-- visuals: flash, travel-time tracers, decals / sparks on arrival
	local look = (((if hit then at else aimPos) :: Vector3) - from).Unit
	local atPos: Vector3 = if hit then at :: Vector3 else aimPos :: Vector3
	Vfx.MuzzleFlash(from, color)
	if def.eject and not lowFx() then
		WeaponFx.SmokePuff(from + look * 0.3, look)
		local cam = Workspace.CurrentCamera
		WeaponFx.Shell(ejectPos(t, from), cam.CFrame.RightVector, rng)
	end
	local pellets = math.min(def.pellets, 5)
	for i = 1, pellets do
		local to: Vector3
		local normal: Vector3? = nil
		if hit then
			local sp = math.rad(def.spread) * (1 + (def.adsSpread - 1) * adsA)
			local jitter = if pellets == 1 then Vector3.zero
				else Vector3.new(rng:NextNumber(-sp, sp), rng:NextNumber(-sp, sp), rng:NextNumber(-sp, sp)) * (atPos - from).Magnitude * 0.5
			to = atPos + jitter
		elseif multi then
			to, normal = trace(from, randomCone(look, spread), range)
		else
			to, normal = atPos, aimNormal
		end
		Vfx.Bullet(from, to, color, function()
			if hit then
				Vfx.HitSpark(to, false)
			elseif normal then
				Vfx.HitSpark(to, false)
				WeaponFx.ImpactDecal(to, normal)
			end
		end, def.travel)
	end
	if hit then
		Vfx.HitFlash(model)
	end

	-- audio layers: shot (pitch varies in Vfx.Sound), mechanical bolt, distant tail
	Vfx.Sound(Sounds.Guns[def.sound or typeId], from)
	if def.eject then
		Vfx.Sound(Sounds.Mech.Bolt, from, { delay = 0.07 })
	end
	if def.tail then
		Vfx.Sound(Sounds.Tail, from, { delay = 0.1, volume = 0.6 })
	end

	-- recoil: vertical climb + random sideways (smaller while aimed), bloom, weapon kickback, camera shake
	shotIdx += 1
	local k = 1 + (def.adsRecoil - 1) * adsA
	recoilPV += math.rad(def.vKick) * 7 * k
	recoilYV += math.rad(def.hKick) * 7 * k * (rng:NextNumber(-1, 1) * 0.7 + math.sin(shotIdx * 1.7) * 0.3)
	bloom = math.min(def.bloomMax, bloom + def.bloom)
	WeaponAnim.Kick(def.recoil * 0.3 * k)
	Vfx.Shake(def.recoil * 0.02 * k, 0.05)
	if aimRay and not hit then
		return true
	end
	local flat = Vector3.new(atPos.X, root.Position.Y, atPos.Z)
	if (flat - root.Position).Magnitude &gt; 1 then
		root.CFrame = CFrame.lookAt(root.Position, flat)
	end
	return true
end

local function step(dt: number)
	local now = os.clock()
	if now - lastShot &gt; 0.12 then
		bloom = math.max(0, bloom - 6 * dt)
	end
	if now - lastShot &gt; 0.45 then
		shotIdx = 0
	end
	local t = tool()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not t or not root then
		burstLeft, chargeEnd = 0, 0
		return
	end
	local typeId = t:GetAttribute("Gun") :: string
	local def = Guns.Types[typeId]
	if not def then
		return
	end
	if modeFor ~= typeId then
		modeFor, modeIdx = typeId, 1
		burstLeft = 0
		WeaponAnim.Equip()
	end
	if GunController.Reloading() then
		return
	end

	-- railgun charge-up finishing
	if chargeEnd &gt; 0 then
		if now &lt; chargeEnd then
			return
		end
		chargeEnd = 0
		if GunController.Mag &gt; 0 then
			doFire(t, def, typeId, root, char :: Model, currentMode(def))
			if GunController.Mag &lt;= 0 then
				GunController.Reload()
			end
		end
		return
	end

	local mode = currentMode(def)
	if GunController.Auto and (holding == false) then
		pull = now -- auto farm = a trigger pull every opportunity
	end
	local triggered = holding or GunController.Auto
	local want: boolean
	if burstLeft &gt; 0 then
		want = true
	elseif mode == "auto" then
		want = triggered
	else
		want = pull &gt; 0 and now - pull &lt; 0.25
	end
	if not want then
		return
	end

	local rate = if player:GetAttribute("MatchId") then def.rate else (t:GetAttribute("Rate") or def.rate)
	local interval = 1 / rate
	local need = interval
	if mode == "burst" then
		local fast = interval / Guns.Burst.RateMult
		need = if burstLeft &gt; 0 then fast else def.burst * interval - (def.burst - 1) * fast
	end
	if def.charge then
		need = math.max(0, need - def.charge)
	end
	if now - lastShot &lt; need then
		return
	end
	if GunController.Mag &lt;= 0 then
		lastShot = now
		pull, burstLeft = 0, 0
		Vfx.Sound(Sounds.Empty)
		GunController.Reload()
		return
	end

	if def.charge then
		-- visual charge on the muzzle first, the shot goes out when it completes
		chargeEnd = now + def.charge
		pull = 0
		local color = Guns.Rarities[t:GetAttribute("Rarity") or 1].color
		Vfx.Sound(Sounds.Mech.Charge, nil, { pitch = 1 })
		WeaponFx.Charge(function()
			return muzzlePos(tool(), player.Character)
		end, color, def.charge)
		return
	end

	local fired = doFire(t, def, typeId, root, char :: Model, mode)
	if not fired then
		pull = 0
		burstLeft = 0
		return
	end
	if mode == "burst" then
		burstLeft = if burstLeft &gt; 0 then burstLeft - 1 else def.burst - 1
	end
	if mode ~= "auto" then
		pull = 0
	end
	if GunController.Mag &lt;= 0 then
		GunController.Reload()
	end
end

-- crosshair: 4 lines + dot, gap follows the live spread (breathes with movement, firing, ADS)
local function buildCrosshair(gui: Instance)
	-- own full-screen gui (no inset, no UI scale) so the reticle lines up with the mouse / screen centre
	local root = Instance.new("Frame")
	root.Name = "Crosshair"
	root.BackgroundTransparency = 1
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.Size = UDim2.fromOffset(0, 0)
	root.Visible = false
	local lines = {}
	for i = 1, 4 do
		local f = Instance.new("Frame")
		f.BackgroundColor3 = Color3.new(1, 1, 1)
		f.BorderSizePixel = 0
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		local st = Instance.new("UIStroke")
		st.Thickness = 1
		st.Color = Color3.new(0, 0, 0)
		st.Transparency = 0.4
		st.Parent = f
		f.Parent = root
		lines[i] = f
	end
	local dot = Instance.new("Frame")
	dot.BackgroundColor3 = Color3.new(1, 1, 1)
	dot.BorderSizePixel = 0
	dot.AnchorPoint = Vector2.new(0.5, 0.5)
	dot.Size = UDim2.fromOffset(3, 3)
	dot.Parent = root
	root.Parent = gui
	crossRoot = root
	cross = lines
end

-- scoped overlay (railgun ADS): black bars around a clear centre square + thin reticle lines
local function buildScope(gui: Instance)
	local f = Instance.new("Frame")
	f.Name = "Scope"
	f.BackgroundTransparency = 1
	f.Size = UDim2.fromScale(1, 1)
	f.Visible = false
	for i = 1, 6 do -- 1-4 black bars (L R T B), 5-6 reticle lines
		local b = Instance.new("Frame")
		b.BackgroundColor3 = if i &lt;= 4 then Color3.new(0, 0, 0) else Color3.fromRGB(20, 20, 24)
		b.BorderSizePixel = 0
		b.Parent = f
		scopeBars[i] = b
	end
	f.Parent = gui
	scopeRoot = f
end

local function updateScope(on: boolean, vp: Vector2)
	if not scopeRoot then
		return
	end
	scopeRoot.Visible = on
	if not on then
		return
	end
	local s = math.min(vp.X, vp.Y) * 0.9
	local sx, sy = (vp.X - s) / 2, (vp.Y - s) / 2
	local b = scopeBars
	b[1].Position, b[1].Size = UDim2.fromOffset(0, 0), UDim2.fromOffset(sx, vp.Y)
	b[2].Position, b[2].Size = UDim2.fromOffset(vp.X - sx, 0), UDim2.fromOffset(sx, vp.Y)
	b[3].Position, b[3].Size = UDim2.fromOffset(sx, 0), UDim2.fromOffset(s, sy)
	b[4].Position, b[4].Size = UDim2.fromOffset(sx, vp.Y - sy), UDim2.fromOffset(s, sy)
	b[5].Position, b[5].Size = UDim2.fromOffset(sx, vp.Y / 2 - 1), UDim2.fromOffset(s, 2)
	b[6].Position, b[6].Size = UDim2.fromOffset(vp.X / 2 - 1, sy), UDim2.fromOffset(2, s)
end

local function renderStep(dt: number)
	local cam = Workspace.CurrentCamera
	local t = tool()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local def = t and Guns.Types[t:GetAttribute("Gun") :: string]

	-- ADS blend (cancelled while reloading)
	local wantAds = t ~= nil and adsWanted and not GunController.Reloading() and def ~= nil
	adsA += ((if wantAds then 1 else 0) - adsA) * math.clamp(dt * 14, 0, 1)
	if math.abs(adsA - (if wantAds then 1 else 0)) &lt; 0.003 then
		adsA = if wantAds then 1 else 0
	end

	if def and adsA &gt; 0 then
		cam.FieldOfView = baseFov + (def.fov - baseFov) * adsA
		UserInputService.MouseDeltaSensitivity = origSens * (1 - 0.5 * adsA * (1 - def.fov / 70))
	else
		local wantFov = if player:GetAttribute("Sprinting") then 80 else 70
		baseFov = cam.FieldOfView + (wantFov - cam.FieldOfView) * math.clamp(dt * 8, 0, 1)
		cam.FieldOfView = baseFov
		UserInputService.MouseDeltaSensitivity = origSens
	end

	-- speed = server BaseSpeed attribute * sprint * ADS (single owner; no read-modify-write of WalkSpeed)
	local baseSpd = hum and hum:GetAttribute("BaseSpeed")
	if hum and type(baseSpd) == "number" then
		local want = baseSpd * (if player:GetAttribute("Sprinting") then 1.4 else 1) * (if def and adsA &gt; 0.5 then def.adsSpeed else 1)
		if math.abs(hum.WalkSpeed - want) &gt; 0.01 then
			hum.WalkSpeed = want
		end
	end

	-- recoil springs (camera offset), applied after the camera script so it recovers on its own
	local ks, cs = 70, 11
	recoilPV += (-ks * recoilP - cs * recoilPV) * dt
	recoilYV += (-ks * recoilY - cs * recoilYV) * dt
	recoilP += recoilPV * dt
	recoilY += recoilYV * dt
	if math.abs(recoilP) &gt; 1e-4 or math.abs(recoilY) &gt; 1e-4 then
		cam.CFrame = cam.CFrame * CFrame.Angles(recoilP, recoilY, 0)
	end

	-- weapon animation
	local speed = root and Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z).Magnitude or 0
	local reload: number? = nil
	if GunController.Reloading() and GunController.ReloadTime &gt; 0 then
		reload = math.clamp(1 - (GunController.ReloadUntil - os.clock()) / GunController.ReloadTime, 0, 1)
	end
	WeaponAnim.Update(dt, { ads = adsA, speed = speed, reload = reload, bloom = bloom })
	local ph = WeaponAnim.PollPhase()
	if ph == 1 then
		Vfx.Sound(Sounds.Mech.MagOut)
	elseif ph == 2 then
		Vfx.Sound(Sounds.Mech.MagIn)
	elseif ph == 3 then
		Vfx.Sound(Sounds.Mech.Bolt)
	end

	-- crosshair
	if crossRoot then
		local show = def ~= nil and not (def.scope and adsA &gt; 0.6)
		crossRoot.Visible = show
		if show and def then
			local vp = cam.ViewportSize
			local pos = if UserInputService.MouseEnabled and not UserInputService.TouchEnabled
				then UserInputService:GetMouseLocation() else Vector2.new(vp.X / 2, vp.Y / 2)
			crossRoot.Position = UDim2.fromOffset(pos.X, pos.Y)
			local deg = spreadDeg(def, root)
			local gap = math.tan(math.rad(deg)) / math.tan(math.rad(cam.FieldOfView / 2)) * (vp.Y / 2)
			gap = math.clamp(gap, 3, 120)
			local len = 9 - adsA * 3
			local col = if os.clock() &lt; hitFlashUntil then Color3.fromRGB(255, 80, 80) else Color3.new(1, 1, 1)
			for i, f in ipairs(cross) do
				f.BackgroundColor3 = col
				local horiz = i &lt;= 2
				local sgn = if i % 2 == 1 then -1 else 1
				f.Size = if horiz then UDim2.fromOffset(len, 2) else UDim2.fromOffset(2, len)
				f.Position = if horiz then UDim2.fromOffset(sgn * (gap + len / 2), 0) else UDim2.fromOffset(0, sgn * (gap + len / 2))
			end
		end
	end
	updateScope(def ~= nil and def.scope == true and adsA &gt; 0.6, cam.ViewportSize)
	if modeBtn then
		modeBtn.Visible = def ~= nil
		if def then
			local m = currentMode(def)
			local label = modeBtn:FindFirstChild("Label") :: TextLabel?
			if label then
				label.Text = (if UserInputService.TouchEnabled then "%s" else "%s [B]"):format(string.upper(m))
			end
		end
	end
end

function GunController.Init()
	local gui = UIController.Gui()
	local aimGui = Instance.new("ScreenGui")
	aimGui.Name = "GunAimGui"
	aimGui.ResetOnSpawn = false
	aimGui.IgnoreGuiInset = true
	aimGui.DisplayOrder = 5
	buildCrosshair(aimGui)
	buildScope(aimGui)
	aimGui.Parent = player:WaitForChild("PlayerGui")
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			holding = true
			pull = os.clock()
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
			adsWanted = true
		elseif input.KeyCode == Enum.KeyCode.R then
			GunController.Reload()
		elseif input.KeyCode == Enum.KeyCode.B then
			local t = tool()
			local def = t and Guns.Types[t:GetAttribute("Gun") :: string]
			if def then
				cycleMode(def)
			end
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			holding = false
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
			adsWanted = false
		end
	end)
	local touch = UserInputService.TouchEnabled
	local fire = UI.button("FIRE", Theme.Colors.Danger, function() end, {
		AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -176, 1, -150), Size = UDim2.fromOffset(110, 110), Visible = touch, Parent = gui })
	UI.corner(UDim.new(1, 0)).Parent = fire
	fire.MouseButton1Down:Connect(function()
		holding = true
		pull = os.clock()
	end)
	fire.MouseButton1Up:Connect(function()
		holding = false
	end)
	fire.MouseLeave:Connect(function()
		holding = false
	end)
	local reloadBtn = UI.button("R", Theme.Colors.PanelLight, GunController.Reload, {
		AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -296, 1, -160), Size = UDim2.fromOffset(64, 64), Visible = touch, Parent = gui })
	UI.corner(UDim.new(1, 0)).Parent = reloadBtn
	-- mobile ADS toggle (above FIRE)
	local adsBtn = UI.button("ADS", Theme.Colors.PanelLight, function()
		adsWanted = not adsWanted
	end, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -176, 1, -268), Size = UDim2.fromOffset(70, 70), Visible = touch, Parent = gui })
	UI.corner(UDim.new(1, 0)).Parent = adsBtn
	-- fire mode button: next to FIRE on touch, above AUTO on PC (also key B)
	local mb: any = UI.button("SEMI", Theme.Colors.PanelLight, function()
		local t = tool()
		local def = t and Guns.Types[t:GetAttribute("Gun") :: string]
		if def then
			cycleMode(def)
		end
	end, { AnchorPoint = Vector2.new(1, 1), Position = if touch then UDim2.new(1, -296, 1, -232) else UDim2.new(1, -16, 1, -210),
		Size = if touch then UDim2.fromOffset(64, 40) else UDim2.fromOffset(150, 34), Visible = false, Parent = gui })
	mb.Label.TextSize = 16
	modeBtn = mb
	local auto
	auto = UI.button("AUTO: OFF", Theme.Colors.PanelLight, function()
		local passes = UIController.State.passes or {}
		if not table.find(passes, "AutoFarm") then
			UIController.Toast("Auto Farm pass required — see SHOP", "info")
			UIController.Open("Shop")
			return
		end
		GunController.Auto = not GunController.Auto
		auto.Label.Text = if GunController.Auto then "AUTO: ON" else "AUTO: OFF"
	end, { AnchorPoint = Vector2.new(1, 1), Position = if touch then UDim2.new(1, -140, 1, -86) else UDim2.new(1, -16, 1, -86), Size = UDim2.fromOffset(150, 50), Parent = gui })
	auto.Label.TextSize = 18

	Net.listen("Ammo", function(mag: number, max: number, reload: number)
		GunController.MaxMag = max
		if reload &gt; 0 then
			if not GunController.Reloading() then
				GunController.ReloadUntil = os.clock() + reload
				task.delay(reload, function()
					GunController.Mag = max
				end)
			end
			GunController.ReloadTime = reload
		else
			GunController.Mag = mag
			GunController.ReloadUntil = 0
			local t = tool()
			local def = t and Guns.Types[t:GetAttribute("Gun") :: string]
			GunController.ReloadTime = def and def.reload or 1.5
		end
	end)
	Net.listen("Hit", function(_pos: Vector3, _dmg: number, crit: boolean)
		hitFlashUntil = os.clock() + (if crit then 0.25 else 0.1)
	end)
	-- other players' shots: flash + tracer with travel time, shot sound, distant tail for far shots
	Net.listen("Shot", function(shooter: Player, to: Vector3)
		local char = shooter.Character
		local t = char and char:FindFirstChildOfClass("Tool")
		local from = muzzlePos(t, char)
		local camPos = Workspace.CurrentCamera.CFrame.Position
		if from and (from - camPos).Magnitude &lt; 150 then
			local color = Guns.Rarities[(t and t:GetAttribute("Rarity")) or 1].color
			local def = t and Guns.Types[t:GetAttribute("Gun") :: string]
			Vfx.MuzzleFlash(from, color)
			Vfx.Bullet(from, to, color, nil, def and def.travel)
			if def then
				local dist = (from - camPos).Magnitude
				Vfx.Sound(Sounds.Guns[def.sound], from, { volume = 0.8 })
				if def.tail and dist &gt; Sounds.Tail.minDist then
					Vfx.Sound(Sounds.Tail, from, { delay = dist / 100 * Sounds.Tail.delayPer100 })
				end
			end
		end
	end)
	RunService.Heartbeat:Connect(step)
	RunService:BindToRenderStep("GunRecoilAnim", Enum.RenderPriority.Camera.Value + 1, renderStep)
end

return GunController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000055"><Properties><string name="Name">HudController</string><ProtectedString name="Source">-- Training HUD: Power + gain/s, TRAIN toggle, x2 Pulse pop-up button, boost timers, announcements,
-- loot/damage popups, gate unlocking (local CanCollide), next-zone hint.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Theme = require(Shared.Theme)
local Net = require(Shared.Net)
local Zones = require(Shared.Config.Zones)
local Materials = require(Shared.Config.Materials)
local UI = require(script.Parent.Parent.UIKit)
local W = require(script.Parent.Parent.Widgets)
local State = require(script.Parent.Parent.ClientState)
local UIController = require(script.Parent.UIController)
local Vfx = require(script.Parent.VfxController)
local GunController = require(script.Parent.GunController)
local Sounds = require(Shared.Config.Sounds)
local Guns = require(Shared.Config.Guns)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local C = Theme.Colors

local Hud = {}

local powerLabel, gainLabel, trainBtn, pulseBtn, boostLabel, hintLabel, banner

local function pop(gui: GuiObject, s: number)
	local sc = gui:FindFirstChildOfClass("UIScale") or UI.new("UIScale", { Parent = gui })
	sc.Scale = s
	TweenService:Create(sc, Theme.Tween, { Scale = 1 }):Play()
end

function Hud.Announce(text: string)
	banner.Text = text
	banner.TextTransparency = 0
	banner.Visible = true
	pop(banner, 1.3)
	task.delay(4, function()
		if banner.Text == text then
			TweenService:Create(banner, TweenInfo.new(0.5), { TextTransparency = 1 }):Play()
		end
	end)
end

local function floatText(worldPos: Vector3, text: string, color: Color3, size: number)
	local anchor = Instance.new("Part")
	anchor.Anchored, anchor.CanCollide, anchor.CanQuery, anchor.CanTouch, anchor.Transparency = true, false, false, false, 1
	anchor.Size = Vector3.one
	anchor.Position = worldPos + Vector3.new(math.random(-15, 15) / 10, 2, math.random(-15, 15) / 10)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(160, size + 10)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 120
	local l = UI.label(text, size, { Size = UDim2.fromScale(1, 1), TextColor3 = color, Parent = bb })
	bb.Parent = anchor
	anchor.Parent = Workspace
	TweenService:Create(bb, TweenInfo.new(0.9, Enum.EasingStyle.Quad), { StudsOffset = Vector3.new(0, 3, 0) }):Play()
	TweenService:Create(l, TweenInfo.new(0.9), { TextTransparency = 1 }):Play()
	task.delay(1, function()
		anchor:Destroy()
	end)
end

local function updateGates()
	local power = State.Power()
	local map = Workspace:FindFirstChild("Map")
	local zones = map and map:FindFirstChild("Zones")
	if not zones then
		return
	end
	for _, z in ipairs(Zones) do
		local zm = zones:FindFirstChild(z.id)
		local gate = zm and zm:FindFirstChild("Gate") :: BasePart?
		if gate then
			local open = power &gt;= z.powerReq
			gate.CanCollide = not open -- local only: server still bounces under-powered players
			gate.Transparency = if open then 0.85 else 0.35
			local tag = gate:FindFirstChild("LockTag") :: BillboardGui?
			if not tag then
				tag = Instance.new("BillboardGui")
				tag.Name = "LockTag"
				tag.Size = UDim2.fromOffset(240, 60)
				tag.StudsOffset = Vector3.new(0, gate.Size.Y / 2 + 3, 0)
				tag.MaxDistance = 150
				UI.label("", 26, { Name = "L", Size = UDim2.fromScale(1, 1), Parent = tag })
				tag.Parent = gate
			end
			local l = (tag :: BillboardGui):FindFirstChild("L") :: TextLabel
			l.Text = if open then "✔ " .. z.name else ("🔒 %s\n%s Power"):format(z.name, W.short(z.powerReq))
			l.TextColor3 = if open then C.Primary else C.Gold
		end
	end
end

local function nextZoneHint()
	local power = State.Power()
	for _, z in ipairs(Zones) do
		if power &lt; z.powerReq then
			hintLabel.Text = ("Next: %s at %s Power (%d%%)"):format(z.name, W.short(z.powerReq), math.floor(power / z.powerReq * 100))
			return
		end
	end
	hintLabel.Text = "All zones unlocked — try Rebirth!"
end

-- First-time hints, one at a time: TRAIN -&gt; x2 pulse -&gt; Adventure gate -&gt; Forge. Session-only; skipped for
-- returning players (already strong). Each step dismisses itself when the player does the thing.
function Hud.StartTutorial()
	local player = Players.LocalPlayer
	task.spawn(function()
		task.wait(4)
		if State.Power() &gt; 300 or (State.Inv.rebirths or 0) &gt; 0 then
			return
		end
		local dismiss: (() -&gt; ())? = nil
		local function show(target: GuiObject, text: string, side: string?)
			if dismiss then
				dismiss()
			end
			dismiss = UI.hint(target, text, side)
		end
		local function hide()
			if dismiss then
				dismiss()
				dismiss = nil
			end
		end
		-- 1. TRAIN
		show(trainBtn, "Training is ON: stay near monsters and your Power grows!", "up")
		task.wait(8)
		hide()
		-- 2. x2 pulse (waits up to 3 min for the first one)
		local waited = 0
		while not pulseBtn.Visible and waited &lt; 180 do
			task.wait(1)
			waited += 1
		end
		if pulseBtn.Visible then
			show(pulseBtn, "Tap x2 for double Power!", "down")
			while pulseBtn.Visible do
				task.wait(0.3)
			end
			hide()
		end
		-- 3. Adventure gate
		local bar = UI.panel({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 100), Size = UDim2.fromOffset(420, 44), BackgroundColor3 = C.Gold, ZIndex = 15, Parent = UIController.Gui() }, {
			UI.label("➡  Walk through the glowing ADVENTURE gate!", 18, { Size = UDim2.fromScale(1, 1), ZIndex = 16 }),
		})
		local bob = TweenService:Create(bar, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Position = UDim2.new(0.5, 0, 0, 108) })
		bob:Play()
		while true do -- lint-ok (task.wait)
			local z = player:GetAttribute("Zone")
			if z ~= nil and z ~= "hub" then
				break
			end
			task.wait(1)
		end
		bob:Cancel()
		bar:Destroy()
		-- 4. Forge: once you hold any material
		local function hasMats(): boolean
			for _, n in pairs(State.Inv.materials) do
				if n &gt; 0 then
					return true
				end
			end
			return false
		end
		while not hasMats() do
			task.wait(2)
		end
		UIController.SetMenuOpen(true)
		local fb = UIController.GetMenuButton("Forge")
		if fb then
			show(fb, "You got materials! Open the FORGE to craft a better gun.", "right")
			while not UIController.IsOpen("Forge") do
				task.wait(0.5)
			end
			hide()
		end
	end)
end

function Hud.Init()
	local gui = UIController.Gui()
	-- Power panel (top centre)
	local panel = UI.panel({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 8), Size = UDim2.fromOffset(340, 86), BackgroundColor3 = C.Bg, Parent = gui })
	UI.gradient(C.Panel, C.Bg).Parent = panel
	powerLabel = UI.label("⚡ 0", 34, { Position = UDim2.fromOffset(0, 4), Size = UDim2.new(1, 0, 0, 40), TextColor3 = C.Energy, Parent = panel })
	gainLabel = UI.label("+0 /s", 16, { Font = Theme.FontBody, Position = UDim2.fromOffset(0, 44), Size = UDim2.new(1, 0, 0, 18), TextColor3 = C.TextDim, Parent = panel })
	hintLabel = UI.label("", 13, { Font = Theme.FontBody, Position = UDim2.fromOffset(0, 64), Size = UDim2.new(1, 0, 0, 16), TextColor3 = C.Gold, Parent = panel })

	-- TRAIN toggle + boost (bottom centre)
	trainBtn = UI.button("TRAINING: ON", C.Energy, function()
		Net.send("SetTraining", not State.Train.training)
	end, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -16), Size = UDim2.fromOffset(220, 56), Parent = gui })
	boostLabel = UI.label("", 16, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -76), Size = UDim2.fromOffset(400, 20), TextColor3 = C.Gold, Parent = gui })

	-- x2 pulse button (pops in at random spots on the right side)
	pulseBtn = UI.button("x2!", C.Forge, function()
		Net.send("PulseTap")
		Vfx.Sound(Sounds.Ui)
		pulseBtn.Visible = false
		W.flash(gui, C.Forge)
	end, { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(130, 130), Visible = false, ZIndex = 10, Skin = false, Parent = gui })
	pulseBtn.Label.TextSize = 48
	UI.corner(UDim.new(1, 0)).Parent = pulseBtn
	if UI.skinPanel(pulseBtn, "badge_x2") then -- uploaded art replaces the code-drawn disc
		pulseBtn.Label.Text = ""
	end

	banner = UI.label("", 30, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 104), Size = UDim2.fromOffset(560, 40), TextColor3 = C.Gold, Visible = false, Parent = gui })

	Net.listen("PulseOffer", function(seconds)
		Vfx.Sound(Sounds.Pulse)
		pulseBtn.Position = UDim2.fromScale(0.55 + math.random() * 0.3, 0.3 + math.random() * 0.35)
		pulseBtn.Visible = true
		pop(pulseBtn, 0.3)
		local spin = TweenService:Create(pulseBtn, TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Rotation = 8 })
		spin:Play()
		task.delay(seconds, function()
			spin:Cancel()
			pulseBtn.Rotation = 0
			pulseBtn.Visible = false
		end)
	end)

	State.TrainChanged:Connect(function(t)
		trainBtn.Label.Text = if t.training then "TRAINING: ON" else "TRAINING: OFF"
		gainLabel.Text = ("+%s /s   x%.2f"):format(W.short(t.gain), t.mult)
		local parts = {}
		if t.pulseLeft &gt; 0 then
			table.insert(parts, ("x2 PULSE %ds"):format(math.ceil(t.pulseLeft)))
		end
		if t.boostLeft &gt; 0 then
			table.insert(parts, ("x3 BOOST %dm"):format(math.ceil(t.boostLeft / 60)))
		end
		boostLabel.Text = table.concat(parts, "   ")
	end)

	Net.listen("Announce", Hud.Announce)

	Net.listen("Loot", function(pos: Vector3, loot)
		local y = 0
		if loot.coins and loot.coins &gt; 0 then
			floatText(pos + Vector3.new(0, y, 0), "+" .. W.short(loot.coins) .. " 🪙", C.Gold, 22)
			Vfx.LootOrbs(pos, 3, C.Gold)
			y += 1.5
		end
		if loot.power and loot.power &gt; 0 then
			floatText(pos + Vector3.new(0, y, 0), "+" .. W.short(loot.power) .. " ⚡", C.Energy, 20)
			y += 1.5
		end
		for mat, n in pairs(loot.mats or {}) do
			local def = Materials[mat]
			if def then
				floatText(pos + Vector3.new(0, y, 0), ("+%d %s %s"):format(n, def.glyph, def.name), def.color, 18)
				Vfx.LootOrbs(pos, n, def.color)
				y += 1.5
			end
		end
		if loot.rank then
			Hud.Announce(("World Boss — your rank #%d"):format(loot.rank))
		end
	end)
	Net.listen("Hit", function(pos: Vector3, dmg: number, crit: boolean?)
		Vfx.DamageNumber(pos, dmg, crit, W.short)
		Vfx.HitSpark(pos, crit)
		Vfx.Sound(if crit then Sounds.Crit else Sounds.Hit)
	end)

	-- health bar (custom, smooth) above the TRAIN button
	local player = Players.LocalPlayer
	local hpBack = UI.panel({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -100), Size = UDim2.fromOffset(320, 26), BackgroundColor3 = C.Bg, Parent = gui })
	local hpLag = UI.new("Frame", { BackgroundColor3 = Color3.fromRGB(255, 255, 255), BackgroundTransparency = 0.3, Size = UDim2.fromScale(1, 1), Parent = hpBack }, { UI.corner() })
	local hpFill = UI.new("Frame", { BackgroundColor3 = C.Primary, Size = UDim2.fromScale(1, 1), Parent = hpBack }, { UI.corner() })
	local hpText = UI.label("", 16, { Size = UDim2.fromScale(1, 1), Parent = hpBack })
	-- ammo counter (bottom right) with reload bar
	local ammoBox = UI.panel({ AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -146), Size = UDim2.fromOffset(150, 58), BackgroundColor3 = C.Bg, Parent = gui })
	local ammoText = UI.label("", 26, { Size = UDim2.new(1, 0, 0, 36), Parent = ammoBox })
	local gunText = UI.label("", 12, { Font = Theme.FontBody, Position = UDim2.fromOffset(0, 32), Size = UDim2.new(1, 0, 0, 14), TextColor3 = C.TextDim, Parent = ammoBox })
	local reloadBar = UI.new("Frame", { BackgroundColor3 = C.Gold, Position = UDim2.new(0, 6, 1, -8), Size = UDim2.new(0, 0, 0, 4), Parent = ammoBox })
	local lagRatio = 1
	RunService.RenderStepped:Connect(function(dt) -- lint-ok (2 bars)
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if hum and hum.MaxHealth &gt; 0 then
			local r = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
			hpFill.Size = hpFill.Size:Lerp(UDim2.fromScale(r, 1), math.clamp(dt * 14, 0, 1))
			lagRatio = if r &gt; lagRatio then r else lagRatio + (r - lagRatio) * math.clamp(dt * 2.5, 0, 1)
			hpLag.Size = UDim2.fromScale(lagRatio, 1)
			hpFill.BackgroundColor3 = C.Danger:Lerp(C.Primary, r)
			hpText.Text = ("%s / %s"):format(W.short(hum.Health), W.short(hum.MaxHealth))
		end
		local t = player.Character and player.Character:FindFirstChildOfClass("Tool")
		ammoBox.Visible = t ~= nil
		if t then
			local def = Guns.Types[t:GetAttribute("Gun") :: string]
			gunText.Text = t.Name
			if GunController.Reloading() then
				ammoText.Text = "RELOADING"
				ammoText.TextColor3 = C.Gold
				local left = GunController.ReloadUntil - os.clock()
				reloadBar.Size = UDim2.new(1 - math.clamp(left / math.max(GunController.ReloadTime, 0.01), 0, 1), -12, 0, 4)
			else
				ammoText.Text = ("%d / %d"):format(GunController.Mag, GunController.MaxMag)
				ammoText.TextColor3 = if GunController.Mag &lt;= (def and def.mag or 10) * 0.25 then C.Danger else Color3.new(1, 1, 1)
				reloadBar.Size = UDim2.new(0, 0, 0, 4)
			end
		end
	end)

	-- sprint (Shift / mobile button) for the long lane: client-side speed boost on top of server speed
	local UserInputService = game:GetService("UserInputService")
	local sprinting = false
	local function setSprint(on: boolean)
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if not hum or sprinting == on then
			return
		end
		sprinting = on
		player:SetAttribute("Sprinting", on) -- GunController applies speed/FOV (shared with ADS)
	end
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.LeftShift then
			setSprint(true)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.LeftShift then
			setSprint(false)
		end
	end)
	if UserInputService.TouchEnabled then
		local sb
		sb = UI.button("RUN", C.PanelLight, function()
			setSprint(not sprinting)
			sb.BackgroundColor3 = if sprinting then C.Energy else C.PanelLight
		end, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -370, 1, -160), Size = UDim2.fromOffset(64, 64), Parent = gui })
		UI.corner(UDim.new(1, 0)).Parent = sb
	end
	player.CharacterAdded:Connect(function()
		sprinting = false
		player:SetAttribute("Sprinting", false)
	end)

	-- stage progress bar: distance from the gate to the boss of the stage you are in
	local stageBar = UI.panel({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -134), Size = UDim2.fromOffset(360, 26), BackgroundColor3 = C.Bg, Visible = false, Parent = gui })
	local stageFill = UI.new("Frame", { BackgroundColor3 = C.Energy, Size = UDim2.fromScale(0, 1), Parent = stageBar }, { UI.corner() })
	local stageText = UI.label("", 14, { Size = UDim2.fromScale(1, 1), Parent = stageBar })
	task.spawn(function()
		while true do -- lint-ok (task.wait)
			task.wait(0.2)
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			local zid = player:GetAttribute("Zone")
			local zone = nil
			for _, z in ipairs(Zones) do
				if z.id == zid then
					zone = z
				end
			end
			stageBar.Visible = root ~= nil and zone ~= nil
			if root and zone then
				local gz, bz = zone.gatePos.Z, zone.bossPos.Z
				local r = math.clamp((root.Position.Z - gz) / (bz - gz), 0, 1)
				stageFill.Size = stageFill.Size:Lerp(UDim2.fromScale(r, 1), 0.5)
				stageFill.BackgroundColor3 = zone.color
				stageText.Text = ("STAGE %d • %s  —  %d%% to BOSS 👑"):format(zone.stage, zone.name, math.floor(r * 100))
			end
		end
	end)

	-- training range: while TRAINING in the hub, your character shoots the nearest target dummy
	task.spawn(function()
		while true do -- lint-ok (task.wait)
			task.wait(0.7)
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			local map = Workspace:FindFirstChild("Map")
			local hub = map and map:FindFirstChild("Hub")
			local dummies = hub and hub:FindFirstChild("TrainingDummies")
			if root and dummies and State.Train.training and player:GetAttribute("Zone") == "hub" then
				local best, bd = nil, 40
				for _, d in ipairs(dummies:GetChildren()) do
					if d:IsA("BasePart") then
						local dist = (d.Position - root.Position).Magnitude
						if dist &lt; bd then
							best, bd = d, dist
						end
					end
				end
				if best then
					local t = char:FindFirstChildOfClass("Tool")
					local from = GunController.MuzzlePos(t, char)
					if from and t then
						local col = Guns.Rarities[t:GetAttribute("Rarity") or 1].color
						local hit = best.Position + Vector3.new((math.random() - 0.5) * 1.5, (math.random() - 0.5) * 1.5, 0)
						Vfx.MuzzleFlash(from, col)
						Vfx.Bullet(from, hit, col, function()
							Vfx.HitSpark(hit, false)
						end)
					end
				end
			end
		end
	end)

	-- stage banner: art splash when you enter a new stage (only once banner_stageN is uploaded)
	local stageBanner = UI.new("ImageLabel", { BackgroundTransparency = 1, ImageTransparency = 1, ScaleType = Enum.ScaleType.Crop, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 100), Size = UDim2.fromOffset(420, 76), Visible = false, ZIndex = 12, Parent = gui }, { UI.corner() })
	local stageBannerText = UI.label("", 30, { Size = UDim2.fromScale(1, 1), ZIndex = 13, TextTransparency = 1, Parent = stageBanner })
	local lastZone = nil
	task.spawn(function()
		while true do -- lint-ok (task.wait)
			task.wait(0.5)
			local zid = player:GetAttribute("Zone")
			if zid ~= lastZone then
				lastZone = zid
				for _, z in ipairs(Zones) do
					local img = UI.imageId("banner_stage" .. z.stage)
					if z.id == zid and img then
						stageBanner.Image = img
						stageBannerText.Text = ("STAGE %d  %s"):format(z.stage, z.name)
						stageBanner.Visible = true
						TweenService:Create(stageBanner, TweenInfo.new(0.4), { ImageTransparency = 0 }):Play()
						TweenService:Create(stageBannerText, TweenInfo.new(0.4), { TextTransparency = 0 }):Play()
						task.delay(3.2, function()
							TweenService:Create(stageBanner, TweenInfo.new(0.6), { ImageTransparency = 1 }):Play()
							TweenService:Create(stageBannerText, TweenInfo.new(0.6), { TextTransparency = 1 }):Play()
						end)
					end
				end
			end
		end
	end)

	Hud.StartTutorial()

	-- power ticker
	local shown = 0
	task.spawn(function()
		local t = 0
		while true do -- lint-ok (task.wait)
			task.wait(0.1)
			local target = State.Power()
			shown += (target - shown) * 0.35
			if math.abs(target - shown) &lt; 1 then
				shown = target
			end
			powerLabel.Text = "⚡ " .. W.short(shown)
			t += 1
			if t % 10 == 0 then
				updateGates()
				nextZoneHint()
			end
		end
	end)
end

return Hud
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000056"><Properties><string name="Name">InventoryController</string><ProtectedString name="Source">-- Inventory: guns / armor (equip, salvage), materials, collection Index. Plus Rebirth + Codes windows.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Theme = require(Shared.Theme)
local Net = require(Shared.Net)
local Guns = require(Shared.Config.Guns)
local Materials = require(Shared.Config.Materials)
local Monsters = require(Shared.Config.Monsters)
local Pets = require(Shared.Config.Pets)
local UI = require(script.Parent.Parent.UIKit)
local W = require(script.Parent.Parent.Widgets)
local State = require(script.Parent.Parent.ClientState)
local UIController = require(script.Parent.UIController)
local Forge = require(script.Parent.ForgeController)

local C = Theme.Colors
local Inv = {}
local body, tab = nil, "GUNS"
local GLYPH = { pistol = "🔫", smg = "🔫", shotgun = "🔫", rifle = "🔫", blaster = "✦", railgun = "⚡", helmet = "⛑", vest = "🦺", boots = "👢" }

local function isEquipped(uid: string): boolean
	local e = State.Inv.equipped
	return e.gun == uid or e.helmet == uid or e.vest == uid or e.boots == uid
end

local function renderGear(kind: string)
	W.grid(body, Vector2.new(140, 170))
	local list = {}
	for uid, it in pairs(State.Inv.items) do
		if it.kind == kind then
			table.insert(list, { uid = uid, it = it })
		end
	end
	table.sort(list, function(a, b)
		local va = a.it.dmg or a.it.hp or 0
		local vb = b.it.dmg or b.it.hp or 0
		return va &gt; vb
	end)
	for i, e in ipairs(list) do
		local it = e.it
		local name = if kind == "gun" then Guns.Types[it.id].name else Guns.Armor[it.id].name
		local eq = isEquipped(e.uid)
		local card = W.card(body, i, it.rarity, GLYPH[it.id] or "★", ("%s T%d"):format(name, it.tier), Forge.StatText(it),
			if eq then "EQUIPPED" else "EQUIP", function()
				if not eq then
					Net.send("Equip", e.uid)
				end
			end, if eq then "ON" else nil, (if kind == "gun" then "gun_" else "armor_") .. it.id)
		if not eq then
			local s = UI.button("♻", C.Danger, function()
				Net.send("Salvage", e.uid)
			end, { Size = UDim2.fromOffset(28, 28), Position = UDim2.new(1, -30, 0, 2), Parent = card })
			s.Label.TextSize = 14
		end
	end
	if #list == 0 then
		UI.label("Nothing yet — craft at the Forge!", 18, { Size = UDim2.fromOffset(560, 30), Parent = body })
	end
end

local function renderMats()
	W.grid(body, Vector2.new(140, 120))
	local i = 0
	for id, n in pairs(State.Inv.materials) do
		local def = Materials[id]
		if def then
			i += 1
			W.card(body, def.rarity * 100 + i, def.rarity, def.glyph, def.name, "x" .. W.short(n), nil, nil, nil, "mat_" .. id)
		end
	end
end

local function renderIndex()
	UIController.List(body)
	local idx = State.Inv.index
	local function count(t)
		local n = 0
		for _ in pairs(t or {}) do
			n += 1
		end
		return n
	end
	local totalGuns = #Guns.TypeOrder * #Guns.Rarities
	local totalPets, totalMon = 0, 0
	for _ in pairs(Pets.Pets) do
		totalPets += 1
	end
	for _ in pairs(Monsters) do
		totalMon += 1
	end
	UIController.Row(body, 1, "Guns discovered", ("%d / %d"):format(count(idx.guns), totalGuns), "", C.Panel, false, function() end, count(idx.guns) / totalGuns)
	UIController.Row(body, 2, "Pets discovered", ("%d / %d"):format(count(idx.pets), totalPets), "", C.Panel, false, function() end, count(idx.pets) / totalPets)
	UIController.Row(body, 3, "Monsters defeated", ("%d / %d"):format(count(idx.monsters), totalMon), "", C.Panel, false, function() end, count(idx.monsters) / totalMon)
	local o = 3
	for _, typeId in ipairs(Guns.TypeOrder) do
		o += 1
		local have = {}
		for r = 1, #Guns.Rarities do
			table.insert(have, if idx.guns[typeId .. "_" .. r] then "★" else "☆")
		end
		UIController.Row(body, o, Guns.Types[typeId].name, table.concat(have, " "), "", C.Panel, false, function() end)
	end
end

local function render()
	if not body then
		return
	end
	W.clear(body)
	if tab == "GUNS" then
		renderGear("gun")
	elseif tab == "ARMOR" then
		renderGear("armor")
	elseif tab == "MATS" then
		renderMats()
	else
		renderIndex()
	end
end

local function rebirthWindow()
	local _, rb = UIController.MakeWindow("Rebirth", "REBIRTH", C.Gold)
	UIController.List(rb)
	local function draw()
		UIController.Clear(rb)
		local info = Net.invoke("RebirthInfo")
		if not info then
			return
		end
		local ok = info.power &gt;= info.cost
		UIController.Row(rb, 1, ("Rebirth %d → %d"):format(info.rebirths, info.rebirths + 1),
			("Training x%.2f → x%.2f  •  Resets Power + Coins, keeps items &amp; pets"):format(info.now, info.after),
			"REBIRTH", C.Gold, ok, function()
				if Net.invoke("Rebirth") then
					UIController.Close("Rebirth")
				end
			end, info.power / info.cost, "menu_rebirth")
		UIController.Row(rb, 2, "Requirement", ("%s / %s Power"):format(W.short(info.power), W.short(info.cost)), "", C.Panel, false, function() end)
	end
	Inv.DrawRebirth = draw
end

local function codesWindow()
	local win = UIController.MakeWindow("Codes", "CODES", C.Energy)
	local box = UI.new("TextBox", { PlaceholderText = "Enter code", Text = "", Font = Theme.Font, TextSize = 26, TextColor3 = C.Text, BackgroundColor3 = C.Bg,
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 120), Size = UDim2.fromOffset(360, 56), ClearTextOnFocus = false, Parent = win })
	UI.corner().Parent = box
	UI.stroke().Parent = box
	local res = UI.label("", 20, { Position = UDim2.fromOffset(0, 270), Size = UDim2.new(1, 0, 0, 30), Parent = win })
	UI.button("REDEEM", C.Primary, function()
		local r = Net.invoke("Redeem", box.Text)
		res.Text = if r == "OK" then "✔ Redeemed!" else tostring(r)
		res.TextColor3 = if r == "OK" then C.Primary else C.Danger
	end, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 196), Size = UDim2.fromOffset(220, 56), Parent = win })
end

local function gemWindow()
	local GemShop = require(Shared.Config.GemShop)
	local _, gb = UIController.MakeWindow("Gems", "GEM SHOP", Color3.fromRGB(181, 108, 255))
	UIController.List(gb)
	for i, it in ipairs(GemShop) do
		UIController.Row(gb, i, it.name, it.desc, ("💎 %d"):format(it.gems), Color3.fromRGB(181, 108, 255), true, function()
			Net.invoke("GemBuy", it.key)
		end, nil, "cur_gems")
	end
end

function Inv.Init()
	local win, b = UIController.MakeWindow("Inventory", "INVENTORY", C.Energy)
	body = b
	local select = W.tabs(win, b, { "GUNS", "ARMOR", "MATS", "INDEX" }, function(name)
		tab = name
		render()
	end)
	UI.button("♻ SALVAGE COMMONS", C.Danger, function()
		Net.send("SalvageAllCommon")
	end, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -60, 0, 52), Size = UDim2.fromOffset(200, 40), Parent = win }).Label.TextSize = 14
	UIController.AddMenuButton(6, "BAG", C.Energy, "Inventory")
	State.InvChanged:Connect(function()
		if UIController.IsOpen("Inventory") then
			render()
		end
	end)
	select("GUNS")
	rebirthWindow()
	codesWindow()
	gemWindow()
	UIController.AddMenuButton(11, "GEMS", Color3.fromRGB(181, 108, 255), "Gems")
	UIController.AddMenuButton(9, "REBIRTH", C.Gold, "Rebirth").Activated:Connect(function()
		task.defer(Inv.DrawRebirth)
	end)
end

return Inv
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000057"><Properties><string name="Name">MinigameController</string><ProtectedString name="Source">-- Training-break minigames (play while AFK-training): Target Rush, Reload Rhythm, Lucky Crate.
-- Also exports the timing-bar widget reused by the Forge assembly minigame.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage.Shared
local Theme = require(Shared.Theme)
local Net = require(Shared.Net)
local Minigames = require(Shared.Config.Minigames)
local Materials = require(Shared.Config.Materials)
local UI = require(script.Parent.Parent.UIKit)
local W = require(script.Parent.Parent.Widgets)
local UIController = require(script.Parent.UIController)

local C = Theme.Colors
local MG = { Busy = false }

local function resultText(res): string
	if not res then
		return "No reward"
	end
	local parts = {}
	if res.power and res.power &gt; 0 then
		table.insert(parts, "+" .. W.short(res.power) .. " ⚡ Power")
	end
	if res.coins and res.coins &gt; 0 then
		table.insert(parts, "+" .. W.short(res.coins) .. " 🪙")
	end
	if res.gems then
		table.insert(parts, "+" .. res.gems .. " 💎")
	end
	if res.mat and Materials[res.mat] then
		table.insert(parts, ("+%d %s"):format(res.amount, Materials[res.mat].name))
	end
	return if #parts &gt; 0 then table.concat(parts, "\n") else "Better luck next time!"
end

local function showResult(box: Frame, close: () -&gt; (), title: string, res)
	for _, ch in ipairs(box:GetChildren()) do
		if ch.Name == "Play" then
			ch:Destroy()
		end
	end
	UI.label(title, 34, { Position = UDim2.fromOffset(0, 90), Size = UDim2.new(1, 0, 0, 40), TextColor3 = C.Gold, Parent = box })
	UI.label(resultText(res), 24, { Position = UDim2.fromOffset(0, 150), Size = UDim2.new(1, 0, 0, 120), Parent = box })
	UI.button("NICE!", C.Primary, function()
		close()
		MG.Busy = false
	end, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -20), Size = UDim2.fromOffset(200, 56), Parent = box })
end

-- Timing bar: needle sweeps; tap when inside the gold zone. Calls onHit(perfect: boolean) per tap.
function MG.TimingBar(parent: Frame, y: number, speed: number, zoneWidth: number, onHit: (boolean) -&gt; ())
	local bar = UI.new("Frame", { Name = "Play", BackgroundColor3 = C.Bg, Position = UDim2.new(0.1, 0, 0, y), Size = UDim2.new(0.8, 0, 0, 34), Parent = parent }, { UI.corner(UDim.new(0, 8)), UI.stroke() })
	local zone = UI.new("Frame", { BackgroundColor3 = C.Gold, Size = UDim2.fromScale(zoneWidth, 1), Parent = bar }, { UI.corner(UDim.new(0, 8)) })
	local needle = UI.new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.new(0, 6, 1, 10), Position = UDim2.fromScale(0, -0.15), Parent = bar })
	local x, dir = 0, 1
	local function newZone()
		zone.Position = UDim2.fromScale(math.random() * (1 - zoneWidth), 0)
	end
	newZone()
	local conn = RunService.RenderStepped:Connect(function(dt) -- lint-ok (one needle)
		x += dir * dt * speed
		if x &gt;= 1 or x &lt;= 0 then
			dir = -dir
			x = math.clamp(x, 0, 1)
		end
		needle.Position = UDim2.new(x, -3, -0.15, 0)
	end)
	local function tap()
		local zx = zone.Position.X.Scale
		local perfect = x &gt;= zx and x &lt;= zx + zoneWidth
		zone.BackgroundColor3 = if perfect then C.Primary else C.Danger
		task.delay(0.15, function()
			zone.BackgroundColor3 = C.Gold
			newZone()
		end)
		onHit(perfect)
	end
	return tap, function()
		conn:Disconnect()
	end
end

local function targetRush(box: Frame, duration: number, done: (number) -&gt; ())
	local area = UI.new("Frame", { Name = "Play", BackgroundTransparency = 1, Position = UDim2.fromOffset(20, 100), Size = UDim2.new(1, -40, 1, -120), Parent = box })
	local scoreL = UI.label("0", 26, { Name = "Play", Position = UDim2.fromOffset(0, 58), Size = UDim2.new(1, 0, 0, 30), TextColor3 = C.Gold, Parent = box })
	local score, running = 0, true
	local function spawnTarget()
		if not running then
			return
		end
		local t = UI.button("🎯", C.Danger, function() end, { Size = UDim2.fromOffset(64, 64), Position = UDim2.fromScale(math.random() * 0.88, math.random() * 0.8), Parent = area })
		UI.corner(UDim.new(1, 0)).Parent = t
		local hit = false
		t.Activated:Connect(function()
			if hit then
				return
			end
			hit = true
			score += 1
			scoreL.Text = tostring(score)
			t:Destroy()
			spawnTarget()
		end)
		task.delay(1.1, function()
			if not hit and t.Parent then
				t:Destroy()
				spawnTarget()
			end
		end)
	end
	spawnTarget()
	spawnTarget()
	task.delay(duration, function()
		running = false
		done(score)
	end)
end

local function reloadRhythm(box: Frame, duration: number, maxScore: number, done: (number) -&gt; ())
	local score, taps = 0, 0
	local scoreL = UI.label("0 / " .. maxScore, 26, { Name = "Play", Position = UDim2.fromOffset(0, 58), Size = UDim2.new(1, 0, 0, 30), TextColor3 = C.Gold, Parent = box })
	local tap, stop = MG.TimingBar(box, 170, 1.4, 0.16, function(perfect)
		taps += 1
		if perfect then
			score += 1
		end
		scoreL.Text = ("%d / %d"):format(score, maxScore)
	end)
	local btn = UI.button("RELOAD!", C.Energy, function()
		if taps &lt; maxScore + 5 then
			tap()
		end
	end, { Name = "Play", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 240), Size = UDim2.fromOffset(240, 70), Parent = box })
	btn.Label.TextSize = 30
	task.delay(duration, function()
		stop()
		done(math.min(score, maxScore))
	end)
end

local function luckyCrate(box: Frame, done: (number) -&gt; ())
	local row = UI.new("Frame", { Name = "Play", BackgroundTransparency = 1, Position = UDim2.fromOffset(40, 120), Size = UDim2.new(1, -80, 0, 180), Parent = box })
	UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 24), Parent = row })
	local picked = false
	for _ = 1, 3 do
		local b = UI.button("📦", C.Gold, function()
			if picked then
				return
			end
			picked = true
			done(1)
		end, { Size = UDim2.fromOffset(150, 150), Parent = row })
		b.Label.TextSize = 70
		TweenService:Create(b, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Rotation = 6 }):Play()
	end
end

function MG.Play(name: string)
	local cfg = Minigames[name]
	if not cfg or MG.Busy then
		return
	end
	local res = Net.invoke("MinigameStart", name)
	if not res or not res.ok then
		UIController.Toast(res and res.wait and ("Ready in %ds"):format(res.wait) or "Not available", "info")
		return
	end
	MG.Busy = true
	local box, close = W.modal(UIController.Gui(), cfg.name, cfg.color)
	UI.label(cfg.desc, 18, { Name = "Play", Font = Theme.FontBody, Position = UDim2.fromOffset(0, 60), Size = UDim2.new(1, 0, 0, 0), TextColor3 = C.TextDim, Parent = box })
	local function finish(score)
		local out = Net.invoke("MinigameEnd", score)
		showResult(box, close, if name == "LuckyCrate" then "YOU GOT" else ("SCORE %d"):format(score), out)
	end
	if name == "TargetRush" then
		targetRush(box, res.duration, finish)
	elseif name == "ReloadRhythm" then
		reloadRhythm(box, res.duration, res.maxScore, finish)
	else
		luckyCrate(box, finish)
	end
end

function MG.Init()
	-- quick-access minigame menu (also opened by booths in the hub)
	local _, body = UIController.MakeWindow("Minigames", "TRAINING GAMES", C.Forge)
	UIController.List(body)
	local function render()
		UIController.Clear(body)
		local cds = Net.invoke("MinigameCooldowns") or {}
		local i = 0
		for key, cfg in pairs(Minigames) do
			i += 1
			local cd = cds[key] or 0
			UIController.Row(body, i, cfg.name, cfg.desc, if cd &gt; 0 then (cd .. "s") else "PLAY", cfg.color, cd &lt;= 0, function()
				UIController.Close("Minigames")
				MG.Play(key)
			end, nil, "menu_games")
		end
	end
	local btn = UIController.AddMenuButton(4, "GAMES", C.Forge, "Minigames")
	btn.Activated:Connect(function()
		task.defer(render)
	end)
	MG.Render = render
end

return MG
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000058"><Properties><string name="Name">MonsterController</string><ProtectedString name="Source">-- Moves monster models locally from server segments (zero physics/network per frame), HP bars,
-- death poofs, world-boss slam telegraph. Also exposes targeting queries for GunController.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Net = require(ReplicatedStorage.Shared.Net)
local Theme = require(ReplicatedStorage.Shared.Theme)
local UI = require(script.Parent.Parent.UIKit)
local Vfx = require(script.Parent.VfxController)

local MonsterController = {}
type Rec = { model: Model, size: number, bar: Frame?, last: Vector3, born: number, rot: CFrame, atk: number, color: Color3 }
local tracked: { [Model]: Rec } = {}

local function pos(m: Model): Vector3
	local from, to = m:GetAttribute("From"), m:GetAttribute("To")
	local t0, dur = m:GetAttribute("T0"), m:GetAttribute("Dur")
	if typeof(from) ~= "Vector3" or typeof(to) ~= "Vector3" then
		return m:GetPivot().Position
	end
	if type(dur) ~= "number" or dur &lt;= 0 then
		return to
	end
	local a = math.clamp((Workspace:GetServerTimeNow() - t0) / dur, 0, 1)
	return from:Lerp(to, a)
end
MonsterController.Pos = pos

function MonsterController.Bob(m: Model): number
	local s = m:GetAttribute("Size") or 4
	return s * 0.1
end

function MonsterController.Alive(): { Model }
	local out = {}
	for m in pairs(tracked) do
		if (m:GetAttribute("HP") or 0) &gt; 0 then
			table.insert(out, m)
		end
	end
	return out
end

local function track(m: Instance)
	if not m:IsA("Model") or tracked[m] then
		return
	end
	local size = m:GetAttribute("Size") or 4
	local root = m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart")
	local rec: Rec = { model = m, size = size, last = pos(m), born = os.clock(), rot = CFrame.identity, atk = 0,
		color = if root and root:IsA("BasePart") then root.Color else Color3.new(1, 1, 1) }
	if root then
		local bb = Instance.new("BillboardGui")
		bb.Size = UDim2.fromOffset(if m:GetAttribute("Boss") then 260 else 130, 34)
		bb.StudsOffset = Vector3.new(0, size * 0.75 + 1, 0)
		bb.MaxDistance = if m:GetAttribute("Boss") then 250 else 90
		UI.label(tostring(m:GetAttribute("Name") or "?"), 14, { Size = UDim2.new(1, 0, 0, 16), TextColor3 = if m:GetAttribute("Boss") then Theme.Colors.Gold else Color3.new(1, 1, 1), Parent = bb })
		local back = UI.new("Frame", { BackgroundColor3 = Color3.fromRGB(20, 16, 30), Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, 0, 0, 10), Parent = bb }, { UI.corner(UDim.new(1, 0)) })
		rec.bar = UI.new("Frame", { BackgroundColor3 = Theme.Colors.Danger, Size = UDim2.fromScale(1, 1), Parent = back }, { UI.corner(UDim.new(1, 0)) })
		bb.Parent = root
	end
	m:GetAttributeChangedSignal("Atk"):Connect(function()
		rec.atk = os.clock()
	end)
	m:GetAttributeChangedSignal("HP"):Connect(function()
		local hp, max = m:GetAttribute("HP") or 0, m:GetAttribute("MaxHP") or 1
		if rec.bar then
			rec.bar.Size = UDim2.fromScale(math.clamp(hp / max, 0, 1), 1)
		end
		if hp &lt;= 0 then
			Vfx.DeathBurst(rec.last, size, rec.color)
		end
	end)
	tracked[m] = rec
end

local function slam(center: Vector3, radius: number, delay: number)
	task.delay(delay, function()
		Vfx.Sound(require(ReplicatedStorage.Shared.Config.Sounds).Slam, center)
		Vfx.Shake(0.6, 0.35)
	end)
	local ring = Instance.new("Part")
	ring.Anchored, ring.CanCollide, ring.CanQuery, ring.CanTouch = true, false, false, false
	ring.Shape = Enum.PartType.Cylinder
	ring.Material = Enum.Material.Neon
	ring.Color = Theme.Colors.Danger
	ring.Transparency = 0.5
	ring.Size = Vector3.new(0.3, 2, 2)
	ring.CFrame = CFrame.new(center + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90))
	ring.Parent = Workspace
	TweenService:Create(ring, TweenInfo.new(delay, Enum.EasingStyle.Linear), { Size = Vector3.new(0.3, radius * 2, radius * 2) }):Play()
	task.delay(delay, function()
		ring.Transparency = 0.1
		TweenService:Create(ring, TweenInfo.new(0.3), { Transparency = 1 }):Play()
		task.wait(0.35)
		ring:Destroy()
	end)
end

function MonsterController.Init()
	local folder = Workspace:WaitForChild("Monsters", 30)
	if not folder then
		return
	end
	folder.ChildAdded:Connect(track)
	folder.ChildRemoved:Connect(function(m)
		tracked[m :: Model] = nil
	end)
	for _, m in ipairs(folder:GetChildren()) do
		track(m)
	end
	Net.listen("BossSlam", slam)

	local cam = Workspace.CurrentCamera
	local player = Players.LocalPlayer
	RunService.Heartbeat:Connect(function(dt)
		local camPos = cam.CFrame.Position
		local char = player.Character
		local me = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		local t = os.clock()
		for m, rec in pairs(tracked) do
			local p = pos(m)
			if (p - camPos).Magnitude &lt; 260 then
				local moving = (p - rec.last).Magnitude &gt; 0.01
				-- facing: player if close, else movement direction; slerped for smooth turns
				local look
				if me and (me.Position - p).Magnitude &lt; 40 then
					look = Vector3.new(me.Position.X, p.Y, me.Position.Z) - p
				elseif moving then
					look = Vector3.new(p.X - rec.last.X, 0, p.Z - rec.last.Z)
				end
				if look and look.Magnitude &gt; 0.05 then
					rec.rot = rec.rot:Lerp(CFrame.lookAt(Vector3.zero, look.Unit), math.clamp(dt * 10, 0, 1))
				end
				-- hop while moving, gentle idle breathing otherwise
				local speed = if moving then 9 else 3
				local hop = math.abs(math.sin(t * speed + rec.size)) * rec.size * (if moving then 0.18 else 0.05)
				-- spawn: rise out of the ground
				local age = t - rec.born
				local rise = if age &lt; 0.5 then -(1 - age / 0.5) ^ 2 * rec.size else 0
				-- attack: wind-up back then lunge forward
				local lunge = 0
				local at = t - rec.atk
				if at &lt; 0.5 then
					lunge = if at &lt; 0.25 then -at / 0.25 * 0.6 else math.sin((at - 0.25) / 0.25 * math.pi) * 1.8
				end
				local cf = CFrame.new(p + Vector3.new(0, hop + rise, 0)) * rec.rot * CFrame.new(0, 0, -lunge * rec.size * 0.3)
				m:PivotTo(cf)
			end
			rec.last = p
		end
	end)
end

return MonsterController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000059"><Properties><string name="Name">PetsController</string><ProtectedString name="Source">-- Fusion Altar (odds always visible) + hatch reveal, pet inventory (equip/best/combine),
-- and client-side pet followers for every player (server only stores ids).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Theme = require(Shared.Theme)
local Net = require(Shared.Net)
local Pets = require(Shared.Config.Pets)
local Guns = require(Shared.Config.Guns)
local Materials = require(Shared.Config.Materials)
local UI = require(script.Parent.Parent.UIKit)
local W = require(script.Parent.Parent.Widgets)
local State = require(script.Parent.Parent.ClientState)
local UIController = require(script.Parent.UIController)
local Effects = require(script.Parent.EffectsController)

local C = Theme.Colors
local PetsC = {}
local body, tab = nil, "FUSE"
local LVL = { [0] = "", [1] = "Golden ", [2] = "Rainbow " }

local function oddsText(core): string
	local total = 0
	for _, w in pairs(core.odds) do
		total += w
	end
	local parts = {}
	for id, w in pairs(core.odds) do
		table.insert(parts, { t = ("%s %.1f%%"):format(Pets.Pets[id].name, w / total * 100), w = w })
	end
	table.sort(parts, function(a, b)
		return a.w &gt; b.w
	end)
	local out = {}
	for _, p in ipairs(parts) do
		table.insert(out, p.t)
	end
	return table.concat(out, " • ")
end

local function hatch(core)
	local res = Net.invoke("Fuse", core.id)
	if not res or not res.ok then
		UIController.Toast(res and res.err or "Can't fuse", "error")
		return
	end
	UIController.Close("Pets")
	local box, close = W.modal(UIController.Gui(), core.name, C.Forge)
	local egg = UI.icon(nil, "🥚", C.Energy, 140)
	egg.AnchorPoint = Vector2.new(0.5, 0.5)
	egg.Position = UDim2.fromScale(0.5, 0.48)
	egg.Parent = box
	for i = 1, 6 do -- shake, faster and faster
		TweenService:Create(egg, TweenInfo.new(0.12 - i * 0.012), { Rotation = if i % 2 == 0 then 14 else -14 }):Play()
		task.wait(0.14 - i * 0.012)
	end
	local def = Pets.Pets[res.pet]
	W.flash(UIController.Gui(), Guns.Rarities[def.rarity].color)
	egg:Destroy()
	local card = W.card(box, 0, def.rarity, "🐾", def.name, ("%s  •  +%d%% Power  +%d%% Coins"):format(Guns.Rarities[def.rarity].name, def.power * 100, def.coins * 100), nil, nil, nil, "pet_" .. res.pet)
	card.AnchorPoint = Vector2.new(0.5, 0)
	card.Position = UDim2.new(0.5, 0, 0, 80)
	card.Size = UDim2.fromOffset(240, 160)
	local s = UI.new("UIScale", { Scale = 0.2, Parent = card })
	TweenService:Create(s, TweenInfo.new(0.5, Enum.EasingStyle.Back), { Scale = 1.25 }):Play()
	if res.lucky then
		UI.label("LUCKY FORGE upgrade!", 20, { Position = UDim2.fromOffset(0, 300), Size = UDim2.new(1, 0, 0, 24), TextColor3 = C.Gold, Parent = box })
	end
	UI.button("AWESOME!", C.Primary, close, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -16), Size = UDim2.fromOffset(220, 54), Parent = box })
end

local function renderFuse()
	UIController.List(body)
	for i, core in ipairs(Pets.Cores) do
		local inv = State.Inv.materials
		local ok = State.Coins() &gt;= core.coins
		local need = {}
		for id, n in pairs(core.mats) do
			ok = ok and (inv[id] or 0) &gt;= n
			table.insert(need, ("%s %d/%d"):format(Materials[id].glyph, inv[id] or 0, n))
		end
		table.insert(need, "🪙 " .. W.short(core.coins))
		UIController.Row(body, i, core.name .. "  —  " .. table.concat(need, " "), oddsText(core), "FUSE", C.Forge, ok, function()
			hatch(core)
		end, nil, "mat_" .. core.id)
	end
end

local function renderMine()
	W.grid(body, Vector2.new(140, 170))
	local groups, list = {}, {}
	for uid, it in pairs(State.Inv.items) do
		if it.kind == "pet" and Pets.Pets[it.id] then
			local key = it.id .. ":" .. (it.lvl or 0)
			groups[key] = (groups[key] or 0) + 1
			table.insert(list, { uid = uid, it = it })
		end
	end
	table.sort(list, function(a, b)
		local pa, pb = Pets.Pets[a.it.id], Pets.Pets[b.it.id]
		return pa.power * (1 + (a.it.lvl or 0) * 2) &gt; pb.power * (1 + (b.it.lvl or 0) * 2)
	end)
	local equipped = State.Inv.equipped.pets
	for i, e in ipairs(list) do
		local def = Pets.Pets[e.it.id]
		local lvl = e.it.lvl or 0
		local eq = table.find(equipped, e.uid) ~= nil
		local mult = if lvl == 2 then Pets.RainbowMult elseif lvl == 1 then Pets.GoldenMult else 1
		local card = W.card(body, i, math.min(5, def.rarity + lvl), "🐾", LVL[lvl] .. def.name, ("+%d%% Power"):format(def.power * mult * 100),
			if eq then "UNEQUIP" else "EQUIP", function()
				Net.send("EquipPet", e.uid)
			end, if eq then "ON" else nil, "pet_" .. e.it.id)
		local key = e.it.id .. ":" .. lvl
		if lvl &lt; 2 and (groups[key] or 0) &gt;= Pets.CombineCount then
			local b = UI.button("x5↑", C.Gold, function()
				Net.send("CombinePets", e.it.id, lvl)
			end, { Size = UDim2.fromOffset(40, 26), Position = UDim2.new(1, -42, 0, 2), Parent = card })
			b.Label.TextSize = 13
		end
	end
end

local function render()
	if not body then
		return
	end
	W.clear(body)
	if tab == "FUSE" then
		renderFuse()
	else
		renderMine()
	end
end

-------------------------------------------------- followers
local followers: { [Player]: { Model } } = {}

local function petModel(id: string, lvl: number): Model
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local src = assets and assets:FindFirstChild("Pets") and assets.Pets:FindFirstChild(id)
	local m: Model
	if src and src:IsA("Model") then
		m = src:Clone()
	else
		m = Instance.new("Model")
		local def = Pets.Pets[id]
		local body = Instance.new("Part")
		body.Shape = Enum.PartType.Ball
		body.Size = Vector3.one * 1.8
		body.Color = if lvl == 1 then Color3.fromRGB(255, 205, 60) else def.color
		body.Material = if lvl == 2 then Enum.Material.Neon else Enum.Material.SmoothPlastic
		body.Parent = m
		for sx = -1, 1, 2 do
			local eye = Instance.new("Part")
			eye.Shape = Enum.PartType.Ball
			eye.Size = Vector3.one * 0.4
			eye.Color = Color3.new(0.05, 0.05, 0.08)
			eye.CFrame = CFrame.new(sx * 0.35, 0.2, -0.75)
			eye.Parent = m
		end
		m.PrimaryPart = body
	end
	for _, p in ipairs(m:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
		end
	end
	m.Parent = Workspace
	return m
end

local function rebuild(p: Player)
	for _, m in ipairs(followers[p] or {}) do
		m:Destroy()
	end
	followers[p] = {}
	local attr = p:GetAttribute("Pets")
	if type(attr) ~= "string" or attr == "" then
		return
	end
	for entry in attr:gmatch("[^,]+") do
		local id, lvl = entry:match("^(.-):(%d)$")
		if id and Pets.Pets[id] then
			table.insert(followers[p], petModel(id, tonumber(lvl) or 0))
		end
	end
end

local function watch(p: Player)
	p:GetAttributeChangedSignal("Pets"):Connect(function()
		rebuild(p)
	end)
	rebuild(p)
end

function PetsC.Init()
	local win, b = UIController.MakeWindow("Pets", "PETS &amp; FUSION", C.Gold)
	body = b
	local select = W.tabs(win, b, { "FUSE", "MY PETS" }, function(name)
		tab = name
		render()
	end)
	UI.button("EQUIP BEST", C.Primary, function()
		Net.send("EquipBestPets")
	end, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -60, 0, 52), Size = UDim2.fromOffset(160, 40), Parent = win }).Label.TextSize = 14
	UIController.AddMenuButton(7, "PETS", C.Gold, "Pets").Activated:Connect(function()
		task.defer(render)
	end)
	State.InvChanged:Connect(function()
		if UIController.IsOpen("Pets") then
			render()
		end
	end)
	select("FUSE")

	Players.PlayerAdded:Connect(watch)
	for _, p in ipairs(Players:GetPlayers()) do
		watch(p)
	end
	Players.PlayerRemoving:Connect(function(p)
		for _, m in ipairs(followers[p] or {}) do
			m:Destroy()
		end
		followers[p] = nil
	end)
	local cam = Workspace.CurrentCamera
	RunService.Heartbeat:Connect(function(dt)
		local t = os.clock()
		for p, list in pairs(followers) do
			local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root and (root.Position - cam.CFrame.Position).Magnitude &lt; 160 and not Effects.LowFx or (root and p == Players.LocalPlayer) then
				local r = root :: BasePart
				for i, m in ipairs(list) do
					local angle = math.rad(150 + (i - 1) * 30 - (#list - 1) * 15)
					local offset = r.CFrame:VectorToWorldSpace(Vector3.new(math.sin(angle) * 5, 0, -math.cos(angle) * 5))
					local goal = r.Position + offset + Vector3.new(0, -1.5 + math.sin(t * 4 + i) * 0.4, 0)
					local cur = m:GetPivot()
					local pos = cur.Position:Lerp(goal, math.clamp(dt * 8, 0, 1))
					m:PivotTo(CFrame.lookAt(pos, pos + r.CFrame.LookVector))
				end
			end
		end
	end)
end

return PetsC
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000005A"><Properties><string name="Name">ProgressController</string><ProtectedString name="Source">-- Retention UI: Season pass ("PASS"), Achievements/Titles/Story ("GOALS"), Daily Spin ("SPIN"), story tracker.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Theme = require(Shared.Theme)
local Net = require(Shared.Net)
local Season = require(Shared.Config.Season)
local Achievements = require(Shared.Config.Achievements)
local Spin = require(Shared.Config.Spin)
local Story = require(Shared.Config.Story)
local UI = require(script.Parent.Parent.UIKit)
local W = require(script.Parent.Parent.Widgets)
local PUI = require(script.Parent.Parent.ProgressUI)
local UIController = require(script.Parent.UIController)

local C = Theme.Colors
local Progress = {}

local seasonBody, goalsBody, spinBody, goalsWin
local selectTab, setTracker
local goalTab = "ACHIEVEMENTS"
local storyState, spinInfo, wheel, spinBtn, spinNote

local function onVisible(win: GuiObject, fn: () -&gt; ())
	win:GetPropertyChangedSignal("Visible"):Connect(function()
		if win.Visible then
			fn()
		end
	end)
end

local function fmtTime(s: number): string
	return ("%dh %02dm"):format(s // 3600, (s % 3600) // 60)
end

-- notification dots on the PASS / SPIN / GOALS menu icons
local function seasonBadge(st)
	local n = 0
	if st then
		for t = 1, math.min(st.tier, Season.Tiers) do
			if not st.claimed[tostring(t)] then
				n += 1
			end
			if st.premium and not st.premiumClaimed[tostring(t)] then
				n += 1
			end
		end
	end
	UIController.SetBadge("Season", n)
end

---------------------------------------------------------------- season
local function renderSeason(st)
	W.clear(seasonBody)
	if not st then
		return
	end
	seasonBadge(st)
	UIController.List(seasonBody)
	local into = st.xp - st.tier * Season.XpPerTier
	local sub = st.tier &gt;= Season.Tiers and "Max tier reached!" or ("%d / %d XP to next tier"):format(into, Season.XpPerTier)
	UIController.Row(seasonBody, 0, ("%s  -  Tier %d / %d"):format(Season.Name, st.tier, Season.Tiers), sub .. (st.premium and "  •  PREMIUM ACTIVE" or "  •  Premium locked (Season Pass+ in SHOP)"), "", C.Panel, false, function() end, st.tier &gt;= Season.Tiers and 1 or into / Season.XpPerTier)
	for t = 1, Season.Tiers do
		PUI.tierRow(seasonBody, t, st, Season, function(tier, premium)
			renderSeason(Net.invoke("SeasonClaim", tier, premium))
		end)
	end
end

---------------------------------------------------------------- achievements / titles / story
local function renderAchievements(info)
	UIController.List(goalsBody)
	local order = {}
	for i, a in ipairs(Achievements.List) do
		table.insert(order, { a = a, i = i, done = info.earned[a.id] == true })
	end
	table.sort(order, function(x, y)
		if x.done ~= y.done then
			return not x.done
		end
		return x.i &lt; y.i
	end)
	for k, e in ipairs(order) do
		local a = e.a
		local v = info.values[a.id] or 0
		local reward = a.gems .. " Gems" .. (a.title and ("  •  Title: " .. Achievements.Titles[a.title].name) or "")
		UIController.Row(goalsBody, k, a.name, ("%s  (%s/%s)  •  %s"):format(a.desc, UI.formatNumber(math.min(v, a.goal)), UI.formatNumber(a.goal), reward), e.done and "DONE" or "IN PROGRESS", C.Primary, false, function() end, v / a.goal)
	end
end

local function renderTitles(info)
	UIController.List(goalsBody)
	UIController.Row(goalsBody, 0, "No Title", "Hide your title tag", info.title == "" and "EQUIPPED" or "EQUIP", C.Primary, info.title ~= "", function()
		Progress.Equip("")
	end)
	local ids = {}
	for id in pairs(Achievements.Titles) do
		table.insert(ids, id)
	end
	table.sort(ids)
	for i, id in ipairs(ids) do
		local own = info.owned[id] == true
		UIController.Row(goalsBody, i, Achievements.Titles[id].name, own and "Unlocked" or "Locked - earn it from achievements, the season pass or story", info.title == id and "EQUIPPED" or (own and "EQUIP" or "LOCKED"), C.Accent, own and info.title ~= id, function()
			Progress.Equip(id)
		end)
	end
end

local function renderStory()
	UIController.List(goalsBody)
	local st = storyState
	if not st then
		return
	end
	for i, step in ipairs(Story.Steps) do
		local label, enabled = "LOCKED", false
		local sub = step.text .. "  •  " .. Achievements.RewardText(step.reward)
		local prog
		if i &lt; st.step or st.finished then
			label = "DONE"
		elseif i == st.step then
			label, enabled = st.done and "CLAIM" or "IN PROGRESS", st.done
			sub = ("%s (%s/%s)  •  %s"):format(step.text, UI.formatNumber(st.value), UI.formatNumber(st.goal), Achievements.RewardText(step.reward))
			prog = st.value / st.goal
		end
		UIController.Row(goalsBody, i, ("%s - Step %d"):format(Story.Npc, i), sub, label, C.Accent, enabled, function()
			Net.send("StoryClaim")
		end, prog)
	end
end

local function renderGoals()
	W.clear(goalsBody)
	if goalTab == "STORY" then
		renderStory()
		return
	end
	local info = Net.invoke("AchInfo")
	if not info then
		return
	end
	if goalTab == "TITLES" then
		renderTitles(info)
	else
		renderAchievements(info)
	end
end

function Progress.Equip(id: string)
	Net.invoke("EquipTitle", id)
	renderGoals()
end

---------------------------------------------------------------- spin
local function refreshSpinUi()
	if not spinInfo or not spinBtn then
		return
	end
	local free = spinInfo.freeIn &lt;= 0
	UIController.SetBadge("Spin", if free then 1 else 0)
	spinBtn.Label.Text = free and "FREE SPIN!" or ("SPIN  -  %d Gems"):format(spinInfo.cost)
	spinNote.Text = free and "Your daily free spin is ready!" or ("Next free spin in %s  •  paid spins left today: %d"):format(fmtTime(spinInfo.freeIn), spinInfo.paidLeft)
end

local function buildSpin()
	wheel = PUI.wheel(spinBody, Spin.Prizes, 300)
	wheel.frame.Position = UDim2.fromOffset(10, 10)
	local lines = {}
	for _, p in ipairs(Spin.Prizes) do
		table.insert(lines, ("%s %s  (%d%%)"):format(p.glyph, p.text, p.weight))
	end
	UI.label("PRIZES\n" .. table.concat(lines, "\n"), 15, { Font = Theme.FontBody, Position = UDim2.fromOffset(330, 10), Size = UDim2.fromOffset(250, 190), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Parent = spinBody })
	spinNote = UI.label("", 15, { Font = Theme.FontBody, TextColor3 = C.TextDim, Position = UDim2.fromOffset(330, 205), Size = UDim2.fromOffset(250, 44), Parent = spinBody })
	spinBtn = UI.button("SPIN", C.Accent, function()
		if wheel.busy() or not spinInfo then
			return
		end
		local res = Net.invoke("Spin", spinInfo.freeIn &gt; 0)
		if not res then
			UIController.Toast("Can't spin right now", "error")
			return
		end
		local prize = Spin.Prizes[res.index]
		wheel.spinTo(res.index, function()
			spinInfo = res.info
			refreshSpinUi()
			UIController.Toast("You won " .. prize.text .. "!", "success")
		end)
	end, { Size = UDim2.fromOffset(250, 54), Position = UDim2.fromOffset(330, 255), Parent = spinBody })
end

---------------------------------------------------------------- init
function Progress.Init()
	local sw, sb = UIController.MakeWindow("Season", "SEASON PASS", C.Accent)
	seasonBody = sb
	local gw, gb = UIController.MakeWindow("Achievements", "GOALS", C.Primary)
	goalsWin, goalsBody = gw, gb
	local pw, pb = UIController.MakeWindow("Spin", "DAILY SPIN", Color3.fromRGB(255, 159, 67))
	spinBody = pb
	spinBody.CanvasSize = UDim2.fromOffset(0, 330)
	spinBody.AutomaticCanvasSize = Enum.AutomaticSize.None

	UIController.AddMenuButton(13, "PASS", C.Accent, "Season")
	UIController.AddMenuButton(14, "GOALS", C.Primary, "Achievements")
	UIController.AddMenuButton(15, "SPIN", Color3.fromRGB(255, 159, 67), "Spin")

	selectTab = W.tabs(gw, gb, { "ACHIEVEMENTS", "TITLES", "STORY" }, function(name)
		goalTab = name
		renderGoals()
	end)
	buildSpin()

	onVisible(sw, function()
		renderSeason(Net.invoke("SeasonInfo"))
	end)
	onVisible(gw, function()
		selectTab(goalTab)
	end)
	onVisible(pw, function()
		spinInfo = Net.invoke("SpinInfo")
		refreshSpinUi()
	end)

	setTracker = PUI.tracker(UIController.Gui(), function()
		goalTab = "STORY"
		if UIController.IsOpen("Achievements") then
			selectTab("STORY")
		else
			UIController.Open("Achievements")
		end
	end)
	Net.listen("StoryState", function(st)
		storyState = st
		setTracker(st)
		UIController.SetBadge("Achievements", if st.done and not st.finished then 1 else 0)
		if goalsWin.Visible and goalTab == "STORY" then
			renderGoals()
		end
	end)
	task.spawn(function()
		seasonBadge(Net.invoke("SeasonInfo"))
		spinInfo = Net.invoke("SpinInfo")
		refreshSpinUi()
		local st = Net.invoke("StoryInfo")
		if st and not storyState then
			storyState = st
			setTracker(st)
		end
	end)
end

return Progress
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000005B"><Properties><string name="Name">RaidController</string><ProtectedString name="Source">-- Co-op raid UI: lobby (create / join / start / solo), Raid Token shop, in-raid HUD (wave, enemies, timer, bar), end screen.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Theme = require(Shared.Theme)
local Net = require(Shared.Net)
local Cfg = require(Shared.Config.Raid)
local UI = require(script.Parent.Parent.UIKit)
local W = require(script.Parent.Parent.Widgets)
local UIController = require(script.Parent.UIController)

local C = Theme.Colors
local Raid = {}
local body, tab = nil, "LOBBY"
local info, hud, state = nil, nil, nil
local barFill, waveL, enemyL, timeL, banner

local function renderLobby()
	UIController.List(body)
	info = Net.invoke("RaidInfo")
	if not info then
		return
	end
	local lp = game:GetService("Players").LocalPlayer
	UIController.Row(body, 0, ("Best wave %d/%d  •  Clears %d  •  Tokens %d"):format(info.best, Cfg.Waves, info.clears, info.tokens),
		if info.dailyReady then "Daily first-clear bonus ready!" else "Daily bonus claimed", "", C.Panel, false, function() end)
	local mine = info.mine
	if mine then
		UIController.Row(body, 1, ("Lobby: %s (%d/%d)"):format(table.concat(mine.names, ", "), mine.count, Cfg.MaxPlayers),
			if mine.started then "Raid in progress" else "Leader starts the raid", "LEAVE", C.Danger, true, function()
				Net.send("RaidLeave")
				task.defer(Raid.Render)
			end)
		if mine.leaderId == lp.UserId and not mine.started then
			UIController.Row(body, 2, "START RAID", ("%d waves • mini-boss wave %d • boss wave %d"):format(Cfg.Waves, Cfg.MiniBossWave, Cfg.BossWave), "START", C.Primary, true, function()
				if Net.invoke("RaidStart") then
					UIController.Close("Raid")
				end
			end, nil, "menu_raid")
		end
		return
	end
	UIController.Row(body, 1, "Create raid lobby", "Other players in the server can join (max 4)", "CREATE", C.Primary, true, function()
		Net.invoke("RaidCreate")
		Raid.Render()
	end)
	UIController.Row(body, 2, "Solo raid", ("Enemies scale with your best zone (tier %d)"):format(info.tier), "GO SOLO", C.Gold, true, function()
		if Net.invoke("RaidCreate") and Net.invoke("RaidStart") then
			UIController.Close("Raid")
		else
			Raid.Render()
		end
	end)
	for i, l in ipairs(info.open) do
		UIController.Row(body, 10 + i, l.leader .. "'s raid", ("%d/%d players"):format(l.count, Cfg.MaxPlayers), "JOIN", C.Primary, true, function()
			Net.invoke("RaidJoin", l.id)
			Raid.Render()
		end)
	end
	UIController.Row(body, 99, "Refresh", "Update lobby list", "REFRESH", C.PanelLight, true, Raid.Render)
end

local function renderShop()
	UIController.List(body)
	info = Net.invoke("RaidInfo")
	if not info then
		return
	end
	UIController.Row(body, 0, ("Raid Tokens: %d"):format(info.tokens), "Earn tokens by clearing raid waves", "", C.Panel, false, function() end, nil, "cur_raid")
	for i, it in ipairs(info.shop) do
		local owned = it.kind == "title" and info.owned[it.id]
		local equipped = owned and info.title == it.title
		UIController.Row(body, i, it.name, it.desc, if equipped then "EQUIPPED" elseif owned then "EQUIP" else ("%d TOKENS"):format(it.cost), C.Gold,
			not equipped and (owned or info.tokens &gt;= it.cost), function()
				Net.invoke("RaidBuy", it.id)
				Raid.Render()
			end, nil, "cur_raid")
	end
end

function Raid.Render()
	if not body then
		return
	end
	W.clear(body)
	if tab == "LOBBY" then
		renderLobby()
	else
		renderShop()
	end
end

local function refreshHud()
	if not state then
		return
	end
	local left = math.max(0, state.endsAt - Workspace:GetServerTimeNow())
	waveL.Text = ("WAVE %d/%d%s"):format(state.wave, state.waves, if state.boss then "  BOSS" else "")
	enemyL.Text = ("Enemies left: %d"):format(math.max(0, state.total - state.killed))
	timeL.Text = ("%d:%02d"):format(left // 60, left % 60)
	barFill.Size = UDim2.fromScale(math.clamp((state.wave - 1 + state.killed / math.max(1, state.total)) / state.waves, 0, 1), 1)
end

local function endScreen(r)
	local box, close = W.modal(UIController.Gui(), if r.won then "RAID CLEARED!" else "RAID FAILED", if r.won then C.Primary else C.Danger)
	local rw = r.rewards
	local lines = { ("Waves cleared: %d/%d"):format(r.cleared, r.waves) }
	if rw then
		table.insert(lines, ("Coins %s   Gems %d   Raid Tokens %d"):format(W.short(rw.coins), rw.gems, rw.tokens))
		local mats = {}
		for id, n in pairs(rw.mats) do
			if n &gt; 0 then
				table.insert(mats, ("%s x%d"):format(id:gsub("_", " "), n))
			end
		end
		table.insert(lines, table.concat(mats, ", "))
		if rw.daily then
			table.insert(lines, "Daily first-clear bonus included!")
		end
	end
	for i, t in ipairs(lines) do
		UI.label(t, if i == 1 then 30 else 20, { Position = UDim2.fromOffset(10, 70 + (i - 1) * 50), Size = UDim2.new(1, -20, 0, 40), TextColor3 = if i == 1 then C.Gold else C.Text, Parent = box })
	end
	UI.button("OK", C.Primary, close, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -20), Size = UDim2.fromOffset(200, 54), Parent = box })
end

function Raid.Init()
	local gui = UIController.Gui()
	local win, b = UIController.MakeWindow("Raid", "CO-OP RAID", C.Danger)
	body = b
	local select = W.tabs(win, b, { "LOBBY", "SHOP" }, function(name)
		tab = name
		Raid.Render()
	end)
	UIController.AddMenuButton(12, "RAID", Color3.fromRGB(255, 120, 40), "Raid").Activated:Connect(function()
		task.defer(Raid.Render)
	end)

	hud = UI.panel({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 100), Size = UDim2.fromOffset(440, 84), BackgroundColor3 = C.Bg, Visible = false, Parent = gui })
	waveL = UI.label("", 24, { Position = UDim2.fromOffset(10, 4), Size = UDim2.new(0.6, 0, 0, 30), TextXAlignment = Enum.TextXAlignment.Left, Parent = hud })
	timeL = UI.label("", 24, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 4), Size = UDim2.fromOffset(100, 30), TextXAlignment = Enum.TextXAlignment.Right, Parent = hud })
	enemyL = UI.label("", 16, { Position = UDim2.fromOffset(10, 34), Size = UDim2.new(1, -20, 0, 22), TextXAlignment = Enum.TextXAlignment.Left, Parent = hud })
	local bar = UI.new("Frame", { BackgroundColor3 = C.PanelLight, Position = UDim2.new(0, 10, 1, -20), Size = UDim2.new(1, -20, 0, 10), Parent = hud }, { UI.corner(UDim.new(1, 0)) })
	barFill = UI.new("Frame", { BackgroundColor3 = C.Primary, Size = UDim2.fromScale(0, 1), Parent = bar }, { UI.corner(UDim.new(1, 0)) })
	banner = UI.label("", 56, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.3), Size = UDim2.fromOffset(700, 80), TextColor3 = C.Gold, Visible = false, Parent = gui })

	Net.listen("RaidState", function(s)
		state = s
		hud.Visible = s ~= nil
		if s and s.banner then
			banner.Text = if s.wave == s.waves then "FINAL WAVE - RAID BOSS!" elseif s.boss then ("WAVE %d - MINI-BOSS!"):format(s.wave) else ("WAVE %d"):format(s.wave)
			banner.Visible = true
			task.delay(2.5, function()
				banner.Visible = false
			end)
		end
		refreshHud()
	end)
	Net.listen("RaidLobby", function()
		if UIController.IsOpen("Raid") then
			Raid.Render()
		end
	end)
	Net.listen("RaidEnd", function(r)
		state = nil
		hud.Visible = false
		endScreen(r)
	end)
	task.spawn(function()
		while true do -- lint-ok (task.wait)
			task.wait(0.25)
			if state then
				refreshHud()
			end
		end
	end)
	select("LOBBY")
end

return Raid
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000005C"><Properties><string name="Name">StationController</string><ProtectedString name="Source">-- Routes hub ProximityPrompts (attribute "Panel", set by StationService) to the right UI.
local ProximityPromptService = game:GetService("ProximityPromptService")

local UIController = require(script.Parent.UIController)
local MG = require(script.Parent.MinigameController)
local Forge = require(script.Parent.ForgeController)
local Inv = require(script.Parent.InventoryController)
local Arena = require(script.Parent.ArenaController)
local Clan = require(script.Parent.ClanController)

local Station = {}

function Station.Init()
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		local panel = prompt:GetAttribute("Panel")
		if type(panel) ~= "string" then
			return
		end
		local game_ = panel:match("^Minigame:(%w+)$")
		if game_ then
			MG.Play(game_)
			return
		end
		UIController.Open(panel)
		if panel == "Forge" then
			Forge.Render()
		elseif panel == "Rebirth" then
			task.spawn(Inv.DrawRebirth)
		elseif panel == "Arena" then
			task.spawn(Arena.Render)
		elseif panel == "Clan" then
			task.spawn(Clan.Render)
		end
	end)
end

return Station
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000005D"><Properties><string name="Name">TradeController</string><ProtectedString name="Source">-- Trading UI: player list -&gt; request, invite popup, trade window (pick ≤ 8 items, see partner's
-- offer live, READY both -&gt; 3 s countdown -&gt; done). Plus the event banner (2x weekend etc.).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Theme = require(Shared.Theme)
local Net = require(Shared.Net)
local Guns = require(Shared.Config.Guns)
local Pets = require(Shared.Config.Pets)
local UI = require(script.Parent.Parent.UIKit)
local W = require(script.Parent.Parent.Widgets)
local State = require(script.Parent.Parent.ClientState)
local UIController = require(script.Parent.UIController)

local C = Theme.Colors
local Trade = {}
local GLYPH = { pistol = "🔫", smg = "🔫", shotgun = "🔫", rifle = "🔫", blaster = "✦", railgun = "⚡", helmet = "⛑", vest = "🦺", boots = "👢" }

local function describe(it): (string, string, number)
	if it.kind == "pet" then
		local def = Pets.Pets[it.id]
		local lvl = ({ [0] = "", [1] = "Golden ", [2] = "Rainbow " })[it.lvl or 0] or ""
		return "🐾", lvl .. (def and def.name or it.id), math.min(5, (def and def.rarity or 1) + (it.lvl or 0))
	end
	local name = if it.kind == "gun" then Guns.Types[it.id].name else Guns.Armor[it.id].name
	return GLYPH[it.id] or "★", ("%s %s T%d"):format(Guns.Rarities[it.rarity].name, name, it.tier), it.rarity
end

local box, close, mineGrid, theirGrid, pickGrid, status, readyBtn
local selected: { string } = {}
local myReady = false

local function isEquipped(uid: string): boolean
	local e = State.Inv.equipped
	return e.gun == uid or e.helmet == uid or e.vest == uid or e.boots == uid or table.find(e.pets, uid) ~= nil
end

local function renderPicker()
	if not pickGrid then
		return
	end
	W.clear(pickGrid)
	W.grid(pickGrid, Vector2.new(96, 110))
	local i = 0
	for uid, it in pairs(State.Inv.items) do
		if not isEquipped(uid) then
			i += 1
			local glyph, name, rarity = describe(it)
			local on = table.find(selected, uid) ~= nil
			W.card(pickGrid, i, rarity, glyph, name, "", if on then "✔" else "+", function()
				local idx = table.find(selected, uid)
				if idx then
					table.remove(selected, idx)
				elseif #selected &lt; 8 then
					table.insert(selected, uid)
				end
				Net.send("TradeSetOffer", selected)
				renderPicker()
			end, if on then "IN" else nil)
		end
	end
end

local function renderList(grid: ScrollingFrame, list)
	W.clear(grid)
	W.grid(grid, Vector2.new(96, 96))
	for i, e in ipairs(list) do
		local glyph, name, rarity = describe(e.item)
		W.card(grid, i, rarity, glyph, name, "")
	end
end

local function scroll(parent: Instance, pos: UDim2, size: UDim2): ScrollingFrame
	return UI.new("ScrollingFrame", { BackgroundColor3 = C.Bg, BackgroundTransparency = 0.3, BorderSizePixel = 0, Position = pos, Size = size,
		ScrollBarThickness = 5, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Parent = parent }, { UI.corner() })
end

local function openWindow(partner: string)
	if box then
		return
	end
	selected, myReady = {}, false
	box, close = W.modal(UIController.Gui(), "TRADE with " .. partner, C.Gold)
	box.Size = UDim2.fromOffset(820, 520)
	UI.label("YOUR OFFER", 16, { Position = UDim2.fromOffset(16, 58), Size = UDim2.fromOffset(250, 20), Parent = box })
	mineGrid = scroll(box, UDim2.fromOffset(16, 80), UDim2.fromOffset(250, 160))
	UI.label("THEIR OFFER", 16, { Position = UDim2.fromOffset(280, 58), Size = UDim2.fromOffset(250, 20), Parent = box })
	theirGrid = scroll(box, UDim2.fromOffset(280, 80), UDim2.fromOffset(250, 160))
	UI.label("PICK YOUR ITEMS (max 8)", 16, { Position = UDim2.fromOffset(16, 248), Size = UDim2.fromOffset(514, 20), Parent = box })
	pickGrid = scroll(box, UDim2.fromOffset(16, 270), UDim2.fromOffset(514, 236))
	status = UI.label("", 18, { Position = UDim2.fromOffset(548, 80), Size = UDim2.fromOffset(256, 90), TextColor3 = C.TextDim, Parent = box })
	readyBtn = UI.button("READY", C.Primary, function()
		myReady = not myReady
		Net.send("TradeReady", myReady)
	end, { Position = UDim2.fromOffset(560, 300), Size = UDim2.fromOffset(230, 70), Parent = box })
	UI.button("CANCEL", C.Danger, function()
		Net.send("TradeCancel")
	end, { Position = UDim2.fromOffset(560, 390), Size = UDim2.fromOffset(230, 56), Parent = box })
	renderPicker()
end

local function shutdown(reason: string)
	if close then
		close()
	end
	box, close, mineGrid, theirGrid, pickGrid = nil, nil, nil, nil, nil
	UIController.Toast(reason, if reason:find("complete") then "success" else "info")
end

local function eventBanner()
	local gui = UIController.Gui()
	local holder = UI.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 196), Size = UDim2.fromOffset(240, 200), Parent = gui })
	UI.new("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Right, Parent = holder })
	local events = {}
	Net.listen("EventState", function(list)
		events = list or {}
		W.clear(holder)
		UI.new("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Right, Parent = holder })
		for i, e in ipairs(events) do
			local p = UI.panel({ LayoutOrder = i, Name = "E" .. i, Size = UDim2.fromOffset(240, 40), BackgroundColor3 = e.color, Parent = holder })
			UI.label("🎉 " .. e.name, 15, { Name = "L", Size = UDim2.fromScale(1, 1), Parent = p })
		end
	end)
	task.spawn(function()
		while true do -- lint-ok (task.wait)
			task.wait(1)
			local now = os.time()
			for i, e in ipairs(events) do
				local p = holder:FindFirstChild("E" .. i)
				local l = p and p:FindFirstChild("L") :: TextLabel?
				if l then
					local left = math.max(0, e.endsAt - now)
					l.Text = ("🎉 %s  %02d:%02d:%02d"):format(e.name, left // 3600, (left % 3600) // 60, left % 60)
				end
			end
		end
	end)
end

function Trade.Init()
	local _, body = UIController.MakeWindow("Trade", "TRADE", C.Gold)
	UIController.List(body)
	local function render()
		UIController.Clear(body)
		UIController.Row(body, 0, "Safe trading", "Both players must press READY, then a 3-second countdown. Any change cancels the countdown.", "", C.Panel, false, function() end)
		local i = 0
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= Players.LocalPlayer then
				i += 1
				UIController.Row(body, i, p.DisplayName, "@" .. p.Name, "REQUEST", C.Gold, true, function()
					Net.send("TradeRequest", p.UserId)
				end)
			end
		end
		if i == 0 then
			UIController.Row(body, 1, "No other players here", "Invite a friend to trade!", "", C.Panel, false, function() end)
		end
	end
	UIController.AddMenuButton(16, "TRADE", C.Gold, "Trade").Activated:Connect(function()
		task.defer(render)
	end)

	Net.listen("TradeInvite", function(inv)
		local b, cl = W.modal(UIController.Gui(), "TRADE REQUEST", C.Gold)
		UI.label(inv.from .. " wants to trade with you", 24, { Position = UDim2.fromOffset(20, 130), Size = UDim2.new(1, -40, 0, 60), Parent = b })
		UI.button("ACCEPT", C.Primary, function()
			Net.send("TradeAccept", inv.fromId)
			cl()
		end, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(0.5, -8, 1, -20), Size = UDim2.fromOffset(170, 54), Parent = b })
		UI.button("DECLINE", C.PanelLight, cl, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0.5, 8, 1, -20), Size = UDim2.fromOffset(170, 54), Parent = b })
		task.delay(30, function()
			if b.Parent then
				cl()
			end
		end)
	end)
	Net.listen("TradeState", function(st)
		UIController.Close("Trade")
		openWindow(st.partner)
		renderList(mineGrid, st.mine)
		renderList(theirGrid, st.theirs)
		myReady = st.myReady
		readyBtn.Label.Text = if st.myReady then "UNREADY" else "READY"
		local cd = st.confirmAt and math.max(0, math.ceil(st.confirmAt - Workspace:GetServerTimeNow()))
		status.Text = ("You: %s\nThem: %s%s"):format(if st.myReady then "READY ✔" else "not ready", if st.theirReady then "READY ✔" else "not ready",
			if cd then ("\n\nTrading in %d...  (change = cancel)"):format(cd) else "")
		status.TextColor3 = if cd then C.Gold else C.TextDim
	end)
	Net.listen("TradeClosed", shutdown)
	State.InvChanged:Connect(function()
		if box then
			renderPicker()
		end
	end)
	eventBanner()
end

return Trade
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000005E"><Properties><string name="Name">UIController</string><ProtectedString name="Source">-- Builds the whole HUD + menus in code: currency bar, side menu, Shop (passes + products),
-- Rewards (daily + playtime), Quests, Settings, toasts. Mobile-safe via UIScale on viewport.
local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Theme = require(Shared.Theme)
local Net = require(Shared.Net)
local GamePasses = require(Shared.Config.GamePasses)
local Products = require(Shared.Config.Products)
local Economy = require(Shared.Config.Economy)
local Settings = require(Shared.Config.Settings)
local UI = require(script.Parent.Parent.UIKit)

local C = Theme.Colors
local ROBUX = utf8.char(0xE002) -- renders as the Robux icon in Roblox fonts
local player = Players.LocalPlayer
local UIController = { State = { currencies = {}, passes = {}, settings = {} } }

local gui, panels, currencyLabels = nil, {}, {}
local menuButtons, badgeSetters, badgeCounts = {}, {}, {}
local menuToggle, menuToggleBadge, setMenuOpen

-- window name -&gt; { image key (Config/UiImages), fallback glyph, short title, tooltip text }
local META = {
	Shop = { "menu_shop", "🛒", "SHOP", "Shop - passes, gem packs and boosts" },
	Rewards = { "menu_rewards", "🎁", "REWARDS", "Rewards - daily gift and playtime prizes" },
	Quests = { "menu_quests", "📜", "QUESTS", "Daily quests" },
	Minigames = { "menu_games", "🎮", "GAMES", "Training games - earn Power fast" },
	Forge = { "menu_forge", "🔨", "FORGE", "Forge - craft guns and armor" },
	Inventory = { "menu_bag", "🎒", "BAG", "Bag - guns, armor, materials, index" },
	Pets = { "menu_pets", "🐾", "PETS", "Pets - hatch, fuse and equip" },
	Arena = { "menu_pvp", "⚔", "PVP", "PvP arena and tournaments" },
	Rebirth = { "menu_rebirth", "🔄", "REBIRTH", "Rebirth - reset for a permanent boost" },
	Clan = { "menu_clan", "🛡", "CLAN", "Clans and clan wars" },
	Gems = { "menu_gems", "💎", "GEMS", "Gem shop" },
	Raid = { "menu_raid", "💀", "RAID", "Co-op raid vs a boss" },
	Season = { "menu_pass", "🎫", "PASS", "Season pass - claim tier rewards" },
	Achievements = { "menu_goals", "🏆", "GOALS", "Goals, titles and story" },
	Spin = { "menu_spin", "🎡", "SPIN", "Daily spin wheel" },
	Settings = { "menu_settings", "⚙", "SETTINGS", "Settings" },
	Codes = { "menu_rewards", "🎟", "CODES", "Redeem codes" },
}
UIController.Meta = META
local shownCoins = {}

local function sorted(tbl)
	local list = {}
	for k, v in pairs(tbl) do
		table.insert(list, { key = k, def = v })
	end
	table.sort(list, function(a, b)
		return (a.def.order or 99) &lt; (b.def.order or 99)
	end)
	return list
end

local function rewardText(reward)
	local parts = {}
	for cur, n in pairs(reward) do
		table.insert(parts, UI.formatNumber(n) .. " " .. cur)
	end
	return table.concat(parts, " + ")
end

---------------------------------------------------------------- toasts
local toastHolder
function UIController.Toast(text: string, kind: string?)
	local color = if kind == "success" then C.Primary elseif kind == "error" then C.Danger else C.PanelLight
	local t = UI.panel({ Size = UDim2.fromOffset(360, 48), BackgroundColor3 = color, Parent = toastHolder }, {
		UI.label(text, 20, { Size = UDim2.fromScale(1, 1) }),
	})
	UI.pop(t, true)
	task.delay(2.6, function()
		UI.pop(t, false)
		task.wait(0.2)
		t:Destroy()
	end)
end

---------------------------------------------------------------- panels
local function makeWindow(name: string, title: string, accent: Color3)
	local win = UI.panel({
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(640, 420),
		Visible = false,
		Parent = gui,
	})
	UI.gradient(C.Panel, C.Bg).Parent = win
	UI.skinPanel(win, "panel_bg")
	-- consistent layout: icon + title header, close button top-right
	local header = UI.panel({ Name = "Header", Size = UDim2.new(1, 0, 0, 56), BackgroundColor3 = accent, Parent = win }, {
		UI.label(title, 30, { Size = UDim2.fromScale(1, 1) }),
	})
	local meta = META[name]
	if meta and UI.hasImage(meta[1]) then
		local ic = UI.image(meta[1], meta[2], accent, 46)
		ic.Position = UDim2.fromOffset(8, 5)
		ic.ZIndex = 3
		ic.Parent = header
	end
	local closeBtn = UI.button("X", C.Danger, function()
		UI.pop(win, false)
	end, { Name = "Close", Size = UDim2.fromOffset(48, 48), Position = UDim2.new(1, -52, 0, 4), ZIndex = 3, Parent = header })
	closeBtn.Label.ZIndex = 4
	local body = UI.new("ScrollingFrame", {
		Name = "Body",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(12, 68),
		Size = UDim2.new(1, -24, 1, -80),
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = win,
	})
	panels[name] = win
	return win, body
end

local function toggle(name: string)
	for n, p in pairs(panels) do
		if n ~= name and p.Visible then
			UI.pop(p, false)
		end
	end
	local p = panels[name]
	UI.pop(p, not p.Visible)
	if UI.isTouch() and setMenuOpen then
		setMenuOpen(false) -- phones: give the window the whole screen
	end
end

local function buyPass(key, def)
	if def.id == 0 then
		if RunService:IsStudio() then
			Net.send("StudioTestBuy", "pass", key)
		else
			UIController.Toast("Coming soon!", "info")
		end
		return
	end
	MarketplaceService:PromptGamePassPurchase(player, def.id)
end

local function buyProduct(key, def)
	if def.id == 0 then
		if RunService:IsStudio() then
			Net.send("StudioTestBuy", "product", key)
		else
			UIController.Toast("Coming soon!", "info")
		end
		return
	end
	MarketplaceService:PromptProductPurchase(player, def.id)
end

local shopBody
local function buildShop()
	local win, body = makeWindow("Shop", "SHOP", C.Accent)
	shopBody = body
	if UI.hasImage("banner_shop") then -- banner on top, cards below
		UI.new("ImageLabel", { Name = "Banner", Image = UI.imageId("banner_shop") :: string, ScaleType = Enum.ScaleType.Crop, BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 62), Size = UDim2.new(1, -24, 0, 96), Parent = win }, { UI.corner() })
		body.Position = UDim2.fromOffset(12, 166)
		body.Size = UDim2.new(1, -24, 1, -178)
	end
	UI.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(190, 250),
		CellPadding = UDim2.fromOffset(12, 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = body,
	})
end

local function renderShop()
	for _, ch in ipairs(shopBody:GetChildren()) do
		if ch:IsA("GuiObject") then
			ch:Destroy()
		end
	end
	local order = 0
	local function card(title, desc, priceText, color, image, glyph, owned, onBuy, tag, imgKey)
		order += 1
		local c = UI.panel({ LayoutOrder = order, BackgroundColor3 = C.PanelLight, Parent = shopBody })
		UI.gradient(color:Lerp(C.PanelLight, 0.55), C.Panel).Parent = c
		local ic = if image and image ~= "" and image ~= "rbxassetid://0" then UI.icon(image, glyph, color, 84) else UI.image(imgKey, glyph, color, 84)
		ic.AnchorPoint = Vector2.new(0.5, 0)
		ic.Position = UDim2.new(0.5, 0, 0, 10)
		ic.Parent = c
		UI.label(title, 22, { Position = UDim2.fromOffset(0, 98), Parent = c })
		UI.label(desc, 14, {
			Font = Theme.FontBody,
			TextColor3 = C.TextDim,
			Position = UDim2.fromOffset(8, 126),
			Size = UDim2.new(1, -16, 0, 60),
			TextYAlignment = Enum.TextYAlignment.Top,
			Parent = c,
		})
		if tag then
			UI.panel({ Size = UDim2.fromOffset(96, 24), Position = UDim2.fromOffset(-6, -8), BackgroundColor3 = C.Danger, Rotation = -8, Parent = c }, {
				UI.label(tag, 14, { Size = UDim2.fromScale(1, 1) }),
			})
		end
		local btn = UI.button(owned and "OWNED" or priceText, owned and C.PanelLight or C.Robux, function()
			if not owned then
				onBuy()
			end
		end, { Size = UDim2.new(1, -20, 0, 44), Position = UDim2.new(0, 10, 1, -54), Parent = c })
		btn.Active = not owned
	end
	for _, e in ipairs(sorted(GamePasses)) do
		local owned = table.find(UIController.State.passes, e.key) ~= nil
		card(e.def.name, e.def.desc, ROBUX .. " " .. e.def.price, e.def.color, e.def.icon, "⭐", owned, function()
			buyPass(e.key, e.def)
		end, nil, "menu_pass")
	end
	for _, e in ipairs(sorted(Products)) do
		local cur = next(e.def.grant or {}) or "Coins"
		local col = Economy.Currencies[cur] and Economy.Currencies[cur].color or C.Accent
		card(e.def.name, "Instant delivery. Buy as many as you like!", ROBUX .. " " .. e.def.price, col, e.def.icon, cur == "Gems" and "💎" or "🪙", false, function()
			buyProduct(e.key, e.def)
		end, e.def.tag, if cur == "Gems" then "cur_gems" else "cur_coins")
	end
end

local rewardsBody, questsBody
local function list(body)
	UI.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = body })
end

-- iconKey (optional, Config/UiImages key) adds a portrait on the left; skipped until that image is uploaded.
local function row(body, order, title, sub, btnText, btnColor, enabled, onClick, progress, iconKey)
	local r = UI.panel({ LayoutOrder = order, Size = UDim2.new(1, -8, 0, 72), BackgroundColor3 = C.PanelLight, Parent = body })
	local x = 14
	if UI.hasImage(iconKey) then
		local ic = UI.image(iconKey, "", C.Primary, 52)
		ic.Position = UDim2.fromOffset(8, 10)
		ic.Parent = r
		x = 68
	end
	UI.label(title, 20, { Position = UDim2.fromOffset(x, 8), Size = UDim2.new(1, -176 - x, 0, 26), TextXAlignment = Enum.TextXAlignment.Left, Parent = r })
	UI.label(sub, 15, { Font = Theme.FontBody, TextColor3 = C.TextDim, Position = UDim2.fromOffset(x, 38), Size = UDim2.new(1, -176 - x, 0, 22), TextXAlignment = Enum.TextXAlignment.Left, Parent = r })
	if progress then
		local bar = UI.new("Frame", { BackgroundColor3 = C.Bg, Position = UDim2.new(0, x, 1, -12), Size = UDim2.new(1, -186 - x, 0, 6), Parent = r }, { UI.corner(UDim.new(1, 0)) })
		UI.new("Frame", { BackgroundColor3 = C.Primary, Size = UDim2.fromScale(math.clamp(progress, 0, 1), 1), Parent = bar }, { UI.corner(UDim.new(1, 0)) })
	end
	local b = UI.button(btnText, enabled and btnColor or C.Panel, function()
		if enabled then
			onClick()
		end
	end, { Size = UDim2.fromOffset(160, 50), Position = UDim2.new(1, -170, 0.5, -25), Parent = r })
	b.Active = enabled
end

local function clear(body)
	for _, ch in ipairs(body:GetChildren()) do
		if ch:IsA("GuiObject") then
			ch:Destroy()
		end
	end
end

function UIController.RenderRewards(state)
	clear(rewardsBody)
	local d = state.daily
	local function curIcon(reward)
		return if reward and reward.Gems then "cur_gems" else "cur_coins"
	end
	local ready = if d.canClaim then 1 else 0
	row(rewardsBody, 0, "Daily Reward — Day " .. (d.streak + 1), rewardText(d.rewards[d.nextIndex]), d.canClaim and "CLAIM" or "TOMORROW", C.Primary, d.canClaim, function()
		Net.send("ClaimDaily")
	end, nil, "menu_rewards")
	for i, p in ipairs(state.playtime) do
		local label = p.claimed and "CLAIMED" or (p.ready and "CLAIM" or (p.minutes .. " MIN"))
		row(rewardsBody, i, "Play " .. p.minutes .. " minutes", rewardText(p.reward), label, C.Accent, p.ready and not p.claimed, function()
			Net.send("ClaimPlaytime", i)
		end, state.sessionMinutes / p.minutes, curIcon(p.reward))
		if p.ready and not p.claimed then
			ready += 1
		end
	end
	UIController.SetBadge("Rewards", ready)
end

function UIController.RenderQuests(quests)
	clear(questsBody)
	local claimable = 0
	for i, q in ipairs(quests) do
		local done = q.progress &gt;= q.goal
		if done and not q.claimed then
			claimable += 1
		end
		row(questsBody, i, q.text, ("%d / %d  •  %s"):format(q.progress, q.goal, rewardText(q.reward)), q.claimed and "DONE" or (done and "CLAIM" or "IN PROGRESS"), C.Primary, done and not q.claimed, function()
			Net.send("ClaimQuest", i)
		end, q.progress / q.goal, if q.reward and q.reward.Gems then "cur_gems" else "menu_quests")
	end
	UIController.SetBadge("Quests", claimable)
end

local settingsBody
local function renderSettings()
	clear(settingsBody)
	local names = { { "music", "Music" }, { "sfx", "Sound Effects" }, { "lowFx", "Low Graphics Mode (less lag)" } }
	for i, pair in ipairs(names) do
		local key, title = pair[1], pair[2]
		local on = UIController.State.settings[key] == true
		row(settingsBody, i, title, on and "ON" or "OFF", on and "TURN OFF" or "TURN ON", on and C.Danger or C.Primary, true, function()
			UIController.State.settings[key] = not on
			Net.send("SetSetting", key, not on)
			renderSettings()
			UIController.SettingsChanged(UIController.State.settings)
		end, nil, "menu_settings")
	end
end
UIController.SettingsChanged = function(_) end -- overwritten by Main

---------------------------------------------------------------- public helpers for genre controllers
local menuFrame
-- Icon-first menu tile: image (or code-drawn glyph) + small label, tooltip on PC, notification dot.
function UIController.AddMenuButton(order: number, text: string, color: Color3, windowName: string)
	local meta = META[windowName] or { "", "★", text, text }
	local b = UI.button("", color:Lerp(C.Bg, 0.6), function()
		toggle(windowName)
	end, { LayoutOrder = order, Size = UDim2.fromOffset(84, 64), Skin = false, Parent = menuFrame })
	b.Label.Text = text
	b.Label.TextSize = 12
	b.Label.Size = UDim2.new(1, 0, 0, 16)
	b.Label.Position = UDim2.new(0, 0, 1, -18)
	local ic = UI.image(meta[1], meta[2], color, 40)
	ic.AnchorPoint = Vector2.new(0.5, 0)
	ic.Position = UDim2.new(0.5, 0, 0, 3)
	ic.Parent = b
	UI.tooltip(b, meta[4])
	menuButtons[windowName] = b
	badgeSetters[windowName] = UI.badge(b)
	if badgeCounts[windowName] then
		badgeSetters[windowName](badgeCounts[windowName])
	end
	return b
end
-- red dot on a menu icon (n &gt; 0 shows it; 2..9 shows the number). Also lights the MENU toggle while collapsed.
function UIController.SetBadge(windowName: string, n: number)
	badgeCounts[windowName] = n
	local set = badgeSetters[windowName]
	if set then
		set(n)
	end
	if menuToggleBadge then
		local total = 0
		for _, v in pairs(badgeCounts) do
			total += v
		end
		menuToggleBadge(total)
	end
end
function UIController.GetMenuButton(windowName: string): GuiButton?
	return menuButtons[windowName]
end
function UIController.SetMenuOpen(open: boolean)
	if setMenuOpen then
		setMenuOpen(open)
	end
end
UIController.MakeWindow = makeWindow
UIController.Toggle = toggle
UIController.Row = row
UIController.Clear = clear
UIController.List = list
function UIController.Open(name: string)
	local p = panels[name]
	if p and not p.Visible then
		toggle(name)
	end
end
function UIController.Close(name: string)
	local p = panels[name]
	if p and p.Visible then
		UI.pop(p, false)
	end
end
function UIController.IsOpen(name: string): boolean
	return panels[name] ~= nil and panels[name].Visible
end
function UIController.Gui(): ScreenGui
	return gui
end

---------------------------------------------------------------- HUD
local function currencyPill(name: string, def, order: number, parent)
	local pill = UI.panel({ LayoutOrder = order, Size = UDim2.fromOffset(190, 46), BackgroundColor3 = C.Bg, Parent = parent })
	local ic = UI.image(if name == "Gems" then "cur_gems" else "cur_coins", name == "Gems" and "💎" or "🪙", def.color, 40)
	ic.Position = UDim2.fromOffset(3, 3)
	ic.Parent = pill
	currencyLabels[name] = UI.label("0", 24, { Position = UDim2.fromOffset(48, 0), Size = UDim2.new(1, -56, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, Parent = pill })
	shownCoins[name] = 0
end

local function animateCurrency(name: string, target: number)
	local label = currencyLabels[name]
	if not label then
		return
	end
	local from = shownCoins[name] or 0
	shownCoins[name] = target
	if from == target then
		label.Text = UI.formatNumber(target)
		return
	end
	local nv = Instance.new("NumberValue")
	nv.Value = from
	nv.Changed:Connect(function(v)
		label.Text = UI.formatNumber(v)
	end)
	local t = TweenService:Create(nv, TweenInfo.new(0.5, Enum.EasingStyle.Quad), { Value = target })
	t.Completed:Once(function()
		nv:Destroy()
		label.Text = UI.formatNumber(target)
	end)
	t:Play()
	local pill = label.Parent
	local s = pill:FindFirstChildOfClass("UIScale") or UI.new("UIScale", { Parent = pill })
	s.Scale = 1.12
	TweenService:Create(s, Theme.Tween, { Scale = 1 }):Play()
end

function UIController.Apply(state)
	UIController.State = state
	for name, v in pairs(state.currencies or {}) do
		animateCurrency(name, v)
	end
	if shopBody then
		renderShop()
	end
	if settingsBody then
		renderSettings()
	end
end

function UIController.Init()
	gui = UI.new("ScreenGui", {
		Name = "GameUI",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	-- responsive scale: design at 1280x720, scale down on phones
	local scale = UI.new("UIScale", { Parent = gui })
	local function rescale()
		local vp = workspace.CurrentCamera.ViewportSize
		scale.Scale = math.clamp(math.min(vp.X / 1280, vp.Y / 720) * 1.1, 0.55, 1.25)
	end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	rescale()

	-- currency bar (top-left)
	local bar = UI.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 12), Size = UDim2.fromOffset(400, 46), Parent = gui })
	UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = bar })
	local i = 0
	for _, e in ipairs(sorted(Economy.Currencies)) do
		i += 1
		currencyPill(e.key, e.def, i, bar)
	end

	-- side menu (left): MENU toggle + 2-column grid of icon tiles; collapsed by default on phones
	local holder = UI.new("Frame", { Name = "MenuHolder", BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 64), Size = UDim2.fromOffset(176, 40), Parent = gui })
	menuToggle = UI.button("MENU", C.PanelLight, function()
		setMenuOpen(not menuFrame.Visible)
	end, { Size = UDim2.fromOffset(176, 40), Skin = false, Parent = holder })
	menuToggle.Label.TextSize = 18
	menuToggleBadge = UI.badge(menuToggle)
	local menu = UI.new("Frame", { Name = "Menu", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 46), Size = UDim2.fromOffset(176, 560), Parent = holder })
	UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(84, 64), CellPadding = UDim2.fromOffset(8, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = menu })
	menuFrame = menu
	setMenuOpen = function(open: boolean)
		menu.Visible = open
		menuToggle.Label.Text = if open then "MENU  ▲" else "MENU  ▼"
	end
	UIController.AddMenuButton(1, "SHOP", C.Accent, "Shop")
	UIController.AddMenuButton(2, "REWARDS", C.Primary, "Rewards")
	UIController.AddMenuButton(3, "QUESTS", Color3.fromRGB(90, 150, 255), "Quests")
	UIController.AddMenuButton(99, "SETTINGS", C.PanelLight, "Settings")
	setMenuOpen(not UI.isTouch())

	buildShop()
	local _, rb = makeWindow("Rewards", "REWARDS", C.Primary)
	rewardsBody = rb
	list(rb)
	local _, qb = makeWindow("Quests", "DAILY QUESTS", Color3.fromRGB(90, 150, 255))
	questsBody = qb
	list(qb)
	local _, sb = makeWindow("Settings", "SETTINGS", C.PanelLight)
	settingsBody = sb
	list(sb)

	toastHolder = UI.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 70), Size = UDim2.fromOffset(360, 300), Parent = gui })
	UI.new("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center, Parent = toastHolder })

	-- loading/title art (only once art/ui/loading.png is uploaded)
	if UI.hasImage("loading") then
		local bg = UI.new("ImageLabel", { Image = UI.imageId("loading") :: string, ScaleType = Enum.ScaleType.Crop, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 0, Parent = gui })
		task.delay(2.5, function()
			TweenService:Create(bg, TweenInfo.new(0.7), { ImageTransparency = 1 }):Play()
			task.wait(0.8)
			bg:Destroy()
		end)
	end

	-- title splash
	local splash = UI.label(Settings.GameName, 64, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.3), Size = UDim2.fromOffset(900, 90), TextColor3 = C.Accent, Parent = gui })
	task.delay(2.5, function()
		TweenService:Create(splash, TweenInfo.new(0.6), { TextTransparency = 1 }):Play()
		TweenService:Create(splash:FindFirstChildOfClass("UIStroke"), TweenInfo.new(0.6), { Transparency = 1 }):Play()
		task.wait(0.7)
		splash:Destroy()
	end)
	renderShop()
end

return UIController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000005F"><Properties><string name="Name">VfxController</string><ProtectedString name="Source">-- Smooth, cheap client VFX + audio. Everything is pooled or short-lived, respects Low Graphics.
--   Bullet (travelling tracer)  MuzzleFlash (light + sparks)  HitSpark  DamageNumber (pop + crit)
--   HitFlash (shared Highlight)  DeathBurst (smoke + ring)  LootOrbs (fly to player)  Shake  Sound
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Sounds = require(Shared.Config.Sounds)
local Theme = require(Shared.Theme)
local UI = require(script.Parent.Parent.UIKit)
local Effects = require(script.Parent.EffectsController)

local Vfx = {}
local player = Players.LocalPlayer
local terrain = Workspace.Terrain
local emitters: { [string]: ParticleEmitter } = {}
local anchorAtt: Attachment
local highlight: Highlight
local shakeUntil, shakePower = 0, 0

local function fx(): boolean
	return not Effects.LowFx
end

local function newPart(): Part
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	p.Material = Enum.Material.Neon
	return p
end

-- extra: optional { pitch = multiplier, volume = multiplier, delay = seconds } for layered weapon audio
function Vfx.Sound(def, pos: Vector3?, extra: { pitch: number?, volume: number?, delay: number? }?)
	if not def or not def.id then
		return
	end
	if extra and extra.delay and extra.delay &gt; 0 then
		local d = extra.delay
		extra.delay = nil
		task.delay(d, function()
			Vfx.Sound(def, pos, extra)
		end)
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = def.id
	s.Volume = (def.volume or 0.5) * (extra and extra.volume or 1)
	s.PlaybackSpeed = (def.pitch or 1) * (extra and extra.pitch or 1) * (0.94 + math.random() * 0.12) -- slight variation = less robotic
	if pos then
		local a = Instance.new("Attachment")
		a.WorldPosition = pos
		a.Parent = terrain
		s.RollOffMaxDistance = Sounds.MaxDistance
		s.Parent = a
		s:Play()
		task.delay(3, function()
			a:Destroy()
		end)
	else
		s.Parent = SoundService
		s:Play()
		task.delay(3, function()
			s:Destroy()
		end)
	end
end

local function emitAt(kind: string, pos: Vector3, n: number, color: Color3?)
	local e = emitters[kind]
	if not e or not fx() then
		return
	end
	anchorAtt.WorldPosition = pos
	e.Color = ColorSequence.new(color or Color3.fromRGB(255, 230, 150), Color3.new(1, 1, 1))
	e:Emit(n)
end

-- travelling bolt (fast) + fading streak: reads as a real bullet but costs 2 parts for 0.1 s
-- speed = studs/s (travel time scales with distance; default 450)
function Vfx.Bullet(from: Vector3, to: Vector3, color: Color3, onArrive: (() -&gt; ())?, speed: number?)
	local dist = (to - from).Magnitude
	if dist &lt; 0.5 then
		return
	end
	local travel = math.clamp(dist / (speed or 450), 0.03, 0.4)
	local bolt = newPart()
	bolt.Color = color
	bolt.Size = Vector3.new(0.14, 0.14, math.min(5, dist))
	bolt.CFrame = CFrame.lookAt(from, to)
	bolt.Parent = Workspace
	TweenService:Create(bolt, TweenInfo.new(travel, Enum.EasingStyle.Linear), { CFrame = CFrame.lookAt(to, to + (to - from)) }):Play()
	if fx() then
		local streak = newPart()
		streak.Color = color
		streak.Transparency = 0.55
		streak.Size = Vector3.new(0.06, 0.06, dist)
		streak.CFrame = CFrame.lookAt(from, to) * CFrame.new(0, 0, -dist / 2)
		streak.Parent = Workspace
		TweenService:Create(streak, TweenInfo.new(0.16), { Transparency = 1 }):Play()
		task.delay(0.18, function()
			streak:Destroy()
		end)
	end
	task.delay(travel, function()
		bolt:Destroy()
		if onArrive then
			onArrive()
		end
	end)
end

function Vfx.MuzzleFlash(pos: Vector3, color: Color3)
	if not fx() then
		return
	end
	local a = Instance.new("Attachment")
	a.WorldPosition = pos
	a.Parent = terrain
	local light = Instance.new("PointLight")
	light.Color = color
	light.Brightness = 5
	light.Range = 9
	light.Shadows = false
	light.Parent = a
	TweenService:Create(light, TweenInfo.new(0.08), { Brightness = 0 }):Play()
	task.delay(0.1, function()
		a:Destroy()
	end)
	local f = newPart()
	f.Shape = Enum.PartType.Ball
	f.Color = Color3.new(1, 0.95, 0.8):Lerp(color, 0.4)
	f.Size = Vector3.one * 0.9
	f.Position = pos
	f.Parent = Workspace
	TweenService:Create(f, TweenInfo.new(0.07, Enum.EasingStyle.Quad), { Size = Vector3.one * 0.15, Transparency = 1 }):Play()
	task.delay(0.08, function()
		f:Destroy()
	end)
end

function Vfx.HitSpark(pos: Vector3, crit: boolean?)
	emitAt("spark", pos, if crit then 14 else 6, if crit then Theme.Colors.Gold else nil)
end

function Vfx.DamageNumber(pos: Vector3, dmg: number, crit: boolean?, short: (number) -&gt; string)
	local a = Instance.new("Attachment")
	a.WorldPosition = pos + Vector3.new((math.random() - 0.5) * 2, 1.5, (math.random() - 0.5) * 2)
	a.Parent = terrain
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(if crit then 200 else 140, if crit then 46 else 32)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 120
	bb.LightInfluence = 0
	local l = UI.label(if crit then ("CRIT " .. short(dmg) .. "!") else short(dmg), if crit then 34 else 22,
		{ Size = UDim2.fromScale(1, 1), TextColor3 = if crit then Theme.Colors.Gold else Color3.new(1, 1, 1), Parent = bb })
	local sc = UI.new("UIScale", { Scale = 0.4, Parent = l })
	bb.Parent = a
	TweenService:Create(sc, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = if crit then 1.25 else 1 }):Play()
	TweenService:Create(bb, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { StudsOffset = Vector3.new(0, 3, 0) }):Play()
	task.delay(0.45, function()
		TweenService:Create(l, TweenInfo.new(0.35), { TextTransparency = 1 }):Play()
		local st = l:FindFirstChildOfClass("UIStroke")
		if st then
			TweenService:Create(st, TweenInfo.new(0.35), { Transparency = 1 }):Play()
		end
	end)
	task.delay(0.85, function()
		a:Destroy()
	end)
end

function Vfx.HitFlash(model: Model?)
	if not model or not fx() then
		return
	end
	highlight.Adornee = model
	highlight.FillTransparency = 0.25
	highlight.OutlineTransparency = 0.2
	TweenService:Create(highlight, TweenInfo.new(0.14), { FillTransparency = 1, OutlineTransparency = 1 }):Play()
end

function Vfx.DeathBurst(pos: Vector3, size: number, color: Color3)
	emitAt("smoke", pos, math.clamp(math.floor(size * 2), 4, 14), color)
	emitAt("spark", pos, 12, color)
	Vfx.Sound(Sounds.Death, pos)
	if not fx() then
		return
	end
	local ring = newPart()
	ring.Shape = Enum.PartType.Cylinder
	ring.Color = color
	ring.Transparency = 0.3
	ring.Size = Vector3.new(0.2, size, size)
	ring.CFrame = CFrame.new(pos.X, 0.25, pos.Z) * CFrame.Angles(0, 0, math.rad(90))
	ring.Parent = Workspace
	TweenService:Create(ring, TweenInfo.new(0.4, Enum.EasingStyle.Quad), { Size = Vector3.new(0.2, size * 3, size * 3), Transparency = 1 }):Play()
	task.delay(0.42, function()
		ring:Destroy()
	end)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root and (root.Position - pos).Magnitude &lt; 40 then
		Vfx.Shake(math.clamp(size / 20, 0.05, 0.4), 0.15)
	end
end

-- glowing orbs pop out, then home onto the player (classic satisfying pickup)
function Vfx.LootOrbs(pos: Vector3, count: number, color: Color3)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	count = if fx() then math.clamp(count, 1, 8) else 1
	for i = 1, count do
		local o = newPart()
		o.Shape = Enum.PartType.Ball
		o.Color = color
		o.Size = Vector3.one * 0.7
		o.Position = pos + Vector3.new(0, 1, 0)
		o.Parent = Workspace
		local up = pos + Vector3.new((math.random() - 0.5) * 6, 3 + math.random() * 3, (math.random() - 0.5) * 6)
		local t1 = TweenService:Create(o, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = up })
		t1:Play()
		task.delay(0.25 + i * 0.04, function()
			local start, t0 = o.Position, os.clock()
			local conn
			conn = RunService.RenderStepped:Connect(function() -- lint-ok (short-lived, ≤ 0.4 s)
				local a = math.clamp((os.clock() - t0) / 0.35, 0, 1)
				local target = root.Position
				o.Position = start:Lerp(target, a * a)
				o.Size = Vector3.one * (0.7 - 0.4 * a)
				if a &gt;= 1 then
					conn:Disconnect()
					o:Destroy()
					if i == 1 then
						Vfx.Sound(Sounds.Loot)
					end
				end
			end)
		end)
	end
end

function Vfx.Shake(power: number, duration: number)
	shakePower = math.max(shakePower, power)
	shakeUntil = math.max(shakeUntil, os.clock() + duration)
end

function Vfx.Init()
	anchorAtt = Instance.new("Attachment")
	anchorAtt.Parent = terrain

	local spark = Instance.new("ParticleEmitter")
	spark.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	spark.LightEmission = 1
	spark.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
	spark.Speed = NumberRange.new(10, 22)
	spark.SpreadAngle = Vector2.new(180, 180)
	spark.Lifetime = NumberRange.new(0.15, 0.35)
	spark.Drag = 6
	spark.Rate = 0
	spark.Parent = anchorAtt
	emitters.spark = spark

	local smoke = Instance.new("ParticleEmitter")
	smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
	smoke.LightEmission = 0.3
	smoke.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
	smoke.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.5), NumberSequenceKeypoint.new(1, 4) })
	smoke.Speed = NumberRange.new(3, 8)
	smoke.SpreadAngle = Vector2.new(180, 180)
	smoke.Lifetime = NumberRange.new(0.5, 0.9)
	smoke.Drag = 3
	smoke.RotSpeed = NumberRange.new(-90, 90)
	smoke.Rate = 0
	smoke.Parent = anchorAtt
	emitters.smoke = smoke

	highlight = Instance.new("Highlight")
	highlight.FillColor = Color3.new(1, 1, 1)
	highlight.OutlineColor = Color3.new(1, 1, 1)
	highlight.FillTransparency = 1
	highlight.OutlineTransparency = 1
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Parent = Workspace

	-- camera shake through Humanoid.CameraOffset (smooth, never fights the camera script)
	RunService.RenderStepped:Connect(function() -- lint-ok (one cheap offset update)
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if not hum then
			return
		end
		local t = os.clock()
		if t &lt; shakeUntil and fx() then
			local p = shakePower
			hum.CameraOffset = Vector3.new((math.random() - 0.5) * p, (math.random() - 0.5) * p, 0)
		elseif hum.CameraOffset ~= Vector3.zero then
			hum.CameraOffset = hum.CameraOffset:Lerp(Vector3.zero, 0.5)
			if hum.CameraOffset.Magnitude &lt; 0.01 then
				hum.CameraOffset = Vector3.zero
				shakePower = 0
			end
		end
	end)
end

return Vfx
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000060"><Properties><string name="Name">WeaponAnim</string><ProtectedString name="Source">-- Code-driven first-person weapon animation (client only, no animation assets).
-- Works with the code-built handle and with Blender guns whose child meshes are named Body/Magazine/Slide/Trigger.
-- The whole gun is moved by editing the character's RightGrip weld C1 (handle-local offsets, so it is independent of the
-- model's axis); Slide / Magazine / Trigger are moved by swapping their WeldConstraint for a client Weld.
--   Update(dt, s)  per frame: s = { ads = 0..1, speed = studs/s, reload = 0..1 | nil, bloom = 0..1 }
--   Kick(strength)  recoil kickback + slide cycle on a shot     Equip()  raise animation
--   PollPhase()  returns 1 (mag out) / 2 (mag in) / 3 (bolt) once each time a reload phase is reached
local Players = game:GetService("Players")

local WeaponAnim = {}

local player = Players.LocalPlayer

type Moving = { part: BasePart, weld: Weld, base: CFrame }
local tool: Tool? = nil
local grip: Weld? = nil
local baseC1 = CFrame.identity
local moving: { [string]: Moving } = {}
local fwd = Vector3.new(0, 0, -1)
local side = Vector3.xAxis
local kick, kickV = 0, 0 -- kickback spring (0 = rest)
local slide = 0 -- slide travel 0..1, snaps back
local equipAt = 0
local phase = 0 -- reload phases already announced (1 mag out, 2 mag in, 3 bolt)
local t0 = os.clock()

local function release()
	if grip and grip.Parent then
		grip.C1 = baseC1
	end
	for _, m in pairs(moving) do
		if m.weld.Parent then
			m.weld.C0 = m.base
		end
		m.part.Transparency = 0
	end
	tool, grip, moving = nil, nil, {}
end

local function dominantAxis(v: Vector3): Vector3
	local ax, ay, az = math.abs(v.X), math.abs(v.Y), math.abs(v.Z)
	if ax &gt;= ay and ax &gt;= az then
		return Vector3.new(math.sign(v.X), 0, 0)
	elseif az &gt;= ay then
		return Vector3.new(0, 0, math.sign(v.Z))
	end
	return Vector3.new(0, math.sign(v.Y), 0)
end

-- take over a named child part: disable its static joints and replace them with a client weld we can offset
local function adopt(handle: BasePart, name: string)
	local part = handle:FindFirstChild(name, true)
	if not part or not part:IsA("BasePart") or part == handle then
		return
	end
	local rel = handle.CFrame:ToObjectSpace(part.CFrame)
	for _, d in ipairs(handle:GetDescendants()) do
		if d:IsA("WeldConstraint") and (d.Part0 == part or d.Part1 == part) then
			d.Enabled = false
		elseif (d:IsA("Weld") or d:IsA("Motor6D")) and (d.Part0 == part or d.Part1 == part) and d.Name ~= "RightGrip" then
			d.Enabled = false
		end
	end
	local w = Instance.new("Weld")
	w.Name = "AnimWeld"
	w.Part0, w.Part1 = handle, part
	w.C0 = rel
	w.Parent = part
	part.Massless = true
	moving[name] = { part = part, weld = w, base = rel }
end

local function setup(t: Tool)
	release()
	local char = player.Character
	local handle = t:FindFirstChild("Handle") :: BasePart?
	local g = char and char:FindFirstChild("RightGrip", true)
	if not handle or not g or not g:IsA("JointInstance") then
		return
	end
	tool, grip = t, g :: any
	baseC1 = (g :: any).C1
	local muz = handle:FindFirstChild("Muzzle") :: Attachment?
	fwd = if muz and muz.Position.Magnitude &gt; 0.1 then dominantAxis(muz.Position) else Vector3.new(0, 0, -1)
	side = fwd:Cross(Vector3.yAxis)
	if side.Magnitude &lt; 0.1 then
		side = Vector3.xAxis
	end
	side = side.Unit
	for _, n in ipairs({ "Slide", "Magazine", "Trigger" }) do
		adopt(handle, n)
	end
	equipAt = os.clock()
	phase = 0
end

function WeaponAnim.Equip()
	equipAt = os.clock()
end

-- shot: kick the grip back and cycle the slide/bolt
function WeaponAnim.Kick(strength: number)
	kickV += strength * 9
	slide = 1
end

local function smooth(a: number): number
	return a * a * (3 - 2 * a)
end

function WeaponAnim.Update(dt: number, s: { ads: number, speed: number, reload: number?, bloom: number })
	local char = player.Character
	local t = char and char:FindFirstChildOfClass("Tool")
	if t and not t:GetAttribute("Gun") then
		t = nil
	end
	if t ~= tool then
		if t then
			setup(t)
		else
			release()
		end
	end
	if not tool or not grip or not grip.Parent then
		return
	end
	local now = os.clock()
	local damp = 1 - s.ads * 0.7 -- idle motion shrinks when aiming

	-- spring for the kickback (underdamped a little = punchy recovery)
	local k, c = 220, 24
	kickV += (-k * kick - c * kickV) * dt
	kick += kickV * dt
	slide = math.max(0, slide - dt * 9)

	-- idle sway + breathing, walk bob
	local tt = now - t0
	local moveF = math.clamp(s.speed / 16, 0, 1.4)
	local bobT = tt * (6 + moveF * 3)
	local px = math.sin(tt * 0.9) * 0.012 * damp + math.sin(bobT) * 0.03 * moveF * damp
	local py = math.sin(tt * 1.6) * 0.01 * damp - math.abs(math.cos(bobT)) * 0.04 * moveF * damp
	local roll = math.sin(bobT) * 0.012 * moveF * damp
	local pitch = math.sin(tt * 1.6) * 0.004 * damp

	-- equip raise
	local eq = smooth(math.clamp((now - equipAt) / 0.4, 0, 1))
	pitch += -(1 - eq) * 0.9
	py -= (1 - eq) * 0.5

	-- reload: tilt the gun, mag drops out (0..0.3), stays out (..0.55), new mag slides in (..0.85), settle + rack
	local magOff, magAlpha = 0, 0
	local r = s.reload
	if r then
		local tilt = math.sin(math.clamp(r, 0, 1) * math.pi)
		pitch += -0.35 * tilt
		roll += 0.5 * tilt
		px += 0.05 * tilt
		if r &lt; 0.3 then
			magOff = smooth(r / 0.3) * 1.6
			magAlpha = smooth(r / 0.3)
		elseif r &lt; 0.55 then
			magOff, magAlpha = 1.6, 1
		elseif r &lt; 0.85 then
			local a = smooth((r - 0.55) / 0.3)
			magOff, magAlpha = 1.6 * (1 - a), 1 - math.min(1, a * 1.5)
		end
		if r &gt; 0.1 and phase &lt; 1 then
			phase = 1
		elseif r &gt; 0.6 and phase &lt; 2 then
			phase = 2
		elseif r &gt; 0.88 and phase &lt; 3 then
			phase = 3
			slide = 1
		end
	else
		phase = 0
	end

	local kb = kick * 0.12
	local off = CFrame.new(side * px + Vector3.yAxis * py - fwd * kb) * CFrame.fromAxisAngle(side, pitch + kick * 0.08)
		* CFrame.fromAxisAngle(fwd, roll)
	grip.C1 = off:Inverse() * baseC1

	local sl = moving.Slide
	if sl then
		sl.weld.C0 = CFrame.new(-fwd * 0.35 * slide) * sl.base
	end
	local tr = moving.Trigger
	if tr then
		tr.weld.C0 = CFrame.new(-fwd * 0.04 * slide) * tr.base
	end
	local mg = moving.Magazine
	if mg then
		mg.weld.C0 = CFrame.new(-Vector3.yAxis * magOff) * mg.base
		mg.part.Transparency = magAlpha
	end
end

-- progress-driven phase pulses for audio: returns the phase number if a new one was reached this frame
local announced = 0
function WeaponAnim.PollPhase(): number?
	if phase == 0 then
		announced = 0
		return nil
	end
	if phase &gt; announced then
		announced += 1
		return announced
	end
	return nil
end

return WeaponAnim
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000061"><Properties><string name="Name">WeaponFx</string><ProtectedString name="Source">-- Weapon-specific client VFX (all pooled + hard capped, off in Low Graphics):
--   ImpactDecal (dark disc on surfaces, &lt;= 30, fades in 3 s)   Shell (brass casing arc, &lt;= 20)
--   SmokePuff (muzzle smoke, &lt;= 8)   Charge (railgun muzzle charge-up glow)
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Effects = require(script.Parent.EffectsController)

local WeaponFx = {}

local MAX_DECALS, MAX_SHELLS, MAX_SMOKE = 30, 20, 8
local decals: { Part } = {}
local decalTweens: { [Part]: Tween } = {}
local decalNext = 1
local shells: { Part } = {}
local shellNext = 1
local flying: { { part: Part, vel: Vector3, spin: Vector3, born: number } } = {}
local smokeActive = 0
local conn: RBXScriptConnection? = nil

local function lowFx(): boolean
	return Effects.LowFx
end

-- dark bullet-hole disc on a surface (call with the raycast hit position + normal)
function WeaponFx.ImpactDecal(pos: Vector3, normal: Vector3)
	if lowFx() then
		return
	end
	local d = decals[decalNext]
	if not d then
		d = Instance.new("Part")
		d.Shape = Enum.PartType.Cylinder
		d.Anchored, d.CanCollide, d.CanQuery, d.CanTouch, d.CastShadow = true, false, false, false, false
		d.Material = Enum.Material.SmoothPlastic
		d.Color = Color3.fromRGB(18, 16, 18)
		d.Size = Vector3.new(0.03, 0.55, 0.55)
		decals[decalNext] = d
	end
	decalNext = decalNext % MAX_DECALS + 1
	local old = decalTweens[d]
	if old then
		old:Cancel()
	end
	d.Transparency = 0.15
	d.CFrame = CFrame.lookAt(pos + normal * 0.02, pos + normal) * CFrame.Angles(0, math.rad(90), 0)
	d.Parent = Workspace
	local tw = TweenService:Create(d, TweenInfo.new(3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Transparency = 1 })
	decalTweens[d] = tw
	tw.Completed:Connect(function(state)
		if state == Enum.PlaybackState.Completed then
			d.Parent = nil
		end
	end)
	tw:Play()
end

local function stepShells(dt: number)
	local now = os.clock()
	for i = #flying, 1, -1 do
		local s = flying[i]
		local life = now - s.born
		if life &gt; 0.9 then
			s.part.Parent = nil
			table.remove(flying, i)
		else
			s.vel += Vector3.new(0, -55 * dt, 0)
			s.part.CFrame = (s.part.CFrame + s.vel * dt) * CFrame.Angles(s.spin.X * dt, s.spin.Y * dt, s.spin.Z * dt)
			if life &gt; 0.4 then
				s.part.Transparency = math.clamp((life - 0.4) / 0.5, 0, 1)
			end
		end
	end
	if #flying == 0 and conn then
		conn:Disconnect()
		conn = nil
	end
end

-- brass casing ejected from `from`, thrown along `right` (+ up), quick arc
function WeaponFx.Shell(from: Vector3, right: Vector3, rng: Random)
	if lowFx() or #flying &gt;= MAX_SHELLS then
		return
	end
	local p = shells[shellNext]
	if not p then
		p = Instance.new("Part")
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
		p.Material = Enum.Material.Metal
		p.Color = Color3.fromRGB(214, 168, 66)
		p.Size = Vector3.new(0.09, 0.09, 0.26)
		shells[shellNext] = p
	end
	shellNext = shellNext % MAX_SHELLS + 1
	for _, f in ipairs(flying) do
		if f.part == p then
			return
		end
	end
	p.Transparency = 0
	p.CFrame = CFrame.new(from)
	p.Parent = Workspace
	table.insert(flying, {
		part = p,
		vel = right * rng:NextNumber(6, 10) + Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(5, 9), rng:NextNumber(-1, 1)),
		spin = Vector3.new(rng:NextNumber(-30, 30), rng:NextNumber(-30, 30), rng:NextNumber(-30, 30)),
		born = os.clock(),
	})
	if not conn then
		conn = RunService.Heartbeat:Connect(stepShells)
	end
end

-- small grey smoke puff drifting up from the muzzle
function WeaponFx.SmokePuff(pos: Vector3, dir: Vector3)
	if lowFx() or smokeActive &gt;= MAX_SMOKE then
		return
	end
	smokeActive += 1
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	p.Material = Enum.Material.SmoothPlastic
	p.Color = Color3.fromRGB(190, 190, 195)
	p.Transparency = 0.6
	p.Size = Vector3.one * 0.3
	p.Position = pos
	p.Parent = Workspace
	local tw = TweenService:Create(p, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.one * 1.3, Transparency = 1, Position = pos + dir * 1.2 + Vector3.new(0, 1.1, 0) })
	tw.Completed:Connect(function()
		smokeActive -= 1
		p:Destroy()
	end)
	tw:Play()
end

-- railgun charge-up: a neon orb at the muzzle that grows for `duration`; getPos keeps it on the (moving) barrel
function WeaponFx.Charge(getPos: () -&gt; Vector3?, color: Color3, duration: number)
	if lowFx() then
		return
	end
	local orb = Instance.new("Part")
	orb.Shape = Enum.PartType.Ball
	orb.Anchored, orb.CanCollide, orb.CanQuery, orb.CanTouch, orb.CastShadow = true, false, false, false, false
	orb.Material = Enum.Material.Neon
	orb.Color = color
	orb.Transparency = 0.3
	orb.Size = Vector3.one * 0.1
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 10
	light.Shadows = false
	light.Brightness = 0
	light.Parent = orb
	orb.Parent = Workspace
	local t0 = os.clock()
	local c
	c = RunService.Heartbeat:Connect(function()
		local a = (os.clock() - t0) / duration
		local pos = getPos()
		if a &gt;= 1 or not pos then
			c:Disconnect()
			orb:Destroy()
			return
		end
		orb.Position = pos
		orb.Size = Vector3.one * (0.1 + a * 0.8 + math.sin(a * 60) * 0.04)
		light.Brightness = a * 6
	end)
end

return WeaponFx
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000062"><Properties><string name="Name">ZoneLightingController</string><ProtectedString name="Source">-- Applies the current zone's lighting preset locally and shows a zone-name banner on change.
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local World = require(ReplicatedStorage.Shared.Config.World)
local Zones = require(ReplicatedStorage.Shared.Config.Zones)

local ZoneLightingController = {}

local current: string? = nil
local banner: TextLabel? = nil

local function ensure(className: string, name: string)
	local inst = Lighting:FindFirstChild(name) or Instance.new(className)
	inst.Name = name
	inst.Parent = Lighting
	return inst
end

-- Tween every numeric/Color3 prop (~1 s); set the rest (bool/enum) immediately.
local FADE = TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
local function apply(inst: Instance, props, fade: boolean)
	local tweenable = {}
	for k, v in pairs(props or {}) do
		if fade and (typeof(v) == "number" or typeof(v) == "Color3") then
			tweenable[k] = v
		else
			pcall(function()
				(inst :: any)[k] = v
			end)
		end
	end
	if next(tweenable) then
		pcall(function()
			TweenService:Create(inst, FADE, tweenable):Play()
		end)
	end
end

local function applyPreset(name: string)
	local p = World.Presets[name]
	if not p then
		return
	end
	apply(Lighting, p.Lighting, true)
	apply(ensure("Atmosphere", "Atmosphere"), p.Atmosphere, true)
	apply(ensure("BloomEffect", "Bloom"), p.Bloom, true)
	apply(ensure("ColorCorrectionEffect", "ColorCorrection"), p.ColorCorrection, true)
	local rays = ensure("SunRaysEffect", "SunRays")
	rays.Enabled = p.SunRays ~= nil
	apply(rays, p.SunRays, true)
	local dof = ensure("DepthOfFieldEffect", "DepthOfField")
	dof.Enabled = p.DepthOfField ~= nil
	apply(dof, p.DepthOfField, true)
	apply(workspace.Terrain, p.Water, true)
	if p.Sky then
		local sky = Lighting:FindFirstChildOfClass("Sky") or ensure("Sky", "Sky")
		apply(sky, p.Sky, true)
	end
end

-- ===== Map animations (server tags decor with "MapAnim" + AnimKind attributes): Spin / Pulse / Beam =====
-- Only entries within RANGE of the camera are updated; spins every frame, the rest at 10 Hz.
local TAG, RANGE = "MapAnim", 420
local anims: { [Instance]: any } = {}
local spinList: { any } = {}
local slowList: { any } = {}

local function register(inst: Instance)
	local kind = inst:GetAttribute("AnimKind")
	if typeof(kind) ~= "string" then
		return
	end
	local e: any = { inst = inst, kind = kind, speed = inst:GetAttribute("AnimSpeed") or 1, ph = inst:GetAttribute("AnimPh") or 0, lo = inst:GetAttribute("AnimLo") or 0.3, hi = inst:GetAttribute("AnimHi") or 0.8 }
	if kind == "Spin" then
		local pivot, axis = inst:GetAttribute("AnimPivot"), inst:GetAttribute("AnimAxis")
		if not inst:IsA("BasePart") or typeof(pivot) ~= "Vector3" or typeof(axis) ~= "Vector3" then
			return
		end
		e.base, e.pivot, e.axis, e.pos = inst.CFrame, pivot, axis.Unit, inst.Position
	elseif kind == "Pulse" then
		if not inst:IsA("BasePart") then
			return
		end
		e.pos = inst.Position
	elseif kind ~= "Beam" or not inst:IsA("Beam") then
		return
	end
	anims[inst] = e
end

local function startAnims()
	for _, inst in ipairs(CollectionService:GetTagged(TAG)) do
		register(inst)
	end
	CollectionService:GetInstanceAddedSignal(TAG):Connect(register)
	CollectionService:GetInstanceRemovedSignal(TAG):Connect(function(inst)
		anims[inst] = nil
	end)
	local clock, refresh, slow = 0, 1, 0
	RunService.Heartbeat:Connect(function(dt)
		clock += dt
		refresh += dt
		slow += dt
		local cam = workspace.CurrentCamera
		if not cam then
			return
		end
		if refresh &gt;= 0.5 then
			refresh = 0
			table.clear(spinList)
			table.clear(slowList)
			local cp = cam.CFrame.Position
			for inst, e in pairs(anims) do
				local pos = e.pos
				if not pos and inst:IsA("Beam") then
					local a = (inst :: Beam).Attachment0
					pos = a and a.WorldPosition
				end
				if pos and (pos - cp).Magnitude &lt; RANGE then
					table.insert(e.kind == "Spin" and spinList or slowList, e)
				end
			end
		end
		for _, e in ipairs(spinList) do
			e.inst.CFrame = CFrame.new(e.pivot) * CFrame.fromAxisAngle(e.axis, clock * e.speed) * CFrame.new(-e.pivot) * e.base
		end
		if slow &gt;= 0.1 then
			slow = 0
			for _, e in ipairs(slowList) do
				local w = 0.5 + 0.5 * math.sin(clock * e.speed + e.ph)
				if e.kind == "Pulse" then
					e.inst.Transparency = e.lo + (e.hi - e.lo) * w
				else
					local b = e.inst :: Beam
					local mid = e.lo + (e.hi - e.lo) * w
					b.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.95), NumberSequenceKeypoint.new(0.5, mid), NumberSequenceKeypoint.new(1, 0.95) })
					b.Width1 = 70 + 14 * math.sin(clock * e.speed * 0.7 + e.ph)
				end
			end
		end
	end)
end

local function getBanner(): TextLabel
	if banner and banner.Parent then
		return banner
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "ZoneBanner"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 20
	local t = Instance.new("TextLabel")
	t.AnchorPoint = Vector2.new(0.5, 0.5)
	t.Position = UDim2.fromScale(0.5, 0.22)
	t.Size = UDim2.fromScale(0.6, 0.1)
	t.BackgroundTransparency = 1
	t.Font = Enum.Font.GothamBlack
	t.TextScaled = true
	t.TextColor3 = Color3.fromRGB(255, 255, 255)
	t.TextStrokeColor3 = Color3.fromRGB(22, 20, 42)
	t.TextStrokeTransparency = 0
	t.TextTransparency = 1
	t.Parent = gui
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	banner = t
	return t
end

local function showBanner(text: string, color: Color3)
	local t = getBanner()
	t.Text = string.upper(text)
	t.TextColor3 = color
	t.TextTransparency = 1
	t.Position = UDim2.fromScale(0.5, 0.26)
	TweenService:Create(t, TweenInfo.new(0.4, Enum.EasingStyle.Back), { TextTransparency = 0, Position = UDim2.fromScale(0.5, 0.22) }):Play()
	local mine = text
	task.delay(2.4, function()
		if banner and banner.Text == string.upper(mine) then
			TweenService:Create(banner, TweenInfo.new(0.6), { TextTransparency = 1 }):Play()
		end
	end)
end

-- returns key, preset, display name, color
local function locate(pos: Vector3): (string, string, string, Color3)
	for _, z in ipairs(Zones) do
		if math.abs(pos.X - z.center.X) &lt;= z.size.X / 2 and math.abs(pos.Z - z.center.Z) &lt;= z.size.Z / 2 then
			return z.id, z.preset, z.name, z.color:Lerp(Color3.new(1, 1, 1), 0.35)
		end
	end
	local A = World.Arena
	if math.abs(pos.Z - A.Origin.Z) &lt;= A.Size / 2 + 20 and math.abs(pos.X - A.Origin.X) &lt;= A.Spacing + A.Size / 2 + 20 then
		return "arena", "NeonCity", "PvP Arena", Color3.fromRGB(255, 79, 216)
	end
	return "hub", World.Preset, "Training Hub", Color3.fromRGB(58, 216, 255)
end

function ZoneLightingController.Init()
	startAnims()
	local player = Players.LocalPlayer
	while true do -- lint-ok (task.wait)
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			local key, preset, name, color = locate(root.Position)
			if key ~= current then
				local first = current == nil
				current = key
				applyPreset(preset)
				if not first or key ~= "hub" then
					showBanner(name, color)
				end
			end
		end
		task.wait(0.5)
	end
end

return ZoneLightingController
</ProtectedString></Properties></Item></Item><Item class="LocalScript" referent="RBX00000064"><Properties><string name="Name">Main</string><ProtectedString name="Source">-- Client entry: controllers only do presentation; the server owns all game state.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Net = require(ReplicatedStorage.Shared.Net)

local Controllers = script.Parent:WaitForChild("Controllers")
local UIController = require(Controllers.UIController)
local EffectsController = require(Controllers.EffectsController)

local ZoneLightingController = require(Controllers.ZoneLightingController)
local ClientState = require(script.Parent:WaitForChild("ClientState"))
ClientState.Init()
UIController.Init()
task.spawn(ZoneLightingController.Init)
task.spawn(EffectsController.Init)

-- Gun Forge controllers (order = menu button order is set inside each)
for _, name in ipairs({ "VfxController", "HudController", "MonsterController", "GunController", "MinigameController", "ForgeController",
	"InventoryController", "PetsController", "ArenaController", "ClanController", "RaidController", "ProgressController", "TradeController", "AfkController", "StationController" }) do
	local ok, err = pcall(function()
		require(Controllers:WaitForChild(name)).Init()
	end)
	if not ok then
		warn("[Client] " .. name .. " failed:", err)
	end
end

UIController.SettingsChanged = function(settings)
	EffectsController.SetLowFx(settings.lowFx == true)
end

Net.listen("DataSync", function(state)
	UIController.Apply(state)
	EffectsController.SetLowFx(state.settings and state.settings.lowFx == true)
end)
Net.listen("Toast", UIController.Toast)
Net.listen("RewardState", UIController.RenderRewards)
Net.listen("QuestState", UIController.RenderQuests)

-- initial pull (in case DataSync fired before listeners connected)
task.spawn(function()
	local state = Net.invoke("GetData")
	if state then
		UIController.Apply(state)
	end
end)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000065"><Properties><string name="Name">ProgressUI</string><ProtectedString name="Source">-- UI helpers for ProgressController: season tier rows, spin wheel, story tracker.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Theme = require(ReplicatedStorage.Shared.Theme)
local Achievements = require(ReplicatedStorage.Shared.Config.Achievements)
local UI = require(script.Parent.UIKit)

local C = Theme.Colors
local P = {}

-- One season tier: free + premium claim buttons. st = SeasonInfo state, cfg = Config/Season
function P.tierRow(body, tier: number, st, cfg, onClaim: (number, boolean) -&gt; ())
	local reached = tier &lt;= st.tier
	local r = UI.panel({ LayoutOrder = tier, Size = UDim2.new(1, -8, 0, 84), BackgroundColor3 = reached and C.PanelLight or C.Panel, Parent = body })
	local tx = 10
	if UI.hasImage("menu_pass") then
		local ic = UI.image("menu_pass", "", C.Accent, 28)
		ic.Position = UDim2.fromOffset(8, 2)
		ic.Parent = r
		tx = 40
	end
	UI.label("TIER " .. tier, 18, { Position = UDim2.fromOffset(tx, 4), Size = UDim2.fromOffset(80, 24), TextXAlignment = Enum.TextXAlignment.Left, Parent = r })
	local function side(xs: number, name: string, reward, claimed: boolean, locked: boolean, premium: boolean)
		UI.label(name .. ": " .. Achievements.RewardText(reward), 13, { Font = Theme.FontBody, TextColor3 = premium and C.Accent or C.TextDim, Position = UDim2.new(xs, 8, 0, 28), Size = UDim2.new(0.5, -16, 0, 22), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Parent = r })
		local can = reached and not claimed and not locked
		local label = claimed and "CLAIMED" or (locked and "LOCKED" or (reached and "CLAIM" or "..."))
		local b = UI.button(label, can and (premium and C.Accent or C.Primary) or C.Panel, function()
			if can then
				onClaim(tier, premium)
			end
		end, { Size = UDim2.new(0.5, -16, 0, 28), Position = UDim2.new(xs, 8, 1, -32), Parent = r })
		b.Label.TextSize = 14
	end
	side(0, "FREE", cfg.Free[tier], st.claimed[tostring(tier)] == true, false, false)
	side(0.5, "PREMIUM", cfg.Premium[tier], st.premiumClaimed[tostring(tier)] == true, not st.premium, true)
	return r
end

-- Wheel with N segments; returns { frame, spinTo(index, done) }
function P.wheel(parent: Instance, prizes, size: number)
	local holder = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(size, size), Parent = parent })
	local wheel = UI.new("Frame", { Name = "Wheel", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.94, 0.94), BackgroundColor3 = C.Bg, Parent = holder }, { UI.corner(UDim.new(1, 0)), UI.stroke(C.Primary, 3) })
	local n = #prizes
	for i, p in ipairs(prizes) do
		local seg = UI.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1), Rotation = (i - 1) * 360 / n, Parent = wheel })
		local tile = UI.panel({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 6), Size = UDim2.fromOffset(size * 0.2, size * 0.26), BackgroundColor3 = p.color, Parent = seg })
		UI.label(p.glyph, math.floor(size * 0.11), { Size = UDim2.new(1, 0, 0.55, 0), Parent = tile })
		UI.label(p.text, 11, { Position = UDim2.fromScale(0, 0.55), Size = UDim2.fromScale(1, 0.45), Parent = tile })
	end
	UI.new("TextLabel", { Text = "▼", TextSize = 30, Font = Theme.Font, TextColor3 = C.Accent, BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, -0.04), Size = UDim2.fromOffset(34, 34), ZIndex = 3, Parent = holder })
	local spinning = false
	local function spinTo(index: number, done: () -&gt; ())
		spinning = true
		local target = math.ceil(wheel.Rotation / 360) * 360 + 360 * 5 - (index - 1) * 360 / n
		local tw = TweenService:Create(wheel, TweenInfo.new(4.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Rotation = target })
		tw.Completed:Once(function()
			spinning = false
			done()
		end)
		tw:Play()
	end
	return { frame = holder, spinTo = spinTo, busy = function() return spinning end }
end

-- compact always-visible story tracker (top-right); onClick opens STORY tab
function P.tracker(gui: Instance, onClick: () -&gt; ())
	local f = UI.panel({ Name = "StoryTracker", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 126), Size = UDim2.fromOffset(240, 64), BackgroundColor3 = C.Bg, BackgroundTransparency = 0.15, Parent = gui })
	local title = UI.label("STORY", 14, { Font = Theme.Font, TextColor3 = C.Accent, Position = UDim2.fromOffset(8, 2), Size = UDim2.new(1, -16, 0, 18), TextXAlignment = Enum.TextXAlignment.Left, Parent = f })
	local text = UI.label("", 13, { Font = Theme.FontBody, Position = UDim2.fromOffset(8, 20), Size = UDim2.new(1, -16, 0, 28), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Parent = f })
	local bar = UI.new("Frame", { BackgroundColor3 = C.Panel, Position = UDim2.new(0, 8, 1, -10), Size = UDim2.new(1, -16, 0, 6), Parent = f }, { UI.corner(UDim.new(1, 0)) })
	local fill = UI.new("Frame", { BackgroundColor3 = C.Primary, Size = UDim2.fromScale(0, 1), Parent = bar }, { UI.corner(UDim.new(1, 0)) })
	UI.new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 5, Parent = f }).Activated:Connect(onClick)
	return function(st)
		if st.finished then
			title.Text = "STORY COMPLETE"
			text.Text = "Thanks for playing, hero!"
			fill.Size = UDim2.fromScale(1, 1)
			return
		end
		title.Text = ("STORY %d/%d%s"):format(st.step, st.total, st.done and "  -  READY!" or "")
		text.Text = ("%s (%s/%s)"):format(st.text, UI.formatNumber(st.value), UI.formatNumber(st.goal))
		fill.Size = UDim2.fromScale(math.clamp(st.value / st.goal, 0, 1), 1)
		fill.BackgroundColor3 = st.done and C.Accent or C.Primary
	end
end

return P
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000066"><Properties><string name="Name">UIKit</string><ProtectedString name="Source">-- Code-drawn UI kit: every element is built from Theme tokens so the whole game can be
-- restyled from Shared/Theme.luau. Uses UICorner/UIStroke/UIGradient (no image uploads needed);
-- pass an image id to Icon() to use AI-generated / Blender-rendered art instead.
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Theme = require(ReplicatedStorage.Shared.Theme)
local Images = require(ReplicatedStorage.Shared.Config.UiImages)

local UI = {}
local C = Theme.Colors

function UI.new(className: string, props: { [string]: any }, children: { Instance }?)
	local inst = Instance.new(className)
	for k, v in pairs(props) do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	if props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

function UI.corner(radius: UDim?)
	return UI.new("UICorner", { CornerRadius = radius or Theme.Corner })
end

function UI.stroke(color: Color3?, thickness: number?)
	return UI.new("UIStroke", {
		Color = color or C.Stroke,
		Thickness = thickness or Theme.StrokeThickness,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function UI.gradient(top: Color3, bottom: Color3)
	return UI.new("UIGradient", { Color = ColorSequence.new(top, bottom), Rotation = 90 })
end

function UI.padding(px: number)
	local u = UDim.new(0, px)
	return UI.new("UIPadding", { PaddingTop = u, PaddingBottom = u, PaddingLeft = u, PaddingRight = u })
end

function UI.label(text: string, size: number, props: { [string]: any }?)
	local p = {
		Text = text,
		Font = Theme.Font,
		TextSize = size,
		TextColor3 = C.Text,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, size + 6),
		TextWrapped = true,
	}
	for k, v in pairs(props or {}) do
		p[k] = v
	end
	local l = UI.new("TextLabel", p)
	UI.new("UIStroke", { Color = C.Stroke, Thickness = 2, Parent = l }) -- text outline = readable on any bg
	return l
end

function UI.panel(props: { [string]: any }, children: { Instance }?)
	local p = { BackgroundColor3 = C.Panel, BorderSizePixel = 0 }
	for k, v in pairs(props) do
		p[k] = v
	end
	local f = UI.new("Frame", p, children)
	UI.corner().Parent = f
	UI.stroke().Parent = f
	return f
end

---------------------------------------------------------------- image system
-- Every image is looked up by key in Config/UiImages. id "rbxassetid://0" (not uploaded yet) = nil,
-- so each caller falls back to the code-drawn look and the game always works before uploads.
function UI.imageId(key: string?): string?
	local e = key and Images[key]
	if e and e.id and e.id ~= "" and e.id ~= "rbxassetid://0" then
		return e.id
	end
	return nil
end

function UI.hasImage(key: string?): boolean
	return UI.imageId(key) ~= nil
end

function UI.isTouch(): boolean
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

-- Image if uploaded, else the glossy code-drawn circle with a glyph.
function UI.image(key: string?, fallbackGlyph: string, color: Color3, size: number)
	local id = UI.imageId(key)
	if id then
		return UI.new("ImageLabel", {
			Name = "Image",
			Image = id,
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(size, size),
			ScaleType = Enum.ScaleType.Fit,
		})
	end
	return UI.icon(nil, fallbackGlyph, color, size)
end

-- 9-slice skin behind a frame's content. Returns the ImageLabel, or nil when the key has no upload yet.
function UI.skin(frame: GuiObject, key: string?, tint: Color3?): ImageLabel?
	local id = UI.imageId(key)
	if not id then
		return nil
	end
	local e = Images[key :: string]
	local props = {
		Name = "Skin",
		Image = id,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 0,
		ImageColor3 = tint or Color3.new(1, 1, 1),
		Parent = frame,
	} :: { [string]: any }
	if e.slice then
		props.ScaleType = Enum.ScaleType.Slice
		props.SliceCenter = Rect.new(e.slice[1], e.slice[2], e.slice[3], e.slice[4])
	else
		props.ScaleType = Enum.ScaleType.Stretch
	end
	return UI.new("ImageLabel", props) :: ImageLabel
end

-- which button background image fits a colour (nil = keep the code-drawn gradient)
local function buttonSkinFor(color: Color3): string?
	local h, s, v = color:ToHSV()
	if s &lt; 0.5 or v &lt; 0.6 then
		return nil
	end
	if h &gt;= 0.25 and h &lt;= 0.45 then
		return "btn_green"
	elseif h &gt;= 0.08 and h &lt;= 0.17 then
		return "btn_gold"
	elseif h &lt;= 0.03 or h &gt;= 0.96 then
		return "btn_red"
	elseif h &gt;= 0.5 and h &lt;= 0.58 then
		return "btn_blue"
	end
	return nil
end

-- Chunky "candy" button with hover/press scale animation. props.Skin = image key | false to force.
function UI.button(text: string, color: Color3, onClick: () -&gt; (), props: { [string]: any }?)
	local p = {
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.fromOffset(160, 52),
	} :: { [string]: any }
	local skinKey: any = nil
	for k, v in pairs(props or {}) do
		if k == "Skin" then
			skinKey = v
		else
			p[k] = v
		end
	end
	if UI.isTouch() then -- bigger touch targets
		local sz = p.Size :: UDim2
		p.Size = UDim2.new(sz.X.Scale, if sz.X.Scale == 0 then math.max(sz.X.Offset, 40) else sz.X.Offset, sz.Y.Scale, if sz.Y.Scale == 0 then math.max(sz.Y.Offset, 40) else sz.Y.Offset)
	end
	local b = UI.new("TextButton", p) :: TextButton
	if skinKey == nil then
		skinKey = buttonSkinFor(color)
	end
	if skinKey and UI.skin(b, skinKey) then
		b.BackgroundTransparency = 1
	else
		UI.corner().Parent = b
		UI.stroke().Parent = b
		local h, s, v = color:ToHSV()
		UI.gradient(Color3.fromHSV(h, s * 0.85, math.min(1, v * 1.15)), Color3.fromHSV(h, s, v * 0.8)).Parent = b
	end
	local scale = UI.new("UIScale", { Parent = b })
	UI.label(text, 22, { Size = UDim2.fromScale(1, 1), Name = "Label", Parent = b })

	b.MouseEnter:Connect(function()
		TweenService:Create(scale, Theme.Tween, { Scale = 1.06 }):Play()
	end)
	b.MouseLeave:Connect(function()
		TweenService:Create(scale, Theme.Tween, { Scale = 1 }):Play()
	end)
	b.MouseButton1Down:Connect(function()
		TweenService:Create(scale, Theme.TweenFast, { Scale = 0.92 }):Play()
	end)
	b.MouseButton1Up:Connect(function()
		TweenService:Create(scale, Theme.Tween, { Scale = 1.06 }):Play()
	end)
	b.Activated:Connect(onClick)
	return b
end

-- Hover tooltip (PC only; touch has none).
local tipFrame: Frame? = nil
function UI.tooltip(obj: GuiObject, text: string)
	if UI.isTouch() then
		return
	end
	local conn: RBXScriptConnection? = nil
	obj.MouseEnter:Connect(function()
		local root = obj:FindFirstAncestorOfClass("ScreenGui")
		if not root then
			return
		end
		if not tipFrame or tipFrame.Parent ~= root then
			if tipFrame then
				tipFrame:Destroy()
			end
			tipFrame = UI.panel({ Name = "Tooltip", Size = UDim2.fromOffset(200, 30), BackgroundColor3 = C.Bg, ZIndex = 60, Visible = false, Parent = root }, {
				UI.label("", 16, { Name = "T", Size = UDim2.fromScale(1, 1), ZIndex = 61 }),
			})
		end
		local tip = tipFrame :: Frame
		(tip:FindFirstChild("T") :: TextLabel).Text = text
		tip.Size = UDim2.fromOffset(math.max(80, #text * 9 + 24), 30)
		tip.Visible = true
		local sc = root:FindFirstChildOfClass("UIScale")
		local inset = game:GetService("GuiService"):GetGuiInset()
		if conn then
			conn:Disconnect()
		end
		conn = game:GetService("RunService").RenderStepped:Connect(function() -- lint-ok (only while hovering)
			local m = UserInputService:GetMouseLocation() - inset
			local k = if sc then sc.Scale else 1
			tip.Position = UDim2.fromOffset(m.X / k + 16, m.Y / k + 18)
		end)
	end)
	obj.MouseLeave:Connect(function()
		if conn then
			conn:Disconnect()
			conn = nil
		end
		if tipFrame then
			tipFrame.Visible = false
		end
	end)
end

-- Red notification dot (with optional count) pinned to a button's top-right. Returns set(n).
function UI.badge(parent: GuiObject): (number?) -&gt; ()
	local dot = UI.panel({ Name = "Dot", Size = UDim2.fromOffset(24, 24), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 4, 0, -4), BackgroundColor3 = C.Danger, Visible = false, ZIndex = 5, Parent = parent })
	UI.corner(UDim.new(1, 0)).Parent = dot
	local l = UI.label("!", 16, { Size = UDim2.fromScale(1, 1), ZIndex = 6, Parent = dot })
	local tween = TweenService:Create(dot, TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Size = UDim2.fromOffset(29, 29) })
	return function(n: number?)
		local on = n ~= nil and n &gt; 0
		dot.Visible = on
		if on then
			l.Text = if n and n &gt; 1 and n &lt; 10 then tostring(n) else "!"
			tween:Play()
		else
			tween:Cancel()
		end
	end
end

-- Tutorial hint: bobbing arrow + speech bubble + pulsing ring on a target. Returns a dismiss function.
function UI.hint(target: GuiObject, text: string, side: string?): () -&gt; ()
	local up = side == nil or side == "up"
	local right = side == "right"
	local holder = UI.new("Frame", { Name = "Hint", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 40, Parent = target })
	local ring = UI.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, 8, 1, 8), ZIndex = 40, Parent = holder }, {
		UI.corner(UDim.new(0, 18)),
		UI.new("UIStroke", { Color = C.Gold, Thickness = 4 }),
	})
	local pulse = TweenService:Create(ring, TweenInfo.new(0.55, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Size = UDim2.new(1, 22, 1, 22) })
	pulse:Play()
	local bubble = UI.panel({
		Size = UDim2.fromOffset(230, 52),
		BackgroundColor3 = C.Primary,
		AnchorPoint = if right then Vector2.new(0, 0.5) else Vector2.new(0.5, if up then 1 else 0),
		Position = if right then UDim2.new(1, 44, 0.5, 0) else UDim2.new(0.5, 0, if up then 0 else 1, if up then -40 else 40),
		ZIndex = 41,
		Parent = holder,
	})
	UI.label(text, 16, { Size = UDim2.new(1, -12, 1, 0), Position = UDim2.fromOffset(6, 0), ZIndex = 42, Parent = bubble })
	local arrow = UI.label(if right then "◀" else (if up then "▼" else "▲"), 30, {
		Size = UDim2.fromOffset(34, 34),
		TextColor3 = C.Gold,
		ZIndex = 41,
		AnchorPoint = if right then Vector2.new(0, 0.5) else Vector2.new(0.5, if up then 1 else 0),
		Position = if right then UDim2.new(1, 8, 0.5, 0) else UDim2.new(0.5, 0, if up then 0 else 1, if up then -4 else 4),
		Parent = holder,
	})
	local bob = TweenService:Create(arrow, TweenInfo.new(0.45, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
		Position = if right then UDim2.new(1, 18, 0.5, 0) else UDim2.new(0.5, 0, if up then 0 else 1, if up then -14 else 14),
	})
	bob:Play()
	return function()
		pulse:Cancel()
		bob:Cancel()
		holder:Destroy()
	end
end

-- Image icon if an asset id is set, otherwise a code-drawn glossy circle with an emoji/glyph.
function UI.icon(image: string?, glyph: string, color: Color3, size: number)
	if image and image ~= "" and image ~= "rbxassetid://0" then
		return UI.new("ImageLabel", {
			Image = image,
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(size, size),
			ScaleType = Enum.ScaleType.Fit,
		})
	end
	local f = UI.new("Frame", { Size = UDim2.fromOffset(size, size), BackgroundColor3 = Color3.new(1, 1, 1) })
	UI.corner(UDim.new(1, 0)).Parent = f
	UI.stroke(C.Stroke, 2).Parent = f
	local h, s, v = color:ToHSV()
	UI.gradient(Color3.fromHSV(h, s * 0.6, 1), Color3.fromHSV(h, s, v * 0.75)).Parent = f
	UI.label(glyph, math.floor(size * 0.55), { Size = UDim2.fromScale(1, 1), Parent = f })
	return f
end

-- Replace a panel's code-drawn look (fill, gradient, stroke) with a 9-slice image when uploaded.
function UI.skinPanel(frame: GuiObject, key: string?): boolean
	if not UI.skin(frame, key) then
		return false
	end
	frame.BackgroundTransparency = 1
	for _, ch in ipairs(frame:GetChildren()) do
		if ch:IsA("UIGradient") or ch:IsA("UIStroke") or ch:IsA("UICorner") then
			ch:Destroy()
		end
	end
	return true
end

-- Open/close with pop animation
function UI.pop(gui: GuiObject, open: boolean)
	local scale = gui:FindFirstChildOfClass("UIScale") or UI.new("UIScale", { Parent = gui })
	if open then
		gui.Visible = true
		scale.Scale = 0.6
		TweenService:Create(scale, Theme.Tween, { Scale = 1 }):Play()
	else
		local t = TweenService:Create(scale, Theme.TweenFast, { Scale = 0.6 })
		t.Completed:Once(function()
			gui.Visible = false
		end)
		t:Play()
	end
end

function UI.formatNumber(n: number): string
	n = math.floor(n)
	if n &gt;= 1e9 then
		return ("%.1fB"):format(n / 1e9)
	elseif n &gt;= 1e6 then
		return ("%.1fM"):format(n / 1e6)
	elseif n &gt;= 1e4 then
		return ("%.1fK"):format(n / 1e3)
	end
	local s = tostring(n)
	return (s:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", ""))
end

return UI
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000067"><Properties><string name="Name">Widgets</string><ProtectedString name="Source">-- Higher-level UI pieces built on UIKit (tabs, item cards, popups, number formatting helpers).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Theme = require(ReplicatedStorage.Shared.Theme)
local Guns = require(ReplicatedStorage.Shared.Config.Guns)
local UI = require(script.Parent.UIKit)

local W = {}
local C = Theme.Colors

function W.short(n: number): string
	n = math.floor(n)
	for _, u in ipairs({ { 1e15, "Q" }, { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" } }) do
		if n &gt;= u[1] then
			return (("%.2f%s"):format(n / u[1], u[2]):gsub("%.?0+([A-Z])", "%1"))
		end
	end
	return tostring(n)
end

-- icon shown on a tab chip (key into Config/UiImages); chips fall back to text only
local TAB_ICON = {
	GUNS = "gun_pistol", ARMOR = "armor_vest", MATS = "mat_scrap_metal", INDEX = "menu_goals", ENCHANT = "menu_forge",
	FUSE = "menu_pets", ["MY PETS"] = "pet_gooey", LOBBY = "menu_raid", SHOP = "menu_shop", QUEUE = "menu_pvp",
	TOURNAMENT = "menu_pass", ["MY CLAN"] = "menu_clan", WAR = "menu_pvp", ACHIEVEMENTS = "menu_goals",
	TITLES = "menu_pass", STORY = "menu_quests",
}
W.TabIcon = TAB_ICON

-- Tab bar inside a window as icon chips (icon + label; selected chip is lit). onSelect(name) re-renders the body.
function W.tabs(win: Frame, body: ScrollingFrame, names: { string }, onSelect: (string) -&gt; ())
	local bar = UI.new("Frame", { Name = "Tabs", BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 64), Size = UDim2.new(1, -24, 0, 40), Parent = win })
	UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), Parent = bar })
	body.Position = UDim2.fromOffset(12, 112)
	body.Size = UDim2.new(1, -24, 1, -124)
	local buttons = {}
	local function select(name)
		for n, b in pairs(buttons) do
			local on = n == name
			b.BackgroundTransparency = if on then 0 else 0.55
			b.BackgroundColor3 = if on then C.Primary else C.PanelLight
		end
		onSelect(name)
	end
	for _, n in ipairs(names) do
		local chip = UI.button(n, C.PanelLight, function()
			select(n)
		end, { Size = UDim2.fromOffset(math.floor(600 / #names) - 6, 40), Parent = bar, Skin = false })
		chip.Label.TextSize = 16
		local key = TAB_ICON[n]
		if UI.hasImage(key) then
			local ic = UI.image(key, "", C.Primary, 30)
			ic.AnchorPoint = Vector2.new(0, 0.5)
			ic.Position = UDim2.new(0, 6, 0.5, 0)
			ic.ZIndex = 2
			ic.Parent = chip
			chip.Label.Position = UDim2.fromOffset(18, 0)
		end
		buttons[n] = chip
	end
	return select
end

function W.grid(body: ScrollingFrame, cell: Vector2)
	UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(cell.X, cell.Y), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = body })
end

function W.clear(body: Instance)
	for _, ch in ipairs(body:GetChildren()) do
		if ch:IsA("GuiObject") or ch:IsA("UIGridLayout") or ch:IsA("UIListLayout") then
			ch:Destroy()
		end
	end
end

-- item card: portrait (image key or glyph fallback) on a rarity frame + title/sub + optional button.
-- imageKey e.g. "gun_pistol" / "mat_slime_goo" / "pet_gooey" (Config/UiImages).
function W.card(parent: Instance, order: number, rarity: number, glyph: string, title: string, sub: string, btnText: string?, onClick: (() -&gt; ())?, badge: string?, imageKey: string?)
	local col = Theme.Rarity and Theme.Rarity[rarity] or Guns.Rarities[rarity].color
	local c = UI.panel({ LayoutOrder = order, BackgroundColor3 = C.PanelLight, Parent = parent })
	UI.gradient(col:Lerp(C.Panel, 0.35), C.Panel).Parent = c
	UI.skinPanel(c, "card_frame_" .. math.clamp(rarity, 1, 5)) -- rarity frame art replaces the gradient
	local ic = UI.image(imageKey, glyph, col, 64)
	ic.AnchorPoint = Vector2.new(0.5, 0)
	ic.Position = UDim2.new(0.5, 0, 0, 8)
	ic.Parent = c
	UI.label(title, 15, { Position = UDim2.fromOffset(4, 74), Size = UDim2.new(1, -8, 0, 18), Parent = c })
	UI.label(sub, 12, { Font = Theme.FontBody, TextColor3 = C.TextDim, Position = UDim2.fromOffset(4, 94), Size = UDim2.new(1, -8, 0, 30), TextYAlignment = Enum.TextYAlignment.Top, Parent = c })
	if badge then
		UI.panel({ Size = UDim2.fromOffset(58, 20), Position = UDim2.fromOffset(-4, -4), BackgroundColor3 = C.Primary, ZIndex = 3, Parent = c }, {
			UI.label(badge, 12, { Size = UDim2.fromScale(1, 1), ZIndex = 4 }),
		})
	end
	if btnText and onClick then
		local b = UI.button(btnText, C.Primary, onClick, { Size = UDim2.new(1, -12, 0, 32), Position = UDim2.new(0, 6, 1, -38), Parent = c })
		b.Label.TextSize = 14
	end
	return c
end

-- Fullscreen modal used by minigames / forge / hatch. Returns frame + close fn.
function W.modal(gui: ScreenGui, title: string, accent: Color3)
	local dim = UI.new("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, Size = UDim2.fromScale(1, 1), ZIndex = 20, Parent = gui })
	local box = UI.panel({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(620, 420), ZIndex = 21, Parent = dim })
	UI.gradient(C.Panel, C.Bg).Parent = box
	UI.skinPanel(box, "panel_bg")
	UI.panel({ Size = UDim2.new(1, 0, 0, 52), BackgroundColor3 = accent, Parent = box }, { UI.label(title, 28, { Size = UDim2.fromScale(1, 1) }) })
	UI.pop(box, true)
	local function close()
		dim:Destroy()
	end
	return box, close
end

function W.flash(gui: Instance, color: Color3)
	local f = UI.new("Frame", { BackgroundColor3 = color, BackgroundTransparency = 0.3, Size = UDim2.fromScale(1, 1), ZIndex = 50, Parent = gui })
	TweenService:Create(f, TweenInfo.new(0.5), { BackgroundTransparency = 1 }):Play()
	task.delay(0.6, function()
		f:Destroy()
	end)
end

return W
