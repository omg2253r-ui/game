}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">Minigames</string><ProtectedString name="Source">-- Training-break minigames. reward = TrainingSeconds of your current training gain * score fraction, + coins.
-- Server caps scores (MaxScore) and requires MinSeconds elapsed.
return {
	TargetRush = { name = "Target Rush", desc = "Tap the targets!", duration = 20, maxScore = 30, minSeconds = 18,
		trainingSeconds = 60, coins = 50, cooldown = 120, color = Color3.fromRGB(255, 79, 106) },
	ReloadRhythm = { name = "Reload Rhythm", desc = "Tap when the bar hits the gold zone.", duration = 15, maxScore = 10, minSeconds = 8,
		trainingSeconds = 60, coins = 60, cooldown = 120, color = Color3.fromRGB(58, 216, 255) },
	LuckyCrate = { name = "Lucky Crate", desc = "Pick 1 of 3 crates.", duration = 5, maxScore = 1, minSeconds = 1,
		trainingSeconds = 0, coins = 0, cooldown = 300, color = Color3.fromRGB(255, 201, 53),
		-- weighted prizes: training seconds or coins or a material from your best zone
		prizes = { { w = 45, trainingSeconds = 90 }, { w = 35, coins = 300 }, { w = 15, material = true, amount = 3 }, { w = 5, gems = 5 } } },
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000C"><Properties><string name="Name">Monsters</string><ProtectedString name="Source">-- hp/damage per zone tier. drops: { material, chance 0..1, min, max }. Power reward = small bonus per kill.
-- style/color/size = fallback part-built look (Assets.Monsters.&lt;id&gt; model replaces it when present).
local M = {}
local function mon(id, name, tier, hp, dmg, coins, power, drops, color, size, boss)
	M[id] = { name = name, tier = tier, hp = hp, damage = dmg, coins = coins, power = power, drops = drops,
		color = color, size = size, boss = boss or false, speed = boss and 8 or 12, respawn = boss and 180 or 4 }
end
local C = Color3.fromRGB
-- Tier 1 Slime Meadow
mon("slime", "Slime", 1, 30, 4, 3, 2, { { "slime_goo", 0.8, 1, 2 }, { "slime_core", 0.08, 1, 1 } }, C(120, 230, 90), 3)
mon("big_slime", "Big Slime", 1, 70, 7, 6, 4, { { "slime_goo", 0.9, 2, 3 }, { "slime_core", 0.15, 1, 1 } }, C(90, 200, 160), 4.5)
mon("bouncer", "Bouncer", 1, 50, 6, 5, 3, { { "slime_goo", 0.8, 1, 3 }, { "slime_core", 0.12, 1, 1 } }, C(255, 159, 200), 3.5)
mon("slime_king", "Slime King", 1, 1200, 15, 120, 60, { { "slime_core", 1, 3, 5 }, { "king_jelly", 0.35, 1, 1 } }, C(255, 220, 60), 10, true)
-- Tier 2 Scrap Desert
mon("scrap_bot", "Scrap Bot", 2, 600, 25, 25, 15, { { "scrap_metal", 0.8, 1, 2 }, { "gear_core", 0.08, 1, 1 } }, C(190, 160, 120), 4)
mon("sand_crab", "Sand Crab", 2, 900, 30, 35, 20, { { "scrap_metal", 0.9, 2, 3 }, { "gear_core", 0.12, 1, 1 } }, C(235, 180, 90), 4)
mon("rust_drone", "Rust Drone", 2, 750, 28, 30, 18, { { "scrap_metal", 0.8, 1, 3 }, { "gear_core", 0.1, 1, 1 } }, C(200, 110, 70), 3.5)
mon("sand_titan", "Sand Titan", 2, 24000, 80, 900, 400, { { "gear_core", 1, 3, 5 }, { "sand_titan_shard", 0.35, 1, 1 } }, C(255, 150, 60), 12, true)
-- Tier 3 Frost Cavern
mon("snowling", "Snowling", 3, 3200, 90, 120, 70, { { "frost_shard", 0.8, 1, 2 }, { "ice_core", 0.08, 1, 1 } }, C(235, 245, 255), 3.5)
mon("ice_bat", "Ice Bat", 3, 2600, 80, 110, 60, { { "frost_shard", 0.85, 1, 3 }, { "ice_core", 0.1, 1, 1 } }, C(140, 200, 255), 3)
mon("frost_golem", "Frost Golem", 3, 5200, 120, 180, 100, { { "frost_shard", 0.9, 2, 3 }, { "ice_core", 0.15, 1, 1 } }, C(90, 170, 255), 6)
mon("yeti_lord", "Yeti Lord", 3, 130000, 300, 6000, 2500, { { "ice_core", 1, 3, 5 }, { "yeti_fang", 0.35, 1, 1 } }, C(220, 240, 255), 13, true)
-- Tier 4 Magma Foundry
mon("ember", "Ember", 4, 16000, 400, 600, 350, { { "magma_rock", 0.8, 1, 2 }, { "flame_core", 0.08, 1, 1 } }, C(255, 140, 50), 3.5)
mon("lava_hound", "Lava Hound", 4, 22000, 500, 800, 450, { { "magma_rock", 0.9, 1, 3 }, { "flame_core", 0.1, 1, 1 } }, C(255, 80, 40), 4.5)
mon("forge_brute", "Forge Brute", 4, 30000, 650, 1100, 600, { { "magma_rock", 0.9, 2, 3 }, { "flame_core", 0.15, 1, 1 } }, C(120, 60, 50), 6.5)
mon("magma_overseer", "Magma Overseer", 4, 800000, 1500, 40000, 15000, { { "flame_core", 1, 3, 5 }, { "forge_heart", 0.25, 1, 1 } }, C(255, 70, 40), 14, true)
-- Tier 5 Neon Void
mon("void_wisp", "Void Wisp", 5, 90000, 1800, 3500, 2000, { { "void_dust", 0.85, 1, 2 }, { "void_core", 0.08, 1, 1 } }, C(181, 108, 255), 3)
mon("glitch", "Glitch", 5, 120000, 2200, 4500, 2600, { { "void_dust", 0.9, 1, 3 }, { "void_core", 0.1, 1, 1 } }, C(58, 216, 255), 4)
mon("void_knight", "Void Knight", 5, 170000, 3000, 6500, 3500, { { "void_dust", 0.9, 2, 3 }, { "void_core", 0.15, 1, 1 } }, C(255, 79, 216), 6.5)
mon("void_emperor", "Void Emperor", 5, 4500000, 8000, 250000, 90000, { { "void_core", 1, 3, 5 }, { "void_crown", 0.25, 1, 1 } }, C(255, 79, 216), 16, true)
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000D"><Properties><string name="Name">Pets</string><ProtectedString name="Source">-- Pets from the Fusion Altar. mult.power = training multiplier, mult.coins = coin multiplier (additive per pet).
-- Odds are ALWAYS shown in UI (paid-random-item policy).
local C = Color3.fromRGB
local P = {}
P.Pets = {
	gooey = { name = "Gooey", rarity = 1, power = 0.10, coins = 0.05, color = C(120, 230, 90), ears = "round" },
	pip = { name = "Pip", rarity = 1, power = 0.12, coins = 0.05, color = C(255, 200, 120), ears = "cat" },
	bubbles = { name = "Bubbles", rarity = 2, power = 0.25, coins = 0.10, color = C(80, 200, 255), ears = "bunny" },
	jelly_kid = { name = "Jelly Kid", rarity = 4, power = 0.8, coins = 0.30, color = C(255, 220, 60), ears = "cat" },
	bolt = { name = "Bolt", rarity = 1, power = 0.35, coins = 0.12, color = C(190, 160, 120), ears = "none" },
	cogsy = { name = "Cogsy", rarity = 2, power = 0.6, coins = 0.2, color = C(255, 159, 67), ears = "round" },
	dune_fox = { name = "Dune Fox", rarity = 3, power = 1.1, coins = 0.35, color = C(235, 170, 80), ears = "cat" },
	titan_cub = { name = "Titan Cub", rarity = 4, power = 2.0, coins = 0.6, color = C(255, 120, 60), ears = "round" },
	frosty = { name = "Frosty", rarity = 1, power = 1.0, coins = 0.3, color = C(235, 245, 255), ears = "round" },
	ice_bun = { name = "Ice Bun", rarity = 2, power = 1.6, coins = 0.45, color = C(140, 200, 255), ears = "bunny" },
	yeti_pup = { name = "Yeti Pup", rarity = 4, power = 4.0, coins = 1.0, color = C(220, 240, 255), ears = "cat" },
	cinder = { name = "Cinder", rarity = 1, power = 2.6, coins = 0.7, color = C(255, 140, 50), ears = "cat" },
	lava_lizard = { name = "Lava Lizard", rarity = 3, power = 4.5, coins = 1.2, color = C(255, 80, 40), ears = "none" },
	forge_spirit = { name = "Forge Spirit", rarity = 5, power = 12, coins = 3, color = C(255, 79, 106), ears = "bunny" },
	wisp = { name = "Wisp", rarity = 2, power = 7, coins = 1.8, color = C(181, 108, 255), ears = "none" },
	glitchy = { name = "Glitchy", rarity = 3, power = 11, coins = 2.6, color = C(58, 216, 255), ears = "cat" },
	nebula = { name = "Nebula", rarity = 4, power = 18, coins = 4, color = C(255, 79, 216), ears = "bunny" },
	void_dragon = { name = "Void Dragon", rarity = 5, power = 40, coins = 9, color = C(120, 40, 200), ears = "none" },
}

-- Fusion cores: cost + odds (weights). One core per tier.
P.Cores = {
	{ id = "slime_core", name = "Jelly Core", tier = 1, coins = 250, mats = { slime_goo = 20, slime_core = 2 },
		odds = { gooey = 50, pip = 35, bubbles = 13, jelly_kid = 2 } },
	{ id = "gear_core", name = "Gear Core", tier = 2, coins = 6000, mats = { scrap_metal = 25, gear_core = 3 },
		odds = { bolt = 55, cogsy = 30, dune_fox = 13, titan_cub = 2 } },
	{ id = "ice_core", name = "Frost Core", tier = 3, coins = 90000, mats = { frost_shard = 30, ice_core = 3 },
		odds = { frosty = 60, ice_bun = 35, yeti_pup = 5 } },
	{ id = "flame_core", name = "Magma Core", tier = 4, coins = 1500000, mats = { magma_rock = 30, flame_core = 4 },
		odds = { cinder = 65, lava_lizard = 33, forge_spirit = 2 } },
	{ id = "void_core", name = "Void Core", tier = 5, coins = 20000000, mats = { void_dust = 35, void_core = 4 },
		odds = { wisp = 55, glitchy = 33, nebula = 11, void_dragon = 1 } },
}
P.BaseSlots = 3
P.CombineCount = 5 -- 5 same -&gt; golden, 5 golden -&gt; rainbow
P.GoldenMult = 2
P.RainbowMult = 4
P.MaxPets = 200
return P
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">Products</string><ProtectedString name="Source">-- Developer products (consumable). Custom keys are handled via MonetizationService.ProductHandlers.
return {
	Coins1 = { id = 0, order = 1, name = "1,000 Coins", price = 25, icon = "rbxassetid://0", grant = { Coins = 1000 } },
	Coins2 = { id = 0, order = 2, name = "6,000 Coins", price = 99, icon = "rbxassetid://0", grant = { Coins = 6000 }, tag = "BEST VALUE" },
	Gems1 = { id = 0, order = 3, name = "120 Gems", price = 49, icon = "rbxassetid://0", grant = { Gems = 120 } },
	TrainBoost = { id = 0, order = 4, name = "x3 Training (30 min)", price = 39, icon = "rbxassetid://0", handler = "TrainBoost" },
	Gems2 = { id = 0, order = 5, name = "700 Gems", price = 249, icon = "rbxassetid://0", grant = { Gems = 700 }, tag = "+17% BONUS" },
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">Raid</string><ProtectedString name="Source">-- Co-op raid: 10 waves, mini-boss at 5, raid boss at 10. Rewards scale with the party's best zone tier.
local Raid = {
	Waves = 10, MiniBossWave = 5, BossWave = 10,
	MaxPlayers = 4, WaveSeconds = 90, IntermissionSeconds = 4, RespawnSeconds = 5,
	MaxArenas = 3, ArenaSpacing = 200, ArenaOrigin = Vector3.new(700, 0, 0), ArenaSize = 140,
	MaxAlive = 20, -- hard cap on simultaneous raid monsters per raid
	-- per wave: count = min(MaxAlive, BaseCount + CountPerWave * wave); hp x (1 + HpPerWave*(wave-1)); x(1+0.25*(players-1))
	BaseCount = 3, CountPerWave = 1.2, HpPerWave = 0.18, PartyHpBonus = 0.25,
	MiniBossHp = 0.35, BossHp = 1.0, -- fraction of the tier boss HP (before wave/party scaling)
	-- rewards per cleared wave, indexed by tier
	CoinsPerWave = { 300, 3000, 25000, 200000, 1500000 },
	GemsPerWave = 2, TokensPerWave = 1, ClearBonus = { Gems = 25, Tokens = 10 },
	DailyFirstClear = { Gems = 50, Tokens = 15, CoinsMult = 5 }, -- CoinsMult x CoinsPerWave[tier]
	-- Raid Token shop. kind: boost | gems | mats | rare | title
	Shop = {
		{ id = "boost", name = "Training Boost 15 min", desc = "Boosted training for 15 minutes", cost = 30, kind = "boost", seconds = 900 },
		{ id = "gems", name = "Gem Pouch", desc = "100 Gems", cost = 25, kind = "gems", amount = 100 },
		{ id = "mats", name = "Material Pack", desc = "Common + core materials of your best tier", cost = 15, kind = "mats" },
		{ id = "rare", name = "Rare Material Crate", desc = "2 boss materials of your best tier", cost = 45, kind = "rare" },
		{ id = "title", name = "Trail Title: Raid Slayer", desc = "Exclusive title (one time)", cost = 150, kind = "title", title = "raid_slayer" },
	},
}
return Raid
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">Recipes</string><ProtectedString name="Source">-- Forge recipes, generated per tier. mats from the tier's zone (common part + rare core).
local Guns = require(script.Parent.Guns)
local TIER_MATS = {
	{ "slime_goo", "slime_core" },
	{ "scrap_metal", "gear_core" },
	{ "frost_shard", "ice_core" },
	{ "magma_rock", "flame_core" },
	{ "void_dust", "void_core" },
}
local COINS = { 100, 2500, 40000, 600000, 9000000 }

local R = { List = {}, ById = {}, TierMats = TIER_MATS }
local function add(r)
	table.insert(R.List, r)
	R.ById[r.id] = r
end
for tier = 1, 5 do
	local common, rare = TIER_MATS[tier][1], TIER_MATS[tier][2]
	for _, typeId in ipairs(Guns.TypeOrder) do
		if Guns.Types[typeId].minTier &lt;= tier then
			add({ id = typeId .. "_t" .. tier, kind = "gun", item = typeId, tier = tier, coins = COINS[tier],
				mats = { [common] = 12 + tier * 3, [rare] = 1 + math.floor(tier / 2) } })
		end
	end
	for _, slot in ipairs(Guns.ArmorOrder) do
		add({ id = slot .. "_t" .. tier, kind = "armor", item = slot, tier = tier, coins = math.floor(COINS[tier] * 0.8),
			mats = { [common] = 10 + tier * 3, [rare] = 1 } })
	end
end

-- Forge minigame: each Perfect adds bump chance; LuckyForge pass adds PassBump.
R.Minigame = { Parts = 4, PerfectBump = 0.04, PassBump = 0.10, MinSeconds = 2.5, QualityMin = 0.9, QualityMax = 1.15 }
R.CraftSeconds = 0 -- forge timer (0 = instant after minigame); InstantCraft product skips when &gt; 0
R.SalvageRefund = 0.3 -- coins refunded when scrapping an item
R.MaxItems = 150
return R
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">Season</string><ProtectedString name="Source">-- Season pass. Change Id to start a new season (everyone's season data resets).
-- reward = { Coins=, Gems=, mats = { [materialId] = n }, boostMin = n, title = "titleId" } (titles live in Achievements.Titles)
local S = {
	Id = 1,
	Name = "Season 1: Forge Rising",
	Tiers = 30,
	XpPerTier = 120,
	-- XP gained per QuestService stat increment
	Weights = { Kills = 0.4, BossKills = 12, Minigames = 6, Crafts = 8, Fusions = 10, PvpWins = 15, Minutes = 1 },
}

local mats = { "slime_core", "gear_core", "ice_core", "flame_core", "void_dust" }

local free, premium = {}, {}
for t = 1, S.Tiers do
	free[t] = { Coins = 250 * t }
	premium[t] = { Coins = 500 * t, Gems = 5 + math.floor(t / 3) * 2 }
	if t % 5 == 0 then
		free[t] = { Coins = 250 * t, Gems = 10 }
		premium[t].mats = { [mats[(t // 5 - 1) % #mats + 1]] = 3 + t // 5 }
	elseif t % 3 == 0 then
		free[t].boostMin = 10
		premium[t].boostMin = 30
	end
end
free[10] = { Gems = 20, title = "pass_vet" }
free[30] = { Gems = 50, boostMin = 60, title = "pass_champ" }
premium[1] = { Gems = 15, title = "pass_holder" }
premium[15] = { Gems = 40, boostMin = 60, title = "elite_operator" }
premium[30] = { Gems = 150, boostMin = 120, title = "forge_legend" }

S.Free, S.Premium = free, premium
return S
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">Settings</string><ProtectedString name="Source">-- Global game settings. The Director/Engineer edit THIS file per game, not the services.
return {
	GameName = "GUN FORGE SIMULATOR",
	DataStoreName = "PlayerData_v1", -- bump the suffix only for a full data wipe
	AutosaveSeconds = 120,

	-- Studio testing: pretend the player owns every game pass with id = 0 (unconfigured)
	-- so the whole game can be play-tested before passes are created on the website.
	StudioGrantUnconfiguredPasses = true,

	-- Demo gameplay loop (CollectibleService). Disable when the real genre loop is in.
	Collectibles = {
		Enabled = false, -- demo loop off: real loop = Training + Monsters
		MaxActive = 40, -- hard cap = performance safety
		SpawnRadius = 80,
		RespawnSeconds = 4,
		Value = 5,
	},

	Leaderboard = {
		Enabled = true,
		Stat = "Power", -- key in data.stats or currency to rank by
		StoreName = "Leaderboard_Power_v1",
		RefreshSeconds = 120,
		Top = 50,
	},
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">Social</string><ProtectedString name="Source">-- Social boosts (encourage playing with friends / joining the group).
return {
	FriendBoostPer = 0.05, FriendBoostMax = 0.25, -- +5% training &amp; coins per friend in the server (max +25%)
	PremiumBoost = 0.1, -- Roblox Premium members: +10% training &amp; coins
	GroupId = 0, -- your Roblox group id (0 = disabled)
	GroupBoost = 0.1, -- +10% for group members
	GroupChest = { cooldownHours = 24, reward = { Gems = 15, Coins = 500 } },
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000014"><Properties><string name="Name">Sounds</string><ProtectedString name="Source">-- Sound ids. Defaults use sounds that ship with every Roblox client (rbxasset://) so the game has
-- audio with zero uploads. For a better mix, replace with Creator Store audio ids (rbxassetid://...).
local gun = "rbxasset://sounds/electronicpingshort.wav"
return {
	Guns = {
		pistol = { id = "rbxasset://sounds/snap.mp3", volume = 0.5, pitch = 1.3 },
		smg = { id = "rbxasset://sounds/snap.mp3", volume = 0.35, pitch = 1.7 },
		shotgun = { id = "rbxasset://sounds/collide.wav", volume = 0.7, pitch = 0.8 },
		rifle = { id = "rbxasset://sounds/snap.mp3", volume = 0.5, pitch = 1.0 },
		blaster = { id = gun, volume = 0.4, pitch = 0.9 },
		railgun = { id = gun, volume = 0.6, pitch = 0.5 },
	},
	-- weapon layers (mixed with the shot): mechanical bolt/slide click, magazine out/in, distant tail, switch, charge
	Mech = {
		Bolt = { id = "rbxasset://sounds/clickfast.wav", volume = 0.35, pitch = 0.6 },
		MagOut = { id = "rbxasset://sounds/collide.wav", volume = 0.25, pitch = 2.2 },
		MagIn = { id = "rbxasset://sounds/clickfast.wav", volume = 0.55, pitch = 0.85 },
		Switch = { id = "rbxasset://sounds/button.wav", volume = 0.3, pitch = 1.6 },
		Charge = { id = gun, volume = 0.4, pitch = 0.4 },
	},
	Tail = { id = "rbxasset://sounds/collide.wav", volume = 0.3, pitch = 0.45, delayPer100 = 0.28, minDist = 45 },
	Reload = { id = "rbxasset://sounds/clickfast.wav", volume = 0.6, pitch = 1 },
	Empty = { id = "rbxasset://sounds/clickfast.wav", volume = 0.4, pitch = 1.6 },
	Hit = { id = "rbxasset://sounds/clickfast.wav", volume = 0.25, pitch = 2 },
	Crit = { id = gun, volume = 0.35, pitch = 1.8 },
	Death = { id = "rbxasset://sounds/collide.wav", volume = 0.5, pitch = 1.4 },
