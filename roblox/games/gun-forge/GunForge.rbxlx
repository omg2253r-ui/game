	SpookyNight = {
		Lighting = { ClockTime = 0.2, Brightness = 0.6, Ambient = C(30, 30, 55), EnvironmentDiffuseScale = 0.3, OutdoorAmbient = C(40, 40, 70), ExposureCompensation = -0.2, ColorShift_Top = C(120, 140, 200), ColorShift_Bottom = C(30, 30, 60) },
