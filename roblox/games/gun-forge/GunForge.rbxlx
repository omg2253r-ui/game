</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000015"><Properties><string name="Name">Spin</string><ProtectedString name="Source">-- Daily spin wheel: 8 weighted prizes, 1 free spin / FreeSeconds, extra spins cost Gems.
return {
	FreeSeconds = 86400,
	GemCost = 25,
	MaxPaidPerDay = 5,
	Prizes = {
		{ text = "500 Coins", glyph = "🪙", weight = 30, color = Color3.fromRGB(255, 205, 60), reward = { Coins = 500 } },
		{ text = "5 Gems", glyph = "💎", weight = 22, color = Color3.fromRGB(190, 110, 255), reward = { Gems = 5 } },
		{ text = "2,000 Coins", glyph = "💰", weight = 16, color = Color3.fromRGB(255, 159, 67), reward = { Coins = 2000 } },
		{ text = "15 Min Boost", glyph = "⚡", weight = 12, color = Color3.fromRGB(58, 216, 255), reward = { boostMin = 15 } },
		{ text = "Slime Cores", glyph = "🔷", weight = 8, color = Color3.fromRGB(80, 200, 255), reward = { mats = { slime_core = 5 } } },
		{ text = "20 Gems", glyph = "💠", weight = 6, color = Color3.fromRGB(120, 140, 255), reward = { Gems = 20 } },
		{ text = "Void Dust", glyph = "✦", weight = 4, color = Color3.fromRGB(181, 108, 255), reward = { mats = { void_dust = 5 } } },
		{ text = "JACKPOT 100 Gems", glyph = "🎰", weight = 2, color = Color3.fromRGB(255, 79, 106), reward = { Gems = 100 }, announce = true },
	},
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000016"><Properties><string name="Name">Story</string><ProtectedString name="Source">-- Commander Vex story chain. kind: "power" (stats.Power &gt;= goal), "stat" (stats[stat] delta since step start),
-- "rebirths" (&gt;= goal), "clan" (in a clan), "pets" (owned pets &gt;= goal).
local Zones = require(script.Parent.Zones)
local function zp(i) return Zones[i] and Zones[i].powerReq or 1e6 end

return {
	Npc = "Commander Vex",
	Steps = {
		{ text = "Train your Power. Stand in the training zone!", kind = "power", goal = 100, reward = { Coins = 200 } },
		{ text = "Defeat 10 monsters in Slime Meadow.", kind = "stat", stat = "Kills", goal = 10, reward = { Coins = 400 } },
		{ text = "Reach 1,000 Power.", kind = "power", goal = 1000, reward = { Coins = 600, Gems = 3 } },
		{ text = "Forge your first gun at the Forge.", kind = "stat", stat = "Crafts", goal = 1, reward = { Gems = 5 } },
		{ text = "Defeat 30 more monsters.", kind = "stat", stat = "Kills", goal = 30, reward = { Coins = 1000 } },
		{ text = "Reach Scrap Desert (zone 2) by gaining Power.", kind = "power", goal = zp(2), reward = { Coins = 1500, Gems = 5 } },
		{ text = "Defeat 40 monsters with your new gun.", kind = "stat", stat = "Kills", goal = 40, reward = { Coins = 2000 } },
		{ text = "Fuse a pet at the Pet station.", kind = "stat", stat = "Fusions", goal = 1, reward = { Gems = 8 } },
		{ text = "Play a minigame.", kind = "stat", stat = "Minigames", goal = 1, reward = { Coins = 2500 } },
		{ text = "Forge 3 more guns.", kind = "stat", stat = "Crafts", goal = 3, reward = { Gems = 10, mats = { gear_core = 3 } } },
		{ text = "Own 3 pets.", kind = "pets", goal = 3, reward = { Coins = 4000 } },
		{ text = "Defeat a boss.", kind = "stat", stat = "BossKills", goal = 1, reward = { Gems = 12 } },
		{ text = "Win a PvP match in the Arena.", kind = "stat", stat = "PvpWins", goal = 1, reward = { Gems = 15, Coins = 5000 } },
		{ text = "Join or create a clan.", kind = "clan", goal = 1, reward = { Gems = 15 } },
		{ text = "Reach Frost Cavern (zone 3) power.", kind = "power", goal = zp(3), reward = { Coins = 10000, Gems = 10 } },
		{ text = "Fuse 3 more pets.", kind = "stat", stat = "Fusions", goal = 3, reward = { Gems = 20, boostMin = 30 } },
		{ text = "Defeat 150 monsters.", kind = "stat", stat = "Kills", goal = 150, reward = { Coins = 15000 } },
		{ text = "Rebirth for the first time.", kind = "rebirths", goal = 1, reward = { Gems = 40, boostMin = 60 } },
		{ text = "Defeat 5 more bosses.", kind = "stat", stat = "BossKills", goal = 5, reward = { Gems = 40 } },
		{ text = "Reach Neon Void power. You are a legend!", kind = "power", goal = zp(5), reward = { Gems = 100, title = "vex_chosen" } },
	},
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000017"><Properties><string name="Name">Training</string><ProtectedString name="Source">-- AFK training tuning (rbx-economy). Gain/s = (Base + sqrt(Power) * SqrtFactor) * multipliers
return {
	Base = 2,
	SqrtFactor = 0.1,
	TickSeconds = 1,
	RebirthMultiplier = 1.5, -- per rebirth (multiplicative)
	-- x2 Pulse: active-play reward
	Pulse = { MinGap = 45, MaxGap = 75, ShowSeconds = 6, BoostSeconds = 30, Multiplier = 2, FirstAt = 10 },
	ProductBoost = { Multiplier = 3, Seconds = 1800 },
	Offline = { MaxHours = 4, Rate = 0.25, MinMinutes = 5 },
	-- training pads: players must be on a pad OR anywhere in the hub when AutoTrainAnywhere
	AutoTrainAnywhere = true,
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000018"><Properties><string name="Name">UiImages</string><ProtectedString name="Source">-- UI image registry. id = "rbxassetid://0" means NOT uploaded yet: UIKit falls back to the code-drawn look.
