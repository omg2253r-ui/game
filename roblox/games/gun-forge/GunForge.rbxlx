<roblox version="4"><Item class="ReplicatedStorage" referent="RBX00000017"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX00000016"><Properties><string name="Name">Shared</string></Properties><Item class="Folder" referent="RBX00000012"><Properties><string name="Name">Config</string></Properties><Item class="ModuleScript" referent="RBX00000001"><Properties><string name="Name">Codes</string><ProtectedString name="Source">-- Redeem codes (case-insensitive). expires = os.time() or 0 for never.
return {
	RELEASE = { reward = { Coins = 500, Gems = 20 }, expires = 0 },
	FORGE = { reward = { Coins = 1000 }, expires = 0 },
	THANKS100 = { reward = { Gems = 50 }, expires = 0 },
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000002"><Properties><string name="Name">Combat</string><ProtectedString name="Source">-- Player survival + PvP queue settings.
return {
	PlayerBaseHp = 100,
	PowerHpFactor = 1.0, -- + sqrt(Power) * factor  (PvE only)
	RegenDelay = 4, RegenPerSecond = 0.06, -- fraction of max HP
	MonsterDamageScale = 0.5, -- global balance knob
	MonsterAggroRange = 45, MonsterAttackRange = 7, MonsterAttackCooldown = 1.6,
	FireTolerance = 0.85, -- server accepts shots at &gt;= 85% of nominal interval (latency)
	Arena = {
		Modes = {
			Duel = { name = "1v1", teamSize = 1, killsToWin = 5, minutes = 3 },
			Duo = { name = "2v2", teamSize = 2, killsToWin = 10, minutes = 4 },
			Squad = { name = "4v4", teamSize = 4, killsToWin = 20, minutes = 5 },
		},
		RespawnSeconds = 3, EloK = 32, WinCoins = 300, LoseCoins = 75,
	},
	Tournament = { IntervalMinutes = 30, Size = 8, EntryCoins = 500, SignupSeconds = 60, KillsToWin = 3, PrizeGems = 40 },
	Clan = { CreateCoins = 25000, MaxMembers = 30, TagMaxLen = 4, NameMaxLen = 20, XpPerKill = 1, XpPerPvpWin = 25, PerkPerLevel = 0.05, XpPerLevel = 5000 },
	WorldBoss = { IntervalMinutes = 20, Hp = 2000000, Position = Vector3.new(0, 0, 90) },
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">DataTemplate</string><ProtectedString name="Source">-- Default save data. New keys are merged into old saves automatically (reconcile).
-- Never rename keys after launch; add new ones instead.
local Economy = require(script.Parent.Economy)

local currencies = {}
for name, def in pairs(Economy.Currencies) do
	currencies[name] = def.start
end

return {
	version = 1,
	currencies = currencies,
	stats = { Power = 0, Kills = 0, BossKills = 0, X2Taps = 0, Minigames = 0, Crafts = 0, Fusions = 0, PvpWins = 0, Earn = 0, Minutes = 0, Purchases = 0 },
	inventory = {}, -- materials: [materialId] = count
	items = {}, -- [uid] = { kind = "gun"|"armor"|"pet", id = typeOrPetId, tier, rarity, dmg/hp/mult, golden }
	nextUid = 1,
	equipped = { gun = "", helmet = "", vest = "", boots = "", pets = {} },
	rebirths = 0,
	boostUntil = 0, -- x3 training product end (os.time)
	lastSeen = 0, -- offline earnings
	index = { guns = {}, pets = {}, monsters = {} },
	pvp = { rating = 1000, wins = 0, losses = 0, trophies = 0 },
	clan = "",
	codes = {},
	daily = { lastDay = 0, streak = 0 },
	quests = { day = 0, list = {} },
	settings = { music = true, sfx = true, lowFx = false },
	receipts = {}, -- processed PurchaseIds (idempotency, trimmed to last 50)
	firstJoin = 0,
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">Economy</string><ProtectedString name="Source">-- Currencies, rewards and quests. Balancing lives here (Economy designer owns this file).
return {
	Currencies = {
		Coins = { start = 0, leaderstat = true, color = Color3.fromRGB(255, 205, 60) },
		Gems = { start = 10, leaderstat = false, color = Color3.fromRGB(190, 110, 255) },
	},

	-- Daily login streak; index = streak day (loops after last)
	DailyRewards = {
		{ Coins = 100 },
		{ Coins = 200 },
		{ Coins = 300, Gems = 5 },
		{ Coins = 500 },
		{ Coins = 750, Gems = 10 },
		{ Coins = 1000 },
		{ Coins = 2000, Gems = 30 },
	},

	-- Playtime rewards (minutes in this session) keep sessions long
	PlaytimeRewards = {
		{ minutes = 5, reward = { Coins = 150 } },
		{ minutes = 15, reward = { Coins = 400 } },
		{ minutes = 30, reward = { Gems = 15 } },
		{ minutes = 60, reward = { Coins = 2500, Gems = 25 } },
	},

	-- Daily quests: stats are fed by genre services via QuestService.Progress
	QuestsPerDay = 3,
	QuestPool = {
		{ id = "kill50", text = "Defeat 50 monsters", stat = "Kills", goal = 50, reward = { Coins = 400 } },
		{ id = "kill200", text = "Defeat 200 monsters", stat = "Kills", goal = 200, reward = { Gems = 10 } },
		{ id = "boss1", text = "Defeat a boss", stat = "BossKills", goal = 1, reward = { Gems = 8 } },
		{ id = "x2tap", text = "Catch 5 x2 Pulses", stat = "X2Taps", goal = 5, reward = { Coins = 300 } },
		{ id = "mini3", text = "Play 3 training minigames", stat = "Minigames", goal = 3, reward = { Coins = 350 } },
		{ id = "forge2", text = "Forge 2 items", stat = "Crafts", goal = 2, reward = { Gems = 6 } },
		{ id = "fuse1", text = "Hatch a pet at the Fusion Altar", stat = "Fusions", goal = 1, reward = { Coins = 500 } },
		{ id = "pvp3", text = "Win 3 arena matches", stat = "PvpWins", goal = 3, reward = { Gems = 12 } },
		{ id = "play20", text = "Play for 20 minutes", stat = "Minutes", goal = 20, reward = { Coins = 300 } },
		{ id = "earn5k", text = "Earn 5,000 coins", stat = "Earn", goal = 5000, reward = { Gems = 5 } },
	},

	-- BadgeService badge ids (0 = skip). Awarded by AnalyticsService helpers.
	Badges = {
		Welcome = 0,
		FirstPurchase = 0,
		Streak7 = 0,
		FirstLegendary = 0,
		TournamentWin = 0,
		Rebirth1 = 0,
	},
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">GamePasses</string><ProtectedString name="Source">-- Game passes (real Robux, permanent). id = 0 -&gt; create on Creator Hub, paste id.
-- Perks NEVER apply in PvP (ArenaService uses normalized stats).
